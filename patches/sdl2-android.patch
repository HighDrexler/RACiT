+/* RACiT: attach under the thread's own name. With no name, ART names the Java
+ * thread "Thread-N" and renames the native thread to match, so the game's
+ * threads (the PPU main thread, the RSX threads) showed in the companion's
+ * Status page, simpleperf and top as "Thread-3" and the like. */
+static JavaVMAttachArgs *racit_attach_args(JavaVMAttachArgs *args, char name[16])
+{
+    SDL_memset(name, 0, 16);
+    if (prctl(PR_GET_NAME, name, 0, 0, 0) != 0 || !name[0]) return NULL;
+    args->version = JNI_VERSION_1_4; args->name = name; args->group = NULL;
+    return args;
+}
