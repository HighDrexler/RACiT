+static void Android_MouseButtons(SDL_Window *window, int state)
+{
+    int bit;
+    int changes = state ^ last_state;
+    for (bit = BUTTON_PRIMARY; bit <= BUTTON_FORWARD; bit <<= 1) {
+        if (changes & bit) SDL_SendMouseButton(window, 0,
+            state & bit ? SDL_PRESSED : SDL_RELEASED, TranslateButton(bit));
+    }
+    last_state = state;
+}
+
+void Android_OnMouseCaptureChanged(SDL_Window *window, SDL_bool captured)
+{
+    SDL_Event event;
+    capture_active = captured;
+    relative_remainder_x = relative_remainder_y = 0.0f;
+    if (!window) { last_state = 0; return; }
+    if (!captured) Android_MouseButtons(window, 0);
+    SDL_zero(event);
+    event.type = SDL_USEREVENT;
+    event.user.windowID = window->id;
+    event.user.code = SDL_RACIT_ANDROID_MOUSE_CAPTURE;
+    event.user.data1 = (void *)(size_t)captured;
+    SDL_PushEvent(&event);
+}
+
+static void Android_MouseMotion(SDL_Window *window, float x, float y, SDL_bool relative)
+{
+    int dx, dy;
+    if (relative) {
+        if (!capture_active) return;
+        /* Preserve subpixel touchpad motion instead of truncating each sample.
+         * Also reject non-finite/out-of-range driver values before float->int. */
+        if (!(x >= -32768.0f && x <= 32768.0f) || !(y >= -32768.0f && y <= 32768.0f)) return;
+        x += relative_remainder_x;
+        y += relative_remainder_y;
+        dx = (int)x; dy = (int)y;
+        relative_remainder_x = x - dx; relative_remainder_y = y - dy;
+        SDL_SendMouseMotion(window, 0, SDL_TRUE, dx, dy);
+    } else if (!capture_active) {
+        SDL_SendMouseMotion(window, 0, SDL_FALSE, (int)x, (int)y);
+    }
+}
