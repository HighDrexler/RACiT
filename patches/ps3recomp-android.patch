+/* display_check's notice: top centre (the FPS counter takes the left, trophies the right), 12 s, fades. */
+static void note_popup(ui_out* o, int sw, int sh)
+{
+    (void)sh;
+    if (!s_note.on) return;
+    const rsx_ui_font* f = o->f;
+    const float px = (float)f->px, lh = (float)f->line_h;
+    LOCK();
+    const unsigned long long t = now_ms();
+    if (!s_note.t0) s_note.t0 = t;
+    const unsigned long long age = t - s_note.t0, life = 12000;
+    if (age >= life) { s_note.on = 0; UNLOCK(); return; }
+    const float pad = px * 0.6f, maxw = (float)sw * 0.6f;
+    char l1[160], l2[160];
+    fit_text(f, s_note.l1, maxw, l1, sizeof l1);
+    fit_text(f, s_note.l2, maxw, l2, sizeof l2);
+    float tw = text_w(f, s_note.head);
+    if (text_w(f, l1) > tw) tw = text_w(f, l1);
+    if (text_w(f, l2) > tw) tw = text_w(f, l2);
+    const float pw = pad * 2.4f + tw, ph = lh * 3.0f + pad * 2.0f;
+    float alpha = 1.0f;
+    if (age > life - 600) alpha = (float)(life - age) / 600.0f;
+    const int a = (int)(alpha * 255.0f);
+    const float x0 = ((float)sw - pw) * 0.5f, y0 = px * 0.8f;
+    rect(o, x0, y0, x0 + pw, y0 + ph, rgba(16, 18, 26, (int)(alpha * 236.0f)));
+    rect(o, x0, y0, x0 + px * 0.16f, y0 + ph, rgba(242, 140, 40, a));
+    text(o, x0 + pad * 1.4f, y0 + pad, s_note.head, rgba(242, 140, 40, a));
+    text(o, x0 + pad * 1.4f, y0 + pad + lh, l1, rgba(240, 240, 245, a));
+    text(o, x0 + pad * 1.4f, y0 + pad + lh * 2.0f, l2, rgba(200, 200, 210, a));
+    UNLOCK();
+}
