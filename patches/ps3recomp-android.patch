+#define AUDIO_DEV_BLOCKS 4u         /* in the device's queue: 21 ms */
+static u32 s_q_target = 6;          /* blocks wanted in the stretcher beyond its frame: 6 (32 ms), +2 per dropout with sound, up to 24 (128 ms) */
