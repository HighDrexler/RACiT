@@ -0,0 +1,35 @@
+#ifndef PS3RECOMP_PPU_VMX_PERMUTE_H
+#define PS3RECOMP_PPU_VMX_PERMUTE_H
+
+#include <stdint.h>
+#include <string.h>
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#endif
+
+/* VMX registers contain raw guest bytes. vperm indexes the concatenation of
+ * A and B using the selector's low five bits; no word endian conversion is
+ * involved. Capture every input before storing so vd may alias va/vb/vc.
+ * AArch64's baseline TBL replaces sixteen scalar dependent byte gathers.
+ * Keep the byte-loop fallback as the portable reference, including controls
+ * with the high bits set. No optional ARM ISA extension is required. */
+static inline void ppu_vperm_bytes(void* destination, const void* a,
+                                   const void* b, const void* control)
+{
+#if defined(__aarch64__) && !defined(PPU_VPERM_FORCE_SCALAR)
+    const uint8x16x2_t table = {{vld1q_u8((const uint8_t*)a), vld1q_u8((const uint8_t*)b)}};
+    const uint8x16_t selectors = vandq_u8(vld1q_u8((const uint8_t*)control), vdupq_n_u8(31));
+    vst1q_u8((uint8_t*)destination, vqtbl2q_u8(table, selectors));
+#else
+    const uint8_t* aa = (const uint8_t*)a;
+    const uint8_t* bb = (const uint8_t*)b;
+    const uint8_t* cc = (const uint8_t*)control;
+    uint8_t result[16];
+    for (int i = 0; i < 16; ++i) {
+        const uint8_t select = cc[i] & 31;
+        result[i] = select < 16 ? aa[select] : bb[select - 16];
+    }
+    memcpy(destination, result, sizeof result);
+#endif
+}
+#endif
