-static int ld_blit_gpu(u32 src_loc, u32 src_abs, u32 src_pitch,
-                       u32 dst_loc, u32 dst_abs, u32 dst_pitch, u32 w, u32 h)
-{
-    if (!g.ready || !src_pitch || !dst_pitch || !w || !h) return 0;
