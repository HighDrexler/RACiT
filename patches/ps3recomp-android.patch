+/* On the lane, for a critical job: run it as a fiber. 0 = not done that way (run it as before). */
+static int racacit_fiber_job(spu_context* ctx, uint32_t return_pc)
+{
+    if (!racacit_fiber_on()) return 0;
+    racacit_fiber* f = 0;
+    for (int i = 0; i < RACACIT_NFIBERS && !f; i++) {
+        spu_context* exp = 0;
+        if (__atomic_compare_exchange_n(&s_fib[i].ctx, &exp, ctx, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) f = &s_fib[i];
+    }
+    if (!f) { __atomic_fetch_add(&g_racacit_fiber_n[3], 1ul, __ATOMIC_RELAXED); return 0; }
+    if (!f->stack) {
+        void* m = mmap(NULL, RACACIT_FIBER_STACK, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (m == MAP_FAILED) { __atomic_store_n(&f->ctx, (spu_context*)0, __ATOMIC_RELEASE); return 0; }
+        mprotect(m, 4096, PROT_NONE);   /* a guard page under the stack */
+        f->stack = (uint8_t*)m;
+    }
+    f->return_pc = return_pc;
+    f->exit_ = 0; f->poll = 0; f->done = 0; f->published = 0; f->nonlocal = 0;
+    f->kind = racacit_fiber_kind(ctx);
+    RACACIT_FIBER_K(f, 0);
+    /* The first frame racacit_fswitch "returns" through: x19 = f, x30 = the trampoline, and the
+     * FPCR of this lane (SPU mode: we are inside spu_run_with_halt). */
+    uint64_t* fr = (uint64_t*)(f->stack + RACACIT_FIBER_STACK - 256);
+    memset(fr, 0, 176);
+    fr[0] = (uint64_t)(uintptr_t)f;                          /* x19 */
+    fr[11] = (uint64_t)(uintptr_t)racacit_fiber_tramp;       /* x30 */
+    { uint64_t fpcr; __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr)); fr[20] = fpcr; }
+    f->sp = fr;
+    __atomic_store_n(&f->state, 2, __ATOMIC_RELEASE);
+    racacit_fiber_resume(f);                                  /* the first slice, here */
+    __atomic_fetch_add(&g_racacit_fiber_n[0], 1ul, __ATOMIC_RELAXED);
+    if (__atomic_load_n(&f->state, __ATOMIC_ACQUIRE) != 3) {
+        __atomic_store_n(&f->published, 1, __ATOMIC_RELEASE);
+        __atomic_add_fetch(&g_racacit_fibers_live, 1, __ATOMIC_ACQ_REL);
+        racacit_lane_sleep(1);
+        const unsigned long long fallback = 400ull * 192ull / 10ull;   /* ~400 us of the 19.2 MHz counter */
+        const unsigned long long absent = 30ull * 192ull / 10ull;     /* ~30 us: the main thread is elsewhere */
+        while (__atomic_load_n(&f->state, __ATOMIC_ACQUIRE) != 3) {
+            const unsigned long long now = racacit_lane_clock();
+            const int main_away = now - __atomic_load_n(&s_fib_serviced, __ATOMIC_RELAXED) > absent;
+            if (__atomic_load_n(&f->state, __ATOMIC_ACQUIRE) == 1 && racacit_fiber_ready(f) &&
+                (!f->irq_owner || pthread_equal(f->irq_owner, pthread_self())) &&
+                now - f->parked_at > (main_away ? absent : fallback)) {
+                int exp = 1;
+                if (__atomic_compare_exchange_n(&f->state, &exp, 2, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+                    __atomic_fetch_add(&g_racacit_fiber_n[2], 1ul, __ATOMIC_RELAXED);
+                    RACACIT_FIBER_K(f, 2);
+                    racacit_fiber_resume(f);
+                    continue;
+                }
+            }
+            /* 200 us while the main thread runs the fiber; 30 us while it is away, to look again soon. */
+            const struct timespec ts = { 0, main_away ? 30000 : 200000 };
+            RACACIT_FIBER_K(f, 6);
+            syscall(SYS_futex, &f->done, FUTEX_WAIT_PRIVATE, 0, &ts, NULL, 0);
+        }
+        racacit_lane_sleep(0);
+        __atomic_store_n(&f->published, 0, __ATOMIC_RELEASE);
+        __atomic_sub_fetch(&g_racacit_fibers_live, 1, __ATOMIC_ACQ_REL);
+    }
+    const int nonlocal = f->nonlocal;
+    __atomic_store_n(&f->ctx, (spu_context*)0, __ATOMIC_RELEASE);
+    /* The job's own exit, repeated here where its driver frame is (both longjmp; neither returns
+     * while that frame is armed, as without fibers). */
+    if (nonlocal == 2) { extern void spu_restart_dispatch(spu_context*); spu_restart_dispatch(ctx); }
+    else if (nonlocal == 1) { extern void spu_halt(spu_context*); spu_halt(ctx); }
+    return 1;
+}
+#endif
