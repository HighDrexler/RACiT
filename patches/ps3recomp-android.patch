+        s_yield = ncpu >= 8 ? 40000 : 1024;
+#if defined(__ANDROID__)
+        /* A phone with eight cores is not a host with cores to spare: small ones among them, and
+         * the fast ones full of runnable threads that this spin keeps waiting. SPU_IDLE_SPIN sets it. */
+        { const char* e = getenv("SPU_IDLE_SPIN"); s_spin = e ? atoi(e) : 256; s_yield = s_spin * 4 + 1; }
+#endif
+    }
