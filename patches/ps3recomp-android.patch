+    if (!ad || FAILED(IDXGIAdapter3_QueryVideoMemoryInfo(ad, 0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &mi))) return -1;
+    *used = (unsigned)(mi.CurrentUsage >> 20); *budget = (unsigned)(mi.Budget >> 20);
