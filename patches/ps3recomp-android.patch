diff --git a/runtime/spu/spu_lanes.h b/runtime/spu/spu_lanes.h
new file mode 100644
index 0000000..9f75f2e
--- /dev/null
+++ b/runtime/spu/spu_lanes.h
@@ -0,0 +1,74 @@
+/*
+ * racacit: the SPURS lanes' host threads and whether each is asleep, for the main thread's core
+ * swap on Android (game/main.cpp racacit_swap_*). While the main thread waits on an SPU job, the
+ * lane that woke last is the one most likely running it. Each lane writes its own entry; the main
+ * thread only reads them. Lanes register in spurs_lane_thread (cellSpurs.c) and mark the sleeps
+ * of spu_lr_wait, the idle line poll (spu_channels.c) and the lane loop's idle pause.
+ */
+#ifndef SPU_LANES_H
+#define SPU_LANES_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RACACIT_LANES 8
+/* One cache line each: every lane writes its own entry on every sleep and wake, job start and
+ * lock-line wait, and at 56 bytes the entries straddled lines, so neighbouring lanes (and the main
+ * thread reading them for the core swap) kept taking each other's line. */
+struct __attribute__((aligned(64))) racacit_lane {
+    volatile long tid;                  /* host thread id, 0 = slot unused */
+    volatile int asleep;                /* in one of the marked sleeps */
+    volatile unsigned long long woke;   /* racacit_lane_clock() when it last woke */
+    volatile unsigned long long job;    /* when its current SPU job started (spu_drain.c), 0 = none */
+    volatile unsigned guid;             /* that job's GUID (LS 0x100), 0 = none */
+    volatile int critical;              /* that job is a collision job the main thread ping-pongs with */
+    void* volatile ctx;                 /* the context of its last lock-line wait (spu_channels.c spu_lr_wait) */
+};
+extern struct racacit_lane g_racacit_lanes[RACACIT_LANES];
+extern volatile int g_racacit_nlanes;
+#ifdef __cplusplus
+extern thread_local int t_racacit_lane;
+extern thread_local int t_racacit_crit;
+#else
+extern _Thread_local int t_racacit_lane;   /* this thread's slot, -1 if not a lane */
+extern _Thread_local int t_racacit_crit;   /* this lane is running a critical job (spu_drain.c) */
+#endif
+/* The collision jobs the main thread hands records to one at a time and waits on each
+ * (func_00555EAC; [frame-waits] lr 002A6558 / 002A887C, ~100 round trips a frame on the Thor):
+ * CollNarrow (job_B8A980) and CollBroad (job_B9B580). */
+static inline int racacit_critical_job(unsigned guid)
+{
+    return guid == 0x43593402u || guid == 0x4248d602u;
+}
+/* spu_channels.c: the critical lane's lock-line waits (count, how they ended, time), for the
+ * "[pingpong]" line; [0] waits [1] ended in the spin [2] after a sleep [3] at the bound [4] ns. */
+extern volatile unsigned long long g_racacit_pp[5];
+
+void racacit_lane_register(void);
+
+/* A fixed-rate counter that is cheap to read (the ARM generic timer, ~10 ns); only differences
+ * between two readings are used. */
+static inline unsigned long long racacit_lane_clock(void)
+{
+#if defined(__aarch64__)
+    unsigned long long v; __asm__ __volatile__("mrs %0, cntvct_el0" : "=r"(v)); return v;
+#else
+    extern unsigned long long ps3_qpc_us(void);
+    return ps3_qpc_us();
+#endif
+}
+
+static inline void racacit_lane_sleep(int on)
+{
+    const int i = t_racacit_lane;
+    if (i < 0) return;
+    if (on) { g_racacit_lanes[i].asleep = 1; return; }
+    g_racacit_lanes[i].woke = racacit_lane_clock();
+    __atomic_store_n(&g_racacit_lanes[i].asleep, 0, __ATOMIC_RELEASE);
+}
+
+#ifdef __cplusplus
+}
+#endif
+#endif
