+typedef struct { float x, y, r, g, b, a; } vk_ov_vtx;
+static struct {
+    VkShaderModule vs, fs;
+    VkPipelineLayout layout;
+    VkPipeline pipe;
+    int failed;
+    vk_ov_vtx* v; u32 n, cap;
