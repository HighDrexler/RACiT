+ * mixing thread keeps AUDIO_DEV_BLOCKS blocks in it as it did in SDL's queue, so
+ * the clock, the stretcher and the 30 s report work as before. A short ring at a
+ * callback plays what it has and fades the rest out over 1.3 ms (no click), and
+ * is counted. The stream is reopened if the device goes (headphones, Bluetooth);
+ * paused while the game is in the background. libaaudio is loaded at run time:
+ * where it is missing or the stream will not open, SDL as before.
+ * RACACIT_AAUDIO=0: SDL as before. RACACIT_AAUDIO_BURSTS=<n>: AAudio's own buffer,
+ * in bursts (default 4, fewer where a burst is long). */
+#include <dlfcn.h>
+#include <aaudio/AAudio.h>
+#define AA_RING 16384u                       /* frames (341 ms); a power of two */
+static struct {
+    void* lib;
+    aaudio_result_t (*createBuilder)(AAudioStreamBuilder**);
+    void (*setDirection)(AAudioStreamBuilder*, aaudio_direction_t);
+    void (*setPerf)(AAudioStreamBuilder*, aaudio_performance_mode_t);
+    void (*setSharing)(AAudioStreamBuilder*, aaudio_sharing_mode_t);
+    void (*setFormat)(AAudioStreamBuilder*, aaudio_format_t);
+    void (*setChannels)(AAudioStreamBuilder*, int32_t);
+    void (*setRate)(AAudioStreamBuilder*, int32_t);
+    void (*setUsage)(AAudioStreamBuilder*, aaudio_usage_t);
+    void (*setContent)(AAudioStreamBuilder*, aaudio_content_type_t);
+    void (*setDataCb)(AAudioStreamBuilder*, AAudioStream_dataCallback, void*);
+    void (*setErrorCb)(AAudioStreamBuilder*, AAudioStream_errorCallback, void*);
+    aaudio_result_t (*open)(AAudioStreamBuilder*, AAudioStream**);
+    aaudio_result_t (*delBuilder)(AAudioStreamBuilder*);
+    aaudio_result_t (*start)(AAudioStream*);
+    aaudio_result_t (*pause)(AAudioStream*);
+    aaudio_result_t (*stop)(AAudioStream*);
+    aaudio_result_t (*close)(AAudioStream*);
+    int32_t (*getRate)(AAudioStream*);
+    int32_t (*getChannels)(AAudioStream*);
+    aaudio_format_t (*getFormat)(AAudioStream*);
+    int32_t (*getBurst)(AAudioStream*);
+    int32_t (*getCapacity)(AAudioStream*);
+    aaudio_result_t (*setBufferSize)(AAudioStream*, int32_t);
+    int32_t (*getBufferSize)(AAudioStream*);
+    aaudio_performance_mode_t (*getPerf)(AAudioStream*);
+    aaudio_sharing_mode_t (*getSharing)(AAudioStream*);
+    int32_t (*getXRuns)(AAudioStream*);
+    AAudioStream* st;
+    int on;                                  /* the main output is this stream */
+    volatile int lost;                       /* the error callback: the stream is gone */
+    int paused;                              /* the game is in the background */
+    unsigned long long w, r;                 /* frames written (mixing thread) / played (callback) */
+    unsigned long long short_cb, short_cb0;  /* callbacks that found the ring short, after the first write */
+    int32_t xruns0;
+    unsigned long long retry_us, drain_us;
+    float last[2];
+    float ring[AA_RING * 2];
+} s_aa;
+
+static aaudio_data_callback_result_t aa_data(AAudioStream* st, void* user, void* data, int32_t n)
+{
+    (void)st; (void)user;
+    /* v113-android.48: AAudio's callback thread to the small cores too (it inherited the fast set
+     * from the game thread that opened the stream), once per thread; RACACIT_AUDIO_LITTLE=0: not. */
+    { static _Thread_local int t_placed;
+      if (__builtin_expect(!t_placed, 0)) { t_placed = 1;
+          const char* e = getenv("RACACIT_AUDIO_LITTLE");
+          if (!(e && *e == '0')) { extern int racacit_little_thread(void); racacit_little_thread(); } } }
+    float* out = (float*)data;
+    const unsigned long long w = __atomic_load_n(&s_aa.w, __ATOMIC_ACQUIRE), r = s_aa.r;
+    const unsigned have = w - r < (unsigned long long)n ? (unsigned)(w - r) : (unsigned)n;
+    for (unsigned i = 0; i < have; i++) {
+        const unsigned p = (unsigned)((r + i) & (AA_RING - 1u));
+        out[i * 2] = s_aa.ring[p * 2]; out[i * 2 + 1] = s_aa.ring[p * 2 + 1];
+    }
+    if (have) { s_aa.last[0] = out[have * 2 - 2]; s_aa.last[1] = out[have * 2 - 1]; }
+    if (have < (unsigned)n) {
+        if (w) s_aa.short_cb++;
+        float g = 1.0f;
+        for (unsigned i = have; i < (unsigned)n; i++) {
+            g = g > 1.0f / 64.0f ? g - 1.0f / 64.0f : 0.0f;
+            out[i * 2] = s_aa.last[0] * g; out[i * 2 + 1] = s_aa.last[1] * g;
+        }
+        s_aa.last[0] *= g; s_aa.last[1] *= g;
+    }
+    __atomic_store_n(&s_aa.r, r + have, __ATOMIC_RELEASE);
+    return AAUDIO_CALLBACK_RESULT_CONTINUE;
+}
+
+static void aa_error(AAudioStream* st, void* user, aaudio_result_t e)
+{
+    (void)st; (void)user; (void)e;
+    s_aa.lost = 1;   /* closed and opened again by the mixing thread, never from here */
+}
+
+static int aa_load(void)
+{
+    if (s_aa.lib) return 0;
+    void* l = dlopen("libaaudio.so", RTLD_NOW | RTLD_LOCAL);
+    if (!l) return -1;
+#define AA_SYM(f, name) if (!(*(void**)&s_aa.f = dlsym(l, name))) { dlclose(l); return -1; }
+    AA_SYM(createBuilder, "AAudio_createStreamBuilder")
+    AA_SYM(setDirection, "AAudioStreamBuilder_setDirection")
+    AA_SYM(setPerf, "AAudioStreamBuilder_setPerformanceMode")
+    AA_SYM(setSharing, "AAudioStreamBuilder_setSharingMode")
+    AA_SYM(setFormat, "AAudioStreamBuilder_setFormat")
+    AA_SYM(setChannels, "AAudioStreamBuilder_setChannelCount")
+    AA_SYM(setRate, "AAudioStreamBuilder_setSampleRate")
+    AA_SYM(setDataCb, "AAudioStreamBuilder_setDataCallback")
+    AA_SYM(setErrorCb, "AAudioStreamBuilder_setErrorCallback")
+    AA_SYM(open, "AAudioStreamBuilder_openStream")
+    AA_SYM(delBuilder, "AAudioStreamBuilder_delete")
+    AA_SYM(start, "AAudioStream_requestStart")
+    AA_SYM(pause, "AAudioStream_requestPause")
+    AA_SYM(stop, "AAudioStream_requestStop")
+    AA_SYM(close, "AAudioStream_close")
+    AA_SYM(getRate, "AAudioStream_getSampleRate")
+    AA_SYM(getChannels, "AAudioStream_getChannelCount")
+    AA_SYM(getFormat, "AAudioStream_getFormat")
+    AA_SYM(getBurst, "AAudioStream_getFramesPerBurst")
+    AA_SYM(getCapacity, "AAudioStream_getBufferCapacityInFrames")
+    AA_SYM(setBufferSize, "AAudioStream_setBufferSizeInFrames")
+    AA_SYM(getBufferSize, "AAudioStream_getBufferSizeInFrames")
+    AA_SYM(getPerf, "AAudioStream_getPerformanceMode")
+    AA_SYM(getSharing, "AAudioStream_getSharingMode")
+    AA_SYM(getXRuns, "AAudioStream_getXRunCount")
+#undef AA_SYM
+    /* Android 9+: say what this is (games get the game routing and volume). */
+    *(void**)&s_aa.setUsage = dlsym(l, "AAudioStreamBuilder_setUsage");
+    *(void**)&s_aa.setContent = dlsym(l, "AAudioStreamBuilder_setContentType");
+    s_aa.lib = l;
+    return 0;
+}
+
+static void aa_close(void)
+{
+    if (!s_aa.st) return;
+    s_aa.stop(s_aa.st);
+    s_aa.close(s_aa.st);
+    s_aa.st = NULL;
+}
+
+/* 0 = playing. Logs what it got, or why not. */
+static int aa_open(int quiet)
+{
+    if (aa_load() != 0) { if (!quiet) fprintf(stderr, "[cellAudio] AAudio: libaaudio not loaded (%s); SDL output%c", dlerror(), 10); return -1; }
+    AAudioStreamBuilder* b = NULL;
+    if (s_aa.createBuilder(&b) != AAUDIO_OK || !b) return -1;
+    s_aa.setDirection(b, AAUDIO_DIRECTION_OUTPUT);
+    s_aa.setPerf(b, AAUDIO_PERFORMANCE_MODE_LOW_LATENCY);
+    s_aa.setSharing(b, AAUDIO_SHARING_MODE_SHARED);
+    s_aa.setFormat(b, AAUDIO_FORMAT_PCM_FLOAT);
+    s_aa.setChannels(b, 2);
+    s_aa.setRate(b, CELL_AUDIO_SAMPLE_RATE);
+    if (s_aa.setUsage) s_aa.setUsage(b, AAUDIO_USAGE_GAME);
+    if (s_aa.setContent) s_aa.setContent(b, AAUDIO_CONTENT_TYPE_MUSIC);
+    s_aa.setDataCb(b, aa_data, NULL);
+    s_aa.setErrorCb(b, aa_error, NULL);
+    AAudioStream* st = NULL;
+    const aaudio_result_t rc = s_aa.open(b, &st);
+    s_aa.delBuilder(b);
+    if (rc != AAUDIO_OK || !st) { if (!quiet) fprintf(stderr, "[cellAudio] AAudio: open failed (%d); SDL output%c", (int)rc, 10); return -1; }
+    if (s_aa.getRate(st) != CELL_AUDIO_SAMPLE_RATE || s_aa.getChannels(st) != 2 || s_aa.getFormat(st) != AAUDIO_FORMAT_PCM_FLOAT) {
+        if (!quiet) fprintf(stderr, "[cellAudio] AAudio: got %d Hz, %d channels, format %d; SDL output%c",
+                            (int)s_aa.getRate(st), (int)s_aa.getChannels(st), (int)s_aa.getFormat(st), 10);
+        s_aa.close(st); return -1;
+    }
+    const int32_t burst = s_aa.getBurst(st);
+    /* Four bursts (8 ms with the Thor's 2 ms MMAP bursts), at most ~43 ms where bursts are
+     * a normal mixer's 20 ms: margin against a late callback; latency is set by the ring. */
+    { const char* e = getenv("RACACIT_AAUDIO_BURSTS"); int nb = e ? atoi(e) : 4;
+      if (!e && burst > 0 && burst * nb > 2048) nb = 2048 / burst > 2 ? 2048 / burst : 2;
+      if (burst > 0 && nb > 0) s_aa.setBufferSize(st, burst * nb); }
+    s_aa.st = st; s_aa.lost = 0;
+    if (s_aa.start(st) != AAUDIO_OK) { aa_close(); if (!quiet) fprintf(stderr, "[cellAudio] AAudio: start failed; SDL output%c", 10); return -1; }
+    s_aa.xruns0 = s_aa.getXRuns(st);
+    const aaudio_performance_mode_t pm = s_aa.getPerf(st);
+    fprintf(stderr, "[cellAudio] output: AAudio, %d Hz, 2 channels, float; %s, %s; burst %d frames, buffer %d of %d%c",
+            (int)s_aa.getRate(st),
+            pm == AAUDIO_PERFORMANCE_MODE_LOW_LATENCY ? "low latency" : pm == AAUDIO_PERFORMANCE_MODE_POWER_SAVING ? "power saving" : "normal latency",
+            s_aa.getSharing(st) == AAUDIO_SHARING_MODE_EXCLUSIVE ? "exclusive" : "shared",
+            (int)burst, (int)s_aa.getBufferSize(st), (int)s_aa.getCapacity(st), 10);
+    return 0;
+}
+
+/* The mixing thread, each pass: reopen a lost stream, follow the background state
+ * (paused there, as SDL paused its device); with no stream at all, let the real rate
+ * pass through the ring so the clock and the game go on. Only one thread moves the
+ * read position at a time: the callback while a stream exists, this one otherwise. */
+static u64 audio_now_us(void);
+static void aa_tend(void)
+{
+    extern int rsx_android_in_background(void);
+    const int bg = rsx_android_in_background();
+    if (s_aa.st && bg != s_aa.paused) {
+        if (bg) s_aa.pause(s_aa.st); else s_aa.start(s_aa.st);
+        s_aa.paused = bg;
+    }
+    const unsigned long long now = audio_now_us();
+    if (s_aa.lost) {
+        if (s_aa.st) { aa_close(); fprintf(stderr, "[cellAudio] AAudio: the stream was lost (device change?); opening it again%c", 10); }
+        if (now >= s_aa.retry_us) {
+            s_aa.retry_us = now + 500000ull;
+            if (aa_open(1) == 0) {
+                s_aa.drain_us = 0;
+                if (bg) s_aa.pause(s_aa.st);
+                s_aa.paused = bg;
+            }
+        }
+    }
+    if (!s_aa.st) {
+        if (s_aa.drain_us) {
+            const unsigned long long frames = (now - s_aa.drain_us) * CELL_AUDIO_SAMPLE_RATE / 1000000ull;
+            const unsigned long long w = __atomic_load_n(&s_aa.w, __ATOMIC_ACQUIRE);
+            unsigned long long r = s_aa.r + frames;
+            if (r > w) r = w;
+            __atomic_store_n(&s_aa.r, r, __ATOMIC_RELEASE);
+            if (frames) s_aa.drain_us += frames * 1000000ull / CELL_AUDIO_SAMPLE_RATE;
+        } else s_aa.drain_us = now;
+    } else s_aa.drain_us = 0;
+}
+
+static unsigned aa_level(void)
+{
+    return (unsigned)(__atomic_load_n(&s_aa.w, __ATOMIC_RELAXED) - __atomic_load_n(&s_aa.r, __ATOMIC_ACQUIRE));
+}
+
+static void aa_write(const float* stereo, unsigned n)
+{
+    const unsigned long long w = s_aa.w;
+    if (aa_level() + n > AA_RING) return;   /* cannot happen: the mixer keeps AUDIO_DEV_BLOCKS */
+    for (unsigned i = 0; i < n; i++) {
+        const unsigned p = (unsigned)((w + i) & (AA_RING - 1u));
+        s_aa.ring[p * 2] = stereo[i * 2]; s_aa.ring[p * 2 + 1] = stereo[i * 2 + 1];
+    }
+    __atomic_store_n(&s_aa.w, w + n, __ATOMIC_RELEASE);
+}
+#endif
+
+static int audio_backend_init(void)
+{
+    if (SDL_WasInit(SDL_INIT_AUDIO) == 0) {
+        if (SDL_InitSubSystem(SDL_INIT_AUDIO) < 0) {
+            printf("[cellAudio] SDL audio init failed: %s\n", SDL_GetError());
+            return -1;
+        }
+    }
+#if defined(__ANDROID__)
+    { const char* e = getenv("RACACIT_AAUDIO");
+      if (!(e && *e == '0') && aa_open(0) == 0) { s_aa.on = 1; ds_audio_open(); return 0; } }
+#endif
+
+    SDL_AudioSpec want, have;
+    memset(&want, 0, sizeof(want));
+    want.freq     = CELL_AUDIO_SAMPLE_RATE;
+    want.format   = AUDIO_F32SYS;
+    want.channels = 2;
+    want.samples  = CELL_AUDIO_BLOCK_SAMPLES;
+    want.callback = NULL; /* We'll use SDL_QueueAudio */
+
+    s_sdl_audio_dev = SDL_OpenAudioDevice(NULL, 0, &want, &have, 0);
+    if (s_sdl_audio_dev == 0) {
+        printf("[cellAudio] SDL_OpenAudioDevice failed: %s\n", SDL_GetError());
+        return -1;
+    }
+
+    SDL_PauseAudioDevice(s_sdl_audio_dev, 0); /* Start playback */
+    fprintf(stderr, "[cellAudio] output: %d Hz, %d channels, %u-sample buffer%c", have.freq, have.channels, (unsigned)have.samples, 10);
+    ds_audio_open();
+    return 0;
+}
+
+static void audio_backend_shutdown(void)
+{
+#if defined(__ANDROID__)
+    if (s_aa.on) { aa_close(); s_aa.on = 0; }
+#endif
+    if (s_sdl_audio_dev) {
+        SDL_CloseAudioDevice(s_sdl_audio_dev);
+        s_sdl_audio_dev = 0;
+    }
+}
+
+/* One block to the device (the AAudio ring, or SDL's queue). */
+static void audio_dev_write(const float* stereo, u32 num_samples)
+{
+#if defined(__ANDROID__)
+    if (s_aa.on) { aa_write(stereo, num_samples); return; }
+#endif
+    if (s_sdl_audio_dev) SDL_QueueAudio(s_sdl_audio_dev, stereo, num_samples * 2 * sizeof(float));
+}
+
+static void audio_backend_submit(const float* stereo_samples, u32 num_samples)
+{
+    ds_audio_submit();   /* the controller's player (and its test capture) */
+    audio_dev_write(stereo_samples, num_samples);
+}
+
+static u32 audio_backend_queued_samples(void)
+{
+#if defined(__ANDROID__)
+    if (s_aa.on) return aa_level();
+#endif
+    if (s_sdl_audio_dev) {
+        return SDL_GetQueuedAudioSize(s_sdl_audio_dev) / (2 * sizeof(float));
+    }
+    return 0;
+}
+
+/* SDL queues without bound: keep AUDIO_DEV_BLOCKS ahead of the device (the AAudio ring the same). */
+static int audio_backend_room(void)
+{
+#if defined(__ANDROID__)
+    if (s_aa.on) {
+        aa_tend();
+        return aa_level() < CELL_AUDIO_BLOCK_SAMPLES * AUDIO_DEV_BLOCKS ? CELL_AUDIO_BLOCK_SAMPLES : 0;
+    }
+#endif
+    if (!s_sdl_audio_dev) return -1;
+    return SDL_GetQueuedAudioSize(s_sdl_audio_dev) / (2 * sizeof(float)) <
+           CELL_AUDIO_BLOCK_SAMPLES * AUDIO_DEV_BLOCKS ? CELL_AUDIO_BLOCK_SAMPLES : 0;
+}
+
+static void audio_backend_wait(void) { SDL_Delay(1); }
+
+static audio_stretch s_st;
+
+/* What the stretcher holds in blocks, beyond the frame it needs in hand. */
+static double audio_st_blocks(void)
+{
+    const double d = ast_level(&s_st) - AST_FRAME;
+    return d > 0.0 ? d / CELL_AUDIO_BLOCK_SAMPLES : 0.0;
+}
