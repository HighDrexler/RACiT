+ * phone GPUs lose more. RSX_VP_EXACT_DOTS=0 turns the position slice on (the far-distance
+ * depth fighting public PR #29 fixed), =1 makes every dot exact. */
+static int vp_plain_dots(void)
+{
+#if defined(__ANDROID__)
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_VP_EXACT_DOTS"); v = !(e && (*e == '0' || *e == '1')); }
+    return v;
+#else
+    return 0;
+#endif
