+/* See the declaration in spu_context.h. */
+void spu_depth_guard(spu_context* ctx)
+{
+    static uint32_t s_max = 0;
+    if (!s_max) {
+        const char* e = getenv("SPU_HOST_DEPTH_MAX");
+        s_max = e ? (uint32_t)strtoul(e, 0, 0) : 2000u;
+    }
+
+    /* Ring of recent drain sites. When the depth trips, the useful question is
+     * not "where are we" but "what cycle got us here" -- one pc names a point,
+     * a ring names the loop. Per thread: one shared ring was a cache line
+     * every SPU thread wrote on every lifted call. */
+    enum { RING = 24 };
+#if defined(__ANDROID__)
+    /* The ring's two thread-locals, on every call here. */
+    if (ctx->host_depth < s_max) return;
+    static uint32_t s_ring[RING];
+    static uint32_t s_n;
+#else
+    static _Thread_local uint32_t s_ring[RING];
+    static _Thread_local uint32_t s_n;
+    s_ring[s_n % RING] = ((uint32_t)ctx->pc & SPU_LS_MASK);
+    s_n++;
+
+    if (ctx->host_depth < s_max) return;
+#endif
+    static int s_reported = 0;
+    if (s_reported < 1) {   /* one report: five SPU threads all trip together */
+        s_reported++;
+        fprintf(stderr, "[spu-depth] img=%d pc=0x%05X lr=0x%05X host_depth=%u"
+                        " -- lifted call recursion, halting the SPU\n",
+                ctx->image_id, (uint32_t)ctx->pc & SPU_LS_MASK,
+                ctx->gpr[0]._u32[0] & SPU_LS_MASK, ctx->host_depth);
+        fprintf(stderr, "[spu-depth] recent drain sites (oldest first):");
+        uint32_t start = (s_n > RING) ? (s_n - RING) : 0;
+        for (uint32_t k = start; k < s_n; k++)
+            fprintf(stderr, " %05X", s_ring[k % RING]);
+        fprintf(stderr, "\n");
+        fflush(stderr);
+    }
+    { extern void spu_halt(spu_context*); spu_halt(ctx); }
+}
+
+/* See spu_context.h. Env-gated: SPU_TAILRET=1. */
+int spu_tailret_enabled(void)
+{
+    static int s_on = -1;
+    if (s_on < 0) { const char* e = getenv("SPU_TAILRET"); s_on = (e && e[0] == 0x31) ? 1 : 0; }
+    return s_on;
+}
+
+/* A return may use any register, not only r0. Running that branch target
+ * inside this drain executes the caller's continuation twice (once here,
+ * once when its real host frame resumes), including its stack adjustment.
+ *
+ * One kind of "wrong" pc is safe to run here, and must be: a lifted ENTRY
+ * that has no host frame of its own. Every WWS job module starts with
+ *
+ *     ila $r0, entry+0xAC ; a $r0, $r0, $r126 ; br body
+ *
+ * so the body ends `bi $r0` at a point the entry function tail-jumped to and
+ * whose host frame is therefore gone: the continuation exists only as the
+ * lifted function seeded at that address. Unwinding instead (the restart
+ * below) leaves the manager unable to resume at ITS return point, which is a
+ * plain r0 drain with no entry, and the job ends on a garbage r0. So when the
+ * callee comes back on a lifted entry, run it in this drain until the pc
+ * reaches return_pc; only a pc with no lifted code behind it is unwound. */
+typedef void (*spu_drain_fn)(spu_context*);
+extern spu_drain_fn spu_lookup(uint32_t addr, int image_id);
+
+static void spu_drain_call_run(spu_context* ctx, uint32_t return_pc);
+
+#if defined(__ANDROID__) && defined(__aarch64__)
+/* ---------------------------------------------------------------------------
+ * The collision jobs as fibers on the main thread (v113-android.27; RACACIT_COLL_FIBER=0 off)
+ *
+ * CollNarrow and CollBroad take records from the main thread one at a time while it waits on each
+ * answer. On a lane that cost ~16% of all SPU-thread CPU spinning between records plus ~9%
+ * computing, on the mid cores everything else needs, and every record crossed cores twice. Here
+ * the job runs on its own stack, a fiber: the lane starts it, and whenever it would wait on a lock
+ * line it parks instead; the main thread, waiting in its own loops for exactly that answer
+ * (stubs.cpp: the PPU spin hint and racacit_wait_poll), switches into it, and the fiber switches
+ * back when it waits again. A hand-off is a register swap (~0.1 us) on the main thread's core, in
+ * time the main thread spent spinning before -- unlike .26's co-location, nothing else ever shares
+ * that core. The lane sleeps meanwhile, and runs the fiber itself only if the main thread has left
+ * it parked and ready for a while (a wait outside those loops). The switch carries each side's
+ * FPCR: SPU code runs with round-toward-zero and flush-to-zero (spu_run_with_halt).
+ * ---------------------------------------------------------------------------*/
+#include <sys/mman.h>
+#include <pthread.h>
+#include <linux/futex.h>
+#include <sys/syscall.h>
+#include <limits.h>
+typedef struct racacit_fiber {
+    void* sp;                       /* the fiber's stack pointer while it is parked */
+    void* back_sp;                  /* its resumer's, while it runs */
+    spu_context* volatile ctx;      /* the job's context; 0 = slot free */
+    uint32_t return_pc;
+    volatile int state;             /* 1 parked, 2 running, 3 finished */
+    volatile int published;         /* the main thread may run it */
+    volatile int poll;              /* parked outside a lock-line wait: run it whenever serviced */
+    volatile int exit_;             /* set by the fiber just before its last switch */
+    volatile int done;              /* futex word the lane sleeps on */
+    volatile unsigned long long parked_at;
+    uint8_t* stack;
+    pthread_t runner;               /* the thread running it now (state 2) */
+    volatile int nonlocal;          /* the job left by spu_halt (1) or spu_restart_dispatch (2) */
+    pthread_t irq_owner;            /* parked inside an SPU interrupt handler: only this thread resumes it */
+    int kind;                       /* 0 narrow phase, 1 broad phase, 2 another job (g_racacit_fiber_k) */
+} racacit_fiber;
+enum { RACACIT_NFIBERS = 4, RACACIT_FIBER_STACK = 8u << 20 };
+static racacit_fiber s_fib[RACACIT_NFIBERS];
+volatile int g_racacit_fibers_live;   /* published fibers: main.cpp keeps the core swap out meanwhile */
+volatile unsigned long g_racacit_fiber_n[4];   /* jobs as fibers, main-thread runs, lane fallbacks, slots full */
+/* v113-android.44, for [sched]: the same by job -- [0] CollNarrow (43593402), [1] CollBroad (4248d602),
+ * [2] any other -- and what the totals hide: jobs, main-thread runs, lane runs, parks on a lock line,
+ * polling parks, parks only the lane may resume (inside an SPU interrupt frame), the lane's timed
+ * sleeps while its fiber is out. The Thor's one fiber run with [sched] (v38_ieee_fiber) had the narrow
+ * phase's lane at 30 ms/s as meant and the broad phase's still at 300: these say which of the two
+ * the main thread really runs, and what the other lane is doing. */
+volatile unsigned long g_racacit_fiber_k[3][7];
+#define RACACIT_FIBER_K(f, i) __atomic_fetch_add(&g_racacit_fiber_k[(f)->kind][i], 1ul, __ATOMIC_RELAXED)
+static int racacit_fiber_kind(const spu_context* c)
+{
+    if (!c || !c->ls) return 2;
+    const uint8_t* g = c->ls + 0x100;
+    const uint32_t guid = (uint32_t)g[0] << 24 | (uint32_t)g[1] << 16 | (uint32_t)g[2] << 8 | g[3];
+    return guid == 0x43593402u ? 0 : guid == 0x4248D602u ? 1 : 2;
+}
