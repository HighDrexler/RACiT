+static struct {
+    u32 fmt;        /* 0x0300: (log2h << 24) | (log2w << 16) | format */
+    u32 offset;     /* 0x0304: destination offset                     */
+    int active;
+    int subch;      /* which subchannel NV309E is bound to. Per-subchannel:
