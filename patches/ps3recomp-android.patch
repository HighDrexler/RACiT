+ * With SMT and 6+ cores, each of the two gets a physical core of its own: the
+ * process default CPU sets leave those cores out (every other thread, the
+ * driver's included, stays off them) and the walker and the main thread are
+ * given one each (racacit_cpu_role / here). On 6+ cores without SMT the walker
+ * is raised one priority step instead, so SPU lanes do not preempt it.
+ * RACACIT_QUIET_CORES=0 leaves placement to Windows; =1 applies it even with a
+ * hand-set process affinity (within it) and on 4-5 cores (the walker only). */
+static struct {
+    int mode;                         /* 0 none, 1 quiet cores, 2 walker priority */
+    ULONG walker[4]; int nwalker;     /* the walker's core (its logical processors) */
+    int walker_core, main_core;
+} s_quiet;
+
+/* The fastest class's cores (or all, on a one-class CPU), grouped. */
+typedef struct { BYTE core, llc; ULONG ids[4]; int n; } rc_core;
+static int quiet_cores_list(rc_core* out, int most, int fast_only)
+{
+    int n = 0;
+    for (int i = 0; i < s_topo.ncs; i++) {
+        if (fast_only && !s_topo.cs[i].fast) continue;
+        int k = 0;
+        while (k < n && out[k].core != s_topo.cs[i].core) k++;
+        if (k == n) { if (n == most) continue; out[n].core = s_topo.cs[i].core; out[n].llc = s_topo.cs[i].llc; out[n].n = 0; n++; }
+        if (out[k].n < 4) out[k].ids[out[k].n++] = s_topo.cs[i].id;
+    }
+    return n;
+}
+
+static void quiet_cores_setup(int fast_only, char* place, size_t place_size)
+{
+    const char* qe = getenv("RACACIT_QUIET_CORES");
+    const int force = qe && *qe == '1';
+    if (qe && *qe == '0') { snprintf(place, place_size, "; quiet cores off (RACACIT_QUIET_CORES=0)"); return; }
+    if (!s_topo.ok) return;
+    if (s_topo.user_mask && !force) return;
+    rc_core cores[128];
+    const int nc = quiet_cores_list(cores, 128, fast_only);
+    int smt = 0;
+    for (int i = 0; i < nc; i++) if (cores[i].n > 1) smt = 1;
+    const int quiet = smt ? (nc >= 6 ? 2 : (force && nc >= 4) ? 1 : 0) : 0;
+    if (!quiet) {
+        if (nc >= 6 || (force && nc >= 4)) {
+            s_quiet.mode = 2;
+            snprintf(place, place_size, "; walker raised a priority step (%d cores, no SMT)", nc);
+        }
+        return;
+    }
+    /* From the L3 group with the most cores, its last ones (core 0 takes most
+     * of the system's interrupts). */
+    int best_llc = cores[0].llc, best_n = 0;
+    for (int i = 0; i < nc; i++) {
+        int c = 0;
+        for (int j = 0; j < nc; j++) c += cores[j].llc == cores[i].llc;
+        if (c > best_n) { best_n = c; best_llc = cores[i].llc; }
+    }
+    int pick[2] = { -1, -1 };
+    for (int q = 0; q < quiet; q++)
+        for (int i = 0; i < nc; i++) {
+            if (cores[i].llc != best_llc || i == pick[0]) continue;
+            if (pick[q] < 0 || cores[i].core > cores[pick[q]].core) pick[q] = i;
+        }
+    if (pick[0] < 0 || (quiet == 2 && pick[1] < 0)) return;
+    ULONG rest[256]; ULONG nrest = 0;
+    for (int i = 0; i < nc; i++)
+        if (i != pick[0] && i != pick[1])
+            for (int k = 0; k < cores[i].n && nrest < 256; k++) rest[nrest++] = cores[i].ids[k];
+    HMODULE k32 = GetModuleHandleA("kernel32.dll");
+    rc_scs_fn sp = k32 ? (rc_scs_fn)(void*)GetProcAddress(k32, "SetProcessDefaultCpuSets") : NULL;
+    rc_scs_fn st = k32 ? (rc_scs_fn)(void*)GetProcAddress(k32, "SetThreadSelectedCpuSets") : NULL;
+    if (!sp || !st || !nrest || !sp(GetCurrentProcess(), rest, nrest)) {
+        snprintf(place, place_size, "; quiet cores not set (error %lu)", (unsigned long)GetLastError());
+        return;
+    }
+    s_quiet.mode = 1;
+    s_quiet.walker_core = cores[pick[0]].core;
+    s_quiet.nwalker = cores[pick[0]].n;
+    memcpy(s_quiet.walker, cores[pick[0]].ids, sizeof s_quiet.walker);
+    /* This thread runs the game's main thread (main.cpp: ppu_run after setup). */
+    if (quiet == 2) {
+        s_quiet.main_core = cores[pick[1]].core;
+        st(GetCurrentThread(), cores[pick[1]].ids, (ULONG)cores[pick[1]].n);
+        snprintf(place, place_size, "; quiet cores: walker core %d, main core %d", s_quiet.walker_core, s_quiet.main_core);
+    } else {
+        s_quiet.main_core = -1;
+        st(GetCurrentThread(), rest, nrest);
+        snprintf(place, place_size, "; quiet core: walker core %d", s_quiet.walker_core);
+    }
+}
+
+/* Called by a thread with a role, from that thread (role 0: the FIFO walker,
+ * main.cpp frame_clock; with the split walker, the engine's sink thread may
+ * take it instead -- role 1 hands it back: process default placement and
+ * normal priority again, rsx_engine_split.c). */
+void racacit_cpu_role(int role)
+{
+    if (role == 1) {
+        if (s_quiet.mode == 1) {
+            HMODULE k32 = GetModuleHandleA("kernel32.dll");
+            rc_scs_fn st = k32 ? (rc_scs_fn)(void*)GetProcAddress(k32, "SetThreadSelectedCpuSets") : NULL;
+            if (st) st(GetCurrentThread(), NULL, 0);
+        } else if (s_quiet.mode == 2) {
+            SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_NORMAL);
+        }
+        return;
+    }
+    if (role != 0) return;
+    if (s_quiet.mode == 1) {
+        HMODULE k32 = GetModuleHandleA("kernel32.dll");
+        rc_scs_fn st = k32 ? (rc_scs_fn)(void*)GetProcAddress(k32, "SetThreadSelectedCpuSets") : NULL;
+        if (!st || !st(GetCurrentThread(), s_quiet.walker, (ULONG)s_quiet.nwalker))
+            fprintf(stderr, "[racacit] walker could not take its quiet core (error %lu)\n", (unsigned long)GetLastError());
+    } else if (s_quiet.mode == 2) {
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+    }
+}
+
+/* At start (main.cpp), before the game's threads: read the topology, keep the
+ * game on a hybrid CPU's fast cores (not while preparing shaders: those want
+ * every core), and say all of it in the log. */
+void racacit_cpu_setup(int allow_placement)
+{
+    topo_get();
+    waits_decide();
+    const double p = pause_ns();
+    char place[256] = "";
+    int on_fast = 0;
+    if (s_topo.classes > 1) {
+        const char* fe = getenv("RACACIT_FAST_CORES");
+        const int force = fe && *fe == '1', off = fe && *fe == '0';
+        if (!allow_placement) snprintf(place, sizeof place, "; threads placed by Windows (shader prepare)");
+        else if (off) snprintf(place, sizeof place, "; threads placed by Windows (RACACIT_FAST_CORES=0)");
+        else if (s_topo.user_mask) snprintf(place, sizeof place, "; threads placed by Windows (process affinity set by hand)");
+        else if (s_topo.fast_cores < 6 && !force)
+            snprintf(place, sizeof place, "; threads placed by Windows (%d fast cores are too few to hold the game)", s_topo.fast_cores);
+        else {
+            HMODULE k32 = GetModuleHandleA("kernel32.dll");
+            rc_scs_fn sp = k32 ? (rc_scs_fn)(void*)GetProcAddress(k32, "SetProcessDefaultCpuSets") : NULL;
+            rc_scs_fn st = k32 ? (rc_scs_fn)(void*)GetProcAddress(k32, "SetThreadSelectedCpuSets") : NULL;
+            if (sp && s_topo.nfast && sp(GetCurrentProcess(), s_topo.fast_ids, (ULONG)s_topo.nfast)) {
+                if (st) st(GetCurrentThread(), s_topo.fast_ids, (ULONG)s_topo.nfast);   /* this thread was made before */
+                snprintf(place, sizeof place, "; game kept on the fast cores");
+                on_fast = 1;
+            } else snprintf(place, sizeof place, "; could not keep the game on the fast cores (error %lu)", (unsigned long)GetLastError());
+        }
+    }
+    /* Quiet cores: on a one-class CPU, or among a hybrid CPU's fast cores once
+     * the game is kept there (otherwise Windows places the threads). */
+    if (allow_placement && (s_topo.classes <= 1 || on_fast)) {
+        const size_t used = strlen(place);
+        quiet_cores_setup(on_fast, place + used, sizeof place - used);
+    }
+    if (!s_topo.ok)
+        fprintf(stderr, "[racacit] CPU: %d threads (no core details from Windows); waits: %s; pause %.1f ns\n",
+                s_topo.lps, s_waits_why, p);
+    else if (s_topo.classes > 1)
+        fprintf(stderr, "[racacit] CPU: %d fast cores (%d threads) + %d efficiency cores (%d threads), %d L3 cache group%s; "
+                "waits: %s; pause %.1f ns%s\n", s_topo.fast_cores, s_topo.fast_lps, s_topo.cores - s_topo.fast_cores,
+                s_topo.lps - s_topo.fast_lps, s_topo.llcs, s_topo.llcs == 1 ? "" : "s", s_waits_why, p, place);
+    else
+        fprintf(stderr, "[racacit] CPU: %d cores (%d threads), %d L3 cache group%s; waits: %s; pause %.1f ns%s%s\n",
+                s_topo.cores, s_topo.lps, s_topo.llcs, s_topo.llcs == 1 ? "" : "s", s_waits_why, p,
+                s_topo.user_mask ? "; process affinity set by hand" : "", place);
+}
+
+/* A run of short polls from one place: 1 if this one really slept. */
+static int usleep_real_sleep(uint32_t lr, uint64_t usec, int64_t now)
+{
+    static long s_spin = -2;
+    if (s_spin == -2) { const char* e = getenv("RACACIT_USLEEP_SPIN_US");
+                        s_spin = e ? atol(e) : (racacit_few_cpus() ? 100 : -1); }
+    if (s_spin < 0) return 0;
+    static __thread uint32_t t_lr; static __thread int64_t t_first, t_last; static __thread HANDLE t_tm; static __thread int t_tried;
+    const int64_t per_us = s_qpc_freq.QuadPart / 1000000;
+    if (lr != t_lr || now - t_last > 200 * per_us) { t_lr = lr; t_first = now; }
+    if ((now - t_first) < s_spin * per_us) { t_last = now + (int64_t)usec * per_us; return 0; }
+    if (!t_tried) { t_tried = 1; t_tm = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS); }
+    LARGE_INTEGER due; due.QuadPart = -(LONGLONG)usec * 10;
+    if (t_tm && SetWaitableTimer(t_tm, &due, 0, NULL, NULL, FALSE)) WaitForSingleObject(t_tm, INFINITE);
+    else Sleep(1);
+    LARGE_INTEGER t; QueryPerformanceCounter(&t); t_last = t.QuadPart;
+    return 1;
+}
+#else
+#include <sys/syscall.h>
+#include <unistd.h>
+/* As on Windows; the process's CPU mask, so a test can limit it with taskset. */
+int racacit_few_cpus(void)
+{
+    static int s_few = -1;
+    if (s_few < 0) {
+        unsigned long m[64];
+        const long b = syscall(SYS_sched_getaffinity, 0, sizeof m, m);
+        unsigned n = 0;
+        for (long i = 0; i < b / (long)sizeof m[0]; i++) n += (unsigned)__builtin_popcountl(m[i]);
+        s_few = n > 0 && n < 16;
+    }
+    return s_few;
+}
