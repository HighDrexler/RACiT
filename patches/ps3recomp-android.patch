diff --git a/libs/video/rsx_engine_split.c b/libs/video/rsx_engine_split.c
new file mode 100644
index 0000000..6f6370e
--- /dev/null
+++ b/libs/video/rsx_engine_split.c
@@ -0,0 +1,313 @@
+/*
+ * The split walker's queue and sink thread (RSX_WALKER_SPLIT=1, see
+ * docs/dev/WALKER_SPLIT.md and rsx_draw_engine.c "split walker").
+ *
+ * One producer (the FIFO walker's thread, decoding methods) and one consumer
+ * (the sink thread, running the draw engine's sink). Records are u32 words: a
+ * header (op | payload words << 8) and its payload, never split by the ring
+ * end (a PAD record fills the tail). The consumer hands each record to the
+ * engine's callback, which returns how many words it used.
+ *
+ * Kept out of rsx_draw_engine.c so that file does not take in <windows.h>.
+ */
+#include "rsx_engine_split.h"
+#include "../../runtime/platform/win32_compat.h"
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <pthread.h>
+#endif
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* The ring, in words: RSX_SPLIT_RING_KB (default 1024, power of two). Small on
+ * purpose: the walker is never far ahead (it syncs at each label write), and a
+ * ring that fits the caches is not streamed through DRAM and every L2. */
+#define SQ_WORDS     s_ro.words
+#define SQ_PAD       1u
+#define SQ_R_BATCH   4096u               /* consumer publishes its position every this many words */
+
+/* Every variable here grouped by the thread that writes it, each group on
+ * whole cache lines of its own: a struct whose first member is _Alignas(64)
+ * starts a line and fills a multiple of 64 bytes. (The first version had
+ * _Alignas on single variables: s_r shared its line with s_ring, the lock and
+ * the producer's word counter, and that line crossed between the two cores at
+ * every record -- the sink thread ran its draws ~1.5x slower than inline.) */
+static struct { _Alignas(64) uint32_t* ring; rsx_sq_consume_fn consume; int running; int place; uint32_t words; }
+    s_ro = { NULL, NULL, 0, -1, 0 };                                    /* set once at start */
+static struct { _Alignas(64) _Atomic unsigned long long v; } s_w_;  /* published by the producer */
+static struct { _Alignas(64) _Atomic unsigned long long v; } s_r_;  /* published by the consumer */
+static struct { _Alignas(64) _Atomic int v; } s_idle_;              /* consumer asleep, everything before s_r done */
+static struct { _Alignas(64) unsigned long long wl, r_seen, syncs, sync_us, room_waits, words, rep_cyc0, rep_us0; }
+    s_prod;                                                          /* producer (and the stats report) */
+static struct { _Alignas(64) SRWLOCK lk; CONDITION_VARIABLE cv_work, cv_room; }
+    s_sy = { SRWLOCK_INIT, CONDITION_VARIABLE_INIT, CONDITION_VARIABLE_INIT };
+#define s_ring    s_ro.ring
+#define s_consume s_ro.consume
+#define s_running s_ro.running
+#define s_place   s_ro.place
+#define s_w       s_w_.v
+#define s_r       s_r_.v
+#define s_idle    s_idle_.v
+#define s_wl      s_prod.wl                /* producer: written, maybe not published */
+#define s_r_seen  s_prod.r_seen            /* producer: the last s_r it read */
+#define s_lk      s_sy.lk
+#define s_cv_work s_sy.cv_work             /* consumer: something to do */
+#define s_cv_room s_sy.cv_room             /* producer: room, or idle at a sync */
+static _Thread_local int s_self;
+/* RSX_SPLIT_PLACE: where the two threads run on a CPU with a quiet core for
+ * the walker (sys_timer.c racacit_cpu_role). swap (default): the sink thread,
+ * the heavier one, takes it and the walker joins the other threads; share:
+ * both on it; none: the walker keeps it. */
+/* s_place: 0 none, 1 swap, 2 share (-1 not read yet) */
+#ifdef _WIN32
+extern void racacit_cpu_role(int role);
+#endif
+static int sq_place(void)
+{
+    if (s_place < 0) {
+        const char* e = getenv("RSX_SPLIT_PLACE");
+        s_place = !e || !*e || !strcmp(e, "swap") ? 1 : !strcmp(e, "share") ? 2 : 0;
+    }
+    return s_place;
+}
+
+/* RSX_SPLIT_STATS=1 (cellGcmSys.c prints them): syncs and their wait, room waits, words. */
+#define g_rsx_sq_syncs      s_prod.syncs
+#define g_rsx_sq_sync_us    s_prod.sync_us
+#define g_rsx_sq_room_waits s_prod.room_waits
+#define g_rsx_sq_words      s_prod.words
+void rsx_sq_stats(unsigned long long out[4])
+{
+    out[0] = s_prod.syncs; out[1] = s_prod.sync_us; out[2] = s_prod.room_waits; out[3] = s_prod.words;
+}
+
+static unsigned long long sq_us(void)
+{
+    LARGE_INTEGER f, c; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&c);
+    return (unsigned long long)(c.QuadPart / (f.QuadPart / 1000000));
+}
+
+static void sq_wake(void)
+{
+    if (atomic_load_explicit(&s_idle, memory_order_acquire)) {
+        AcquireSRWLockExclusive(&s_lk);
+        WakeAllConditionVariable(&s_cv_work);
+        ReleaseSRWLockExclusive(&s_lk);
+    }
+}
+
+int rsx_sq_on_sink_thread(void) { return s_self; }
+int rsx_sq_running(void) { return s_running; }
+
+void rsx_sq_publish(void)
+{
+    if (atomic_load_explicit(&s_w, memory_order_relaxed) == s_wl) return;
+    atomic_store(&s_w, s_wl);            /* seq_cst: ordered before the idle check */
+    sq_wake();
+}
+
+uint32_t* rsx_sq_reserve(uint32_t words)
+{
+    for (;;) {
+        const unsigned long long w = s_wl;
+        const uint32_t off = (uint32_t)(w & (SQ_WORDS - 1u));
+        const uint32_t tail = SQ_WORDS - off;
+        const uint32_t need = tail < words ? tail + words : words;
+        if (SQ_WORDS - (w - s_r_seen) < need)
+            s_r_seen = atomic_load_explicit(&s_r, memory_order_acquire);
+        if (SQ_WORDS - (w - s_r_seen) >= need) {
+            if (tail < words) {                     /* pad to the end, start over */
+                s_ring[off] = SQ_PAD | ((tail - 1u) << 8);
+                s_wl = w + tail;
+                continue;
+            }
+            return s_ring + off;
+        }
+        rsx_sq_publish();
+        g_rsx_sq_room_waits++;
+        AcquireSRWLockExclusive(&s_lk);
+        if (SQ_WORDS - (s_wl - atomic_load(&s_r)) < need)
+            SleepConditionVariableSRW(&s_cv_room, &s_lk, 1, 0);
+        ReleaseSRWLockExclusive(&s_lk);
+    }
+}
+
+void rsx_sq_commit(uint32_t words)
+{
+    s_wl += words;
+    g_rsx_sq_words += words;
+}
+
+/* The sink thread's own time (RSX_SPLIT_STATS): cycles per record type, spinning,
+ * sleeping. Written by the sink thread, read racily by the report. */
+#if defined(__x86_64__) || defined(_M_X64)
+static inline unsigned long long sq_cyc(void) { return __builtin_ia32_rdtsc(); }
+#else
+static inline unsigned long long sq_cyc(void) { return 0; }
+#endif
+static int s_sink_stats = -1;
+static struct { _Alignas(64) unsigned long long op_cyc[16], op_n[16], op_w[16], spin_cyc, sleeps, sleep_us; } s_cons;   /* sink thread */
+#define s_op_cyc   s_cons.op_cyc
+#define s_op_n     s_cons.op_n
+#define s_op_w     s_cons.op_w
+#define s_spin_cyc s_cons.spin_cyc
+#define s_sleeps   s_cons.sleeps
+#define s_sleep_us s_cons.sleep_us
+#define s_rep_cyc0 s_prod.rep_cyc0
+#define s_rep_us0  s_prod.rep_us0
+void rsx_sq_sink_report(double frames)
+{
+    const unsigned long long c = sq_cyc(), u = sq_us();
+    const double cpu = (s_rep_us0 && u > s_rep_us0) ? (double)(c - s_rep_cyc0) / (double)(u - s_rep_us0) : 0.0;  /* cycles per us */
+    s_rep_cyc0 = c; s_rep_us0 = u;
+    if (cpu <= 0.0) return;
+    static const char* names[16] = { "?", "pad", "regs", "consts", "vp", "scal", "clear", "begin", "end", "arrays", "index", "inline", "inline*", "flip", "?", "?" };
+    char line[1024]; int k = 0; double tot = 0;
+    for (int i = 0; i < 16; i++) tot += s_op_cyc[i];
+    k += snprintf(line + k, sizeof line - k, "[split-stats] sink thread per frame: busy %.2f ms, spin %.2f ms, %.1f sleeps (%.2f ms) |",
+                  tot / cpu / frames / 1e3, s_spin_cyc / cpu / frames / 1e3, s_sleeps / frames, s_sleep_us / frames / 1e3);
+    for (int i = 0; i < 16; i++) {
+        if (s_op_n[i] && k < (int)sizeof line - 60)
+            k += snprintf(line + k, sizeof line - k, " %s %.0fx %.0fkw %.2f ms", names[i], s_op_n[i] / frames, s_op_w[i] / frames / 1e3, s_op_cyc[i] / cpu / frames / 1e3);
+        s_op_cyc[i] = s_op_n[i] = s_op_w[i] = 0;
+    }
+    s_spin_cyc = s_sleeps = s_sleep_us = 0;
+    fprintf(stderr, "%s%c", line, 10);
+}
+
+/* Syncs by call site (RSX_SPLIT_STATS): a few dozen sites at most. */
+static struct { _Alignas(64) const char* where; unsigned long long n, us; } s_sites[24];   /* producer: one line each */
+void rsx_sq_sync_report(double frames)
+{
+    char line[1024]; int k = 0;
+    k += snprintf(line + k, sizeof line - k, "[split-stats] syncs per frame by site:");
+    for (int i = 0; i < 24 && s_sites[i].where; i++) {
+        if (k < (int)sizeof line - 80)
+            k += snprintf(line + k, sizeof line - k, " %s %.1f (%.2f ms)", s_sites[i].where,
+                          s_sites[i].n / frames, s_sites[i].us / frames / 1e3);
+        s_sites[i].n = s_sites[i].us = 0;
+    }
+    fprintf(stderr, "%s%c", line, 10);
+}
+
+void rsx_sq_sync_at(const char* where)
+{
+    /* Done when the consumer has published s_r == everything written: it
+     * publishes only after a record's work, and past that point it just
+     * watches s_w, so the caller then owns the engine's state (the acquire
+     * here pairs with the consumer's release; the caller's own writes reach
+     * the consumer through the next publish). */
+    if (!s_running || s_self) return;
+    if (atomic_load_explicit(&s_r, memory_order_acquire) == s_wl) return;
+    const unsigned long long t0 = sq_us();
+    g_rsx_sq_syncs++;
+    rsx_sq_publish();
+    AcquireSRWLockExclusive(&s_lk);
+    WakeAllConditionVariable(&s_cv_work);
+    while (atomic_load(&s_r) != s_wl)
+        SleepConditionVariableSRW(&s_cv_room, &s_lk, 1, 0);
+    ReleaseSRWLockExclusive(&s_lk);
+    const unsigned long long d = sq_us() - t0;
+    g_rsx_sq_sync_us += d;
+    for (int i = 0; i < 24; i++)
+        if (!s_sites[i].where || s_sites[i].where == where) { s_sites[i].where = where; s_sites[i].n++; s_sites[i].us += d; break; }
+}
+
+#ifdef _WIN32
+static DWORD WINAPI sq_thread(LPVOID arg)
+#else
+static void* sq_thread(void* arg)
+#endif
+{
+    (void)arg;
+    s_self = 1;
+#ifdef _WIN32
+    /* PS3_SAMPLE_SINK=1: the sampler profiles this thread (as PS3_SAMPLE_RSX does the walker). */
+    { extern void ps3_samp_only_tid(unsigned long tid); if (getenv("PS3_SAMPLE_SINK")) ps3_samp_only_tid(GetCurrentThreadId()); }
+#endif
+#ifdef _WIN32
+    if (sq_place()) racacit_cpu_role(0);
+#endif
+    { char hb[160]; snprintf(hb, sizeof hb, "[hosttid] %lu rsx engine sink (split walker)%c", (unsigned long)GetCurrentThreadId(), 10); fputs(hb, stderr); }
+    unsigned long long r = atomic_load_explicit(&s_r, memory_order_relaxed), w = r, r_pub = r;
+    if (s_sink_stats < 0) s_sink_stats = getenv("RSX_SPLIT_STATS") ? 1 : 0;
+    const int st = s_sink_stats;
+    for (;;) {
+        if (r == w) w = atomic_load_explicit(&s_w, memory_order_acquire);
+        if (r == w) {
+            if (r_pub != r) {                                  /* caught up: show it */
+                atomic_store_explicit(&s_r, r, memory_order_release); r_pub = r;
+                AcquireSRWLockExclusive(&s_lk); WakeAllConditionVariable(&s_cv_room); ReleaseSRWLockExclusive(&s_lk);
+            }
+            /* Spin briefly (records come microseconds apart in a frame), then sleep. */
+            { const unsigned long long c0 = st ? sq_cyc() : 0;
+              for (int i = 0; i < 2000 && r == w; i++) { YieldProcessor(); w = atomic_load_explicit(&s_w, memory_order_acquire); }
+              if (st) s_spin_cyc += sq_cyc() - c0; }
+            if (r == w) {
+                const unsigned long long u0 = st ? sq_us() : 0;
+                if (st) s_sleeps++;
+                AcquireSRWLockExclusive(&s_lk);
+                atomic_store(&s_idle, 1);                      /* seq_cst: before re-reading s_w */
+                WakeAllConditionVariable(&s_cv_room);          /* a sync may be waiting */
+                while (atomic_load(&s_w) == r)
+                    SleepConditionVariableSRW(&s_cv_work, &s_lk, 5, 0);
+                atomic_store_explicit(&s_idle, 0, memory_order_release);
+                ReleaseSRWLockExclusive(&s_lk);
+                if (st) s_sleep_us += sq_us() - u0;
+                w = atomic_load_explicit(&s_w, memory_order_acquire);
+                continue;
+            }
+        }
+        const uint32_t* rec = s_ring + (uint32_t)(r & (SQ_WORDS - 1u));
+        uint32_t n;
+        if (st) {
+            const unsigned long long c0 = sq_cyc();
+            n = (rec[0] & 0xFFu) == SQ_PAD ? 1u + (rec[0] >> 8) : s_consume(rec);
+            const unsigned op = rec[0] & 0xFu;
+            s_op_cyc[op] += sq_cyc() - c0; s_op_n[op]++; s_op_w[op] += n;
+        } else
+            n = (rec[0] & 0xFFu) == SQ_PAD ? 1u + (rec[0] >> 8) : s_consume(rec);
+        r += n;
+        if (r - r_pub >= SQ_R_BATCH) {
+            atomic_store_explicit(&s_r, r, memory_order_release); r_pub = r;
+            AcquireSRWLockExclusive(&s_lk); WakeAllConditionVariable(&s_cv_room); ReleaseSRWLockExclusive(&s_lk);
+        }
+    }
+#ifdef _WIN32
+    return 0;
+#else
+    return NULL;
+#endif
+}
+
+int rsx_sq_start(rsx_sq_consume_fn consume)
+{
+    if (s_running) return 1;
+    { const char* e = getenv("RSX_SPLIT_RING_KB"); unsigned kb = e ? (unsigned)atoi(e) : 1024u;
+      if (kb < 512u) kb = 512u; if (kb > 65536u) kb = 65536u;
+      unsigned p2 = 512u; while (p2 < kb) p2 <<= 1;
+      SQ_WORDS = p2 * 256u; }                          /* KB -> words */
+    s_ring = (uint32_t*)malloc((size_t)SQ_WORDS * 4u);
+    if (!s_ring) return 0;
+    s_consume = consume;
+    atomic_store(&s_idle, 1);
+#ifdef _WIN32
+    DWORD tid; HANDLE th = CreateThread(NULL, 1u << 20, sq_thread, NULL, 0, &tid);
+    s_running = th != NULL;
+    if (th) CloseHandle(th);
+#else
+    pthread_t th; s_running = pthread_create(&th, NULL, sq_thread, NULL) == 0;
+    if (s_running) pthread_detach(th);
+#endif
+    if (!s_running) { free(s_ring); s_ring = NULL; }
+#ifdef _WIN32
+    else if (sq_place() == 1) racacit_cpu_role(1);   /* the caller is the walker: give its core up */
+#endif
+    fprintf(stderr, "[rsx engine] split walker placement: %s%c",
+            sq_place() == 1 ? "sink thread on the walker's quiet core, walker with the rest" :
+            sq_place() == 2 ? "both on the walker's quiet core" : "walker keeps its core", 10);
+    return s_running;
+}
