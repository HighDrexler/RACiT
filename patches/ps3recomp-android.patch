+/* The short locks' wait: on a plain read, with a pause; a holder off its CPU gets a yield. */
+void spu_spin_wait(volatile long* lock)
+{
+    unsigned spins = 0;
+    while (*lock) {
+        YieldProcessor();
+        if (++spins >= 1024u) { spins = 0; SwitchToThread(); }
+    }
