+/* ---------------------------------------------------------------------------
+ * Window
+ * -------------------------------------------------------------------------*/
+static void desktop_size(int* w, int* h)
+{
+    SDL_DisplayMode dm;
+    const int di = s_win ? SDL_GetWindowDisplayIndex(s_win) : 0;
+    if (SDL_GetDesktopDisplayMode(di < 0 ? 0 : di, &dm) == 0 && dm.w > 0) { *w = dm.w; *h = dm.h; }
+    else { *w = 1920; *h = 1080; }
+}
+
+/* The default window: the largest preset that leaves room around it. */
+static void default_window(int* w, int* h)
+{
+    int dw, dh; desktop_size(&dw, &dh);
+    *w = 1280; *h = 720;
+    for (int i = 0; i < N_OF(k_win); i++)
+        if (k_win[i][0] <= dw * 3 / 4 && k_win[i][1] <= dh * 3 / 4) { *w = k_win[i][0]; *h = k_win[i][1]; }
+}
+
+void rsx_host_ui_initial_window(int* w, int* h, unsigned* flags)
+{
+    rsx_host_ui_load_options();
+    rsx_host_options o; rsx_host_ui_options(&o);
+    if (o.win_w && o.win_h) { *w = o.win_w; *h = o.win_h; }
+    else default_window(w, h);
+    unsigned f = SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI;
+    if (o.display_mode == RSX_UI_DISPLAY_BORDERLESS) f |= SDL_WINDOW_FULLSCREEN_DESKTOP;
+    if (o.display_mode == RSX_UI_DISPLAY_EXCLUSIVE)  f |= SDL_WINDOW_FULLSCREEN;
+    *flags = f;
+}
+
+/* The game makes 60 frames a second. A display whose refresh 60 does not divide
+ * shows them unevenly however evenly they arrive: at 165 Hz each frame stays for
+ * 3, 3, 3, then 2 refreshes (18, 18, 18, 12 ms) -- judder on every fast camera
+ * turn at a steady "60 fps" (owner, Into the Nexus 2026-11-24, 165 Hz panel).
+ * Exclusive fullscreen therefore takes the desktop's resolution at the highest
+ * refresh that is a multiple of 60 (120 Hz on such a panel), when the desktop's
+ * own refresh is not one. RACACIT_FULLSCREEN_HZ=0 keeps the desktop's refresh,
+ * =<n> asks for n Hz. Windowed and borderless cannot change it: G-Sync/FreeSync
+ * or a 60/120 Hz desktop does that there (the log says so). */
+static int hz_even60(int hz) { return hz > 0 && (hz % 60 <= 1 || hz % 60 >= 59); }   /* 59.94 / 119.88 too */
+static int pick_exclusive_mode(int disp, SDL_DisplayMode* dm)
+{
+    if (SDL_GetDesktopDisplayMode(disp, dm) != 0) return 0;
+    const char* e = getenv("RACACIT_FULLSCREEN_HZ");
+    const int want = e && *e ? atoi(e) : -1;
+    if (want == 0 || (want < 0 && hz_even60(dm->refresh_rate))) return 1;
+    SDL_DisplayMode best; int found = 0;
+    for (int i = 0, n = SDL_GetNumDisplayModes(disp); i < n; i++) {
+        SDL_DisplayMode m;
+        if (SDL_GetDisplayMode(disp, i, &m) != 0 || m.w != dm->w || m.h != dm->h) continue;
+        if (want > 0 ? abs(m.refresh_rate - want) > 1 : !hz_even60(m.refresh_rate)) continue;
+        if (!found || m.refresh_rate > best.refresh_rate ||
+            (m.refresh_rate == best.refresh_rate && m.format == dm->format)) { best = m; found = 1; }
+    }
+    fprintf(stderr, "[ui] exclusive fullscreen: desktop %dx%d at %d Hz -> %d Hz%s\n", dm->w, dm->h, dm->refresh_rate,
+            found ? best.refresh_rate : dm->refresh_rate, found ? "" : " (no mode 60 divides at this resolution)");
+    if (found) *dm = best;
+    return 1;
+}
+
+static void apply_window(void)
+{
+    if (!s_win) return;
+    rsx_host_options o; rsx_host_ui_options(&o);
+    if (o.display_mode == RSX_UI_DISPLAY_WINDOWED) {
+        SDL_SetWindowFullscreen(s_win, 0);
+        int w = o.win_w, h = o.win_h;
+        if (!w || !h) default_window(&w, &h);
+        SDL_SetWindowSize(s_win, w, h);
+        SDL_SetWindowPosition(s_win, SDL_WINDOWPOS_CENTERED_DISPLAY(SDL_GetWindowDisplayIndex(s_win)),
+                              SDL_WINDOWPOS_CENTERED_DISPLAY(SDL_GetWindowDisplayIndex(s_win)));
+    } else if (o.display_mode == RSX_UI_DISPLAY_BORDERLESS) {
+        SDL_SetWindowFullscreen(s_win, SDL_WINDOW_FULLSCREEN_DESKTOP);
+    } else {
+        /* Exclusive at the desktop's resolution, at a refresh 60 divides when the
+         * desktop's is not one (pick_exclusive_mode). */
+        SDL_DisplayMode dm;
+        if (pick_exclusive_mode(SDL_GetWindowDisplayIndex(s_win), &dm))
+            SDL_SetWindowDisplayMode(s_win, &dm);
+        SDL_SetWindowFullscreen(s_win, SDL_WINDOW_FULLSCREEN);
+    }
+    LOCK(); s_opt.swap_gen++; UNLOCK();
+}
+
+static void update_cursor(void)
+{
+#ifdef __ANDROID__
+    /* A connected mouse remains visible until capture succeeds/is requested;
+     * Android only draws this cursor for pointer devices, never for fingers. */
+    SDL_ShowCursor((s_open || !SDL_GetRelativeMouseMode()) ? SDL_ENABLE : SDL_DISABLE);
+#else
+    rsx_host_options o; rsx_host_ui_options(&o);
+    SDL_ShowCursor((s_open || o.display_mode == RSX_UI_DISPLAY_WINDOWED) ? SDL_ENABLE : SDL_DISABLE);
+#endif
+}
+
+void rsx_host_ui_attach(SDL_Window* win, float max_aniso, float res_scale_active)
+{
+    rsx_host_ui_load_options();
+    s_win = win;
+    s_max_aniso = max_aniso;
+    s_rs_active = res_scale_active;
+    if (win) {
+        rsx_host_options o; rsx_host_ui_options(&o);
+        if (o.display_mode == RSX_UI_DISPLAY_EXCLUSIVE) apply_window();
+        else {
+            SDL_DisplayMode dm;
+            if (SDL_GetDesktopDisplayMode(SDL_GetWindowDisplayIndex(win), &dm) == 0 && !hz_even60(dm.refresh_rate))
+                fprintf(stderr, "[ui] the display runs at %d Hz, which 60 does not divide: 60 fps cannot be shown evenly "
+                        "in a window (judder when the camera turns). Fullscreen (exclusive) switches to a refresh 60 "
+                        "divides; or use G-Sync / FreeSync, or set the desktop to 120 or 60 Hz.\n", dm.refresh_rate);
+        }
+        update_cursor();
+    }
+}
