-
-    cellfs_add_path_mapping("/dev_hdd0/",  "gamedata/dev_hdd0/");
-    cellfs_add_path_mapping("/dev_bdvd/",  "gamedata/dev_bdvd/");
-    cellfs_add_path_mapping("/dev_flash/", "gamedata/dev_flash/");
