+/* The save runs on a thread of its own: fetching an 18 MB cache from the
+ * driver and writing it took ~160 ms, and done from the draw path it was a
+ * visible hitch every 5 s while new pipelines kept appearing. Reading a
+ * pipeline cache's data needs no external synchronisation against pipeline
+ * creation, so the render thread carries on. */
+static SDL_atomic_t s_pcache_busy;
+static volatile int s_pw_running;      /* the pre-warm builds into the main cache */
+static void vk_ap_merge(void);
+#if defined(__ANDROID__)
+/* game/main.cpp: a helper thread off the top core (kept for the main thread), allowed the small
+ * cores as well as the mid ones (background = 1: the small cores only, low priority). A thread made
+ * by the render thread inherits its mid cores, where it competed with the SPU lanes. */
+extern void racacit_place_helper(const char* name, int background);
+#define VK_PLACE_HELPER(name, bg) racacit_place_helper(name, bg)
+#else
+#define VK_PLACE_HELPER(name, bg) ((void)0)
+#endif
+static int SDLCALL vk_pcache_save_thread(void* arg)
+{
+    VK_PLACE_HELPER("pcache-save", 1);
+    const char* path = (const char*)arg;
+    size_t n = 0;
+    VkResult r = pvkGetPipelineCacheData(s_vk.device, s_g.pcache, &n, NULL);
+    if (r == VK_SUCCESS && n) {
+        void* data = malloc(n);
+        r = data ? pvkGetPipelineCacheData(s_vk.device, s_g.pcache, &n, data) : VK_ERROR_OUT_OF_HOST_MEMORY;
+        if (r == VK_SUCCESS) {
+            char tmp[1100];
+            snprintf(tmp, sizeof tmp, "%s.tmp", path);
+            FILE* f = fopen(tmp, "wb");
+            if (f) {
+                const int ok = fwrite(data, 1, n, f) == n;
+                const int closed = fclose(f) == 0;
+#ifdef _WIN32
+                /* Windows rename does not replace an existing file. */
+                if (ok && closed)
+                remove(path);
+#endif
+                /* POSIX rename replaces atomically: a failed/partial save must
+                 * leave the previous good cache available for the next boot. */
+                if (!ok || !closed || rename(tmp, path) != 0) {
+                    s_g.pcache_dirty++;
+                    VK_LOG("pipeline cache: writing %s failed (errno %d)\n", path, errno);
+                }
+            } else {
+                s_g.pcache_dirty++;
+                VK_LOG("pipeline cache: cannot create %s (errno %d)\n", tmp, errno);
+            }
+        } else {
+            s_g.pcache_dirty++;
+            VK_LOG("pipeline cache: reading driver data failed (VkResult %d)\n", (int)r);
+        }
+        free(data);
+    } else if (r != VK_SUCCESS) {
+        s_g.pcache_dirty++;
+        VK_LOG("pipeline cache: querying driver data failed (VkResult %d)\n", (int)r);
+    }
+    SDL_AtomicSet(&s_pcache_busy, 0);
+    return 0;
+}
+
+static void vk_pcache_save(int force)
+{
+    static unsigned long long s_last;
+    static const char* path = (const char*)-1;
+    if (path == (const char*)-1) path = getenv("RSX_PIPELINE_CACHE");
+    if (SDL_AtomicSet(&s_pw_dirty, 0)) s_g.pcache_dirty++;
+    if (!s_g.pcache || !s_g.pcache_dirty || !path || !*path) return;
+    const unsigned long long now = ps3_qpc_us();
+    if (!force && now - s_last < 5000000ull) return;      /* batch a burst of builds */
+    if (!SDL_AtomicCAS(&s_pcache_busy, 0, 1)) return;     /* one save at a time */
+    vk_ap_merge();
+    s_last = now;
+    s_g.pcache_dirty = 0;                                 /* builds from here on re-dirty it */
+    if (force) { vk_pcache_save_thread((void*)path); return; }
+    SDL_Thread* t = SDL_CreateThread(vk_pcache_save_thread, "pcache-save", (void*)path);
+    if (t) SDL_DetachThread(t);
+    else vk_pcache_save_thread((void*)path);
+}
