+/* v113-android.44: spu_fi's ARM inline path (spu_helpers.h), its own source text, against the
+ * scalar reference spu_fi_exact -- on the PC, with no ARM machine: the handful of NEON intrinsics
+ * the text uses are emulated here lane by lane, the fused multiply-subtract as exact integer
+ * arithmetic truncated toward zero (the FPCR SPU code runs with: toward zero, flush to zero).
+ * test_spu_fi_neon.py writes fi_block.inc from spu_helpers.h, builds this and runs it, then plants
+ * mutations in the text and expects each to be caught.
+ * A lane the text hands to the stub is not judged (the stub's path is not this text). */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
