+/* Recursively create directories for a path (like mkdir -p) */
+static void ensure_parent_dirs(const char* path)
+{
+    char tmp[CELL_FS_MAX_FS_PATH_LENGTH];
+    strncpy(tmp, path, sizeof(tmp) - 1);
+    tmp[sizeof(tmp) - 1] = '\0';
+
+    /* Find last separator */
+    char* last_sep = NULL;
+    for (char* p = tmp; *p; p++) {
+        if (*p == '/' || *p == '\\')
+            last_sep = p;
+    }
+    if (!last_sep) return;
+    *last_sep = '\0';
+
+    /* Create each component */
+    for (char* p = tmp; *p; p++) {
+        if (*p == '/' || *p == '\\') {
+            char saved = *p;
+            *p = '\0';
+            if (strlen(tmp) > 0)
+                HOST_MKDIR(tmp);
+            *p = saved;
+        }
+    }
+    if (strlen(tmp) > 0)
+        HOST_MKDIR(tmp);
+}
