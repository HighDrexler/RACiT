+/* The split walker's queue and sink thread: see rsx_engine_split.c. */
+#ifndef RSX_ENGINE_SPLIT_H
+#define RSX_ENGINE_SPLIT_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The consumer: one record (header word first); returns its length in words. */
+typedef uint32_t (*rsx_sq_consume_fn)(const uint32_t* rec);
+
+int       rsx_sq_start(rsx_sq_consume_fn consume);   /* 1 = sink thread running */
+int       rsx_sq_running(void);
+int       rsx_sq_on_sink_thread(void);
+/* Producer: room for `words` contiguous words, then commit what was written. */
+uint32_t* rsx_sq_reserve(uint32_t words);
+void      rsx_sq_commit(uint32_t words);
+void      rsx_sq_publish(void);
+/* Wait until the sink thread has done everything queued (no-op on it). */
+void      rsx_sq_sync_at(const char* where);
+#define   rsx_sq_sync() rsx_sq_sync_at(__func__)
+/* RSX_SPLIT_STATS: syncs per call site since the last report, then reset. */
+void      rsx_sq_sync_report(double frames);
+void      rsx_sq_sink_report(double frames);
+
+/* syncs, sync wait us, full-queue waits, words queued (RSX_SPLIT_STATS) */
+void      rsx_sq_stats(unsigned long long out[4]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
