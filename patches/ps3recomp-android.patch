+ * ones at 0x02C8xxxx "overwritten by the game"). A span with no whole page
+ * cannot be told apart: its GPU contents stand. eng_zdepth_overwritten
+ * already did this. */
+static int eng_ww_written_inner(const u8* p, u32 len, u32 epoch)
+{
+    if (!p || !len) return 0;
