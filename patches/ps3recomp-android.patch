+            break;
+        case OP_UP2US:
+            snprintf(rhs, sizeof(rhs),
+                     "((float4)((asuint((%s).x).xxxx >> uint4(0u, 16u, 0u, 16u)) & 0xFFFFu) / 65535.0)", a);
