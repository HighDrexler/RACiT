+static int ch_weapon_sel(void)   /* the selected weapon's id, or -1 */
+{
+    int ids[32]; const int n = ch_weapons(ids, 32);
+    if (n <= 0) return -1;
+    if (s_ch_wsel >= n) s_ch_wsel = n - 1;
