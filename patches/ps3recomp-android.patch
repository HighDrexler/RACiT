+                u128 a, b;
+                const uint32_t bv = ((hi & 1u) << 31) | 0x7F800000u | ((hi >> 1) * 0x0421Fu << 10 & 0x7FFC00u) | f;
+                const uint32_t av = k == 0 ? 0u : k == 1 ? 0x7FFFFu : (k * 0x9E37u + f * 31u) & 0x7FFFFu;
+                for (int i = 0; i < 4; i++) { b._u32[i] = bv; a._u32[i] = av; }
+                g_stub_now = 0;
+                const u128 r = spu_fi(a, b), x = spu_fi_exact(a, b);
+                if (g_stub_now) { if (wrong++ < 8) printf("WRONG: an all-extended vector went to the stub (b %08X)\n", bv); continue; }
+                n += 4;
+                for (int i = 0; i < 4; i++) if (r._u32[i] != x._u32[i]) { if (wrong++ < 8) printf("WRONG ext: a %08X b %08X -> %08X, exact %08X\n", av, bv, r._u32[i], x._u32[i]); }
+            }
+    printf("lanes judged %ld, wrong %ld; emulation out of its exact range %ld times\n", n, wrong, g_inexact_guard);
+    printf("vectors inline %ld of 6000000; three normal lanes + a padding lane: %ld of %ld inline\n", vec_inline, vec_pad_inline, vec_pad);
+    printf("lanes inline by kind (normal, exp 255, zero, exp 1-19, denormal, any): %ld %ld %ld %ld %ld %ld\n",
+           inline_kind[0], inline_kind[1], inline_kind[2], inline_kind[3], inline_kind[4], inline_kind[5]);
+    return (wrong || g_inexact_guard || !inline_kind[1] || !inline_kind[2] || vec_pad_inline != vec_pad) ? 1 : 0;
+}
diff --git a/runtime/spu/tests/test_spu_ib_memo.c b/runtime/spu/tests/test_spu_ib_memo.c
new file mode 100644
index 0000000..1ff6389
--- /dev/null
+++ b/runtime/spu/tests/test_spu_ib_memo.c
@@ -0,0 +1,137 @@
+/* v113-android.44: spu_ib_memo.h against a plain model -- per set, the words in the order they
+ * were last used, four at most. Every find and put is checked: a find gives the word last put for
+ * that key or 0, never another key's; the model and the table hold the same words in the same
+ * order after each step. Then two shapes the old one-word-a-target table lost every time: two
+ * targets that share a set taking turns, and one target address under eight job overlays.
+ * Build: zig cc -O2 -I.. test_spu_ib_memo.c -o t.exe          (-DMUT=1..3 plants a defect) */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#if defined(MUT)
+#define spu_ib_memo_find spu_ib_memo_find_real
+#define spu_ib_memo_put  spu_ib_memo_put_real
+#endif
+#include "spu_ib_memo.h"
+#if defined(MUT)
+#undef spu_ib_memo_find
+#undef spu_ib_memo_put
+/* the defects: 1 = a find takes any live word of the set's first way; 2 = a put never replaces the
+ * key's old word; 3 = a find does not move its word to the front */
+static uint64_t spu_ib_memo_find(uint64_t* memo, uint64_t key)
+{
+#if MUT == 1
+    uint64_t* const s = memo + (size_t)spu_ib_set(key) * SPU_IB_WAYS;
+    if (s[0] & 0x1FFFFu) return s[0];
+    return spu_ib_memo_find_real(memo, key);
+#elif MUT == 3
+    uint64_t* const s = memo + (size_t)spu_ib_set(key) * SPU_IB_WAYS;
+    for (unsigned k = 0; k < SPU_IB_WAYS; k++) if (!((s[k] ^ key) >> 17) && (s[k] & 0x1FFFFu)) return s[k];
+    return 0;
+#else
+    return spu_ib_memo_find_real(memo, key);
+#endif
+}
+static void spu_ib_memo_put(uint64_t* memo, uint64_t word)
+{
+#if MUT == 2
+    uint64_t* const s = memo + (size_t)spu_ib_set(word) * SPU_IB_WAYS;
+    for (unsigned j = SPU_IB_WAYS - 1u; j > 0; j--) s[j] = s[j - 1];
+    s[0] = word;
+#else
+    spu_ib_memo_put_real(memo, word);
+#endif
+}
+#endif
+
+static uint64_t g_memo[SPU_IB_WORDS];
+static uint64_t g_model[SPU_IB_SETS][SPU_IB_WAYS];   /* most recently used first; 0 = none */
+static uint64_t rng = 0x6A09E667F3BCC909ull;
+static uint64_t rnd(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return rng; }
+
+/* spu_ib_key's layout */
+static uint64_t make_key(uint32_t pc, int policy, uint32_t img, uint32_t task, uint32_t ovl)
+{
+    return ((uint64_t)(pc >> 2) << 48) | ((uint64_t)(policy != 0) << 47) | ((uint64_t)img << 37) |
+           ((uint64_t)task << 27) | ((uint64_t)ovl << 17);
+}
+static uint64_t model_find(uint64_t key)
+{
+    uint64_t* s = g_model[spu_ib_set(key)];
+    for (unsigned k = 0; k < SPU_IB_WAYS; k++)
+        if (s[k] && !((s[k] ^ key) >> 17)) { const uint64_t w = s[k]; memmove(s + 1, s, k * sizeof s[0]); s[0] = w; return w; }
+    return 0;
+}
+static void model_put(uint64_t word)
+{
+    uint64_t* s = g_model[spu_ib_set(word)];
+    unsigned at = SPU_IB_WAYS - 1u;
+    for (unsigned k = 0; k < SPU_IB_WAYS; k++) if (s[k] && !((s[k] ^ word) >> 17)) { at = k; break; }
+    if (at == SPU_IB_WAYS - 1u) for (unsigned k = 0; k < SPU_IB_WAYS; k++) if (!s[k]) { at = k; break; }   /* an empty way first */
+    memmove(s + 1, s, at * sizeof s[0]);
+    s[0] = word;
+}
+static long fail;
+static void same_state(const char* when)
+{
+    for (unsigned i = 0; i < SPU_IB_SETS; i++)
+        for (unsigned k = 0; k < SPU_IB_WAYS; k++)
+            if (g_memo[i * SPU_IB_WAYS + k] != g_model[i][k]) { if (fail++ < 6) printf("FAIL %s: set %u way %u holds %016llX, model %016llX\n", when, i, k,
+                (unsigned long long)g_memo[i * SPU_IB_WAYS + k], (unsigned long long)g_model[i][k]); return; }
+}
+int main(void)
+{
+    long finds = 0, hits = 0, puts = 0;
+    /* a pool of keys small enough to collide: 96 targets, 3 images, 6 overlays, some tasks */
+    for (long t = 0; t < 4000000; t++) {
+        const uint32_t pc = (uint32_t)(rnd() % 96u) * 0x44u + (uint32_t)(rnd() % 3u) * 0x4000u;
+        const uint64_t key = make_key(pc & 0x3FFFCu, (int)(rnd() & 1u), 100u + (uint32_t)(rnd() % 3u), (rnd() % 5u) ? 0u : (uint32_t)(rnd() % 4u),
+                                      (rnd() % 4u) ? 200u + (uint32_t)(rnd() % 6u) : 1023u);
+        const uint64_t got = spu_ib_memo_find(g_memo, key), want = model_find(key);
+        finds++;
+        if (got != want) { if (fail++ < 6) printf("FAIL find: key %016llX gave %016llX, model %016llX\n", (unsigned long long)key, (unsigned long long)got, (unsigned long long)want); }
+        if (got && (got ^ key) >> 17) { if (fail++ < 6) printf("FAIL find: another key's word\n"); }
+        if (got) hits++;
+        else if (rnd() % 3u) {                      /* the walk found it: kept */
+            const uint64_t word = key | (1u + (uint32_t)(rnd() % 0x1FFFFu));
+            spu_ib_memo_put(g_memo, word); model_put(word); puts++;
+        }
+        if (!(rnd() % 64u)) {                       /* the same key walked again (its content check failed): its word is replaced */
+            const uint64_t word = key | (1u + (uint32_t)(rnd() % 0x1FFFFu));
+            spu_ib_memo_put(g_memo, word); model_put(word); puts++;
+        }
+        if (!(t & 1023)) same_state("random");
+    }
+    same_state("random, end");
+    printf("random: %ld finds (%ld hits), %ld puts\n", finds, hits, puts);
+
+    /* two targets of one set, taking turns: every find after the first two puts is a hit */
+    memset(g_memo, 0, sizeof g_memo); memset(g_model, 0, sizeof g_model);
+    { uint64_t a = make_key(0x1BE0, 1, 100, 0, 1023), b = 0; long miss = 0;
+      for (uint32_t pc = 0x1BE4; pc < 0x40000u && !b; pc += 4) { const uint64_t k = make_key(pc, 1, 100, 0, 1023); if (spu_ib_set(k) == spu_ib_set(a)) b = k; }
+      if (!b) { printf("FAIL: no second key for the set\n"); fail++; }
+      for (int i = 0; i < 100000; i++) {
+          const uint64_t k = (i & 1) ? b : a;
+          if (!spu_ib_memo_find(g_memo, k)) { miss++; spu_ib_memo_put(g_memo, k | 7u); }
+      }
+      printf("two targets of one set, 100,000 turns: %ld walks\n", miss);
+      if (miss != 2) { printf("FAIL: expected 2\n"); fail++; } }
+
+    /* one target address under eight job overlays in turn (a lane's frame): a walk each the first time only */
+    memset(g_memo, 0, sizeof g_memo);
+    { long miss = 0;
+      for (int i = 0; i < 80000; i++) {
+          const uint64_t k = make_key(0x4A40, 1, 2, 0, 200u + (uint32_t)(i % 8));
+          if (!spu_ib_memo_find(g_memo, k)) { miss++; spu_ib_memo_put(g_memo, k | 9u); }
+      }
+      printf("one target under eight overlays, 80,000 dispatches: %ld walks\n", miss);
+      if (miss > 8 * 4) { printf("FAIL: expected a few (at most 32)\n"); fail++; } }
+
+    /* a key of all zero bits is a key like any other */
+    memset(g_memo, 0, sizeof g_memo);
+    if (spu_ib_memo_find(g_memo, 0)) { printf("FAIL: an empty way read as key 0's word\n"); fail++; }
+    spu_ib_memo_put(g_memo, 0x55u);
+    if (spu_ib_memo_find(g_memo, 0) != 0x55u) { printf("FAIL: key 0's word not found\n"); fail++; }
+
+    printf("%s (%ld failures)\n", fail ? "FAIL" : "PASS", fail);
+    return fail ? 1 : 0;
+}
diff --git a/runtime/spu/tests/test_spu_mem_ne.c b/runtime/spu/tests/test_spu_mem_ne.c
new file mode 100644
index 0000000..3c48d68
--- /dev/null
+++ b/runtime/spu/tests/test_spu_mem_ne.c
@@ -0,0 +1,40 @@
+/* v113-android.44: spu_channels.c's spu_mem_ne, its own text (the ARM 64-byte step with the five
+ * NEON intrinsics it uses emulated here), against memcmp: equal buffers, and one byte changed at
+ * every position, for every length up to 400 at shifting alignments.
+ * test_spu_mem_ne.py writes mem_ne_block.inc, builds, runs, and plants defects. */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef struct { uint8_t v[16]; } uint8x16_t;
+typedef struct { uint32_t v[4]; } uint32x4_t;
+static uint8x16_t vld1q_u8(const unsigned char* p) { uint8x16_t r; memcpy(r.v, p, 16); return r; }
+static uint8x16_t veorq_u8(uint8x16_t a, uint8x16_t b) { uint8x16_t r; for (int i = 0; i < 16; i++) r.v[i] = a.v[i] ^ b.v[i]; return r; }
+static uint8x16_t vorrq_u8(uint8x16_t a, uint8x16_t b) { uint8x16_t r; for (int i = 0; i < 16; i++) r.v[i] = a.v[i] | b.v[i]; return r; }
+static uint32x4_t vreinterpretq_u32_u8(uint8x16_t a) { uint32x4_t r; memcpy(r.v, a.v, 16); return r; }
+static uint32_t vmaxvq_u32(uint32x4_t a) { uint32_t m = 0; for (int i = 0; i < 4; i++) if (a.v[i] > m) m = a.v[i]; return m; }
+#undef __aarch64__
+#define __aarch64__ 1
+#include "mem_ne_block.inc"
+static uint64_t rng = 0x13198A2E03707344ull;
+static uint32_t rnd(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return (uint32_t)(rng >> 20); }
+int main(void)
+{
+    static unsigned char A[1024], B[1024];
+    long n = 0, fail = 0;
+    for (size_t len = 0; len <= 400; len++) {
+        const size_t oa = len % 7, ob = (len * 3) % 5;
+        for (size_t i = 0; i < len; i++) A[oa + i] = (unsigned char)rnd();
+        memcpy(B + ob, A + oa, len);
+        n++; if (spu_mem_ne(A + oa, B + ob, len) != 0) { if (fail++ < 5) printf("FAIL: equal buffers of %zu read as different\n", len); }
+        for (size_t d = 0; d < len; d++) {
+            B[ob + d] ^= (unsigned char)(1u << (d & 7));
+            n++; if (spu_mem_ne(A + oa, B + ob, len) != 1) { if (fail++ < 5) printf("FAIL: length %zu, byte %zu changed, read as equal\n", len, d); }
+            B[ob + d] = A[oa + d];
+        }
+        /* a difference just past the end must not count */
+        B[ob + len] = (unsigned char)(A[oa + len] ^ 0x5A);
+        n++; if (spu_mem_ne(A + oa, B + ob, len) != 0) { if (fail++ < 5) printf("FAIL: length %zu read past its end\n", len); }
+    }
+    printf("%ld compares, %ld wrong\n", n, fail);
+    return fail ? 1 : 0;
+}
