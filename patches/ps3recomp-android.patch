+void racacit_ring_note(char op, uint32_t id, uint32_t pc, uint32_t ea, int only_if_changed)
+{
+    if (!ring_on()) return;
+    const uint32_t l = ea & ~127u;
+    if (l != s_ring_ea[0] && l != s_ring_ea[1] && l != s_ring_ea[2] && l != s_ring_ea[3]) return;
+    extern uint8_t* vm_base;
