diff --git a/runtime/spu/tests/test_spu_dec_ticks.c b/runtime/spu/tests/test_spu_dec_ticks.c
new file mode 100644
index 0000000..7c98fc0
--- /dev/null
+++ b/runtime/spu/tests/test_spu_dec_ticks.c
@@ -0,0 +1,46 @@
+/* v113-android.43: the SPU decrementer's tick math (spu_channels.c spu_dec_ticks) against exact
+ * 128-bit arithmetic, on the ARM timer rates phones use and on nanoseconds (the other platforms);
+ * the old form multiplied elapsed nanoseconds by 79.8e6 in 64 bits and wrapped after 231 s.
+ * Build: zig cc -O2 test_spu_dec_ticks.c -o t.exe */
+#include <stdint.h>
+#include <stdio.h>
+#define HZ 79800000ull
+/* spu_channels.c spu_dec_ticks, verbatim but for the clock read */
+static uint32_t new_arm(uint64_t d, uint64_t rate)
+{
+    const uint64_t q = d / rate, r = d - q * rate;
+    return (uint32_t)(q * HZ + (r * HZ) / rate);
+}
+static uint32_t exact_counts(uint64_t d_counts, uint64_t rate)
+{ return (uint32_t)(((unsigned __int128)d_counts * HZ) / rate); }
+static uint32_t new_ns(uint64_t d_ns) { return new_arm(d_ns, 1000000000ull); }
+static uint32_t old_ns(uint64_t d_ns) { return (uint32_t)((d_ns * HZ) / 1000000000ull); }
+static uint64_t rng = 0x9E3779B97F4A7C15ull;
+static uint64_t next(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return rng; }
+int main(void)
+{
+    const uint64_t rates[] = { 19200000ull, 24000000ull, 25000000ull, 1000000000ull, 54000000ull };
+    long fail = 0, n = 0; int64_t worst = 0;
+    for (unsigned r = 0; r < sizeof rates / sizeof rates[0]; r++)
+        for (int i = 0; i < 2000000; i++) {
+            /* up to ~3 hours of counts, half of them short */
+            const uint64_t secs_cap = (i & 1) ? 10800ull : 60ull;
+            const uint64_t d = next() % (secs_cap * rates[r]);
+            const int64_t e = (int64_t)(int32_t)(new_arm(d, rates[r]) - exact_counts(d, rates[r]));
+            if (e > worst) worst = e; if (-e > worst) worst = -e;
+            if (e) { if (fail++ < 5) printf("rate %llu d %llu: %u vs %u\n",
+                (unsigned long long)rates[r], (unsigned long long)d, new_arm(d, rates[r]), exact_counts(d, rates[r])); }
+            n++;
+        }
+    printf("ARM counter form: %ld checks, %ld wrong, worst %lld\n", n, fail, (long long)worst);
+    /* The nanosecond form: new is exact; old is right below 231 s, wrong past it. */
+    long ns_fail = 0, old_wrong_after = 0, old_wrong_before = 0;
+    for (int i = 0; i < 2000000; i++) {
+        const uint64_t d = next() % (10800ull * 1000000000ull);
+        const uint32_t ex = (uint32_t)(((unsigned __int128)d * HZ) / 1000000000ull);
+        if (new_ns(d) != ex) ns_fail++;
+        if (old_ns(d) != ex) { if (d > 231000000000ull) old_wrong_after++; else old_wrong_before++; }
+    }
+    printf("ns form: new %ld wrong; old wrong %ld below 231 s, %ld past it (of 2,000,000)\n", ns_fail, old_wrong_before, old_wrong_after);
+    return (fail || ns_fail || old_wrong_before || !old_wrong_after) ? 1 : 0;
+}
