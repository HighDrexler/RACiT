+    if (!strncmp(line, "mus_ryno_", 9)) return lv * 1.45f;   /* the RYNO V's overture: over its rockets (0.30) */
+    if (!strncmp(line, "gen_zoni_misc001", 16)) return lv * 0.55f;   /* the spawn/collect "weee" (v77): present, not jarring */
