+    else if (!(s->rsx_fmt == 4 || s->rsx_fmt == 5 || s->rsx_fmt == 8)) why = "surface format";
+    else if (swz && ((s->w & (s->w - 1u)) || (s->h & (s->h - 1u)))) why = "swizzled, not power of two";
+    else if (pitch < s->w * 4u || (u64)span > (64u << 20)) why = "pitch";
