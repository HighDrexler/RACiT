+/* The mixing thread, each pass: reopen a lost stream, follow the background state
+ * (paused there, as SDL paused its device); with no stream at all, let the real rate
+ * pass through the ring so the clock and the game go on. Only one thread moves the
+ * read position at a time: the callback while a stream exists, this one otherwise. */
+static u64 audio_now_us(void);
+static void aa_tend(void)
+{
+    extern int rsx_android_in_background(void);
+    const int bg = rsx_android_in_background();
+    if (s_aa.st && bg != s_aa.paused) {
+        if (bg) s_aa.pause(s_aa.st); else s_aa.start(s_aa.st);
+        s_aa.paused = bg;
+    }
+    const unsigned long long now = audio_now_us();
+    if (s_aa.lost) {
+        if (s_aa.st) { aa_close(); fprintf(stderr, "[cellAudio] AAudio: the stream was lost (device change?); opening it again%c", 10); }
+        if (now >= s_aa.retry_us) {
+            s_aa.retry_us = now + 500000ull;
+            if (aa_open(1) == 0) {
+                s_aa.drain_us = 0;
+                if (bg) s_aa.pause(s_aa.st);
+                s_aa.paused = bg;
+            }
+        }
+    }
+    if (!s_aa.st) {
+        if (s_aa.drain_us) {
+            const unsigned long long frames = (now - s_aa.drain_us) * CELL_AUDIO_SAMPLE_RATE / 1000000ull;
+            const unsigned long long w = __atomic_load_n(&s_aa.w, __ATOMIC_ACQUIRE);
+            unsigned long long r = s_aa.r + frames;
+            if (r > w) r = w;
+            __atomic_store_n(&s_aa.r, r, __ATOMIC_RELEASE);
+            if (frames) s_aa.drain_us += frames * 1000000ull / CELL_AUDIO_SAMPLE_RATE;
+        } else s_aa.drain_us = now;
+    } else s_aa.drain_us = 0;
+}
+
+static unsigned aa_level(void)
+{
+    return (unsigned)(__atomic_load_n(&s_aa.w, __ATOMIC_RELAXED) - __atomic_load_n(&s_aa.r, __ATOMIC_ACQUIRE));
+}
+
+static void aa_write(const float* stereo, unsigned n)
+{
+    const unsigned long long w = s_aa.w;
+    if (aa_level() + n > AA_RING) return;   /* cannot happen: the mixer keeps AUDIO_DEV_BLOCKS */
+    for (unsigned i = 0; i < n; i++) {
+        const unsigned p = (unsigned)((w + i) & (AA_RING - 1u));
+        s_aa.ring[p * 2] = stereo[i * 2]; s_aa.ring[p * 2 + 1] = stereo[i * 2 + 1];
+    }
+    __atomic_store_n(&s_aa.w, w + n, __ATOMIC_RELEASE);
+}
