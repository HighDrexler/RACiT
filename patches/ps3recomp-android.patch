diff --git a/libs/video/rsx_perf_graph.h b/libs/video/rsx_perf_graph.h
new file mode 100644
index 0000000..90833f8
--- /dev/null
+++ b/libs/video/rsx_perf_graph.h
@@ -0,0 +1,39 @@
+/* Uses the existing present-interval ring; no sampling thread or file output. */
+static void racit_perf_overlay(ui_out* out, const rsx_ui_font* font)
+{
+    double frames[128]; unsigned count;
+    char summary[64];
+    LOCK();
+    memcpy(summary, s_fps_text, sizeof summary);
+    count = s_ft_n < N_OF(s_ft) ? s_ft_n : N_OF(s_ft);
+    for (unsigned i = 0; i < count; ++i)
+        frames[i] = s_ft[(s_ft_n - count + i) % N_OF(s_ft)];
+    UNLOCK();
+    if (!summary[0]) snprintf(summary, sizeof summary, "-- FPS / -- ms");
+    const float px = (float)font->px, x = px * .6f, y = px * .5f;
+    const float width = px * 21, height = px * 2.4f, line = (float)font->line_h;
+    rect(out, 0, 0, x + width + px, y + line * 3 + height * 2 + px,
+         rgba(0, 0, 0, 180));
+    text(out, x, y, summary, rgba(255, 230, 120, 255));
+    for (int graph = 0; graph < 2; ++graph) {
+        const float top = y + line * (graph ? 3 : 2) + height * graph;
+        double maximum = graph ? 33.333 : 120.0;
+        for (unsigned i = 0; i < count; ++i) {
+            double value = graph ? frames[i] : frames[i] > 0 ? 1000.0 / frames[i] : 0;
+            if (value > maximum) maximum = value;
+        }
+        char label[64];
+        snprintf(label, sizeof label, graph ? "Frametime: 0 - %.1f ms" : "FPS: 0 - %.0f", maximum);
+        text(out, x, top - line, label, rgba(210, 220, 235, 255));
+        rect(out, x, top, x + width, top + height, rgba(35, 42, 52, 210));
+        const float guide = top + height * (1.f - (float)((graph ? 16.666667 : 60.0) / maximum));
+        rect(out, x, guide, x + width, guide + 1, rgba(125, 130, 140, 180));
+        for (unsigned i = 0; i < count; ++i) {
+            const double value = graph ? frames[i] : frames[i] > 0 ? 1000.0 / frames[i] : 0;
+            const float left = x + width * (float)(128 - count + i) / 128.f;
+            rect(out, left, top + height * (1.f - (float)(value / maximum)),
+                 left + width / 128.f, top + height,
+                 graph ? rgba(100, 190, 255, 240) : rgba(120, 230, 160, 240));
+        }
+    }
+}
diff --git a/libs/video/rsx_shader_scalar.h b/libs/video/rsx_shader_scalar.h
new file mode 100644
index 0000000..9847974
--- /dev/null
+++ b/libs/video/rsx_shader_scalar.h
@@ -0,0 +1,94 @@
+/*
+ * ps3recomp - register files of a translated program as separate variables
+ *
+ * The decompilers write the RSX's register files as arrays (float4 r[48]) and zero
+ * them in a loop. glslang's optimizer is not built here, so that reaches the driver
+ * as it is: desktop compilers remove it, a mobile one may keep up to 96 vec4s and the
+ * loop per pixel. This turns r[3] into r_3 and declares only the registers the
+ * program names. RACACIT_SCALAR_REGS=0 keeps the arrays.
+ */
+#ifndef RSX_SHADER_SCALAR_H
+#define RSX_SHADER_SCALAR_H
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* `decl`: the exact text declaring and clearing the files, replaced by the new
+ * declarations. names[i] is a one-letter file, inits[i] its starting value.
+ * A file indexed by anything but a number leaves the text as it was. */
+/* `decl` must be the declaration's text to the byte: when it is not found the arrays
+ * stay, without a word. The v121 port put `precise` in front of the vertex programs'
+ * files and every vertex shader kept its 48 registers (v121-android.52: 44 ms of GPU
+ * waits a frame where .50 had 1). A caller whose declaration can vary tries each form;
+ * `qual` goes in front of the new declarations ("precise " or ""). */
+static inline int rsx_scalarize_regs_q(char* hlsl, size_t cap, const char* decl,
+                                       const char* names, const char* const* inits, const char* qual)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RACACIT_SCALAR_REGS"); on = !(e && *e == '0'); }
+    if (!on) return 0;
+    char* at = strstr(hlsl, decl);
+    if (!at) return 0;
+    const size_t dlen = strlen(decl), total = strlen(hlsl);
+    const size_t nn = strlen(names);
+    unsigned long long used[8];
+    if (nn > 8) return 0;
+    memset(used, 0, sizeof used);
+    for (const char* p = hlsl; *p; p++) {
+        if (p == at) { p += dlen - 1; continue; }
+        if (p[1] != '[' || (p > hlsl && (isalnum((unsigned char)p[-1]) || p[-1] == '_'))) continue;
+        const char* k = strchr(names, *p);
+        if (!k) continue;
+        const char* q = p + 2;
+        unsigned idx = 0;
+        if (!isdigit((unsigned char)*q)) return 0;
+        while (isdigit((unsigned char)*q)) idx = idx * 10u + (unsigned)(*q++ - '0');
+        if (*q != ']' || idx >= 64u) return 0;
+        used[k - names] |= 1ull << idx;
+    }
+    char* out = (char*)malloc(cap);
+    if (!out) return 0;
+    size_t n = 0;
+    int fits = 1;
+#define RSX_SCALAR_PUT(s_, l_) do { if (n + (l_) + 1 > cap) fits = 0; else { memcpy(out + n, (s_), (l_)); n += (l_); } } while (0)
+    for (const char* p = hlsl; *p && fits; p++) {
+        if (p == at) {
+            for (size_t f = 0; f < nn; f++)
+                for (unsigned i = 0; i < 64u; i++) {
+                    if (!(used[f] & (1ull << i))) continue;
+                    char line[96];
+                    /* RACACIT_FP_H16=1: the fragment programs' half registers really 16-bit. */
+                    static int h16 = -1;
+                    if (h16 < 0) { const char* e = getenv("RACACIT_FP_H16"); h16 = e && *e == '1'; }
+                    const int l = snprintf(line, sizeof line, "    %s%s %c_%u = %s;\n", qual,
+                                           h16 && names[f] == 'h' ? "min16float4" : "float4", names[f], i, inits[f]);
+                    RSX_SCALAR_PUT(line, (size_t)l);
+                }
+            p += dlen - 1;
+            continue;
+        }
+        if (p[1] == '[' && strchr(names, *p) && !(p > hlsl && (isalnum((unsigned char)p[-1]) || p[-1] == '_'))) {
+            RSX_SCALAR_PUT(p, 1);
+            RSX_SCALAR_PUT("_", 1);
+            p += 2;
+            while (*p != ']') { RSX_SCALAR_PUT(p, 1); p++; }
+            continue;
+        }
+        RSX_SCALAR_PUT(p, 1);
+    }
+#undef RSX_SCALAR_PUT
+    (void)total;
+    if (fits) { out[n] = '\0'; memcpy(hlsl, out, n + 1); }
+    free(out);
+    return fits;
+}
+
+static inline int rsx_scalarize_regs(char* hlsl, size_t cap, const char* decl,
+                                     const char* names, const char* const* inits)
+{
+    return rsx_scalarize_regs_q(hlsl, cap, decl, names, inits, "");
+}
+
+#endif
