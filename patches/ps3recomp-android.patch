+file(GLOB_RECURSE HLE_SOURCES
+    "libs/system/*.c"
+    "libs/filesystem/*.c"
+    "libs/input/*.c"
+    "libs/audio/*.c"
+    "libs/video/*.c"
+    "libs/network/*.c"
+    "libs/spurs/*.c"
