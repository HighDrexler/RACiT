-{
-    if (!pattern_ea) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
-
-    u64 word[2] = { 0, 0 };
-
-    if (elf_ea) {
-        const uint8_t* img = vm_base + (uint32_t)elf_ea;
-        if (img[0] == 0x7F && img[1] == 'E' && img[2] == 'L' && img[3] == 'F' &&
