-                        spu->list_stall_mask,
-                        spu->ls[0x12A0], spu->ls[0x12A1],
-                        spu->ls[0x12A2], spu->ls[0x12A3],
-                        spu->ls[0x12A4], spu->ls[0x12A5],
-                        spu->ls[0x12A6], spu->ls[0x12A7]); }
-            return 0;
-        }
-    }
-    return 0;
-}
