+            const int cube = (tex_cube_mask >> tex_unit) & 1u;
+            char tn[32];
+            fp_tex_name(tn, sizeof tn, tex_cube_mask, tex_unit);
+            char c3[1600]; snprintf(c3, sizeof c3, "(%s).xyz", a);
+            if (!fp_tex3d_rhs(rhs, sizeof rhs, tn, tex_unit, c3))
