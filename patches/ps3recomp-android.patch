+/* ---------------------------------------------------------------------------
+ * Display refresh rate
+ *
+ * The game makes 60 frames a second and frame pacing (rsx_be_proxy.c) spaces
+ * them 16.7 ms apart. A 60, 120 or 240 Hz display shows each for the same
+ * number of refreshes; a 144 or 165 Hz one cannot (2, 3, 2, 2, 3 ... at 144):
+ * a judder at a steady 60 fps that players call stutter, unless G-Sync or
+ * FreeSync runs the display at the game's rate. The log names the rate
+ * (players with fast PCs reported stutter, and the log could not say whether
+ * the display was part of it); the first time the game runs on a rate 60 does
+ * not divide, a notice says so once. RACACIT_REFRESH_HINT_HZ keeps the rate
+ * it was shown for; -1 never shows it.
+ * -------------------------------------------------------------------------*/
+static void display_check(void)
+{
+    if (!s_win) return;
+    const int di = SDL_GetWindowDisplayIndex(s_win);
+    SDL_DisplayMode dm;
+    if (di < 0 || SDL_GetCurrentDisplayMode(di, &dm) != 0) return;
+    { const char* t = getenv("RACACIT_DISPLAY_HZ_TEST");   /* test: act as if the display ran at this rate */
+      if (t && atoi(t) > 0) dm.refresh_rate = atoi(t); }
+    if (di == s_disp_idx && dm.refresh_rate == s_disp_hz && dm.w == s_disp_w && dm.h == s_disp_h) return;
+    s_disp_idx = di; s_disp_hz = dm.refresh_rate; s_disp_w = dm.w; s_disp_h = dm.h;
+    rsx_host_options o; rsx_host_ui_options(&o);
+    const int hz = dm.refresh_rate, r = hz > 0 ? hz % 60 : 0;
+    const int even = hz <= 61 ? 1 : (r <= 1 || r >= 59);   /* 59.94 Hz modes come as 59 or 119 */
+    /* One fputs: the first present comes while boot threads print, and an
+     * fprintf to the unbuffered log went out in pieces, mixed into their lines. */
+    char line[320];
+    snprintf(line, sizeof line, "[display] display %d: %dx%d at %d Hz, %s, VSync %s%s%c", di, dm.w, dm.h, hz,
+             o.display_mode == RSX_UI_DISPLAY_EXCLUSIVE ? "fullscreen" : o.display_mode == RSX_UI_DISPLAY_BORDERLESS ? "borderless" : "windowed",
+             o.vsync == RSX_UI_VSYNC_FIFO ? "on" : o.vsync == RSX_UI_VSYNC_IMMEDIATE ? "off (tearing)" : "off (no tearing)",
+             even ? "" : "; 60 fps does not divide this rate: motion judders unless G-Sync/FreeSync is on", 10);
+    fputs(line, stderr);
+    if (even || s_hint_hz < 0 || s_hint_hz == hz) return;
+    LOCK();
+    snprintf(s_note.head, sizeof s_note.head, "Display at %d Hz", hz);
+    snprintf(s_note.l1, sizeof s_note.l1, "60 fps can't be shown evenly at %d Hz: without G-Sync/FreeSync, motion judders.", hz);
+#if defined(_WIN32)
+    const char* where = "in Windows display settings";
+#elif defined(__APPLE__)
+    const char* where = "in System Settings > Displays";
+#else
+    const char* where = "in the system display settings";
+#endif
+    snprintf(s_note.l2, sizeof s_note.l2, "Turn on G-Sync/FreeSync, or set the display to 60, 120 or 240 Hz %s.", where);
+    s_note.t0 = 0; s_note.on = 1;
+    s_hint_hz = hz;
+    UNLOCK();
+    settings_save();   /* once per rate, not every start */
+}
