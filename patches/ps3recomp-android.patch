+static const ui_row* page_rows(int p, int* n)
+{
+    /* Filtered copies, made once. Without the DualSense Plus mod: no
+     * DualSense rows (Fire button, adaptive triggers, the DualSense section)
+     * -- Rumble stays, it is every controller's. Phones also go without the
+     * rows they have no use for: window mode and size, Discord, the DualSense
+     * speaker and haptics (USB audio, Windows only). USB/Bluetooth mice use
+     * Android pointer capture and retain the v97 camera controls. */
+    static ui_row f[3][N_OF(k_rows_controls) + N_OF(k_rows_general) + N_OF(k_rows_graphics)];
+    static int fn[3] = { -1, -1, -1 };
+    if (p == TR_PAGE) {
+        if (cheats_mode()) { *n = N_OF(k_rows_cheats); return k_rows_cheats; }
+        *n = N_OF(k_rows_trophies); return k_rows_trophies;
+    }
+    if (p < 0 || p > 2) p = 0;
+    if (fn[p] < 0) {
+        rsx_host_ui_load_options();
+        LOCK(); const int plus = s_opt.ds_plus; UNLOCK();
+        const ui_row* src = p == 1 ? k_rows_graphics : p == 2 ? k_rows_controls : k_rows_general;
+        const int ns = p == 1 ? N_OF(k_rows_graphics) : p == 2 ? N_OF(k_rows_controls) : N_OF(k_rows_general);
+        int k = 0;
+        for (int i = 0; i < ns; i++) {
+            const int id = src[i].kind == K_OPT ? src[i].id : 0;
+            if (!plus && (id == R_DSSWAP || id == R_DSTRIG || id == R_DSTRIGSTR || id == R_DSSPK || id == R_DSVOL ||
+                          id == R_DSHAP || id == R_DSHVOL || id == R_DSLIGHT || id == R_DSMOTION ||
+                          (src[i].kind == K_HEAD && !strcmp(src[i].label, "DualSense")))) continue;
+#ifdef __ANDROID__
+            if (id == R_DISPLAY || id == R_WINSIZE || id == R_DISCORD || id == R_DSSPK || id == R_DSVOL ||
+                id == R_DSHAP || id == R_DSHVOL) continue;
+#endif
+            f[p][k++] = src[i];
+        }
+        fn[p] = k;
+    }
+    *n = fn[p]; return f[p];
+}
+static const ui_row* rows(void) { int n; return page_rows(s_page, &n); }
+static int n_rows(void) { int n; page_rows(s_page, &n); return n; }
+/* Height of the longest page (head and row heights given), so the panel is
+ * sized once and does not move when the page changes. */
+static float rows_height(float head, float row)
+{
+    float best = 0.0f;
+    for (int p = 0; p < N_PAGES; p++) {
+        int n; const ui_row* r = page_rows(p, &n);
+        float h = 0.0f;
+        for (int i = 0; i < n; i++) h += r[i].kind == K_HEAD ? head : r[i].kind == K_GAP ? row * 0.5f : row;
+        if (h > best) best = h;
+    }
+    return best;
+}
+#define N_ROWS n_rows()
+#define k_rows rows()
