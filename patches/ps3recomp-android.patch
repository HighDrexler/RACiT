+void spu_lockline_unlock(void)
+{
+    spu_context* q[SPU_COH_WQ_MAX];
+    const int n = s_coh_wq.n;
+    if (n) { for (int k = 0; k < n; k++) q[k] = s_coh_wq.q[k]; s_coh_wq.n = 0; }
+    __atomic_store_n(&g_lockline, 0, __ATOMIC_SEQ_CST);
+    if (__atomic_load_n(&g_lockline_waiters, __ATOMIC_SEQ_CST))
+        syscall(SYS_futex, &g_lockline, FUTEX_WAKE_PRIVATE, INT_MAX, NULL, NULL, 0);
+    /* The predicate (event_status, resv_valid) was set under the lock; a sleeper re-checks it under its
+     * CV's mutex before it sleeps, and the wake bumps that CV's generation after, so none is lost. */
+    for (int k = 0; k < n; k++) spu_ch_wake(q[k]);
+}
+void spu_spin_wait(volatile long* lock)
+{
+    unsigned spins = 0;
+    while (__atomic_load_n(lock, __ATOMIC_RELAXED)) {
+        SPU_LL_PAUSE();
+        if (++spins >= 1024u) { spins = 0; sched_yield(); }
+    }
+}
+#else
+#include <stdatomic.h>
+/* Alone on its line: the compiler packs a file's globals together, and the armed flag, the context list
+ * and the counters would bounce with each take of the lock. */
+static struct { atomic_uint v; char pad[60]; } __attribute__((aligned(64))) s_lockline_word;
+#define g_lockline s_lockline_word.v
+void spu_lockline_lock(void)
+{
