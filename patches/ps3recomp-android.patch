+/*
+ * ps3recomp - RSX Vertex Program (NV40 ISA) -> HLSL decompiler
+ *
+ * See rsx_vp_decompiler.h. The 4-word instruction encoding (D0..D3 fields,
+ * source operand layout, opcode numbers) follows the public NV40 vertex
+ * program layout as documented in the NV_vertex_program3 extension spec and
+ * the envytools rnndb; RPCS3 was consulted as a READ-ONLY semantics oracle
+ * for the field positions and the dest-write rules (no code copied).
+ *
+ * Field facts used (verified against the oracle 2026-07-03):
+ *   D0: mask_w/z/y/x pairs [2:9] are the CC swizzle, cond [10:12],
+ *       cond_test_enable [13], dst_tmp [15:20], src0/1/2_abs [21:23],
+ *       addr_reg_sel [24], saturate [26], vec_result [30]
+ *   D1: src0h [0:7], input_src [8:11], const_src [12:21],
+ *       vec_opcode [22:26], sca_opcode [27:31]
+ *   D2: src2h [0:5], src1 [6:22], src0l [23:31]
+ *   D3: end [0], index_const [1], dst [2:6], sca_dst_tmp [7:12],
+ *       vec_writemask w/z/y/x [13:16], sca_writemask w/z/y/x [17:20],
+ *       src2l [21:31]
+ *   SRC (17 bits): reg_type [0:1] (1 = temp, 2 = input, 3 = constant),
+ *       tmp_src [2:7], swz w/z/y/x [8:15] (2 bits each), neg [16]
+ *   Dest rules: the VEC result goes to output o[D3.dst] when D0.vec_result
+ *       (dst 0x1F = none) AND to temp r[D0.dst_tmp] (0x3F = none); the SCA
+ *       result goes to o[D3.dst] when !D0.vec_result, else to
+ *       r[D3.sca_dst_tmp]. The SCA unit reads SRC2.
+ *   VEC ADD reads src0 + src2 (not src1).
+ *   Output register map: o0 = HPOS, o1 = COL0, o2 = COL1, o3/o4 = back-face
+ *       colors, o5.x = FOG, o6 = point size / TEX9, o7..o14 = TEX0..7,
+ *       o15 = TEX8. Unwritten outputs default to (0,0,0,1).
+ */
+#include "rsx_vp_decompiler.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+static int s_vp_ieee = -1;   /* RACACIT_VP_IEEE (rsx_vp_decompile's multiply and output forms) */
+#include "rsx_shader_scalar.h"
+
+/* ---- little-endian word read (RPCS3-capture native order) --------------- */
+static u32 rd_le(const u8* p)
+{ return (u32)p[0] | ((u32)p[1]<<8) | ((u32)p[2]<<16) | ((u32)p[3]<<24); }
+
+/* ---- opcode names ------------------------------------------------------ */
+const char* rsx_vp_vec_name(u32 op)
+{
+    static const char* n[] = {"NOP","MOV","MUL","ADD","MAD","DP3","DPH","DP4",
+        "DST","MIN","MAX","SLT","SGE","ARL","FRC","FLR","SEQ","SFL","SGT","SLE",
+        "SNE","STR","SSG","?","?","TXL"};
+    return op < 26 ? n[op] : "?";
+}
+const char* rsx_vp_sca_name(u32 op)
+{
+    static const char* n[] = {"NOP","MOV","RCP","RCC","RSQ","EXP","LOG","LIT",
+        "BRA","BRI","CAL","CLI","RET","LG2","EX2","SIN","COS","BRB","CLB","PSH","POP"};
+    return op < 21 ? n[op] : "?";
+}
+
+u32 rsx_vp_program_size_instrs(const u8* ucode, u32 max_bytes)
+{
+    if (!ucode) return 0;
+    u32 off = 0, instrs = 0;
+    while (off + 16 <= max_bytes) {
+        u32 d3 = rd_le(ucode + off + 12);
+        instrs++;
+        off += 16;
+        if (d3 & 1u) return instrs;   /* D3.end */
+    }
+    return 0;
+}
+
+/* ---- output appender --------------------------------------------------- */
+typedef struct { char* p; u32 cap; u32 len; int overflow; } Out;
+/* Exact (Dot2) dot products in every program, or only where they reach the
+ * position. Apple: the slice by default (RSX_VP_EXACT_DOTS=1 keeps every dot
+ * exact). Elsewhere: every dot exact, the shader text unchanged, unless
+ * RSX_VP_EXACT_DOTS=0 turns the slice on. */
+/* Android: no exact dot and no `precise` by default -- the vertex programs as every
+ * Android build up to v113-android.50 wrote them. Measured on the Thor (Adreno 740,
+ * Great Clock e, 13.0k draws a frame, v121-android.53): plain 43.5 fps with 2 ms of GPU
+ * waits a frame; exact only where a dot reaches the position 36.3 fps with 13 ms. Slower
+ * phone GPUs lose more. RSX_VP_EXACT_DOTS=0 turns the position slice on (the far-distance
+ * depth fighting public PR #29 fixed), =1 makes every dot exact. */
+static int vp_plain_dots(void)
+{
+#if defined(__ANDROID__)
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_VP_EXACT_DOTS"); v = !(e && (*e == '0' || *e == '1')); }
+    return v;
+#else
+    return 0;
+#endif
+}
+
+static int vp_all_exact_dots(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("RSX_VP_EXACT_DOTS");
+#if defined(__APPLE__) || defined(__ANDROID__)
+        /* Android: a phone GPU, and every dot exact made each DP3/DP4 ~10x the ALU; the slice
+         * keeps the position (what the z-fighting was) exact. v113-android.52. */
+        v = e && *e == '1';
+#else
+        v = !(e && *e == '0');
+#endif
+    }
+    return v;
+}
+
+/* Apple: no `precise` (SPIR-V NoContraction) in the vertex programs.
+ * SPIRV-Cross, inside MoltenVK, implements it by calling an optnone helper
+ * (spvFAdd/spvFSub/spvFMul) for every add, subtract and multiply -- a median
+ * of 260 calls per vertex program in A Crack in Time -- and those calls were
+ * most of the GPU's frame. The exact dots (vp_dot3/vp_dot4) stay exact
+ * without it on Apple GPUs: the product error is an explicit fma (mad), and
+ * Metal's compiler neither fused p + a*b nor reordered the TwoSum terms in
+ * any math mode (checked on 1M cases where fusing would change the sum,
+ * fast, relaxed and safe). RSX_VP_PRECISE=1 keeps `precise`. */
+static int vp_keep_precise(void)
+{
+#if defined(__APPLE__)
+    static int k = -1;
+    if (k < 0) { const char* e = getenv("RSX_VP_PRECISE"); k = e && *e == '1'; }
+    return k;
+#else
+    return !vp_plain_dots();
+#endif
+}
+
+static void emit(Out* o, const char* s)
+{
+    if (!vp_keep_precise() && strstr(s, "precise ")) {
+        for (const char* q = s; *q; ) {
+            if (!strncmp(q, "precise ", 8)) { q += 8; continue; }
+            if (o->len + 2 > o->cap) { o->overflow = 1; return; }
+            o->p[o->len++] = *q++;
+        }
+        o->p[o->len] = '\0';
+        return;
+    }
+    u32 n = (u32)strlen(s);
+    if (o->len + n + 1 > o->cap) { o->overflow = 1; return; }
+    memcpy(o->p + o->len, s, n); o->len += n; o->p[o->len] = '\0';
+}
+
+/* ---- source operand ---------------------------------------------------- */
+static const char SWZ[4] = {'x','y','z','w'};
+
+/* Build the HLSL expression for one 17-bit source field.
+ * reg_type: 1 = temp r[], 2 = input v[], 3 = constant vp_c[]. */
+static void emit_src(u32 src, int is_abs, u32 input_src, u32 const_src,
+                     int index_const, u32 addr_sel, u32 addr_swz,
+                     char* buf, u32 bufsz)
+{
+    u32 reg_type = src & 3;
+    u32 tmp_src  = (src >> 2) & 0x3F;
+    u32 sw = (src >> 8) & 3, sz = (src >> 10) & 3;
+    u32 sy = (src >> 12) & 3, sx = (src >> 14) & 3;
+    int neg = (src >> 16) & 1;
+
+    char base[64];
+    switch (reg_type) {
+    case 2:  snprintf(base, sizeof(base), "v[%u]", input_src & 15); break;
+    case 3:
+        if (index_const)
+            snprintf(base, sizeof(base), "vp_c[(%uu + a%u.%c) & 511u]",
+                     const_src, addr_sel & 1, SWZ[addr_swz & 3]);
+        else
+            snprintf(base, sizeof(base), "vp_c[%u]", const_src & 511);
+        break;
+    default: snprintf(base, sizeof(base), "r[%u]", tmp_src & 31); break;
+    }
+
+    char swz[8];
+    swz[0]='.'; swz[1]=SWZ[sx]; swz[2]=SWZ[sy]; swz[3]=SWZ[sz]; swz[4]=SWZ[sw]; swz[5]='\0';
+
+    const char* pre = neg ? "-" : "";
+    if (is_abs) snprintf(buf, bufsz, "%sabs(%s)%s", pre, base, swz);
+    else        snprintf(buf, bufsz, "%s(%s)%s", pre, base, swz);
+}
+
+/* writemask string from 4 bits (x,y,z,w order) -> "xyzw" subset */
+static void mask_str(int mx,int my,int mz,int mw, char* m)
+{
+    int i=0;
+    if (mx) m[i++]='x';
+    if (my) m[i++]='y';
+    if (mz) m[i++]='z';
+    if (mw) m[i++]='w';
+    m[i]='\0';
+}
+
+/* Emit "    dst.mask = _v.mask;" (skips when mask empty). */
+static void emit_store(Out* b, const char* dst_fmt, u32 idx, const char* m)
+{
+    if (!m[0]) return;
+    char line[96];
+    char dst[32];
+    snprintf(dst, sizeof(dst), dst_fmt, idx);
+    snprintf(line, sizeof(line), "        %s.%s = _v.%s;\n", dst, m, m);
+    emit(b, line);
+}
+
+/* ---- flow control -------------------------------------------------------- */
+/* The RSX takes longer programs than 512 instructions (544 slots); at 512 a
+ * 532-instruction program in A Crack in Time lost its block openers past the
+ * limit while the terminators were still emitted: unbalanced braces, "function
+ * does not return a value: @main", and every draw using it dropped. */
+#define RSX_VP_MAX_INSTR 1024
+
+static u32 s_vp_branch_base = 0;   /* VP slot the program being decompiled starts at */
+/* NV4097_SET_TRANSFORM_BRANCH_BITS (0x1FF8) for the draw being translated:
+ * BRB/CLB test one of its bits, so a program that has them is translated
+ * per value (the engine keys on it -- rsx_vp_uses_branch_bits). */
+u32 rsx_vp_branch_bits = 0;
+int rsx_vp_last_loops = 0;
+
+/* v121-android.63: the most rounds the block state machine of a program that CAN loop gets (a
+ * reachable backward branch or call). It was 16384 for every branching program. A Crack in Time's only
+ * such programs are the 544-slot uber programs with their two light loops on (branch bits 15/16): a
+ * round per light, a handful of rounds in all. The Thor's GPU hangs in the Agorian Arena fights (kgsl
+ * "GPU hang detected", 0.35-0.55 s frozen frames, 5 in the owner's 2026-11-17 fight, 2 in the .58 one)
+ * leave those loops as the only unbounded work in any recorded shader (no fragment program loops; FP
+ * LOOP/REP are capped at 255 by their encoding). A loop that never meets its exit -- loop constants
+ * that are not what the program expects -- now stops after this many rounds instead of 16384 per vertex.
+ * Programs whose loops are unreachable keep their old text (the 16384 bound, never reached: one round),
+ * so their shader-cache entries stay valid. RACACIT_VP_ROUNDS=<n> sets it; 16384 = the old text. */
+static int vp_loop_rounds(void)
+{
+    static int r = -1;
+    if (r < 0) {
+        const char* e = getenv("RACACIT_VP_ROUNDS");
+        r = (e && *e) ? atoi(e) : 256;
+        if (r < 8) r = 8;
+        if (r > 16384) r = 16384;
+    }
+    return r;
+}
+
+int rsx_vp_uses_branch_bits(const void* ucode, u32 bytes)
+{
+    /* The words as the decompiler reads them (rd_le: the dispatcher keeps the
+     * program in host order). Reading them big-endian looked at byte-swapped
+     * words, so most programs with BRB were called branch-free and translated
+     * with every bit 0 -- A Crack in Time's particle program then skipped the
+     * corner expansion and every particle (fire, shots, sparks) collapsed
+     * to a point. */
+    const u8* p = (const u8*)ucode;
+    for (u32 o = 0; o + 16u <= bytes; o += 16u) {
+        const u32 d1 = rd_le(p + o + 4);
+        const u32 d3 = rd_le(p + o + 12);
+        const u32 op = (d1 >> 27) & 0x1F;
+        if (op == 0x11 || op == 0x12) return 1;
+        if (d3 & 1u) break;
+    }
+    return 0;
+}
+void rsx_vp_set_branch_base(u32 start_slot) { s_vp_branch_base = start_slot; }
+
+/* BRA BRI CAL CLI RET BRB CLB (scalar opcodes). */
+static int vp_is_flow(u32 sca_op)
+{
+    return sca_op == 0x08 || sca_op == 0x09 || sca_op == 0x0A || sca_op == 0x0B ||
+           sca_op == 0x0C || sca_op == 0x11 || sca_op == 0x12;
+}
+
+/* Branch target (NV40 layout, RPCS3 as oracle): D0[23] << 9 | D2[0:5] << 3 |
+ * D3[29:31], an absolute VP slot; made relative to the program start. */
+static u32 vp_branch_target(u32 d0, u32 d2, u32 d3)
+{
+    const u32 t = (((d0 >> 23) & 1u) << 9) | ((d2 & 0x3Fu) << 3) | ((d3 >> 29) & 7u);
+    return t >= s_vp_branch_base ? t - s_vp_branch_base : t;
+}
+
+/* Condition-code state for one instruction (D0). The NV40 VP has two CC
+ * registers; a write under cond-test lands only in the components whose
+ * CC component (through the D0 CC swizzle) compares true against zero.
+ * cond: 0 = never, 1 LT, 2 EQ, 3 LE, 4 GT, 5 NE, 6 GE, 7 = always. */
+typedef struct { int test; u32 cond, sel; char swz[4]; } CondCtx;
+
+/* Emit the store, predicated per component when a cond test is active. */
+static void emit_store_cc(Out* b, const char* dst_fmt, u32 idx, const char* m, const CondCtx* cc)
+{
+    if (!cc->test) { emit_store(b, dst_fmt, idx, m); return; }
+    if (cc->cond == 0) return;                      /* FL: never writes */
+    static const char* cmp[8] = { 0, "<", "==", "<=", ">", "!=", ">=", 0 };
+    char dst[32];
+    snprintf(dst, sizeof(dst), dst_fmt, idx);
+    for (const char* c = m; *c; c++) {
+        const int ci = (*c == 'x') ? 0 : (*c == 'y') ? 1 : (*c == 'z') ? 2 : 3;
+        char line[160];
+        snprintf(line, sizeof(line), "        if (cc[%u].%c %s 0.0) %s.%c = _v.%c;\n",
+                 cc->sel, cc->swz[ci], cmp[cc->cond], dst, *c, *c);
+        emit(b, line);
+    }
+}
+
+static u32 vec_source_use(u32 op, int* exact)
+{
+    switch (op) {
+    case 0x00: return 0;       /* NOP */
+    case 0x01: return 1u;      /* src0 */
+    case 0x02: return 3u;      /* src0, src1 */
+    case 0x03: return 5u;      /* src0, src2 */
+    case 0x04: return 7u;      /* src0, src1, src2 */
+    case 0x05: case 0x06: case 0x07: case 0x08:
+    case 0x09: case 0x0A: case 0x0B: case 0x0C:
+    case 0x10: case 0x12: case 0x13: case 0x14:
+        return 3u;             /* src0, src1 */
+    case 0x0D: case 0x0E: case 0x0F: case 0x16: case 0x19:
+        return 1u;             /* src0 */
+    case 0x11: case 0x15:
+        return 0;              /* source-independent constants */
+    default:
+        *exact = 0;
+        return 0;
+    }
+}
+
+static u32 sca_source_use(u32 op, int* exact)
+{
+    switch (op) {
+    case 0x00:
+        return 0;
+    case 0x01: case 0x02: case 0x03: case 0x04:
+    case 0x05: case 0x06: case 0x07:
+    case 0x0D: case 0x0E: case 0x0F: case 0x10:
+        return 4u;             /* scalar ALU reads src2 */
+    default:
+        /* Flow control and currently unsupported scalar opcodes make a
+         * narrowed data-flow result unsafe. */
+        *exact = 0;
+        return 0;
+    }
+}
+
+int rsx_vp_analyze_inputs(const u8* ucode, u32 max_bytes,
+                          rsx_vp_input_analysis* analysis)
+{
+    if (!ucode || !analysis) return -1;
+    analysis->input_mask = 0;
+    analysis->exact = 1;
+    u32 off = 0;
+    int instrs = 0;
+    int ended = 0;
+    while (off + 16 <= max_bytes) {
+        const u32 d1 = rd_le(ucode + off + 4);
+        const u32 d2 = rd_le(ucode + off + 8);
+        const u32 d3 = rd_le(ucode + off + 12);
+        off += 16;
+        instrs++;
+
+        const u32 vec_op = (d1 >> 22) & 0x1F;
+        const u32 sca_op = (d1 >> 27) & 0x1F;
+        const u32 input_src = (d1 >> 8) & 0xF;
+        const u32 src0 = ((d2 >> 23) & 0x1FF) | ((d1 & 0xFF) << 9);
+        const u32 src1 = (d2 >> 6) & 0x1FFFF;
+        const u32 src2 = ((d3 >> 21) & 0x7FF) | ((d2 & 0x3F) << 11);
+        const u32 sources[3] = {src0, src1, src2};
+        const int vec_writes = ((d3 >> 13) & 0xFu) != 0;
+        const int sca_writes = ((d3 >> 17) & 0xFu) != 0;
+        u32 use = 0;
+        if (vec_writes && vec_op)
+            use |= vec_source_use(vec_op, &analysis->exact);
+        if (sca_writes && sca_op)
+            use |= sca_source_use(sca_op, &analysis->exact);
+        for (u32 source = 0; source < 3; source++)
+            if ((use & (1u << source)) && (sources[source] & 3u) == 2u)
+                analysis->input_mask |= 1u << input_src;
+
+        if (d3 & 1u) {
+            ended = 1;
+            break;
+        }
+    }
+    if (!ended) {
+        analysis->input_mask = 0xFFFFu;
+        analysis->exact = 0;
+        return -1;
+    }
+    if (!analysis->exact)
+        analysis->input_mask = 0xFFFFu;
+    return instrs;
+}
+
+static int rsx_vp_decompile_impl(
+    const u8* ucode, u32 max_bytes, u32 vtex_mask, int compact_inputs,
+    u32 input_mask, char* out, u32 out_size);
+
+int rsx_vp_decompile(const u8* ucode, u32 max_bytes, char* out, u32 out_size)
+{
+    return rsx_vp_decompile_ex(ucode, max_bytes, 0u, out, out_size);
+}
+
+int rsx_vp_decompile_ex(const u8* ucode, u32 max_bytes, u32 vtex_mask,
+                        char* out, u32 out_size)
+{
+    return rsx_vp_decompile_impl(
+        ucode, max_bytes, vtex_mask, 0, 0xFFFFu, out, out_size);
+}
+
+int rsx_vp_decompile_compact_ex(
+    const u8* ucode, u32 max_bytes, u32 vtex_mask, u32 input_mask,
+    char* out, u32 out_size)
+{
+    rsx_vp_input_analysis analysis;
+    if (rsx_vp_analyze_inputs(ucode, max_bytes, &analysis) < 0 ||
+        !analysis.exact ||
+        (analysis.input_mask & ~(input_mask & 0xFFFFu)) != 0)
+        input_mask = 0xFFFFu;
+    else
+        input_mask = analysis.input_mask;
+    return rsx_vp_decompile_impl(
+        ucode, max_bytes, vtex_mask, 1, input_mask, out, out_size);
+}
+
+static int rsx_vp_decompile_impl(
+    const u8* ucode, u32 max_bytes, u32 vtex_mask, int compact_inputs,
+    u32 input_mask, char* out, u32 out_size)
+{
+    rsx_vp_last_loops = 0;
+    if (!ucode || !out || out_size < 256) return -1;
+
+    /* Body is built first, preamble/epilogue wrap it. */
+    static char body[192 * 1024];
+    Out b = { body, sizeof(body), 0, 0 };
+    body[0] = '\0';
+
+    int n_cond_skipped = 0, n_flow_skipped = 0;
+
+    /* Flow control (BRI/CAL/CLI/RET...). It carries no write mask, so it was
+     * dropped and every block ran straight through: a lit shader that
+     * branches around its lighting when lighting is off (@20 -> 134 on
+     * cc.y == 0 in Tornado Outbreak's UI/particle shader) zeroed its colour
+     * and summed no lights -- black text, black smoke, black leaves.
+     *
+     * A branching program is emitted as a block state machine: leaders are
+     * the entry, every branch target and the instruction after every branch;
+     * each block is "if (_pc == N) { ... _pc = next-or-target; }" inside a
+     * bounded loop, with a small call stack for CAL/RET. Branch-free programs
+     * are emitted exactly as before. Targets are VP slot addresses; the slot
+     * the program starts at comes from rsx_vp_set_branch_base(). */
+    static u8 leader[RSX_VP_MAX_INSTR + 1];
+    memset(leader, 0, sizeof leader);
+    int has_flow = 0;
+    /* v121-android.59: a branch that can be taken backward, or a call/return, needs the _pc loop;
+     * without either, the blocks (emitted in ascending order) run in one pass. */
+    int flow_back = 0, flow_call = 0;
+    /* v113-android.52: the program's length. A branch to it or past it -- "skip to the end", or the
+     * fall-through of a flow op that is the last instruction -- named no block, so the state machine
+     * below found nothing to run and spun all 16384 rounds for every vertex. On the Thor that was a
+     * GPU hang the driver had to recover (kgsl "GPU hang detected", 0.3-1 s frozen frames; 9 in the
+     * owner's 2026-11-16 session). Such a destination now ends the program (_pc = -1). */
+    int prog_len = RSX_VP_MAX_INSTR;
+    {
+        u32 o2 = 0; int k = 0;
+        while (o2 + 16 <= max_bytes && k < RSX_VP_MAX_INSTR) {
+            const u32 e0 = rd_le(ucode + o2), e1 = rd_le(ucode + o2 + 4);
+            const u32 e2 = rd_le(ucode + o2 + 8), e3 = rd_le(ucode + o2 + 12);
+            const u32 so = (e1 >> 27) & 0x1F;
+            if (vp_is_flow(so)) {
+                has_flow = 1;
+                const u32 t = vp_branch_target(e0, e2, e3);
+                if (t < RSX_VP_MAX_INSTR) leader[t] = 1;
+                leader[k + 1] = 1;
+            }
+            k++; o2 += 16;
+            if (e3 & 1u) break;
+        }
+        leader[0] = 1;
+        prog_len = k;
+    }
+    /* v121-android.59: which instructions can run, following only branches that can be taken
+     * (cond 0 never, a BRB/CLB whose branch bit disagrees never; cond 7 with the bit agreeing
+     * always). A Crack in Time's 544-slot uber programs loop only in paths their branch bits
+     * switch off; without a reachable backward branch or call they run in one pass. */
+    static u8 reach[RSX_VP_MAX_INSTR + 1];
+    memset(reach, 0, sizeof reach);
+    if (has_flow) {
+        static int stack[RSX_VP_MAX_INSTR + 1];
+        int sp = 0;
+        stack[sp++] = 0; reach[0] = 1;
+        while (sp > 0) {
+            const int i = stack[--sp];
+            if (i < 0 || i >= prog_len) continue;
+            const u8* p = ucode + (u32)i * 16u;
+            const u32 e0 = rd_le(p), e1 = rd_le(p + 4), e2 = rd_le(p + 8), e3 = rd_le(p + 12);
+            const u32 so = (e1 >> 27) & 0x1F;
+            int succ[2], ns = 0;
+            if (vp_is_flow(so)) {
+                const u32 cnd = (e0 >> 10) & 7;
+                int can = cnd != 0, must = cnd == 7;
+                if (so == 0x11 || so == 0x12) {
+                    const u32 bi_ = (e3 >> 23) & 31u, want_ = (e3 >> 28) & 1u;
+                    if (((rsx_vp_branch_bits >> bi_) & 1u) != want_) can = must = 0;
+                }
+                const int t = (int)vp_branch_target(e0, e2, e3);
+                if (can) {
+                    if (so == 0x0A || so == 0x0B || so == 0x0C || so == 0x12) flow_call = 1;
+                    else if (t <= i) flow_back = 1;
+                    if (t < prog_len) succ[ns++] = t;
+                }
+                if (!must && !(e3 & 1u)) succ[ns++] = i + 1;
+                if (so == 0x0C && can) { /* RET: the caller's next instruction; the loop handles it */ }
+            } else if (!(e3 & 1u)) succ[ns++] = i + 1;
+            for (int s = 0; s < ns; s++)
+                if (succ[s] < prog_len && !reach[succ[s]]) { reach[succ[s]] = 1; stack[sp++] = succ[s]; }
+        }
+    }
+    rsx_vp_last_loops = has_flow && (flow_back || flow_call);
+    /* Which DP3/DPH/DP4 need the exact (Dot2) form. The exactness is there
+     * for the position: depth z-fought where world coordinates are large (see
+     * vp_dot4). A dot that never reaches o[0] -- lighting, texture
+     * coordinates, colours -- gets the plain sum of the same products (0*x
+     * rule kept), about a tenth of the work. A backward slice from the writes
+     * to o[0] over the temps; programs with flow control or condition codes
+     * keep the exact form everywhere. On by default on Apple only (measured
+     * there); elsewhere RSX_VP_EXACT_DOTS=0 turns it on -- off, the shader
+     * text is exactly what it was, so no shader cache is invalidated.
+     * RSX_VP_EXACT_DOTS=1 keeps the exact form everywhere on Apple too. */
+    static u8 exact_dot[RSX_VP_MAX_INSTR + 1];
+    memset(exact_dot, 1, sizeof exact_dot);
+    {
+        const int all_exact = vp_all_exact_dots();
+        u32 rd[RSX_VP_MAX_INSTR][2], vt[RSX_VP_MAX_INSTR], st[RSX_VP_MAX_INSTR];
+        u8 vpos[RSX_VP_MAX_INSTR], spos[RSX_VP_MAX_INSTR], vfull[RSX_VP_MAX_INSTR], sfull[RSX_VP_MAX_INSTR];
+        int n = 0, simple = !has_flow && !all_exact, sees_pos = 0;
+        u32 o2 = 0;
+        while (simple && o2 + 16 <= max_bytes && n < RSX_VP_MAX_INSTR) {
+            const u32 e0 = rd_le(ucode + o2), e1 = rd_le(ucode + o2 + 4);
+            const u32 e2 = rd_le(ucode + o2 + 8), e3 = rd_le(ucode + o2 + 12);
+            o2 += 16;
+            if (((e0 >> 13) & 1) || ((e0 >> 14) & 1)) { simple = 0; break; }   /* CC test / update */
+            const u32 vop = (e1 >> 22) & 0x1F, sop = (e1 >> 27) & 0x1F;
+            const int vm = (e3 >> 13) & 0xF, sm = (e3 >> 17) & 0xF;
+            const u32 sr0 = ((e2 >> 23) & 0x1FF) | ((e1 & 0xFF) << 9), sr1 = (e2 >> 6) & 0x1FFFF;
+            const u32 sr2 = ((e3 >> 21) & 0x7FF) | ((e2 & 0x3F) << 11);
+            const u32 dout = (e3 >> 2) & 0x1F, dtmp = (e0 >> 15) & 0x3F, stmp = (e3 >> 7) & 0x3F;
+            const int vres = (e0 >> 30) & 1;
+            #define TMPBIT(sr) ((((sr) & 3u) <= 1u) ? (1u << (((sr) >> 2) & 31u)) : 0u)
+            const int von = vm && vop != 0, son = sm && sop != 0;
+            rd[n][0] = von ? (TMPBIT(sr0) | TMPBIT(sr1) | TMPBIT(sr2)) : 0u;
+            rd[n][1] = son ? TMPBIT(sr2) : 0u;
+            #undef TMPBIT
+            vt[n] = (von && dtmp != 0x3F) ? (dtmp & 31u) : 32u;
+            st[n] = (son && stmp != 0x3F) ? (stmp & 31u) : 32u;
+            vpos[n] = von && vres && dout != 0x1F && (dout & 15u) == 0;
+            spos[n] = son && !vres && dout != 0x1F && (dout & 15u) == 0;
+            vfull[n] = vm == 0xF; sfull[n] = sm == 0xF;
+            sees_pos |= vpos[n] | spos[n];
+            n++;
+            if (e3 & 1u) break;
+        }
+        if (vp_plain_dots()) memset(exact_dot, 0, sizeof exact_dot);
+        if (!vp_plain_dots() && simple && sees_pos) {
+            u32 need = 0;
+            for (int i = n - 1; i >= 0; i--) {
+                const int vneed = vpos[i] || (vt[i] < 32u && ((need >> vt[i]) & 1u));
+                const int sneed = spos[i] || (st[i] < 32u && ((need >> st[i]) & 1u));
+                exact_dot[i] = (u8)vneed;
+                if (vt[i] < 32u && vfull[i]) need &= ~(1u << vt[i]);
+                if (st[i] < 32u && sfull[i] && st[i] != vt[i]) need &= ~(1u << st[i]);
+                if (vneed) need |= rd[i][0];
+                if (sneed) need |= rd[i][1];
+            }
+        }
+    }
+    int block_open = 0;
+    /* RSX_VP_SINGLE_PASS: the reachability pass below (one pass, dead blocks cut). Off in .61-.65
+     * (GPU-neutral in Space Sector 3, no fight); ON again by default from v121-android.66 (0.1.0): in
+     * the Fongoid battle (out/thor_ab_20261108 run.sh) the looping form gave 4-7 kgsl "GPU hang
+     * detected" a minute -- the combat full stalls, 0.35-0.55 s each, the owner's Agorian Arena
+     * fights had 9-13 -- and this form 0 (h65_single). RACACIT_GPU_EXP=1 (3 vertices a draw) also
+     * gave 0 and EXP=2 (no pixels) 7: vertex work, the 544-slot uber programs' block loop.
+     * RSX_VP_SINGLE_PASS=0 = the looping form for every branching program. */
+    static int single_env = -1;
+    if (single_env < 0) { const char* e = getenv("RSX_VP_SINGLE_PASS"); single_env = !(e && *e == '0'); }
+    const int single = has_flow && single_env && !flow_back && !flow_call;
+    /* A block nothing can reach is cut from the text (dead_from: where it began); not with
+     * calls, whose returns the reachability walk does not follow. */
+    long dead_from = -1;
+
+    u32 off = 0; int instrs = 0;
+    while (off + 16 <= max_bytes) {
+        u32 d0 = rd_le(ucode+off+0), d1 = rd_le(ucode+off+4);
+        u32 d2 = rd_le(ucode+off+8), d3 = rd_le(ucode+off+12);
+        if (has_flow && instrs < RSX_VP_MAX_INSTR && leader[instrs]) {
+            char line[64];
+            if (block_open) {
+                snprintf(line, sizeof line, "        _pc = %d;\n    }\n", instrs);
+                emit(&b, line);
+            }
+            if (dead_from >= 0) { b.len = (u32)dead_from; b.p[b.len] = '\0'; dead_from = -1; }
+            if (single_env && !flow_call && !reach[instrs]) dead_from = (long)b.len;
+            snprintf(line, sizeof line, "    if (_pc == %d) {\n", instrs);
+            emit(&b, line);
+            block_open = 1;
+        }
+        off += 16; instrs++;
+
+        u32 vec_op = (d1 >> 22) & 0x1F;
+        u32 sca_op = (d1 >> 27) & 0x1F;
+        u32 input_src = (d1 >> 8) & 0xF;
+        u32 const_src = (d1 >> 12) & 0x3FF;
+        int index_const = (d3 >> 1) & 1;
+
+        /* assemble the three 17-bit source fields */
+        u32 src0 = ((d2 >> 23) & 0x1FF) | ((d1 & 0xFF) << 9);
+        u32 src1 = (d2 >> 6) & 0x1FFFF;
+        u32 src2 = ((d3 >> 21) & 0x7FF) | ((d2 & 0x3F) << 11);
+        int a0 = (d0 >> 21) & 1, a1 = (d0 >> 22) & 1, a2 = (d0 >> 23) & 1;
+        u32 addr_sel = (d0 >> 24) & 1;
+        u32 addr_swz = d0 & 3;
+        int saturate = (d0 >> 26) & 1;
+        int cond_test = (d0 >> 13) & 1;
+        u32 cond = (d0 >> 10) & 7;
+
+        char A[96], B[96], C[96];
+        emit_src(src0, a0, input_src, const_src, index_const, addr_sel, addr_swz, A, sizeof(A));
+        emit_src(src1, a1, input_src, const_src, index_const, addr_sel, addr_swz, B, sizeof(B));
+        emit_src(src2, a2, input_src, const_src, index_const, addr_sel, addr_swz, C, sizeof(C));
+
+        u32 dst_tmp     = (d0 >> 15) & 0x3F;
+        u32 dst_out     = (d3 >> 2) & 0x1F;
+        u32 sca_dst_tmp = (d3 >> 7) & 0x3F;
+        int vec_result  = (d0 >> 30) & 1;
+
