+        if (id < 0 || id >= TR_MAX || (s_set.n && id >= s_set.n)) continue;
+        if (!s_set.unlocked[id] || (t > 0 && t < s_set.when[id])) {
+            if (!s_set.unlocked[id]) got++;
+            s_set.unlocked[id] = 1;
+            s_set.when[id] = t > 0 ? t : 1;
