+/* Only after all slots have completed, or while unwinding an unused heap. */
+static void vk_geo_shutdown(void)
+{
+    vk_destroy_buffer_now(&s_geo_heap);
+    for (u32 c = 0; c < VK_GEO_CLASSES; c++) {
+        free(s_geo_bits[c]); s_geo_bits[c] = NULL;
+    }
+    memset(s_geo_nfree, 0, sizeof s_geo_nfree);
+    memset(s_geo_hint, 0, sizeof s_geo_hint);
+    memset(s_geo, 0, sizeof s_geo);
+    memset(s_geo_hstk, 0, sizeof s_geo_hstk);
+    s_geo_top = 0; s_geo_nh = 1; s_geo_nhstk = 0; s_geo_state = 0;
