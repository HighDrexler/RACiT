+/* Only after device idle: all queued acquire waits have finished. Separately
+ * finish the acquire fences before destroying them (their signal is later). */
+static int vk_present_drop_acquire(void)
+{
+    for (u32 i = 0; i < VK_BT_SLOTS; i++)
+        if (vk_present_wait_acquire(s_bt.s[i].acquire_done, &s_bt.s[i].acquire_pending)) return -1;
+    if (vk_present_wait_acquire(s_vk.acquire_done, &s_vk.acquire_pending)) return -1;
+    for (u32 i = 0; i < VK_BT_SLOTS; i++) {
+        if (s_bt.s[i].acquire) pvkDestroySemaphore(s_vk.device, s_bt.s[i].acquire, NULL);
+        if (s_bt.s[i].acquire_done) pvkDestroyFence(s_vk.device, s_bt.s[i].acquire_done, NULL);
+        s_bt.s[i].acquire = VK_NULL_HANDLE;
+        s_bt.s[i].acquire_done = VK_NULL_HANDLE;
+    }
+    if (s_vk.acquire_done) pvkDestroyFence(s_vk.device, s_vk.acquire_done, NULL);
+    s_vk.acquire_done = VK_NULL_HANDLE;
