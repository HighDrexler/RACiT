+static void vk_geo_give(VkDeviceSize off, u32 cls)
+{
+    u64 idx = off >> VK_GEO_SHIFT(cls);
+    while (cls + 1u < VK_GEO_CLASSES && vk_geo_bit(cls, idx ^ 1u)) {
