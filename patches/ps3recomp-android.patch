diff --git a/libs/video/tests/test_rsx_texture_decode_fast.c b/libs/video/tests/test_rsx_texture_decode_fast.c
new file mode 100644
index 0000000..46d417c
--- /dev/null
+++ b/libs/video/tests/test_rsx_texture_decode_fast.c
@@ -0,0 +1,53 @@
+/* rsx_texture_decode_fast must give byte-for-byte what rsx_texture_decode_slow
+ * (the texel-by-texel reference) gives: every uncompressed format byte the
+ * layout code knows, swizzled and linear, square and non-square, both channel
+ * orders. Build: zig cc -O2 -I.. -I../../../include test_rsx_texture_decode_fast.c
+ * ../rsx_texture_layout.c */
+#include "rsx_texture_layout.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static u32 s_rng = 0x12345678u;
+static u32 rnd(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 17; s_rng ^= s_rng << 5; return s_rng; }
+
+int main(void)
+{
+    static const u32 sizes[][2] = { {1,1}, {2,8}, {8,2}, {4,4}, {16,16}, {64,32}, {32,64}, {128,4},
+                                    {4,128}, {256,256}, {1024,512}, {13,7}, {640,360}, {2048,2048} };
+    long checked = 0, failed = 0, skipped = 0;
+    for (u32 fmt = 0x80; fmt <= 0xBF; fmt++) {
+        for (size_t si = 0; si < sizeof sizes / sizeof sizes[0]; si++) {
+            const u32 w = sizes[si][0], h = sizes[si][1];
+            rsx_tex_layout tl;
+            memset(&tl, 0, sizeof tl);
+            rsx_texture_layout_pitched(fmt, w, h, 0, &tl);
+            if (tl.compressed || !tl.bytes_per_texel || !tl.dst_bytes_per_texel || !tl.row_bytes) { skipped++; continue; }
+            /* A swizzled layout needs power-of-two sides (the hardware's rule). */
+            if (tl.swizzled && ((w & (w - 1u)) || (h & (h - 1u)))) { skipped++; continue; }
+            const size_t sbytes = tl.swizzled ? (size_t)(1u << rsx_log2_ceil(w)) * (1u << rsx_log2_ceil(h)) * tl.bytes_per_texel
+                                              : (size_t)tl.row_bytes * h;
+            u8* src = (u8*)malloc(sbytes + 16);
+            for (size_t i = 0; i < sbytes + 16; i++) src[i] = (u8)rnd();
+            const u32 pitch = tl.dst_row_bytes ? tl.dst_row_bytes : w * tl.dst_bytes_per_texel;
+            const size_t dbytes = (size_t)pitch * h;
+            u8* a = (u8*)malloc(dbytes); u8* b = (u8*)malloc(dbytes);
+            for (int order = 0; order < 2; order++) {
+                memset(a, 0xCD, dbytes); memset(b, 0xCD, dbytes);
+                rsx_texture_decode_slow(a, pitch, src, w, h, &tl, order);
+                rsx_texture_decode_fast(b, pitch, src, w, h, &tl, order);
+                checked++;
+                if (memcmp(a, b, dbytes)) {
+                    failed++;
+                    size_t k = 0; while (k < dbytes && a[k] == b[k]) k++;
+                    printf("MISMATCH fmt 0x%02X (base 0x%02X, %s) %ux%u order %d at byte %zu: %02X vs %02X\n",
+                           fmt, tl.base_format, tl.swizzled ? "swizzled" : "linear", w, h, order, k, a[k], b[k]);
+                }
+            }
+            free(a); free(b); free(src);
+        }
+    }
+    printf("decode fast vs slow: %ld cases, %ld mismatches (%ld skipped: compressed/unknown/non-pow2 swizzled)\n",
+           checked, failed, skipped);
+    return failed ? 1 : 0;
+}
diff --git a/libs/video/tests/test_vertex_fetch_fast.c b/libs/video/tests/test_vertex_fetch_fast.c
new file mode 100644
index 0000000..c4c791c
--- /dev/null
+++ b/libs/video/tests/test_vertex_fetch_fast.c
@@ -0,0 +1,100 @@
+/*
+ * rsx_vertex_fetch_many, byte for byte against the loop it replaced (v113-android.36: the
+ * per-vertex format switch decided once per attribute).
+ *
+ * The old implementation is compiled in from a copy of the file as it was (-DOLD_IMPL=<path>,
+ * every exported function renamed old_*), the new one from rsx_vertex_compact.c. Random plans --
+ * every format, component counts 0-4, frequencies 0-5 with both divider rules, spans that leave
+ * some elements outside (the guest_ptr path, failing on purpose for some elements and for
+ * attribute 0) -- and random references, decoded by both; outputs and return codes must match.
+ * Inputs are random bytes, so NaNs, infinities and denormals are all in it.
+ *
+ * Build and run (host, any C compiler; zig cc on the build PC):
+ *   zig cc -O2 -std=gnu17 -I include -I libs/video -DOLD_IMPL="\"<old copy>\"" \
+ *       -o test_vertex_fetch_fast.exe libs/video/tests/test_vertex_fetch_fast.c \
+ *       libs/video/tests/vertex_fetch_old_wrap.c libs/video/rsx_vertex_compact.c
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "rsx_vertex_compact.h"
+
+int old_rsx_vertex_fetch_many(const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs, u32 count, u8* out);
+
+/* What the plan set-up reaches in rsx_dispatch.c; the test fills plans by hand. */
+u32 rsx_dsp_vertex_data_base_offset(const rsx_dispatch* rsx) { (void)rsx; return 0; }
+u32 rsx_dsp_vertex_data_base_index(const rsx_dispatch* rsx) { (void)rsx; return 0; }
+void rsx_dsp_get_vertex_attr(const rsx_dispatch* rsx, u32 index, rsx_dsp_vertex_attr* out) { (void)rsx; (void)index; memset(out, 0, sizeof *out); }
+void rsx_dsp_vertex_default(const rsx_dispatch* rsx, u32 index, float out[4]) { (void)rsx; (void)index; out[0] = out[1] = out[2] = 0; out[3] = 1; }
+
+static u8 g_mem[1u << 20];
+static u32 g_fail_mod;   /* guest_ptr refuses offsets that are a multiple of this (0 = never) */
+static const u8* guest_ptr(void* user, u32 location, u32 offset, u32 min_bytes)
+{
+    (void)user; (void)location;
+    if (g_fail_mod && offset % g_fail_mod == 0) return NULL;
+    if ((u64)offset + min_bytes > sizeof g_mem) return NULL;
+    return g_mem + offset;
+}
+static u32 rng_state = 12345u;
+static u32 rnd(void) { rng_state ^= rng_state << 13; rng_state ^= rng_state >> 17; rng_state ^= rng_state << 5; return rng_state; }
+
+int main(void)
+{
+    for (size_t i = 0; i < sizeof g_mem; i++) g_mem[i] = (u8)rnd();
+    static const u32 types[] = { 0, 1, 2, 3, 4, 5, 6, 7, 8 };
+    static const u32 tsize[] = { 4, 2, 4, 2, 1, 2, 4, 1, 4 };
+    long cases = 0, fails = 0, rc_mismatch = 0, slow_paths = 0;
+    enum { MAXV = 300 };
+    static rsx_vertex_ref refs[MAXV];
+    static u8 out_old[MAXV * 16 * 16], out_new[MAXV * 16 * 16];
+    for (int iter = 0; iter < 20000; iter++) {
+        rsx_vertex_fetch_plan plan; memset(&plan, 0, sizeof plan);
+        const u32 nslots = 1 + rnd() % 6;
+        plan.layout.count = (u8)nslots;
+        plan.layout.stride = 16u * nslots + (rnd() % 3) * 16u;
+        plan.base_offset = rnd() % 4096;
+        plan.divider_mask = rnd() & 0xFFFFu;
+        plan.guest_ptr = (rnd() % 8) ? guest_ptr : NULL;
+        g_fail_mod = (rnd() % 4 == 0) ? 3 + rnd() % 40 : 0;
+        for (u32 s = 0; s < nslots; s++) {
+            const u32 attr = (s == 0 && rnd() % 2) ? 0 : rnd() % RSX_DSP_NUM_VERTEX_ATTR;
+            plan.layout.attrs[s] = (u8)attr;
+            rsx_vertex_fetch_attr* f = &plan.attr[attr];
+            const u32 ti = rnd() % 9;
+            f->desc.type = types[ti];
+            f->desc.size = rnd() % 5;
+            f->desc.frequency = rnd() % 6;
+            f->desc.offset = rnd() % 8192;
+            f->desc.location = rnd() % 2;
+            f->elem_size = tsize[ti] * (f->desc.size ? f->desc.size : 1);
+            f->stride = f->elem_size + (rnd() % 3) * 4;
+            f->desc.stride = f->stride;
+            for (int c = 0; c < 4; c++) { u32 w = rnd(); memcpy(&f->default_value[c], &w, 4); }
+            f->stable_first = rnd() % 64;
+            f->stable_last = f->stable_first + rnd() % 200;
+            const u32 at = plan.base_offset + f->desc.offset + f->stable_first * f->stride;
+            f->stable_base = (rnd() % 10 && (u64)at + (u64)(f->stable_last - f->stable_first + 1) * f->stride < sizeof g_mem)
+                ? g_mem + at : NULL;
+        }
+        const u32 count = rnd() % MAXV;
+        for (u32 i = 0; i < count; i++) {
+            refs[i].vertex_id = rnd() % 300;
+            refs[i].base_index = (rnd() % 4 == 0) ? (rnd() & 0x1FFFFFu) : rnd() % 8;
+        }
+        memset(out_old, 0xA5, sizeof out_old); memset(out_new, 0xA5, sizeof out_new);
+        const int a = old_rsx_vertex_fetch_many(&plan, refs, count, out_old);
+        const int b = rsx_vertex_fetch_many(&plan, refs, count, out_new);
+        cases++;
+        if (a != b) { rc_mismatch++; if (rc_mismatch < 5) printf("  return code differs: iter %d old %d new %d\n", iter, a, b); continue; }
+        if (g_fail_mod) slow_paths++;
+        /* Equal outputs only matter where the call succeeded: on failure the caller drops them. */
+        if (a && memcmp(out_old, out_new, (size_t)count * plan.layout.stride)) {
+            fails++;
+            if (fails < 5) printf("  output differs: iter %d (%u refs, %u slots)\n", iter, count, nslots);
+        }
+    }
+    printf("vertex fetch: %ld cases (%ld with refused reads), %ld return-code mismatches, %ld output mismatches\n",
+           cases, slow_paths, rc_mismatch, fails);
+    return (fails || rc_mismatch) ? 1 : 0;
+}
diff --git a/libs/video/tests/test_ww_mapcount.c b/libs/video/tests/test_ww_mapcount.c
new file mode 100644
index 0000000..5582fed
--- /dev/null
+++ b/libs/video/tests/test_ww_mapcount.c
@@ -0,0 +1,95 @@
+/*
+ * rsx_writewatch.c on Linux (v113-android.37): the mapping-count estimate ww_tick now uses in
+ * place of reading /proc/self/maps every 5 s -- the last real count plus twice the read-only runs
+ * (ww_ro_runs) -- must never be below the real count, whatever the write watch has armed since;
+ * and ww_ro_runs must count runs exactly. Real pages are armed with the file's own ww_arm_run
+ * (mprotect), the real count is the file's own ww_mappings.
+ *
+ * Runs on the device (needs a Linux kernel):
+ *   clang --target=aarch64-linux-android29 -O2 -std=gnu17 -I tools/ps3recomp/libs/video
+ *       -o test_ww_mapcount tools/ps3recomp/libs/video/tests/test_ww_mapcount.c
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+uint8_t* vm_base;
+#include "../rsx_writewatch.c"
+
+static unsigned rng = 0x9E3779B9u;
+static unsigned rnd(void) { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+static int fails;
+
+/* Arm [i0, i1) the way the readers do: take the pages (PG_BUSY), then ww_arm_run. */
+static void arm(int i0, int i1)
+{
+    for (int i = i0; i < i1; i++) atomic_store(&s_state[i], PG_BUSY);
+    ww_arm_run(i0, i1, atomic_load(&s_epoch), ww_ms());
+}
+/* Runs counted the slow way, from the states. */
+static unsigned slow_runs(void)
+{
+    unsigned r = 0;
+    for (unsigned i = 0; i < s_npages; i++) {
+        const int ro = s_state[i] != PG_OPEN && s_state[i] != PG_PROT_OPEN;
+        const int prev = (i % s_range_pages) && s_state[i - 1] != PG_OPEN && s_state[i - 1] != PG_PROT_OPEN;
+        r += ro && !prev;
+    }
+    return r;
+}
+
+int main(void)
+{
+    vm_base = (uint8_t*)mmap(NULL, 0x100000000ull, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (vm_base == MAP_FAILED) { printf("cannot reserve 4 GB\n"); return 2; }
+    /* The three pieces the write watch covers, committed as the game's are (64 MB of each). */
+    mprotect(vm_base + 0x20000000u, 64u << 20, PROT_READ | PROT_WRITE);
+    mprotect(vm_base + 0x40000000u, 64u << 20, PROT_READ | PROT_WRITE);
+    mprotect(vm_base + 0xC0000000u, 64u << 20, PROT_READ | PROT_WRITE);
+    if (!rsx_ww_on()) { printf("write watch did not start\n"); return 2; }
+    const unsigned base = ww_mappings();
+    const unsigned committed = (64u << 20) >> s_page_shift;
+    printf("host page %u, %u pages a piece, %u mappings before arming\n", s_page_size, s_range_pages, base);
+    unsigned worst_slack = ~0u, rounds = 0;
+    for (int round = 0; round < 12; round++) {
+        /* Arm a batch of random runs inside the committed parts (some touching, some at a piece's start). */
+        const int batch = 200 + (int)(rnd() % 1200);
+        for (int k = 0; k < batch; k++) {
+            const unsigned piece = rnd() % 3, len = 1 + rnd() % 6;
+            const unsigned start = (rnd() % 5 == 0) ? 0 : rnd() % (committed - len);
+            const int i0 = (int)(piece * s_range_pages + start);
+            int ok = 1;
+            for (int i = i0; i < i0 + (int)len; i++) ok &= s_state[i] == PG_OPEN;
+            if (ok) arm(i0, i0 + (int)len);
+        }
+        /* And open some again, the way a fault does (ww_open + its 64 KB group). */
+        for (int k = 0; k < batch / 3; k++) {
+            const int i = (int)((rnd() % 3) * s_range_pages + rnd() % committed);
+            if (s_state[i] == PG_ARMED && ww_open(i, 1) > 0) ww_open_group(i);
+        }
+        const unsigned runs = ww_ro_runs(), slow = slow_runs(), real = ww_mappings(), est = base + 2u * runs;
+        if (runs != slow) { fails++; printf("  FAIL round %d: ww_ro_runs %u, counted %u\n", round, runs, slow); }
+        if (est < real) { fails++; printf("  FAIL round %d: estimate %u below the real count %u\n", round, est, real); }
+        if (est - real < worst_slack) worst_slack = est - real;
+        printf("  round %2d: %5u runs, real %5u mappings, estimate %5u\n", round, runs, real, est);
+        rounds++;
+    }
+    /* Planted fault: a read-only page the states do not know about must make a real count exceed the estimate,
+     * i.e. the check above can fail. */
+    mprotect(vm_base + 0x20000000u + (32u << 20) + s_page_size, s_page_size, PROT_READ);
+    mprotect(vm_base + 0x20000000u + (33u << 20) + s_page_size, s_page_size, PROT_READ);
+    {
+        const unsigned runs = ww_ro_runs(), real = ww_mappings();
+        printf("  planted: 2 untracked read-only pages -> real %u, estimate %u (%s)\n", real, base + 2u * runs,
+               base + 2u * runs < real ? "caught" : "not caught: estimate already above by slack");
+    }
+    /* Timing: the old per-tick cost against the new one. */
+    struct timespec a, b;
+    clock_gettime(CLOCK_MONOTONIC, &a); unsigned r1 = ww_mappings(); clock_gettime(CLOCK_MONOTONIC, &b);
+    const double t_old = (b.tv_sec - a.tv_sec) * 1e3 + (b.tv_nsec - a.tv_nsec) / 1e6;
+    clock_gettime(CLOCK_MONOTONIC, &a); unsigned r2 = ww_ro_runs(); clock_gettime(CLOCK_MONOTONIC, &b);
+    const double t_new = (b.tv_sec - a.tv_sec) * 1e3 + (b.tv_nsec - a.tv_nsec) / 1e6;
+    printf("per 5 s tick: maps read %.2f ms (%u lines), state pass %.3f ms (%u runs)\n", t_old, r1, t_new, r2);
+    printf("ww map count: %u rounds, %d failures, closest the estimate came to the real count: %u\n", rounds, fails, worst_slack);
+    return fails ? 1 : 0;
+}
