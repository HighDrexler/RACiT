diff --git a/libs/video/vulkan/rsx_vk_d24.comp b/libs/video/vulkan/rsx_vk_d24.comp
new file mode 100644
index 0000000..c02465d
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_d24.comp
@@ -0,0 +1,17 @@
+#version 450
+
+// VkBufferImageCopy places D24 in the low 24 bits of each 32-bit word;
+// the upper eight bits are undefined. Convert in place before the buffer
+// is copied into R32_SFLOAT, retaining the existing shadow sampling path.
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+layout(set = 0, binding = 0, std430) buffer Depth { uint words[]; } depth;
+layout(push_constant) uniform Extent { uint width; uint height; } extent;
+
+void main()
+{
+    uvec2 p = gl_GlobalInvocationID.xy;
+    if (p.x >= extent.width || p.y >= extent.height) return;
+    uint i = p.y * extent.width + p.x;
+    float z = float(depth.words[i] & 0x00ffffffu) / 16777215.0;
+    depth.words[i] = floatBitsToUint(z);
+}
