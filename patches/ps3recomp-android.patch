-        &IID_ID3D12Debug, (void**)&debug);
-    if (FAILED(hr) || !debug) {
-        fprintf(stderr,
-                "[d3d-debug] validation layer unavailable hr=0x%08lX\n",
-                (unsigned long)hr);
-        return;
-    }
-    debug->lpVtbl->EnableDebugLayer(debug);
