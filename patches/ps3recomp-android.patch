--- a/runtime/platform/win32_compat.h
+++ b/runtime/platform/win32_compat.h
@@ -522,7 +522,14 @@ typedef void*  CONDITION_VARIABLE;
 typedef CONDITION_VARIABLE* PCONDITION_VARIABLE;
