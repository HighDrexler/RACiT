+    const uintptr_t e = ((uintptr_t)p + len) & ~(uintptr_t)4095u;
+    if (e <= a) return 0;
+    return rsx_ww_watched((const void*)a, (unsigned)(e - a)) &&
+           rsx_ww_guest_written_since((const void*)a, (unsigned)(e - a), epoch);
