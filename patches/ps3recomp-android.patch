+static volatile int s_lock_v;
+static void tlock(void)   { while (__atomic_exchange_n(&s_lock_v, 1, __ATOMIC_ACQUIRE)) { } }
+static void tunlock(void) { __atomic_store_n(&s_lock_v, 0, __ATOMIC_RELEASE); }
