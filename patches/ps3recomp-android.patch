+{
+#if defined(__aarch64__)
+    { unsigned long long f; __asm__ __volatile__("mrs %0, cntfrq_el0" : "=r"(f)); s_jt_hz = f ? f : 1; }
+#else
+    s_jt_hz = 1000000ull;
