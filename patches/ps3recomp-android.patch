+
+/* ---------------------------------------------------------------------------
+ * Mixing
+ * -----------------------------------------------------------------------*/
+
+/* Guest PCM is BIG-ENDIAN float32; the port buffer is a raw vm_base view, so
+ * every sample must be byte-swapped before use. Reading it as a host float
+ * turned the whole mix into denormal noise -- silence after clipping (LBP
+ * had a verified end-to-end pipeline with no audible output). */
+static inline float ld_be_f32(const float* p)
+{
+    u32 v;
+    memcpy(&v, p, 4);
+    v = (v >> 24) | ((v >> 8) & 0xFF00u) | ((v << 8) & 0xFF0000u) | (v << 24);
+    float f;
+    memcpy(&f, &v, 4);
+    return f;
+}
+
+/* Host monotonic microseconds -- the same epoch as sys_time_get_system_time
+ * and the PPU timebase (CLOCK_MONOTONIC / QPC from the guest clock origin,
+ * sys_timer.c). */
+#ifdef _WIN32
+extern uint64_t ps3_guest_clock_epoch_qpc(void);
+#else
+extern uint64_t ps3_guest_clock_epoch_ns(void);
+#endif
+static u64 audio_now_us(void)
+{
+#ifdef _WIN32
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    const u64 q = (u64)c.QuadPart - ps3_guest_clock_epoch_qpc();
+    return (q / (u64)f.QuadPart) * 1000000ULL +
+           (q % (u64)f.QuadPart) * 1000000ULL / (u64)f.QuadPart;
+#else
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ((u64)ts.tv_sec * 1000000000ULL + (u64)ts.tv_nsec - ps3_guest_clock_epoch_ns()) / 1000ULL;
+#endif
+}
+
+/* Mix one block from all active ports into s_mix_buffer (stereo float) */
+static void audio_mix_one_block(void)
+{
+    memset(s_mix_buffer, 0, sizeof(s_mix_buffer));
+#if AUDIO_BACKEND_SDL2
+    memset(s_ds_buffer, 0, sizeof(s_ds_buffer));
+    memset(s_ds_hbuffer, 0, sizeof(s_ds_hbuffer));
+#endif
+
+    mutex_lock(&s_audio_mutex);
+
+    for (int p = 0; p < CELL_AUDIO_PORT_MAX; p++) {
+        AudioPortSlot* port = &s_ports[p];
+        /* Diagnostic: a port that HOLDS PCM but was never started is inaudible
+         * by design -- flag it once so "no PortStart" vs "no data" is decidable
+         * from the log (LBP's Bink movie audio port sat exactly there). */
+        if (port->in_use && !port->running && port->buffer) {
+            static u8 warned[CELL_AUDIO_PORT_MAX];
+            if (!warned[p]) {
+                u32 probe = (u32)(port->param.nBlock * CELL_AUDIO_BLOCK_SAMPLES *
+                                  port->param.nChannel);
+                int nz = 0;
+                for (u32 s = 0; s < probe; s += 64) if (port->buffer[s] != 0.0f) { nz = 1; break; }
+                if (nz) {
+                    warned[p] = 1;
+                    fprintf(stderr, "[cellAudio] port %d HAS DATA but never started"
+                            " -- game withheld PortStart\n", p);
+                }
+            }
+        }
+        if (!port->in_use || !port->running || !port->buffer)
+            continue;
+
+        u32 nch    = (u32)port->param.nChannel;
+        u32 nblock = (u32)port->param.nBlock;
+        float level = port->param.level;
+        if (level <= 0.0f) level = 1.0f;
+        if (level > 1.0f) level = 1.0f;
+
+        /* Read one block at the current read_index */
+        u32 block_idx = (u32)(port->read_index % nblock);
+        const int by_put = s_pub_mode && s_port_done_seen[p] && block_idx < 32;
+        if (by_put && !s_blk_done[p][block_idx]) continue;   /* the game has not finished it: nothing from this port */
+        u32 block_offset = block_idx * CELL_AUDIO_BLOCK_SAMPLES * nch;
+        float* src = port->buffer + block_offset;
+
+        /* AUDIO_PEAK diag: which blocks of this port's WHOLE ring hold data,
+         * vs which block the read cursor is on -- distinguishes "writer never
+         * writes" from "writer and reader cycle out of phase". */
+        /* AUDIO_PEAK=1: a ring map every 400 blocks. AUDIO_PEAK=<n> (n > 1):
+         * a map for EVERY block from mix #n for 96 blocks, with the host time,
+         * so the writer's position relative to the read cursor is visible. */
+        { static long s_pk = -1; if (s_pk < 0) { const char* e = getenv("AUDIO_PEAK"); s_pk = e ? atol(e) : 0; }
+          if (s_pk) { static _Thread_local unsigned _c; ++_c;
+            static long s_pkn = -1; if (s_pkn < 0) { const char* e2 = getenv("AUDIO_PEAK_N"); s_pkn = e2 ? atol(e2) : 96; }
+            if (s_pk > 1 ? (_c >= (unsigned long)s_pk && _c < (unsigned long)(s_pk + s_pkn)) : (_c % 400) == 0) {
+                char map[36]; u32 b;
+                for (b = 0; b < nblock && b < 32; b++) {
+                    const float* bp = port->buffer + b * CELL_AUDIO_BLOCK_SAMPLES * nch;
+                    int nz = 0;
+                    for (u32 s2 = 0; s2 < CELL_AUDIO_BLOCK_SAMPLES * nch; s2 += 16)
+                        if (bp[s2] != 0.0f) { nz = 1; break; }
+                    map[b] = nz ? '#' : '.';
+                }
+                map[b] = 0;
+                fprintf(stderr, "[audio-ring] t=%llu port %d ridx=%llu blk=%u ring=[%s]\n",
+                        (unsigned long long)audio_now_us(), p, (unsigned long long)port->read_index, block_idx, map);
+            } } }
+
+        for (u32 s = 0; s < CELL_AUDIO_BLOCK_SAMPLES; s++) {
+            float left, right;
+            if (nch >= 2) {
+                left  = ld_be_f32(&src[s * nch + 0]) * level;
+                right = ld_be_f32(&src[s * nch + 1]) * level;
+            } else {
+                /* Mono: duplicate to both channels */
+                left = right = ld_be_f32(&src[s]) * level;
+            }
+
+            /* If 7.1, mix center and other channels into stereo */
+            if (nch == 8) {
+                float center = ld_be_f32(&src[s * 8 + 2]) * level * 0.707f;
+                float lfe    = ld_be_f32(&src[s * 8 + 3]) * level * 0.5f;
+                float rl     = ld_be_f32(&src[s * 8 + 4]) * level * 0.5f;
+                float rr     = ld_be_f32(&src[s * 8 + 5]) * level * 0.5f;
+                float sl     = ld_be_f32(&src[s * 8 + 6]) * level * 0.3f;
+                float sr     = ld_be_f32(&src[s * 8 + 7]) * level * 0.3f;
+                left  += center + lfe + rl + sl;
+                right += center + lfe + rr + sr;
+            }
+
+            s_mix_buffer[s * 2 + 0] += left;
+            s_mix_buffer[s * 2 + 1] += right;
+        }
+
+        /* AUDIO_WAV8=<file>: port 0 as the game wrote it, raw f32le, all its
+         * channels (7.1: L R C LFE RL RR SL SR) -- which sounds sit where. */
+        if (p == 0) { static FILE* _w8 = (FILE*)-1;
+          if (_w8 == (FILE*)-1) { const char* e = getenv("AUDIO_WAV8"); _w8 = e ? fopen(e, "wb") : NULL; }
+          if (_w8) { float t[CELL_AUDIO_BLOCK_SAMPLES * 8];
+            const u32 n = CELL_AUDIO_BLOCK_SAMPLES * (nch > 8 ? 8 : nch);
+            for (u32 s2 = 0; s2 < n; s2++) t[s2] = ld_be_f32(&src[s2]);
+            fwrite(t, sizeof(float), n, _w8); g_racacit_wav8_blocks++; } }
+
+        /* Firmware clears a ring-buffer block after consuming it. Besides
+         * preventing stale PCM from replaying when a producer stalls, the
+         * cleared block is an observable consumption signal for producers. */
+        {
+            int nz = 0;
+            for (u32 s2 = 0; s2 < CELL_AUDIO_BLOCK_SAMPLES * nch; s2 += 7)
+                if (src[s2] != 0.0f) { nz = 1; break; }
+            s_port_sound[p] = (u8)nz;
+            if (p == 0) { g_audio_blocks++; g_audio_blocks_nz += nz; }
+        }
+        memset(src, 0, CELL_AUDIO_BLOCK_SAMPLES * nch * sizeof(float));
+        if (block_idx < 32) s_blk_done[p][block_idx] = 0;
+
+        /* Keep the monotonic counter for tags/timestamps, but publish the
+         * ring slot to the guest. SurMixer multiplies this value by the block
+         * size directly; an unbounded counter walks beyond the audio buffer. */
+        port->read_index++;
+        if (!by_put) {
+            port->pub_index = port->read_index;
+            if (port->read_idx_addr)
+                vm_write64((u32)port->read_idx_addr, port->pub_index % nblock);
+        }
+    }
+
+    mutex_unlock(&s_audio_mutex);
+
+    /* Clip to [-1.0, 1.0] */
+    for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
+        if (s_mix_buffer[i] > 1.0f) s_mix_buffer[i] = 1.0f;
+        if (s_mix_buffer[i] < -1.0f) s_mix_buffer[i] = -1.0f;
+    }
+
+    /* After a jump in the game's ring, the new block does not
+     * continue the last sample played: glide from that sample into it over
+     * 2 ms instead of a step (a click). */
+    if (s_splice) {
+        for (u32 i = 0; i < 96; i++) {
+            const float g = (float)i / 96.0f;
+            s_mix_buffer[i * 2]     = s_mix_buffer[i * 2] * g     + s_last_out[0] * (1.0f - g);
+            s_mix_buffer[i * 2 + 1] = s_mix_buffer[i * 2 + 1] * g + s_last_out[1] * (1.0f - g);
+        }
+        s_splice = 0;
+    }
+    s_last_out[0] = s_mix_buffer[(CELL_AUDIO_BLOCK_SAMPLES - 1) * 2];
+    s_last_out[1] = s_mix_buffer[(CELL_AUDIO_BLOCK_SAMPLES - 1) * 2 + 1];
+}
+
+/* The game writes each port block in four SPU PUTs: three scratch passes of
+ * its synth buses (planar, not audio yet), then the finished interleaved block
+ * from LS 0x12000. Reading a block between them played the scratch data --
+ * clicks at 32-sample steps when the game ran late. Once a port has had such a
+ * final PUT, a block counts as written only after its own; a port the game
+ * fills some other way falls back to "not empty". */
+static void audio_put_hook(uint32_t ea, uint32_t lsa, uint32_t size)
+{
+    if (lsa != 0x12000u) return;
+    for (int p = 0; p < CELL_AUDIO_PORT_MAX; p++) {
+        const AudioPortSlot* port = &s_ports[p];
+        if (!port->in_use || !port->port_addr) continue;
+        const u32 base = (u32)port->port_addr, bb = CELL_AUDIO_BLOCK_SAMPLES * (u32)port->param.nChannel * 4u;
+        if (ea < base || ea >= base + port->buf_size || size != bb) continue;
+        const u32 blk = (ea - base) / bb;
+        if (blk < 32) {
+            s_finished[p]++;
+#if defined(_WIN32) || defined(AUDIO_LINUX_DESKTOP)
+            /* The thread that runs the game's audio job is its SPU, real-time on
+             * the PS3. At normal priority, behind the game's boosted PPU threads,
+             * it lost whole time slices (125-185 blocks a second of 187.5 under
+             * load). HIGHEST was worse on 6 threads: it starved the work the job
+             * itself waits on (20-37 fps against 33-47, fewer blocks). Above
+             * normal, level with those threads. RACACIT_AUDIO_BOOST=0/1/2. */
+            { static int s_b; if (!s_b) { s_b = 1; const char* e = getenv("RACACIT_AUDIO_BOOST"); const int lv = e ? atoi(e) : 1;
+                if (lv) SetThreadPriority(GetCurrentThread(), lv >= 2 ? THREAD_PRIORITY_HIGHEST : THREAD_PRIORITY_ABOVE_NORMAL);
+#if defined(__ANDROID__)
+                /* The Thor: four mid cores carry this thread, five SPU lanes, the render and
+                 * Vulkan threads, and in heavy scenes all of them queue for a core. ABOVE_NORMAL
+                 * (nice -5) sat below the collision lanes (-10, spu_drain.c): the owner's .15 log,
+                 * at 21-25 fps, had this thread waiting 386 ms a second for a core, the game
+                 * finishing 157 blocks a second of 187.5 and dialogue slurring. Nice -12, above
+                 * them; its feeders (snd_stream, syn_tick_timer, fios; sys_ppu_thread.c) are at
+                 * the same level, so it cannot starve what it waits on (Windows' HIGHEST did).
+                 * RACACIT_SOUND_NICE=<n> (0: as before). */
+                if (lv) { const char* sn = getenv("RACACIT_SOUND_NICE"); const int n = sn ? atoi(sn) : -12;
+                          if (n) setpriority(PRIO_PROCESS, (id_t)syscall(SYS_gettid), n); }
+#endif
+                fprintf(stderr, "[cellAudio] audio writer thread %lu, boost %d%c", (unsigned long)GetCurrentThreadId(), lv, 10); } }
+#endif
+            s_blk_done[p][blk] = 1; s_port_done_seen[p] = 1;
+        }
+        return;
+    }
+}
+
+/* Before reading: is there anything to play from the ports the game fills by
+ * PUT? Read blocks are cleared, so a finished block is an unread one, and the
+ * game writes in order: the first finished block after the cursor is the next
+ * to play (the cursor has to move only when a port starts, or if the writer
+ * lapped it). *skipped = blocks passed. Late = a port has none finished, and no
+ * other port wants mixing. *paced = nothing here sets the pace (a port not filled
+ * by PUT, or no port running): mix to keep the output fed. */
+#if AUDIO_BACKEND_SDL2
+static int audio_game_late(u32* skipped, int* paced)
+{
+    *skipped = 0;
+    int late = 0, other = 0, put = 0;
+    mutex_lock(&s_audio_mutex);
+    for (int p = 0; p < CELL_AUDIO_PORT_MAX; p++) {
+        AudioPortSlot* port = &s_ports[p];
+        if (!port->in_use || !port->running || !port->buffer) continue;
+        if (!s_port_done_seen[p]) { other = 1; continue; }
+        put = 1;
+        const u32 nblock = (u32)port->param.nBlock;
+        const u32 cur = (u32)(port->read_index % nblock);
+        if (cur >= 32 || s_blk_done[p][cur]) continue;
+        u32 d = 1;
+        while (d < nblock && !s_blk_done[p][(cur + d) % nblock]) d++;
+        if (d == nblock) { late = 1; continue; }
+        port->read_index += d;
+        if (d > *skipped) *skipped = d;
+        s_splice = 1;
+    }
+    mutex_unlock(&s_audio_mutex);
+    *paced = other || !put;
+    return late && !other;
+}
+
+/* Everything the game has finished goes to the stretcher at once. */
+static void audio_feed_stretcher(void)
+{
+    for (int n = 0; n < 16; n++) {
+        u32 skipped = 0; int paced = 0;
+        const int late = audio_game_late(&skipped, &paced);
+        if (skipped) s_late_skips++;
+        if (late || (paced && audio_st_blocks() >= (double)s_q_target)) return;
+        audio_mix_one_block();
+        ds_audio_submit();
+        ast_push(&s_st, s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+    }
+}
+#endif
+
+/* Every 30 s, if the sound was ever short: how much was stretched, how often it
+ * stopped altogether, and what the game made of the 187.5 blocks a second it
+ * should finish (under that = the CPU is short). A quiet minute brings the queue
+ * back down: one rough moment (a level load) must not leave the latency for good. */
+static void audio_late_report(void)
+{
+#if AUDIO_BACKEND_SDL2
+    static u64 t0; static unsigned f0, quiet; static unsigned long long st0, n0, fades0;
+    const u64 t = audio_now_us();
+    if (s_st.fades != fades0) {   /* the output stopped: more margin, if there was sound to lose */
+        s_late_fades += (unsigned)(s_st.fades - fades0); fades0 = s_st.fades;
+        int sound = 0;
+        for (int p = 0; p < CELL_AUDIO_PORT_MAX; p++) { sound |= s_port_sound[p]; s_port_sound[p] = 0; }
+        if (sound && s_q_target < 24) {
+            s_q_target += 2;
+            fprintf(stderr, "[cellAudio] the game fell behind the audio: keeping %u blocks (%u ms) in hand from now on%c",
+                    s_q_target, s_q_target * CELL_AUDIO_BLOCK_SAMPLES * 1000u / CELL_AUDIO_SAMPLE_RATE, 10);
+        }
+    }
+    if (!t0) { t0 = t; f0 = s_finished[0]; s_pub_steps = 0; }
+    if (t - t0 < 30000000ull) return;
+    const double sec = (double)(t - t0) / 1000000.0;
+    const unsigned long long st = s_st.stretched_steps - st0, n = s_st.steps - n0;
+    if (s_late_fades || s_late_skips || st)
+        fprintf(stderr, "[cellAudio] in the last 30 s: stretched %u%% of the time, %u dropouts, %u jumps, game finished %.1f blocks/s, read index %.1f/s (in hand %u blocks)%c",
+                n ? (unsigned)(st * 100u / n) : 0u, s_late_fades, s_late_skips, (s_finished[0] - f0) / sec, s_pub_steps / sec, s_q_target, 10);
+#if defined(__ANDROID__)
+    /* The device side: callbacks that found the ring short (this thread was late) and
+     * AAudio's own under-runs (its callback was late), when there were any. */
+    if (s_aa.on) {
+        const unsigned long long sc = s_aa.short_cb - s_aa.short_cb0;
+        const int32_t xr = s_aa.st ? s_aa.getXRuns(s_aa.st) : s_aa.xruns0;
+        if (sc || xr != s_aa.xruns0)
+            fprintf(stderr, "[cellAudio] AAudio in the last 30 s: %llu callbacks found the ring short, %d under-runs%c",
+                    sc, (int)(xr - s_aa.xruns0), 10);
+        s_aa.short_cb0 = s_aa.short_cb; s_aa.xruns0 = xr;
+    }
+#endif
+    quiet = s_late_fades ? 0 : quiet + 1;
+    if (quiet >= 2 && s_q_target > 6) { s_q_target -= 2; quiet = 0; }
+    s_late_skips = s_late_fades = 0; s_pub_steps = 0;
+    f0 = s_finished[0]; st0 = s_st.stretched_steps; n0 = s_st.steps;
+    t0 = t;
+#endif
+}
+
+/* ---------------------------------------------------------------------------
+ * Mixing thread
+ * -----------------------------------------------------------------------*/
+
+static void audio_notify_event_queues(void)
+{
+    /* AUDIO_STATS=1: every ~5 s, how many mixed port-0 blocks held PCM and
+     * how many period events reached the game. */
+    { static int st = -1; if (st < 0) st = getenv("AUDIO_STATS") ? 1 : 0;
+      if (st && g_audio_blocks >= 940) {
+          fprintf(stderr, "[audio-stats] blocks=%lu with-pcm=%lu (%lu%%) events ok=%lu fail=%lu\n",
+                  g_audio_blocks, g_audio_blocks_nz, g_audio_blocks_nz * 100 / g_audio_blocks,
+                  g_audio_push_ok, g_audio_push_fail);
+          g_audio_blocks = g_audio_blocks_nz = g_audio_push_ok = g_audio_push_fail = 0;
+      } }
+    /* Push the audio-period event (data1 = CELL_AUDIO_EVENT_MIX = 0) to each
+     * registered notify queue, so the game's audio loop (blocked on
+     * sys_event_queue_receive) wakes once per block and writes the next one.
+     * Resolve the queue by its ipc_key (set via cellAudioSetNotifyEventQueue). */
+    for (int i = 0; i < CELL_AUDIO_MAX_NOTIFY_EVENT_QUEUES; i++) {
+        if (!s_notify_queues[i].in_use) continue;
+        uint32_t qid = sys_event_find_queue_by_key(s_notify_queues[i].key);
+        if (qid) {
+            int rc = sys_event_queue_push_by_id(qid, s_notify_queues[i].key,
+                                       0 /*CELL_AUDIO_EVENT_MIX*/, 0, 0);
+            if (rc == 0) g_audio_push_ok++; else g_audio_push_fail++;
+        } else g_audio_push_fail++;
+    }
+}
+
+/* The clock of what the game sees: one step per block in real time, with the
+ * period event its frame waits on. The step leans 1% to keep what is buffered
+ * (device queue + stretcher + finished unread blocks) near the target: the device's clock
+ * is not this one, and a bigger target fills without silence. The game only
+ * writes sooner or later. A ring still entirely unread
+ * holds the step, or the writer would overwrite the block about to play. */
+#if AUDIO_BACKEND_SDL2
+static void audio_pub_tick(void)
+{
+    static double t_next, ema;
+    const double block_us = CELL_AUDIO_BLOCK_SAMPLES * 1000000.0 / CELL_AUDIO_SAMPLE_RATE;
+    const double now = (double)audio_now_us();
+    if (t_next == 0.0 || now - t_next > 40000.0) t_next = now;   /* this thread stalled: no burst */
+    while (now >= t_next) {
+        u32 unread = 0; int any = 0, max_lag = -1000;
+        mutex_lock(&s_audio_mutex);
+        for (int p = 0; p < CELL_AUDIO_PORT_MAX; p++) {
+            AudioPortSlot* port = &s_ports[p];
+            if (!port->in_use || !port->running || !port->buffer || !s_port_done_seen[p]) continue;
+            const u32 nblock = (u32)port->param.nBlock;
+            u32 done = 0;
+            for (u32 b = 0; b < nblock && b < 32; b++) done += s_blk_done[p][b];
+            any = 1; if (done > unread) unread = done;
+            if (done >= nblock) continue;
+            /* A whole lap ahead of the writer reads to it as "equal": full,
+             * nothing to do, just when it is furthest behind. Wait for it at 6
+             * (lag counts finished blocks; some of those are on their way), but
+             * never for long: it is not this index the game may wait on. */
+            { static unsigned s_steps[CELL_AUDIO_PORT_MAX], s_base[CELL_AUDIO_PORT_MAX]; static u8 s_hold[CELL_AUDIO_PORT_MAX];
+              const int lag = (int)(s_steps[p] - (s_finished[p] - s_base[p]));
+              if (lag >= 6 && s_hold[p] < 16) { s_hold[p]++; if (lag > max_lag) max_lag = lag; continue; }
+              if (s_hold[p] >= 16 || lag < -32) s_base[p] = s_finished[p] - s_steps[p];
+              s_hold[p] = 0;
+              s_steps[p]++;
+              if (lag > max_lag) max_lag = lag; }
+            s_pub_steps++;
+            port->pub_index++;
+            if (port->read_idx_addr)
+                vm_write64((u32)port->read_idx_addr, port->pub_index % nblock);
+        }
+        mutex_unlock(&s_audio_mutex);
+        double step = block_us;
+        if (any) {
+            const double level = (double)audio_backend_queued_samples() / CELL_AUDIO_BLOCK_SAMPLES + audio_st_blocks() + unread;
+            const double want = (double)s_q_target + AUDIO_DEV_BLOCKS;
+            ema += (level - ema) / 32.0;
+            if (ema < want - 2.0 && max_lag < 0) step *= 0.99;
+            else if (ema > want + 5.0) step *= 1.01;
+        }
+        t_next += step;
+        audio_notify_event_queues();
+    }
+}
+#endif
+
+/* AUDIO_WAV=<file>: append the final mix as raw f32le stereo 48 kHz
+ * (ffmpeg -f f32le -ar 48000 -ac 2 -i <file>). */
+static void audio_wav_tap(const float* stereo)
+{
+    static FILE* _wf = (FILE*)-1;
+    if (_wf == (FILE*)-1) { const char* e = getenv("AUDIO_WAV"); _wf = e ? fopen(e, "wb") : NULL; }
+    if (_wf) fwrite(stereo, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, _wf);
+}
+
+#if AUDIO_BACKEND_SDL2
+/* One block from the stretcher to the device, at the ratio the level asks for.
+ * The game writes in bursts of about 3 blocks and the stretcher moves in steps
+ * of 2, nothing to act on: stretching starts when under a block is left and then
+ * fills all the way back to the target, so at full supply the ratio is exactly 1.
+ * A short dip barely stretches; a lasting shortage settles where it must. */
+static int audio_output_stretched(void)
+{
+    static float out[CELL_AUDIO_BLOCK_SAMPLES * 2];
+    static double smooth = 1.0;
+    static int filling;
+    const double have = audio_st_blocks(), err = (double)s_q_target - have;
+    if (have < 1.0) filling = 1; else if (err <= 0.0) filling = 0;
+    double r = 1.0;
+    if (filling) r = 1.02 + (err > 0.0 ? err : 0.0) * 0.1;
+    else if (err < -20.0) r = 0.92;
+    else if (err < -6.0) r = 0.97;
+    if (r > 1.8) r = 1.8;
+    smooth += (r - smooth) * 0.1;
+    if (r == 1.0 && fabs(smooth - 1.0) < 0.01) smooth = 1.0;
+    ast_set_ratio(&s_st, smooth);
+    if (!ast_pull(&s_st, out, CELL_AUDIO_BLOCK_SAMPLES)) return 0;
+    audio_wav_tap(out);
+    audio_dev_write(out, CELL_AUDIO_BLOCK_SAMPLES);
+    return 1;
+}
+#endif
+
+#if defined(_WIN32) || defined(AUDIO_LINUX_DESKTOP)
+#ifdef _WIN32
+static unsigned __stdcall audio_mix_thread_func(void* arg)
+#else
+static void* audio_mix_thread_func(void* arg)
+#endif
+{
+    (void)arg;
+    printf("[cellAudio] Mixing thread started\n");
+    /* It carries the clock the game's synth runs on (audio_pub_tick) and does
+     * little else: a late wake here is a late read index for the whole game. */
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+#if defined(__ANDROID__)
+    /* HIGHEST is nice -10 here, level with the collision lanes on the Thor's saturated mid
+     * cores. Android's own audio threads run at -16 (THREAD_PRIORITY_URGENT_AUDIO); so does
+     * this one, which sleeps 2-5 ms between blocks. Named for the profiler and [sched]. */
+    setpriority(PRIO_PROCESS, (id_t)syscall(SYS_gettid), -16);
+    prctl(PR_SET_NAME, "cellAudio mix", 0, 0, 0);
+    /* v113-android.48: on the small cores (game/main.cpp racacit_little_thread). It wakes every
+     * millisecond at -16; made by a game thread it inherited the fast cores, the main thread's top
+     * one included, and took them from the main thread and the SPU lanes a thousand times a
+     * second. Its work (the mix, the stretch) is a few ms a second; the ring ahead of the device
+     * is 21 ms. RACACIT_AUDIO_LITTLE=0: as before. */
+    { const char* e = getenv("RACACIT_AUDIO_LITTLE");
+      if (!(e && *e == '0')) { extern int racacit_little_thread(void);
+          if (racacit_little_thread()) fprintf(stderr, "[cellAudio] mixing thread on the small cores%c", 10); } }
+#endif
+#if AUDIO_BACKEND_SDL2
+    ast_init(&s_st);
+#endif
+
+    /* Pace to the device clock. The PS3 consumes one block every 5.33 ms;
+     * the old Sleep(2)/Sleep(5) loop keyed on a queue depth the 1056-frame
+     * WASAPI buffer can never reach, so it mixed ~225 blocks/s and the device
+     * dropped the surplus: 20% of the audio thrown away, and a guest mixer
+     * (GH3's FMOD) that could not keep ahead of the read index played gaps.
+     * With no device, pace on the performance counter instead. */
+    LARGE_INTEGER qf, q0; QueryPerformanceFrequency(&qf); QueryPerformanceCounter(&q0);
+    unsigned long long blocks = 0;
+    while (s_mix_thread_running) {
+        const int room = audio_backend_room();
+#if AUDIO_BACKEND_SDL2
+        /* RACACIT_AUDIO_NOWAIT=1: read on and publish as before v89 (for A/B tests). */
+        { static int nowait = -1;
+          if (nowait < 0) nowait = getenv("RACACIT_AUDIO_NOWAIT") != NULL;
+          s_pub_mode = room >= 0 && !nowait;
+          if (s_pub_mode) audio_pub_tick(); }
+#endif
+#if AUDIO_BACKEND_SDL2
+        if (s_pub_mode) {
+            audio_feed_stretcher();
+            audio_late_report();
+            while (audio_backend_room() > 0 && audio_output_stretched()) {}
+            audio_backend_wait();
+            continue;
+        }
+#endif
+        if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { audio_backend_wait(); continue; }
+        if (room < 0) {
+            LARGE_INTEGER now; QueryPerformanceCounter(&now);
+            const long long due = q0.QuadPart +
+                (long long)(blocks * CELL_AUDIO_BLOCK_SAMPLES * qf.QuadPart / CELL_AUDIO_SAMPLE_RATE);
+            if (now.QuadPart < due) { Sleep(1); continue; }
+            /* More than 50 ms behind (device just went away, a debugger
+             * stop): drop the backlog instead of mixing it in a burst. */
+            if (now.QuadPart - due > qf.QuadPart / 20)
+                q0.QuadPart = now.QuadPart -
+                    (long long)(blocks * CELL_AUDIO_BLOCK_SAMPLES * qf.QuadPart / CELL_AUDIO_SAMPLE_RATE);
+        }
+        blocks++;
+        /* Mix and submit one block */
+        audio_mix_one_block();
+        /* AUDIO_PEAK=1: report the mixed block's peak amplitude periodically so
+         * "is any port producing sound" is answerable (LBP Bink movie audio). */
+        { static int _ap = -1; if (_ap < 0) _ap = getenv("AUDIO_PEAK") ? 1 : 0;
+          if (_ap) { static unsigned _n = 0; float pk = 0.0f;
+            for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
+                float a = s_mix_buffer[i]; if (a < 0) a = -a; if (a > pk) pk = a; }
+            if ((++_n % 200) == 0 || (pk > 0.001f && _n < 40))
+                fprintf(stderr, "[audio-peak] block#%u peak=%.4f\n", _n, pk); } }
+        audio_wav_tap(s_mix_buffer);
+        audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+        /* AUDIO_RATE=1: blocks mixed vs real time, and frames dropped. */
+        { static int on = -1; if (on < 0) on = getenv("AUDIO_RATE") ? 1 : 0;
+          if (on) { static ULONGLONG t0; static unsigned n, z; static unsigned long long d0;
+            ULONGLONG now = GetTickCount64(); if (!t0) t0 = now; n++;
+            { int nz = 0; for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) if (s_mix_buffer[i] != 0.0f) { nz = 1; break; }
+              if (!nz) z++; }
+            if (now - t0 >= 5000) {
+                fprintf(stderr, "[audio-rate] %.1f blocks/s (real time 187.5), silent %.1f%%, dropped %.0f frames/s, device buf %u%c",
+                        n * 1000.0 / (now - t0), n ? 100.0 * z / n : 0.0, (g_audio_dropped - d0) * 1000.0 / (now - t0),
+                #if AUDIO_BACKEND_WASAPI
+                        (unsigned)s_wasapi_buf_frames, 10);
+#else
+                        0u, 10);
+#endif
+                n = z = 0; d0 = g_audio_dropped; t0 = now; } } }
+
+        /* Notify event queues */
+        audio_notify_event_queues();
+    }
+
+    printf("[cellAudio] Mixing thread stopped\n");
+    return 0;
+}
+#else
+static void* audio_mix_thread_func(void* arg)
+{
+    (void)arg;
+    printf("[cellAudio] Mixing thread started\n");
+
+    while (s_mix_thread_running) {
+        audio_mix_one_block();
+        /* AUDIO_WAV=<file>: the final mix as raw f32le stereo 48 kHz (as on Windows). */
+        { static FILE* _wf = (FILE*)-1;
+          if (_wf == (FILE*)-1) { const char* e = getenv("AUDIO_WAV"); _wf = e ? fopen(e, "wb") : NULL; }
+          if (_wf) { fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, _wf); fflush(_wf); } }
+        audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+        audio_notify_event_queues();
+
+        u32 queued = audio_backend_queued_samples();
+        if (queued > CELL_AUDIO_BLOCK_SAMPLES * 4) {
+            usleep(5000);
+        } else {
+            usleep(2000);
+        }
+    }
+
+    printf("[cellAudio] Mixing thread stopped\n");
+    return NULL;
+}
+#endif
+
+static int audio_start_mix_thread(void)
+{
+    s_mix_thread_running = 1;
+    { extern void (*g_audio_put_hook)(uint32_t, uint32_t, uint32_t);
+      g_audio_put_hook = audio_put_hook; }
+
+#ifdef _WIN32
+    s_mix_thread = (HANDLE)_beginthreadex(NULL, 0, audio_mix_thread_func,
+                                           NULL, 0, NULL);
+    if (!s_mix_thread) {
+        s_mix_thread_running = 0;
+        return -1;
+    }
+#else
+    if (pthread_create(&s_mix_thread, NULL, audio_mix_thread_func, NULL) != 0) {
+        s_mix_thread_running = 0;
+        return -1;
+    }
+    s_mix_thread_live = 1;
+#endif
+    return 0;
+}
+
+static void audio_stop_mix_thread(void)
+{
+    s_mix_thread_running = 0;
+#ifdef _WIN32
+    if (s_mix_thread) {
+        WaitForSingleObject(s_mix_thread, 2000);
+        CloseHandle(s_mix_thread);
+        s_mix_thread = NULL;
+    }
+#else
+    /* Same guard. Init leaves s_audio_initialized set even when the mixing
+     * thread failed to start ("continuing silently" -- a title without audio
+     * still runs), so Quit reaches here with s_mix_thread never assigned.
+     * pthread_t has no null value to test, and joining an unset one, or
+     * joining the same one twice, is undefined rather than an error the way
+     * WaitForSingleObject on a null HANDLE is. */
+    if (s_mix_thread_live) {
+        pthread_join(s_mix_thread, NULL);
+        s_mix_thread_live = 0;
+    }
+#endif
+}
+
+/* ---------------------------------------------------------------------------
+ * API implementations
+ * -----------------------------------------------------------------------*/
+
+s32 cellAudioInit(void)
+{
+    /* PS3_NO_AUDIO=1: report that the audio library is unavailable. Middleware
+     * that drives its mixer through SPU jobs will otherwise block the whole boot
+     * waiting on work we cannot yet complete; failing here lets a title take its
+     * silent path and keep going. Diagnostic first, workaround second. */
+    if (getenv("PS3_NO_AUDIO")) {
+        printf("[cellAudio] PS3_NO_AUDIO -- reporting audio unavailable\n");
+        return (s32)CELL_AUDIO_ERROR_NOT_INIT;
+    }
+    printf("[cellAudio] Init()\n");
+
+    if (s_audio_initialized)
+        return CELL_AUDIO_ERROR_ALREADY_INIT;
+
+    memset(s_ports, 0, sizeof(s_ports));
+    memset(s_notify_queues, 0, sizeof(s_notify_queues));
+    mutex_init(&s_audio_mutex);
+
+    if (audio_backend_init() < 0) {
+        printf("[cellAudio] WARNING: Audio backend init failed, continuing silently\n");
+        /* Don't fail -- games should still run without audio */
+    }
+
+
+    /* Port timestamps (cellAudioGetPortTimestamp) count from here: the same
+     * guest clock origin as the timebase and audio_now_us, not raw host time. */
+    s_audio_start_us = audio_now_us();
+    if (audio_start_mix_thread() < 0) {
+        printf("[cellAudio] WARNING: Could not start mixing thread\n");
+    }
+
+    s_audio_initialized = 1;
+    return CELL_OK;
+}
+
+s32 cellAudioQuit(void)
+{
+    printf("[cellAudio] Quit()\n");
+
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+
+    audio_stop_mix_thread();
+    audio_backend_shutdown();
+
+    /* Port buffers live in the guest vm_base arena (bump-allocated, not host
+     * malloc) -- just drop the references; never free() them. */
+    for (int i = 0; i < CELL_AUDIO_PORT_MAX; i++) {
+        s_ports[i].buffer = NULL;
+        s_ports[i].in_use = 0;
+        s_ports[i].running = 0;
+    }
+
+    mutex_destroy(&s_audio_mutex);
+    s_audio_initialized = 0;
+    return CELL_OK;
+}
+
+s32 cellAudioPortOpen(const CellAudioPortParam* param, u32* portNum)
+{
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+
+    /* param / portNum are GUEST addresses; translate, and read the BE u64 param
+     * fields via vm_read64 (a raw param->nChannel faults / is host-endian). */
+    uint32_t param_ea   = (uint32_t)(uintptr_t)param;
+    uint32_t portNum_ea = (uint32_t)(uintptr_t)portNum;
+    if (!param_ea || !portNum_ea)
+        return CELL_AUDIO_ERROR_PARAM;
+
+    u64 nch  = vm_read64(param_ea + 0);   /* nChannel */
+    u64 nblk = vm_read64(param_ea + 8);   /* nBlock   */
+    printf("[cellAudio] PortOpen(nChannel=%llu, nBlock=%llu)\n",
+           (unsigned long long)nch, (unsigned long long)nblk);
+
+    if (nch != CELL_AUDIO_PORT_2CH && nch != CELL_AUDIO_PORT_8CH)
+        return CELL_AUDIO_ERROR_PARAM;
+    if (nblk != CELL_AUDIO_BLOCK_8 && nblk != CELL_AUDIO_BLOCK_16 && nblk != CELL_AUDIO_BLOCK_32)
+        return CELL_AUDIO_ERROR_PARAM;
+
+    mutex_lock(&s_audio_mutex);
+
+    /* Find a free port slot */
+    s32 found = -1;
+    for (u32 i = 0; i < CELL_AUDIO_PORT_MAX; i++) {
+        if (!s_ports[i].in_use) {
+            found = (s32)i;
+            break;
+        }
+    }
+
+    if (found < 0) {
+        mutex_unlock(&s_audio_mutex);
+        return CELL_AUDIO_ERROR_PORT_FULL;
+    }
+
+    AudioPortSlot* port = &s_ports[found];
+    port->in_use  = 1;
+    port->running = 0;
+    /* Store the decoded (host-endian) param values, not the raw BE guest bytes. */
+    memset(&port->param, 0, sizeof(port->param));
+    port->param.nChannel = nch;
+    port->param.nBlock   = nblk;
+    port->read_index  = 0;
+    port->pub_index   = 0;
+    port->write_index = 0;
+    s_port_done_seen[(int)(port - s_ports)] = 0;
+    memset((void*)s_blk_done[(int)(port - s_ports)], 0, sizeof s_blk_done[0]);
+
+    /* Allocate the audio buffer in GUEST memory so portAddr/readIndexAddr are
+     * real guest addresses (the game's mixer -- FMOD here -- writes PCM there
+     * and validates them as 1 MB-aligned guest pointers; a host pointer trips
+     * its "invalid parameter" check). Bump from a free main-memory window; the
+     * host-side `buffer` is just the vm_base view of the same bytes. */
+    u32 buf_samples = (u32)(nblk * CELL_AUDIO_BLOCK_SAMPLES * nch);
+    port->buf_size = buf_samples * (u32)sizeof(float);
+
+    /* Keep audio outside sys_memory (0x40000000..0x50000000), the HLE heap
+     * (0x50000000..0x58000000), and sys_vm (0x60000000..0x70000000).
+     * Reserve two 1-MB pages per port so reopening reuses its own storage. */
+    u32 guest_buf = 0x58000000u + (u32)found * 0x200000u;
+    u32 guest_ridx = guest_buf + 0x100000u;
+    if (vm_commit(guest_buf, 0x200000u) != CELL_OK) {
+        port->in_use = 0;
+        mutex_unlock(&s_audio_mutex);
+        return CELL_AUDIO_ERROR_AUDIOSYSTEM;
+    }
+
+    port->buffer = (float*)(vm_base + guest_buf);     /* host view of guest buffer */
+    memset(port->buffer, 0, port->buf_size);
+    vm_write64(guest_ridx, 0);                        /* read index counter (u64, see below) */
+
+    port->port_addr     = guest_buf;
+    port->read_idx_addr = guest_ridx;
+
+    vm_write32(portNum_ea, (u32)found);   /* guest out-param */
+
+    mutex_unlock(&s_audio_mutex);
+    return CELL_OK;
+}
+
+s32 cellAudioPortClose(u32 portNum)
+{
+    printf("[cellAudio] PortClose(port=%u)\n", portNum);
+
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+
+    if (portNum >= CELL_AUDIO_PORT_MAX)
+        return CELL_AUDIO_ERROR_PORT_NOT_OPEN;
+
+    mutex_lock(&s_audio_mutex);
+
+    if (!s_ports[portNum].in_use) {
+        mutex_unlock(&s_audio_mutex);
+        return CELL_AUDIO_ERROR_PORT_NOT_OPEN;
+    }
+
+    /* buffer points INTO the guest vm_base arena (reserved per port in PortOpen),
+     * not a host malloc -- do NOT free() it (that corrupts the host heap).
+     * The guest window is reclaimed wholesale when vm_base is released. */
+    s_ports[portNum].buffer = NULL;
+
+    s_ports[portNum].in_use  = 0;
+    s_ports[portNum].running = 0;
+
+    mutex_unlock(&s_audio_mutex);
+    return CELL_OK;
+}
+
+s32 cellAudioPortStart(u32 portNum)
+{
+    printf("[cellAudio] PortStart(port=%u)\n", portNum);
+
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+
+    if (portNum >= CELL_AUDIO_PORT_MAX || !s_ports[portNum].in_use)
+        return CELL_AUDIO_ERROR_PORT_NOT_OPEN;
+
+    if (s_ports[portNum].running)
+        return CELL_AUDIO_ERROR_PORT_ALREADY_RUN;
+
+    mutex_lock(&s_audio_mutex);
+    s_ports[portNum].running = 1;
+    mutex_unlock(&s_audio_mutex);
+
+    return CELL_OK;
+}
+
+s32 cellAudioPortStop(u32 portNum)
+{
+    printf("[cellAudio] PortStop(port=%u)\n", portNum);
+
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+
+    if (portNum >= CELL_AUDIO_PORT_MAX || !s_ports[portNum].in_use)
+        return CELL_AUDIO_ERROR_PORT_NOT_OPEN;
+
+    if (!s_ports[portNum].running)
+        return CELL_AUDIO_ERROR_PORT_NOT_RUN;
+
+    mutex_lock(&s_audio_mutex);
+    s_ports[portNum].running = 0;
+    mutex_unlock(&s_audio_mutex);
+
+    return CELL_OK;
+}
+
+s32 cellAudioGetPortBlockTag(u32 portNum, u64 blockNo, u64* tag)
+{
+    { static int st = -1; if (st < 0) st = getenv("AUDIO_STATS") ? 1 : 0;
+      static unsigned long n; if (st && (n++ < 20 || (n % 2000) == 0))
+          fprintf(stderr, "[audio-api] GetPortBlockTag(port=%u block=%llu) #%lu ridx=%llu\n", portNum,
+                  (unsigned long long)blockNo, n, (unsigned long long)s_ports[portNum < CELL_AUDIO_PORT_MAX ? portNum : 0].read_index); }
+    uint32_t tag_ea = (uint32_t)(uintptr_t)tag;
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+    if (portNum >= CELL_AUDIO_PORT_MAX)
+        return CELL_AUDIO_ERROR_PARAM;
+    if (!s_ports[portNum].in_use)
+        return CELL_AUDIO_ERROR_PORT_NOT_OPEN;
+    if (!tag_ea)
+        return CELL_AUDIO_ERROR_PARAM;
+
+    mutex_lock(&s_audio_mutex);
+    AudioPortSlot* port = &s_ports[portNum];
+    u64 nblk = port->param.nBlock ? port->param.nBlock : 1;
+    if (blockNo >= nblk) {
+        mutex_unlock(&s_audio_mutex);
+        return CELL_AUDIO_ERROR_PARAM;
+    }
+    u64 t = port->pub_index + blockNo - (port->pub_index % nblk);
+    if (blockNo < port->pub_index % nblk) t += nblk;
+    mutex_unlock(&s_audio_mutex);
+
+    vm_write64(tag_ea, t);
+    return CELL_OK;
+}
+
+s32 cellAudioGetPortTimestamp(u32 portNum, u64 tag, u64* stamp)
+{
+    { static int st = -1; if (st < 0) st = getenv("AUDIO_STATS") ? 1 : 0;
+      static unsigned long n; if (st && (n++ < 20 || (n % 2000) == 0))
+          fprintf(stderr, "[audio-api] GetPortTimestamp(port=%u tag=%llu) #%lu ridx=%llu\n", portNum,
+                  (unsigned long long)tag, n, (unsigned long long)s_ports[portNum < CELL_AUDIO_PORT_MAX ? portNum : 0].read_index); }
+    uint32_t stamp_ea = (uint32_t)(uintptr_t)stamp;
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+    if (portNum >= CELL_AUDIO_PORT_MAX)
+        return CELL_AUDIO_ERROR_PARAM;
+    if (!s_ports[portNum].in_use)
+        return CELL_AUDIO_ERROR_PORT_NOT_OPEN;
+    if (!stamp_ea)
+        return CELL_AUDIO_ERROR_PARAM;
+
+    mutex_lock(&s_audio_mutex);
+    u64 global_counter = s_ports[portNum].pub_index;
+    mutex_unlock(&s_audio_mutex);
+    if (tag > global_counter)
+        return CELL_AUDIO_ERROR_TAG_NOT_FOUND;
+
+    u64 t = s_audio_start_us + tag * 256000000ULL / 48000ULL;
+    vm_write64(stamp_ea, t);
+    return CELL_OK;
+}
+
+/* cellAudioCreateNotifyEventQueue(sys_event_queue_t* id, u64* key)
+ *
+ * Creates the queue the game will block on for audio-period events, and
+ * registers it for notification in one step -- the game never calls
+ * SetNotifyEventQueue for this one.
+ *
+ * This was missing entirely. YDKJ imports it, got the unimplemented-NID path,
+ * and then blocked on an id nothing had created: sys_event_queue_receive
+ * answered CELL_ESRCH every time and the title logged 1.7 MILLION
+ * "ERROR - LIBAUDIO DROPOUT" lines in a 60 s run.
+ *
+ * Both params are GUEST addresses and both are big-endian out-values; the id
+ * is 32-bit and the key 64-bit, so they cannot be written with a plain store. */
+s32 cellAudioCreateNotifyEventQueue(u32* id, u64* key)
+{
+    uint32_t id_ea  = (uint32_t)(uintptr_t)id;
+    uint32_t key_ea = (uint32_t)(uintptr_t)key;
+
+    printf("[cellAudio] CreateNotifyEventQueue(id_ea=0x%08X key_ea=0x%08X)\n",
+           id_ea, key_ea);
+
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+    if (!id_ea || !key_ea)
+        return CELL_AUDIO_ERROR_PARAM;
+
+    /* A distinct key per queue: the notify path resolves queues BY KEY, and the
+     * game creates its other queues with key 0, so reusing 0 here would make
+     * find_queue_by_key ambiguous and post audio events to whichever matched. */
+    static uint64_t s_next_key = 0x8000000000000001ull;
+    uint64_t k = s_next_key++;
+
+    uint32_t qid = sys_event_queue_create_direct(k, 8);
+    if (!qid)
+        return CELL_AUDIO_ERROR_EVENT_QUEUE;
+
+    mutex_lock(&s_audio_mutex);
+    int slot = -1;
+    for (int i = 0; i < CELL_AUDIO_MAX_NOTIFY_EVENT_QUEUES; i++) {
+        if (!s_notify_queues[i].in_use) { slot = i; break; }
+    }
+    if (slot < 0) { mutex_unlock(&s_audio_mutex); return CELL_AUDIO_ERROR_PARAM; }
+    s_notify_queues[slot].in_use = 1;
+    s_notify_queues[slot].key    = k;
+    mutex_unlock(&s_audio_mutex);
+
+    vm_write32(id_ea, qid);
+    vm_write64(key_ea, k);
+    printf("[cellAudio] CreateNotifyEventQueue -> id=%u key=0x%llX\n",
+           qid, (unsigned long long)k);
+    return CELL_OK;
+}
+
+s32 cellAudioSetNotifyEventQueue(u64 key)
+{
+    printf("[cellAudio] SetNotifyEventQueue(key=0x%llX)\n",
+           (unsigned long long)key);
+
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+
+    mutex_lock(&s_audio_mutex);
+
+    for (int i = 0; i < CELL_AUDIO_MAX_NOTIFY_EVENT_QUEUES; i++) {
+        if (!s_notify_queues[i].in_use) {
+            s_notify_queues[i].in_use = 1;
+            s_notify_queues[i].key = key;
+            mutex_unlock(&s_audio_mutex);
+            return CELL_OK;
+        }
+    }
+
+    mutex_unlock(&s_audio_mutex);
+    return CELL_AUDIO_ERROR_PARAM; /* no free slots */
+}
+
+s32 cellAudioRemoveNotifyEventQueue(u64 key)
+{
+    printf("[cellAudio] RemoveNotifyEventQueue(key=0x%llX)\n",
+           (unsigned long long)key);
+
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+
+    mutex_lock(&s_audio_mutex);
+
+    for (int i = 0; i < CELL_AUDIO_MAX_NOTIFY_EVENT_QUEUES; i++) {
+        if (s_notify_queues[i].in_use && s_notify_queues[i].key == key) {
+            s_notify_queues[i].in_use = 0;
+            mutex_unlock(&s_audio_mutex);
+            return CELL_OK;
+        }
+    }
+
+    mutex_unlock(&s_audio_mutex);
+    return CELL_AUDIO_ERROR_PARAM;
+}
+
+s32 cellAudioGetPortConfig(u32 portNum, CellAudioPortConfig* config)
+{
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+
+    if (portNum >= CELL_AUDIO_PORT_MAX || !s_ports[portNum].in_use)
+        return CELL_AUDIO_ERROR_PORT_NOT_OPEN;
+
+    if (!config)
+        return CELL_AUDIO_ERROR_PARAM;
+
+    /* `config` is a GUEST address; write the BE struct field-by-field at its
+     * guest offsets (8-byte aligned u64s). */
+    uint32_t cfg = (uint32_t)(uintptr_t)config;
+    if (!cfg)
+        return CELL_AUDIO_ERROR_PARAM;
+
+    mutex_lock(&s_audio_mutex);
+    AudioPortSlot* port = &s_ports[portNum];
+
+    /* CellAudioPortConfig (cell/audio.h). sys_addr_t is uintptr_t, which on the
+     * 32-bit PPU ABI is FOUR bytes -- not eight. Writing the two sys_addr_t
+     * fields as u64 shifted every field past it and left the game reading the
+     * high (zero) half of readIndexAddr as its pointer:
+     *   sys_addr_t readIndexAddr;  u32 @  0
+     *   uint32_t   status;         u32 @  4
+     *   uint64_t   nChannel;       u64 @  8
+     *   uint64_t   nBlock;         u64 @ 16
+     *   uint32_t   portSize;       u32 @ 24
+     *   sys_addr_t portAddr;       u32 @ 28      -> 32 bytes */
+    vm_write32(cfg +  0, (u32)port->read_idx_addr);                          /* readIndexAddr */
+    vm_write32(cfg +  4, port->running ? CELL_AUDIO_STATUS_RUN
+                                       : CELL_AUDIO_STATUS_READY);           /* status */
+    vm_write64(cfg +  8, port->param.nChannel);                             /* nChannel */
+    vm_write64(cfg + 16, port->param.nBlock);                               /* nBlock */
+    vm_write32(cfg + 24, port->buf_size);                                   /* portSize */
+    vm_write32(cfg + 28, (u32)port->port_addr);                             /* portAddr */
+
+    { static int _n = 0; if ((_n < 24 && (_n++, 1)))
+        fprintf(stderr, "[cellAudio] GetPortConfig(port=%u) status=%s bufEA=0x%08X ridxEA=0x%08X\n",
+                portNum, port->running ? "RUN" : "READY",
+                (u32)port->port_addr, (u32)port->read_idx_addr); }
+
+    mutex_unlock(&s_audio_mutex);
+    return CELL_OK;
+}
+
+s32 cellAudioPortGetStatus(u32 portNum, u32* status)
+{
+    if (!s_audio_initialized)
+        return CELL_AUDIO_ERROR_NOT_INIT;
+
+    if (portNum >= CELL_AUDIO_PORT_MAX || !status)
+        return CELL_AUDIO_ERROR_PARAM;
+
+    if (!s_ports[portNum].in_use) {
+        vm_write32((u32)(uintptr_t)status, CELL_AUDIO_STATUS_CLOSE);
+    } else if (s_ports[portNum].running) {
+        vm_write32((u32)(uintptr_t)status, CELL_AUDIO_STATUS_RUN);
+    } else {
+        vm_write32((u32)(uintptr_t)status, CELL_AUDIO_STATUS_READY);
+    }
+
+    return CELL_OK;
+}
+
+s32 cellAudioSetPersonalDevice(s32 iPersonalStream, s32 iDevice)
+{
+    (void)iPersonalStream;
+    (void)iDevice;
+    printf("[cellAudio] SetPersonalDevice(stream=%d, device=%d) - stub\n",
+           iPersonalStream, iDevice);
+    return CELL_OK;
+}
+
+s32 cellAudioUnsetPersonalDevice(s32 iPersonalStream)
+{
+    (void)iPersonalStream;
+    printf("[cellAudio] UnsetPersonalDevice(stream=%d) - stub\n", iPersonalStream);
+    return CELL_OK;
+}
diff --git a/libs/audio/ds_player.c b/libs/audio/ds_player.c
new file mode 100644
index 0000000..17ebc1d
--- /dev/null
+++ b/libs/audio/ds_player.c
@@ -0,0 +1,841 @@
+/*
+ * ds_player -- the DualSense speaker's own sound player.
+ *
+ * The game side decides what the controller plays (game/stubs.cpp: by a sound
+ * instance's name; runtime/ppu/ppu_fs.cpp: by a dialogue line's speaker) and
+ * hands the whole sound over: a SCREAM bank sound, which runs here from its
+ * grain script on the player's own clock, or a line's PS-ADPCM data. This
+ * file decodes, resamples and mixes them (48 kHz mono) into the controller's
+ * speaker and actuator buffers; cellAudio.c (ds_audio_submit) pulls a block at
+ * a time. Nothing is taken from the game's own mix. v42-v62 copied the synth
+ * voices whose sample addresses had been marked, and samples shared between
+ * sounds, reused voices and stream rings let other sounds through (owner,
+ * v62: "random noises ... nothing is consistent").
+ *
+ * SCREAM banks ("klBS", 989snd's SFX block, version 3). In memory every
+ * offset below is already an address:
+ *   [bank+0x1C] sounds, 12 bytes: vol, vol group, pan s16, grain count,
+ *               instance limit, flags s16, first grain
+ *   grains, 8 bytes: opcode (type in the top byte, 24-bit argument), then
+ *               the delay in ticks (240 Hz) before the next grain
+ *   [bank+0x34] + argument of a tone grain, 24 bytes: priority, vol (s8;
+ *               negative = register -vol-1), center note (s8; negative = a
+ *               48 kHz note), center fine (1/128 semitone), pan s16, map
+ *               low/high, bend down/up (semitones), ADSR1, ADSR2, flags,
+ *               sample address, size
+ * A tone plays at base * 2^((60 - |note| + fine/128 + bend) / 12) Hz, base
+ * 48000 for a negative note, 44100 for a positive one (989snd's
+ * PS1Note2Pitch). The sign of the fine part is measured: 14 pistol shots in
+ * a capture matched the TV's copy at 1.04-1.135x (mean 1.085) with it
+ * subtracted -- 1.08x is 2 x 84/128 of a semitone. Samples are PS-ADPCM, 16-byte frames: predictor << 4 |
+ * shift, flags (1 end, 2 repeat, 4 loop start), 28 samples.
+ */
+#include "ds_player.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern uint8_t* vm_base;
+
+#define DS_RATE     48000
+#define DS_TICK_HZ  240
+#define DS_VOICES   64
+#define DS_SCRIPTS  32
+#define DS_GRAINS   96
+#define DS_MAX_DATA (4u << 20)
+
+typedef struct {
+    int      used;
+    uint8_t* data;
+    uint32_t nfr, fr;          /* frames, next frame to decode */
+    int      loop_fr;          /* the last loop-start frame seen, -1 none */
+    int      last;             /* the frame decoded last had the end flag */
+    int32_t  h1, h2;           /* ADPCM history */
+    int16_t  buf[28];
+    int      bi;               /* next sample of buf; 28 = decode a frame */
+    float    s0, s1;           /* the samples the output lies between */
+    double   phase, step;      /* position between s0 and s1; input samples per output sample */
+    double   base;             /* step before the script's pitch bend */
+    int      up, down;         /* the tone's bend range, semitones */
+    int      ended;            /* no more input: s1 was the last sample */
+    float    spk, felt;        /* levels */
+    float    env, fade;        /* 1 = full; per-sample decrement once released */
+    uint32_t delay;            /* output samples before it starts */
+    uint32_t owner;
+    uint32_t handle;           /* the game's SCREAM sound it belongs to, 0 unknown */
+    int      dead;             /* checks that found that sound gone */
+    int      script;           /* the script that started it, -1 */
+    uint32_t age;              /* output samples played */
+    uint32_t line;             /* a dialogue line's token, 0 otherwise */
+    uint32_t read_fr, margin;  /* frames of it the game has read; how far past that it may run */
+    uint32_t held;             /* output samples spent holding for the game's reads */
+    float    gate;             /* 1 = playing, 0 = holding */
+    char     name[32];
+} ds_voice;
+
+typedef struct {
+    int      used;
+    uint32_t bank, tab;        /* bank, tone table */
+    uint32_t g[DS_GRAINS][2];
+    int      ng, pc;
+    int32_t  countdown;        /* ticks before the next grain */
+    int      play_left, skip_after;   /* a RAND_PLAY / PLAY_CYCLE choice being played */
+    int      loop_pc, stop_pc; /* LOOP_START; the release part (after ON_STOP_MARKER), -1 none */
+    int      stopping, waiting, parked;   /* parked: at ON_STOP_MARKER, ends with its voices */
+    uint32_t ticks;            /* age */
+    float    bend;             /* -1..1 of the tone's bend range */
+    int      reg[4];
+    float    vol, spk, felt;
+    float    lift;             /* the whole sound brought up (sound_lift) */
+    uint32_t owner;
+    uint32_t handle;
+    int      dead;
+    char     name[48];
+} ds_script;
+
+static ds_voice  s_v[DS_VOICES];
+static ds_script s_s[DS_SCRIPTS];
+static volatile long s_mu;
+static volatile int  s_on;
+static double s_tick_acc;
+static uint32_t s_snd;         /* SCREAM's globals (ds_player_bind) */
+static uint32_t s_check;       /* output samples since the last handle check */
+static uint64_t s_clock;       /* output samples rendered (debug) */
+static uint32_t s_rng = 0x9E3779B9u;
+
+static void lock(void)   { while (__sync_lock_test_and_set(&s_mu, 1)) { } }
+static void unlock(void) { __sync_lock_release(&s_mu); }
+static uint32_t rnd(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 17; s_rng ^= s_rng << 5; return s_rng; }
+static float frand(void) { return (float)(rnd() & 0xFFFFFF) / 8388608.0f - 1.0f; }   /* -1..1 */
+
+static int ea_ok(uint32_t ea, uint32_t n) { return vm_base && ea >= 0x10000u && ea < 0x40000000u && n <= 0x40000000u - ea; }
+static uint32_t g32(uint32_t ea) { const uint8_t* p = vm_base + ea; return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+
+void ds_player_enable(int on) { s_on = on; }
+
+/* RACACIT_DS_DEBUG=1: voice starts and stops in the log (tests). */
+static int dbg(void) { static int d = -1; if (d < 0) { const char* e = getenv("RACACIT_DS_DEBUG"); d = e && *e == '1'; } return d; }
+int  ds_player_enabled(void) { return s_on; }
+
+/* Each sound name once in the log, with what it played. */
+static void say_once(const char* what, const char* name, const char* detail)
+{
+    static char seen[512][48]; static int n; static volatile long mu;
+    while (__sync_lock_test_and_set(&mu, 1)) { }
+    int i = 0;
+    while (i < n && strcmp(seen[i], name)) i++;
+    const int fresh = i == n && n < 512;
+    if (fresh) snprintf(seen[n++], sizeof seen[0], "%s", name);
+    __sync_lock_release(&mu);
+    if (fresh) fprintf(stderr, "[ds] %s %s%s%c", what, name, detail, 10);
+}
+
+/* ---- voices ---------------------------------------------------------------- */
+
+static const int k_coef[5][2] = { { 0, 0 }, { 60, 0 }, { 115, -52 }, { 98, -55 }, { 122, -60 } };
+
+static int decode_frame(ds_voice* v)
+{
+    if (v->last || v->fr >= v->nfr) return 0;
+    const uint8_t* f = v->data + (size_t)v->fr * 16u;
+    const int pr = f[0] >> 4, sh = f[0] & 15, fl = f[1];
+    const int c1 = pr < 5 ? k_coef[pr][0] : 0, c2 = pr < 5 ? k_coef[pr][1] : 0;
+    if (fl & 4) v->loop_fr = (int)v->fr;
+    for (int i = 0; i < 14; i++) {
+        for (int k = 0; k < 2; k++) {
+            int s = (f[2 + i] >> (k * 4)) & 15;
+            if (s >= 8) s -= 16;
+            int32_t x = (sh <= 12 ? (s << 12) >> sh : 0) + ((v->h1 * c1 + v->h2 * c2) >> 6);
+            if (x > 32767) x = 32767; if (x < -32768) x = -32768;
+            v->h2 = v->h1; v->h1 = x;
+            v->buf[i * 2 + k] = (int16_t)x;
+        }
+    }
+    v->bi = 0;
+    if (fl & 1) {   /* end: repeat from the loop start, or this was the last frame */
+        if ((fl & 2) && v->loop_fr >= 0) v->fr = (uint32_t)v->loop_fr;
+        else v->last = 1;
+    } else v->fr++;
+    return 1;
+}
+
+static int next_sample(ds_voice* v, float* out)
+{
+    if (v->bi >= 28 && !decode_frame(v)) return 0;
+    *out = (float)v->buf[v->bi++] * (1.0f / 32768.0f);
+    return 1;
+}
+
+/* A bank sample's loudness, for the ceiling (v69) and the lift below: its loudest ~40 ms
+ * (64 frames) and ~400 ms (640 frames) RMS, from the first 4096 frames (~2.4 s at 48 kHz),
+ * once per sample (cached by address). */
+static void sample_loudness(const uint8_t* src, uint32_t n, float* r40, float* r400)
+{
+    static struct { const uint8_t* src; uint32_t n, head; float r40, r400; } cache[1024];   /* head: a level reloads banks */
+    const unsigned h = (unsigned)(((uintptr_t)src >> 4) ^ n) & 1023u;
+    uint32_t head; memcpy(&head, src + 2, 4);
+    if (cache[h].src != src || cache[h].n != n || cache[h].head != head) {
+        ds_voice t; memset(&t, 0, sizeof t);
+        t.data = (uint8_t*)src; t.nfr = n < 4096u ? n : 4096u; t.bi = 28;
+        static double fs[640]; memset(fs, 0, sizeof fs);
+        double w40 = 0.0, w400 = 0.0, b40 = 0.0, b400 = 0.0;
+        for (uint32_t f = 0; f < t.nfr && !t.last && decode_frame(&t); f++) {
+            double ss = 0.0;
+            for (int i = 0; i < 28; i++) { const double x = t.buf[i] / 32768.0; ss += x * x; }
+            w40 += ss - fs[(f + 576u) % 640u];      /* the frame 64 ago */
+            w400 += ss - fs[f % 640u];
+            fs[f % 640u] = ss;
+            if (w40 > b40) b40 = w40;
+            if (w400 > b400) b400 = w400;
+            if (t.fr <= f) break;                   /* looped back: measured once through */
+        }
+        cache[h].src = src; cache[h].n = n; cache[h].head = head;
+        cache[h].r40 = (float)sqrt(b40 / (64.0 * 28.0)); cache[h].r400 = (float)sqrt(b400 / (640.0 * 28.0));
+    }
+    *r40 = cache[h].r40; *r400 = cache[h].r400;
+}
+
+/* The ceiling (v69): the gain that brings a sample's loudest ~40 ms down to
+ * RACACIT_DS_VOICE_RMS (default 0.20) and, since 0.9.5, its loudest ~400 ms down to
+ * RACACIT_DS_VOICE_RMS400 (default 0.10), never up. Banks mix samples cut at very different
+ * levels, and every routed sound reached the limiter at its sample's own level ("there needs
+ * to be a clean baseline for how loud certain volumes of weapons can be", owner, v68). 40 ms
+ * alone let a long roar stand at the level of a short pop and sound far louder: shotgun and
+ * Dynamo 0.058-0.069 over 400 ms against 0.03-0.04 for a pop ("some weapons being too loud",
+ * owner, 0.9.4). */
+static float voice_ceiling(const uint8_t* src, uint32_t n)
+{
+    static float ref = -1.0f, ref4;
+    if (ref < 0.0f) { const char* e = getenv("RACACIT_DS_VOICE_RMS"); ref = e ? (float)atof(e) : 0.20f;
+                      e = getenv("RACACIT_DS_VOICE_RMS400"); ref4 = e ? (float)atof(e) : 0.10f; }
+    if (ref <= 0.0f) return 1.0f;
+    float r40, r400; sample_loudness(src, n, &r40, &r400);
+    float g = r40 > ref ? ref / r40 : 1.0f;
+    if (ref4 > 0.0f && r400 * g > ref4) g = ref4 / r400;
+    return g;
+}
+
+/* A sample's frames: whole frames up to and including the first end frame, or `max` bytes. */
+static uint32_t sample_frames(const uint8_t* src, uint32_t max)
+{
+    uint32_t n = 0;
+    for (uint32_t f = 0; (f + 1u) * 16u <= max && (f + 1u) * 16u <= DS_MAX_DATA; f++) {
+        n = f + 1u;
+        if (src[f * 16u + 1] & 1) break;   /* the end frame (a loop's too: it jumps back) */
+    }
+    return n;
+}
+
+/* A voice for the frames at `src` (whole frames up to and including the
+ * first end frame, or `max` bytes); the data is copied. -1 if none is free.
+ * A bank sound's voice (script >= 0) is held to its sample's ceiling, on
+ * the speaker and the actuators. */
+static void voice_free(ds_voice* v);
+static int voice_start(const uint8_t* src, uint32_t max, uint32_t rate, float spk, float felt,
+                       uint32_t owner, int script, uint32_t delay, int up, int down, const char* name)
+{
+    if (rate < 1000u || rate > 192000u || max < 16) return -1;
+    const uint32_t n = sample_frames(src, max);
+    if (!n) return -1;
+    if (script >= 0) {
+        const float g = voice_ceiling(src, n);
+        spk *= g; felt *= g;
+        if (dbg() && g != 1.0f) { static int nl; if (nl++ < 200)
+            fprintf(stderr, "[ds-dbg] %s: sample %p held to its ceiling, x%.2f%c", name ? name : "?", (const void*)src, g, 10); }
+    }
+    int k = -1;
+    for (int i = 0; i < DS_VOICES; i++) if (!s_v[i].used) { k = i; break; }
+    /* Full: an effect makes room -- one already fading, else the oldest. A
+     * line's voice is never taken. The RYNO V's rockets alone held all 64
+     * voices, and its 1812 Overture (a line) found none ("player full",
+     * 0.9.7); a new sound now takes the oldest one's place instead of being
+     * dropped. */
+    if (k < 0) {
+        uint64_t best = 0;
+        for (int i = 0; i < DS_VOICES; i++) {
+            if (!s_v[i].used || s_v[i].line) continue;
+            const uint64_t score = (uint64_t)s_v[i].age + (s_v[i].fade > 0.0f ? (1ull << 40) : 0ull) + 1u;
+            if (score > best) { best = score; k = i; }
+        }
+        if (k >= 0) voice_free(&s_v[k]);
+    }
+    if (k < 0) return -1;
+    uint8_t* d = (uint8_t*)malloc((size_t)n * 16u);
+    if (!d) return -1;
+    memcpy(d, src, (size_t)n * 16u);
+    ds_voice* v = &s_v[k];
+    memset(v, 0, sizeof *v);
+    v->data = d; v->nfr = n; v->loop_fr = -1; v->bi = 28;
+    v->step = v->base = (double)rate / DS_RATE;
+    v->up = up; v->down = down;
+    v->spk = spk; v->felt = felt; v->env = 1.0f;
+    v->owner = owner; v->script = script; v->delay = delay;
+    snprintf(v->name, sizeof v->name, "%s", name ? name : "");
+    if (!next_sample(v, &v->s0)) v->s0 = 0.0f;
+    if (!next_sample(v, &v->s1)) { v->s1 = 0.0f; v->ended = 1; }
+    v->used = 1;
+    return k;
+}
+
+static void voice_free(ds_voice* v) { free(v->data); memset(v, 0, sizeof *v); }
+
+/* Key off: a short fade (the synth's release is not modelled). */
+static void voice_release(ds_voice* v) { if (v->fade == 0.0f) v->fade = 1.0f / (0.030f * DS_RATE); }
+
+/* ---- SCREAM scripts ---------------------------------------------------------- */
+
+static void say_grain(int type)
+{
+    static uint8_t said[256];
+    if (said[type & 255]) return;
+    said[type & 255] = 1;
+    fprintf(stderr, "[ds] grain type 0x%02X not played (first seen)%c", type, 10);
+}
+
+static void tone_start(ds_script* s, uint32_t arg)
+{
+    const uint32_t t = s->tab + arg;
+    if (!ea_ok(t, 24)) return;
+    const uint8_t* r = vm_base + t;
+    int vol = (int8_t)r[1];
+    if (vol < 0) { const int i = -vol - 1; vol = i < 4 && s->reg[i] > 0 ? s->reg[i] : 127; }
+    const int cn = (int8_t)r[2], fine = r[3] & 0x7F;
+    const int down = r[8], up = r[9];
+    const double semis = 60.0 - (cn < 0 ? -cn : cn) + fine / 128.0;
+    const uint32_t rate = (uint32_t)((cn < 0 ? 48000.0 : 44100.0) * pow(2.0, semis / 12.0) + 0.5);
+    const uint32_t ea = g32(t + 16), size = g32(t + 20);
+    const uint32_t max = size && size < DS_MAX_DATA ? size : DS_MAX_DATA;
+    if (!ea_ok(ea, max)) return;
+    /* 0.707: a centred voice's share of the TV's L/R, so a stereo pair (two
+     * tones panned +-15 degrees) sums like the TV's channels do. */
+    const float lv = s->vol * s->lift * (float)(vol > 127 ? 127 : vol) / 127.0f * 0.707f;
+    const int k = voice_start(vm_base + ea, max, rate, lv * s->spk, lv * s->felt, s->owner, (int)(s - s_s), 0, up, down, s->name);
+    if (dbg()) { static int nl; if (nl++ < 400)
+        fprintf(stderr, "[ds-dbg] %s tone +%X: %08X %u Hz vol %.2f (%u frames)%s%c", s->name, arg, ea, rate, lv,
+                k >= 0 ? s_v[k].nfr : 0, k < 0 ? " NOT STARTED" : "", 10); }
+    if (k >= 0) s_v[k].handle = s->handle;
+    if (k >= 0 && s->bend != 0.0f) {
+        const float st = s->bend >= 0.0f ? s->bend * (float)up : s->bend * (float)down;
+        s_v[k].step = s_v[k].base * pow(2.0, st / 12.0);
+    }
+}
+
+/* A pitch bend moves the script's playing voices too (989snd bends a
+ * sound's voices: the Dynamo's charging whine rises by ADD_PB in a loop). */
+static void bend_apply(ds_script* s)
+{
+    for (int i = 0; i < DS_VOICES; i++) {
+        ds_voice* v = &s_v[i];
+        if (!v->used || v->script != (int)(s - s_s)) continue;
+        const float st = s->bend >= 0.0f ? s->bend * (float)v->up : s->bend * (float)v->down;
+        v->step = v->base * pow(2.0, st / 12.0);
+    }
+}
+
+static int script_start(uint32_t bank, uint32_t sound, float vol, float spk, float felt,
+                        uint32_t owner, uint32_t handle, const char* name, int depth);
+
+/* STARTCHILDSOUND: 32 bytes at the tone table + argument {vol s32, pan s32,
+ * register settings, sound s32, name[16]}. */
+static void child_start(ds_script* s, uint32_t arg, int depth)
+{
+    const uint32_t p = s->tab + arg;
+    if (depth > 3 || !ea_ok(p, 32)) return;
+    const int32_t vol = (int32_t)g32(p), snd = (int32_t)g32(p + 12);
+    const float cv = vol > 0 && vol <= 127 ? (float)vol / 127.0f : 1.0f;
+    if (snd >= 0) script_start(s->bank, (uint32_t)snd, s->vol * cv, s->spk, s->felt, s->owner, s->handle, s->name, depth + 1);
+}
+
+/* One grain; returns 0 when the script ends. */
+static int grain_run(ds_script* s, int depth)
+{
+    const uint32_t op = s->g[s->pc][0];
+    const int type = (int)(op >> 24), a = (op >> 16) & 0xFF, b = (op >> 8) & 0xFF, c = op & 0xFF;
+    const uint32_t arg = op & 0xFFFFFF;
+    switch (type) {
+    case 0x01: tone_start(s, arg); break;               /* TONE */
+    case 0x05: child_start(s, arg, depth); break;       /* STARTCHILDSOUND */
+    case 0x14: break;                                   /* CONTROL_NULL */
+    case 0x15: s->loop_pc = s->pc + 1; break;           /* LOOP_START */
+    case 0x16: if (!s->stopping && s->loop_pc >= 0) { s->pc = s->loop_pc - 1; } break;   /* LOOP_END */
+    case 0x17: break;                                   /* LOOP_CONTINUE */
+    case 0x18: return 0;                                /* STOP */
+    case 0x19: case 0x27: {                             /* RAND_PLAY / PLAY_CYCLE: one of a groups of b */
+        if (a < 1 || b < 1) break;
+        int k;
+        if (type == 0x19) k = (int)(rnd() % (uint32_t)a);
+        else {   /* the next one each time this sound plays */
+            static struct { uint32_t key; int n; } cyc[64]; static unsigned nc;
+            const uint32_t key = s->g[0][0] ^ (s->bank * 2654435761u) ^ (uint32_t)s->pc;
+            unsigned i = 0; while (i < nc && cyc[i].key != key) i++;
+            if (i == nc) { i = nc < 64 ? nc++ : (unsigned)(rnd() % 64); cyc[i].key = key; cyc[i].n = 0; }
+            k = cyc[i].n++ % a;
+        }
+        s->pc += k * b;                       /* the grain after this one is the chosen group's first */
+        s->play_left = b;
+        s->skip_after = (a - 1 - k) * b;
+        return 1; }
+    case 0x30: {   /* RAND_PLAY with a 24-byte record {groups, per group, ?, no-repeat depth}.
+                    * Not a tone (its sample is 0xFFFFFFFF in all 88 uses): read as one it
+                    * started nothing and every group after it played at once -- the
+                    * Constructo Shotgun fired 12 shots together into the limiter. */
+        const uint32_t t = s->tab + arg;
+        if (!ea_ok(t, 4)) break;
+        const int ga = vm_base[t], gb = vm_base[t + 1];
+        if (ga < 1 || gb < 1) break;
+        int hist = vm_base[t + 3] < 4 ? vm_base[t + 3] : 3;
+        if (hist > ga - 1) hist = ga - 1;
+        static struct { uint32_t key; int last[4]; } rp[64]; static unsigned nr;
+        const uint32_t key = t ^ (s->bank * 2654435761u);
+        unsigned i = 0; while (i < nr && rp[i].key != key) i++;
+        if (i == nr) { i = nr < 64 ? nr++ : (unsigned)(rnd() % 64); rp[i].key = key; for (int h = 0; h < 4; h++) rp[i].last[h] = -1; }
+        int k = 0;
+        for (int tries = 0; tries < 16; tries++) {   /* not one of the last `hist` picks */
+            k = (int)(rnd() % (uint32_t)ga);
+            int seen = 0; for (int h = 0; h < hist; h++) if (rp[i].last[h] == k) seen = 1;
+            if (!seen) break;
+        }
+        for (int h = 3; h > 0; h--) rp[i].last[h] = rp[i].last[h - 1];
+        rp[i].last[0] = k;
+        s->pc += k * gb;
+        s->play_left = gb;
+        s->skip_after = (ga - 1 - k) * gb;
+        return 1; }
+    case 0x1A: s->countdown += arg ? (int32_t)(rnd() % (arg + 1u)) : 0; break;   /* RAND_DELAY */
+    case 0x1B: s->bend = frand() * (float)a / 127.0f; break;            /* RAND_PB: the tones that follow */
+    case 0x1C: s->bend = (float)(int8_t)a / 127.0f; bend_apply(s); break;   /* PB */
+    case 0x1D: s->bend += (float)(int8_t)a / 127.0f;                      /* ADD_PB */
+               if (s->bend > 1.0f) s->bend = 1.0f; if (s->bend < -1.0f) s->bend = -1.0f;
+               bend_apply(s); break;
+    case 0x1E: if (a < 4) s->reg[a] = (int8_t)b; break;                  /* SET_REGISTER */
+    case 0x1F: if (a < 4) s->reg[a] = b <= c ? b + (int)(rnd() % (uint32_t)(c - b + 1)) : b; break;   /* SET_REGISTER_RAND */
+    case 0x20: if (a < 4) s->reg[a]++; break;                            /* INC_REGISTER */
+    case 0x21: if (a < 4) s->reg[a]--; break;                            /* DEC_REGISTER */
+    case 0x23: break;                                                    /* MARKER */
+    case 0x26: s->waiting = 1; break;                                    /* WAIT_FOR_ALL_VOICES */
+    case 0x29: case 0x2A:                                                /* KEY_OFF_VOICES / KILL_VOICES */
+        for (int i = 0; i < DS_VOICES; i++) if (s_v[i].used && s_v[i].script == (int)(s - s_s)) voice_release(&s_v[i]);
+        break;
+    case 0x2B: if (!s->stopping) { s->parked = 1; return 1; } break;     /* ON_STOP_MARKER: what follows plays on stop */
+    default: say_grain(type); break;
+    }
+    return 1;
+}
+
+/* A script ends; its voices play on, no longer tied to the slot (it is
+ * reused). `kill`: they fade now too. */
+static void script_end(ds_script* s, int kill)
+{
+    for (int i = 0; i < DS_VOICES; i++) {
+        if (!s_v[i].used || s_v[i].script != (int)(s - s_s)) continue;
+        s_v[i].script = -1;
+        if (kill) voice_release(&s_v[i]);
+    }
+    s->used = 0;
+}
+
+static int script_voices(const ds_script* s)
+{
+    for (int i = 0; i < DS_VOICES; i++) if (s_v[i].used && s_v[i].script == (int)(s - s_s)) return 1;
+    return 0;
+}
+
+static void script_tick(ds_script* s)
+{
+    /* Loops run as long as the game lets the sound play; a minute is a
+     * missed stop -- 20 s for a sound the game gave no handle for (only its
+     * stop hook can end it, and some stops take paths no hook sees: the
+     * owner's v66 "the speaker is still looping sounds"). */
+    if (++s->ticks > (s->handle ? 60u : 20u) * DS_TICK_HZ) { script_end(s, 1); return; }
+    if (s->parked) { if (!script_voices(s)) s->used = 0; return; }
+    if (s->waiting) { if (script_voices(s)) return; s->waiting = 0; }
+    if (s->countdown > 0 && --s->countdown > 0) return;
+    for (int guard = 0; guard < 64; guard++) {
+        if (s->pc >= s->ng) { script_end(s, 0); return; }
+        const int pc = s->pc;
+        if (!grain_run(s, 0)) { script_end(s, 0); return; }
+        if (s->parked) return;
+        if (s->play_left > 0 && --s->play_left == 0) { s->pc += s->skip_after; s->skip_after = 0; }
+        const uint32_t delay = s->g[pc][1];
+        s->pc++;
+        if (s->waiting) return;
+        if (delay) { s->countdown = (int32_t)(delay > 100000u ? 100000u : delay); return; }
+    }
+    s->countdown = 1;   /* a zero-delay loop: one pass per tick */
+}
+
+/* A quiet sound brought up, as one sound: the gain that takes its loudest tone, after the
+ * ceiling, up to the ceiling itself, 40 ms and 400 ms, at most RACACIT_DS_LIFT_MAX (default 6). Only for the
+ * names in RACACIT_DS_LIFT (stubs.cpp list syntax without ^): what the player does, not the
+ * hums and tails that are meant to sit low. The Constructo Pistol's shot reached the speaker
+ * at a sixth of the other guns' ("some being too quiet", owner, 0.9.4). A tone at a time (v77)
+ * would have raised a shot's quiet layers as far as its main one. Never a looping sound: a
+ * loop is meant to sit under everything, and the names catch some (the Spiral's "_hit_*_rolling"). */
+static float sound_lift(const ds_script* s, const char* name)
+{
+    static const char* list = (const char*)-1; static float ref = -1.0f, ref4, cap;
+    if (list == (const char*)-1) {
+        const char* e = getenv("RACACIT_DS_LIFT");
+        list = e ? e : "ui_upgrade_,zoni,fire,firing,shot,throw,launch,zap,explo,blast,shockwave,_hit";
+        e = getenv("RACACIT_DS_VOICE_RMS"); ref = e ? (float)atof(e) : 0.20f;
+        e = getenv("RACACIT_DS_VOICE_RMS400"); ref4 = e ? (float)atof(e) : 0.10f;
+        e = getenv("RACACIT_DS_LIFT_MAX"); cap = e ? (float)atof(e) : 6.0f;
+    }
+    int on = 0;
+    if (name && *list)
+        for (const char* q = list; *q && !on; ) {
+            const char* c = strchr(q, ','); const size_t len = c ? (size_t)(c - q) : strlen(q);
+            for (const char* t = name; *t && !on; t++) if (!strncmp(t, q, len)) on = 1;
+            q += len + (c ? 1 : 0);
+        }
+    if (!on || ref <= 0.0f) return 1.0f;
+    float best = 0.0f, best4 = 0.0f;
+    for (int i = 0; i < s->ng; i++) if ((s->g[i][0] >> 24) == 0x15) return 1.0f;   /* LOOP_START */
+    for (int i = 0; i < s->ng; i++) {
+        if ((s->g[i][0] >> 24) != 0x01) continue;
+        const uint32_t t = s->tab + (s->g[i][0] & 0xFFFFFFu);
+        if (!ea_ok(t, 24)) continue;
+        const uint32_t ea = g32(t + 16), size = g32(t + 20), max = size && size < DS_MAX_DATA ? size : DS_MAX_DATA;
+        if (!ea_ok(ea, max)) continue;
+        const uint32_t n = sample_frames(vm_base + ea, max);
+        if (!n) continue;
+        if (vm_base[ea + (n - 1u) * 16u + 1] & 2) return 1.0f;   /* a sample that repeats */
+        float r40, r400; sample_loudness(vm_base + ea, n, &r40, &r400);
+        const int v = (int8_t)vm_base[t + 1];
+        const float k = voice_ceiling(vm_base + ea, n) * (float)(v < 0 ? 127 : v) / 127.0f;
+        if (r40 * k > best) best = r40 * k;
+        if (r400 * k > best4) best4 = r400 * k;
+    }
+    if (best <= 0.0f) return 1.0f;
+    float g = ref / best;
+    if (ref4 > 0.0f && best4 > 0.0f && ref4 / best4 < g) g = ref4 / best4;
+    if (g > cap) g = cap;
+    return g > 1.0f ? g : 1.0f;
+}
+
+static int script_start(uint32_t bank, uint32_t sound, float vol, float spk, float felt,
+                        uint32_t owner, uint32_t handle, const char* name, int depth)
+{
+    if (!ea_ok(bank, 0x40) || g32(bank) != 0x6B6C4253u) return -1;      /* "klBS" */
+    if (sound >= (g32(bank + 0x14) & 0x7FFFu)) return -1;
+    const uint32_t rec = g32(bank + 0x1C) + sound * 12u;
+    if (!ea_ok(rec, 12)) return -1;
+    const uint32_t ng = vm_base[rec + 4], gp = g32(rec + 8);
+    if (!ng || !ea_ok(gp, ng * 8u)) return -1;
+    int k = -1;
+    for (int i = 0; i < DS_SCRIPTS; i++) if (!s_s[i].used) { k = i; break; }
+    if (k < 0) return -1;
+    ds_script* s = &s_s[k];
+    memset(s, 0, sizeof *s);
+    s->bank = bank; s->tab = g32(bank + 0x34);
+    s->ng = (int)(ng < DS_GRAINS ? ng : DS_GRAINS);
+    for (int i = 0; i < s->ng; i++) { s->g[i][0] = g32(gp + i * 8u); s->g[i][1] = g32(gp + i * 8u + 4); }
+    s->loop_pc = s->stop_pc = -1;
+    for (int i = 0; i < s->ng; i++) if ((s->g[i][0] >> 24) == 0x2B) { s->stop_pc = i + 1; break; }
+    s->vol = vol * (float)(vm_base[rec] > 127 ? 127 : vm_base[rec]) / 127.0f;
+    s->spk = spk; s->felt = felt; s->owner = owner; s->handle = handle;
+    snprintf(s->name, sizeof s->name, "%s", name ? name : "");
+    s->lift = sound_lift(s, s->name);
+    s->used = 1;
+    /* The first grains run now: the sound starts with the game's. */
+    script_tick(s);
+    (void)depth;
+    return k;
+}
+
+/* ---- the API -------------------------------------------------------------------- */
+
+/* A game sound instance starting again (the game reuses them) ends what it
+ * played before -- that sound is over in the game even when no stop reached
+ * us. Not the sounds of this same start (one start can begin several). */
+static void owner_restart(uint32_t owner)
+{
+    if (!owner) return;
+    for (int i = 0; i < DS_SCRIPTS; i++)
+        if (s_s[i].used && s_s[i].owner == owner && s_s[i].ticks > DS_TICK_HZ / 10u) script_end(&s_s[i], 1);
+    for (int j = 0; j < DS_VOICES; j++)
+        if (s_v[j].used && s_v[j].owner == owner && s_v[j].script < 0 && s_v[j].age > DS_RATE / 10u) voice_release(&s_v[j]);
+}
+
+void ds_player_scream(uint32_t bank_ea, uint32_t sound, float spk, float felt, uint32_t owner, const char* name)
+{
+    if (!s_on || (spk <= 0.0f && felt <= 0.0f)) return;
+    lock();
+    owner_restart(owner);
+    const int k = script_start(bank_ea, sound, 1.0f, spk, felt, owner, 0, name, 0);
+    unlock();
+    char d[64];
+    snprintf(d, sizeof d, " (bank %08X sound %u)%s%s", bank_ea, sound, spk > 0.0f ? "" : " -- actuators only",
+             k < 0 ? " -- NOT played: bank unreadable or player full" : "");
+    say_once("plays", name && *name ? name : "?", d);
+}
+
+void ds_player_adpcm(const uint8_t* data, uint32_t bytes, uint32_t rate, float spk, float felt, uint32_t owner,
+                     uint32_t delay_ms, const char* name)
+{
+    if (!s_on || !data || bytes < 16) return;
+    lock();
+    owner_restart(owner);
+    const int k = voice_start(data, bytes, rate, spk, felt, owner, -1, (uint32_t)((uint64_t)delay_ms * DS_RATE / 1000u), 0, 0, name);
+    unlock();
+    char d[64];
+    snprintf(d, sizeof d, " (%u bytes at %u Hz)%s", bytes, rate, k < 0 ? " -- NOT played: player full" : "");
+    say_once("plays line", name && *name ? name : "?", d);
+}
+
+/* ---- dialogue lines ------------------------------------------------------------ */
+
+/* The game's streams that are paused now. Every stream is paused for a moment at each start,
+ * so only one still paused after 150 ms counts: then the game has paused its sound (a pause
+ * menu), and the controller's lines hold until it resumes them. */
+#define DS_STREAMS 16
+#define DS_PAUSE_DEBOUNCE (DS_RATE * 3u / 20u)
+static struct { uint32_t stream; uint64_t at; } s_paused[DS_STREAMS];
+static volatile int s_lines_paused;
+static uint64_t s_pause_at;    /* s_clock when they began to hold */
+static uint32_t s_line_serial;
+
+static void pause_clear(void) { memset(s_paused, 0, sizeof s_paused); s_lines_paused = 0; }
+
+/* Once per render block. */
+static void pause_update(void)
+{
+    int on = 0;
+    for (int i = 0; i < DS_STREAMS; i++) if (s_paused[i].stream && s_clock - s_paused[i].at >= DS_PAUSE_DEBOUNCE) on = 1;
+    if (on != s_lines_paused) {
+        if (on) s_pause_at = s_clock;
+        s_lines_paused = on;
+        if (dbg()) fprintf(stderr, "[ds-pause] lines %s at %.2f s%c", on ? "hold" : "go on", s_clock / (double)DS_RATE, 10);
+    }
+}
+
+void ds_player_stream_pause(uint32_t stream, int on)
+{
+    lock();
+    int k = -1, free_k = -1;
+    for (int i = 0; i < DS_STREAMS; i++) {
+        if (s_paused[i].stream == stream) k = i;
+        else if (!s_paused[i].stream && free_k < 0) free_k = i;
+    }
+    if (on && k < 0 && free_k >= 0) { s_paused[free_k].stream = stream; s_paused[free_k].at = s_clock; }
+    else if (!on && k >= 0) s_paused[k].stream = 0;
+    unlock();
+}
+
+uint32_t ds_player_line(const uint8_t* data, uint32_t bytes, uint32_t rate, float spk, uint32_t delay_ms, const char* name)
+{
+    if (!s_on || !data || bytes < 16) return 0;
+    lock();
+    pause_clear();        /* the game is starting speech: nothing of its is held */
+    const uint32_t token = 0x80000000u | (++s_line_serial & 0x7FFFFFFFu);
+    const int k = voice_start(data, bytes, rate, spk, 0.0f, 0u, -1, (uint32_t)((uint64_t)delay_ms * DS_RATE / 1000u), 0, 0, name);
+    if (k >= 0) { s_v[k].line = token; s_v[k].gate = 1.0f; s_v[k].margin = rate * 2u / 28u; }
+    unlock();
+    char d[64];
+    snprintf(d, sizeof d, " (%u bytes at %u Hz)%s", bytes, rate, k < 0 ? " -- NOT played: player full" : "");
+    say_once("plays line", name && *name ? name : "?", d);
+    return token;
+}
+
+void ds_player_line_read(uint32_t token, uint32_t bytes)
+{
+    if (!token) return;
+    const uint32_t fr = bytes / 16u;
+    lock();
+    int moved = 0;
+    for (int j = 0; j < DS_VOICES; j++)
+        if (s_v[j].used && s_v[j].line == token && fr > s_v[j].read_fr) { s_v[j].read_fr = fr; moved = 1; }
+    /* A line the game goes on reading, 2 s into a pause, is not paused: that pause was some
+     * other stream's. */
+    if (moved && s_lines_paused && s_clock - s_pause_at > 2u * DS_RATE) {
+        pause_clear();
+        fprintf(stderr, "[ds-pause] the game is still reading a paused line: playing on%c", 10);
+    }
+    if (moved && dbg()) { static int nl; if (nl++ < 400) for (int j = 0; j < DS_VOICES; j++) if (s_v[j].used && s_v[j].line == token)
+        fprintf(stderr, "[ds-dbg] %s read %u of %u frames, playing frame %u%c", s_v[j].name, fr, s_v[j].nfr, s_v[j].fr, 10); }
+    unlock();
+}
+
+void ds_player_stop_lines(int all)
+{
+    lock();
+    for (int j = 0; j < DS_VOICES; j++) {
+        ds_voice* v = &s_v[j];
+        if (!v->used || !v->line) continue;
+        if (!all && (strstr(v->name, "_zurk_") || strstr(v->name, "_zoni_") || strstr(v->name, "mus_ryno_"))) continue;   /* weapons' lines */
+        if (dbg()) fprintf(stderr, "[ds-dbg] %s stopped by the game at frame %u of %u, %.2f s%c", v->name, v->fr, v->nfr, s_clock / (double)DS_RATE, 10);
+        voice_release(v);
+    }
+    if (all) pause_clear();
+    unlock();
+}
+
+void ds_player_stop(uint32_t owner)
+{
+    if (!owner) return;
+    lock();
+    for (int i = 0; i < DS_SCRIPTS; i++) {
+        ds_script* s = &s_s[i];
+        if (!s->used || s->owner != owner || s->stopping) continue;
+        if (dbg()) { static int nl; if (nl++ < 300) fprintf(stderr, "[ds-dbg] stop %s (instance %08X)%s%c", s->name, owner,
+                                                            s->stop_pc >= 0 ? ": release part" : "", 10); }
+        /* Voices playing now fade; a release part (after ON_STOP_MARKER) plays on. */
+        for (int j = 0; j < DS_VOICES; j++) if (s_v[j].used && s_v[j].script == i) voice_release(&s_v[j]);
+        if (s->stop_pc >= 0 && s->stop_pc < s->ng) {
+            s->stopping = 1; s->parked = 0; s->waiting = 0; s->play_left = 0;
+            s->pc = s->stop_pc; s->countdown = 0;
+        }
+        else s->used = 0;
+    }
+    for (int j = 0; j < DS_VOICES; j++) if (s_v[j].used && s_v[j].owner == owner && s_v[j].script < 0) voice_release(&s_v[j]);
+    unlock();
+}
+
+/* SCREAM's own handle check (func_00982858, without its lock): a handle is
+ * type << 24 | slot << 16 | serial; the slot's handler holds the handle while
+ * the sound lives. Type 5 has its own table of 0x1DC-byte handlers, the
+ * others a {.., count +8, stride +0xC, first +0x10} per type. Anything
+ * unreadable counts as alive. */
+static int scream_alive(uint32_t h)
+{
+    if (!s_snd) return 1;
+    const uint32_t g = s_snd, type = (h >> 24) & 0x1Fu, slot = (h >> 16) & 0xFFu;
+    if (!ea_ok(g - 0x8000u, 0x8000u)) return 1;
+    uint32_t e;
+    if (type == 5) e = g32(g - 0x7FE4u) + slot * 0x1DCu;
+    else {
+        const uint32_t t = g32(g - 0x7FFCu) + type * 4u;
+        if (!ea_ok(t, 4)) return 1;
+        const uint32_t p = g32(t);
+        if (!p) return 0;
+        if (!ea_ok(p, 0x14)) return 1;
+        if ((int32_t)g32(p + 8) <= (int32_t)slot) return 0;
+        e = slot * g32(p + 0xC) + g32(p + 0x10);
+    }
+    if (!e) return 0;
+    return !ea_ok(e, 4) || g32(e) == h;
+}
+
+void ds_player_bind(uint32_t owner, uint32_t handle, uint32_t snd_globals)
+{
+    if (!owner || !handle) return;
+    lock();
+    s_snd = snd_globals;
+    for (int i = 0; i < DS_SCRIPTS; i++) if (s_s[i].used && s_s[i].owner == owner && !s_s[i].handle) s_s[i].handle = handle;
+    for (int j = 0; j < DS_VOICES; j++) if (s_v[j].used && s_v[j].owner == owner && !s_v[j].handle) s_v[j].handle = handle;
+    unlock();
+}
+
+/* Every 20 ms: sounds whose game copy is gone (twice in a row -- the read is
+ * not under SCREAM's lock) end. The game stops some sounds by paths no hook
+ * sees: the Dynamo's rolling loop played on for 20 s+ after the ball was gone
+ * (v63 test). */
+static void check_handles(void)
+{
+    for (int i = 0; i < DS_SCRIPTS; i++) {
+        ds_script* s = &s_s[i];
+        if (!s->used || !s->handle) continue;
+        if (scream_alive(s->handle)) { s->dead = 0; continue; }
+        if (++s->dead < 2) continue;
+        if (dbg()) { static int nl; if (nl++ < 300) fprintf(stderr, "[ds-dbg] game's sound gone: %s (handle %08X)%c", s->name, s->handle, 10); }
+        script_end(s, 1);
+    }
+    for (int j = 0; j < DS_VOICES; j++) {
+        ds_voice* v = &s_v[j];
+        if (!v->used || v->fade > 0.0f) continue;
+        /* A looping voice its script let go of, with no game handle to check:
+         * 8 s, then it ends (nothing routed to the controller loops longer
+         * on its own); any voice ends after 2 minutes (a missed stop). */
+        if ((!v->handle && v->script < 0 && v->loop_fr >= 0 && v->age > 8u * DS_RATE) || v->age > 120u * DS_RATE) {
+            if (dbg()) { static int nl; if (nl++ < 300) fprintf(stderr, "[ds-dbg] %s voice ended at %.1fs (no game handle)%c", v->name, v->age / (double)DS_RATE, 10); }
+            voice_release(v);
+            continue;
+        }
+        if (!v->handle) continue;
+        if (scream_alive(v->handle)) { v->dead = 0; continue; }
+        if (++v->dead < 2) continue;
+        if (dbg()) { static int nl; if (nl++ < 300) fprintf(stderr, "[ds-dbg] game's sound gone: %s voice (%.1fs%s, %.2fs of data left) at %.2fs%c", v->name,
+                                                            v->age / (double)DS_RATE, v->loop_fr >= 0 ? " loop" : "",
+                                                            (v->nfr - v->fr) * 28.0 / DS_RATE / v->step, s_clock / (double)DS_RATE, 10); }
+        voice_release(v);
+    }
+}
+
+void ds_player_stop_all(void)
+{
+    lock();
+    for (int i = 0; i < DS_SCRIPTS; i++) if (s_s[i].used) script_end(&s_s[i], 1);
+    for (int j = 0; j < DS_VOICES; j++) if (s_v[j].used) voice_release(&s_v[j]);
+    unlock();
+}
+
+void ds_player_render(float* speaker, float* felt, unsigned n)
+{
+    if (!s_on) return;
+    lock();
+    if ((s_check += n) >= DS_RATE / 50u) { s_check = 0; check_handles(); }
+    pause_update();
+    for (unsigned o = 0; o < n; o++) {
+        s_tick_acc += (double)DS_TICK_HZ / DS_RATE;
+        if (s_tick_acc >= 1.0) {
+            s_tick_acc -= 1.0;
+            for (int i = 0; i < DS_SCRIPTS; i++) if (s_s[i].used) script_tick(&s_s[i]);
+        }
+        float sp = 0.0f, fe = 0.0f;
+        for (int i = 0; i < DS_VOICES; i++) {
+            ds_voice* v = &s_v[i];
+            if (!v->used) continue;
+            if (v->delay) { v->delay--; continue; }
+            float lg = 1.0f;
+            if (v->line) {
+                /* Paused with the game, or past what it has read (it read some, then stopped).
+                 * A 20 ms fade each way; the line stays where it is. */
+                const int hold = s_lines_paused || (v->read_fr && v->fr > v->read_fr + v->margin && v->fr < v->nfr);
+                if (hold) {
+                    v->gate -= 1.0f / (0.020f * DS_RATE);
+                    if (v->gate <= 0.0f) {
+                        v->gate = 0.0f;
+                        /* Only a line the game stopped reading ends: a pause can last. */
+                        if (!v->held && dbg()) fprintf(stderr, "[ds-dbg] %s holds at frame %u (read %u), %s, %.2f s%c", v->name, v->fr, v->read_fr,
+                                                        s_lines_paused ? "paused" : "past what the game has read", s_clock / (double)DS_RATE, 10);
+                        if (++v->held > 30u * DS_RATE && !s_lines_paused) { voice_free(v); }
+                        continue;
+                    }
+                } else if (v->gate < 1.0f) {
+                    if (v->held && dbg()) fprintf(stderr, "[ds-dbg] %s goes on, %.2f s%c", v->name, s_clock / (double)DS_RATE, 10);
+                    v->gate += 1.0f / (0.020f * DS_RATE); if (v->gate > 1.0f) v->gate = 1.0f; v->held = 0;
+                }
+                lg = v->gate;
+            }
+            const float x = (v->s0 + (v->s1 - v->s0) * (float)v->phase) * v->env * lg;
+            sp += x * v->spk; fe += x * v->felt;
+            v->phase += v->step;
+            while (v->phase >= 1.0) {
+                v->phase -= 1.0;
+                v->s0 = v->s1;
+                if (v->ended || !next_sample(v, &v->s1)) {
+                    if (v->ended) { voice_free(v); break; }
+                    v->s1 = 0.0f; v->ended = 1;
+                }
+            }
+            if (v->used && v->fade > 0.0f) { v->env -= v->fade; if (v->env <= 0.0f) voice_free(v); }
+        }
+        if (speaker) speaker[o] += sp;
+        if (felt) felt[o] += fe;
+    }
+    for (int i = 0; i < DS_VOICES; i++) if (s_v[i].used && !(s_v[i].line && s_v[i].gate <= 0.0f)) s_v[i].age += n;
+    s_clock += n;
+    if (dbg()) {   /* every 10 s: what still plays (a stuck voice shows up here) */
+        static uint32_t clk; clk += n;
+        if (clk >= 10u * DS_RATE) { clk = 0;
+            char b[600]; int o = snprintf(b, sizeof b, "[ds-dbg] playing:");
+            for (int i = 0; i < DS_VOICES && o < 560; i++) if (s_v[i].used)
+                o += snprintf(b + o, sizeof b - o, " %s(%.1fs%s%s)", s_v[i].name, s_v[i].age / (double)DS_RATE,
+                              s_v[i].loop_fr >= 0 ? " loop" : "", s_v[i].spk > 0.0f ? "" : " felt");
+            for (int i = 0; i < DS_SCRIPTS && o < 560; i++) if (s_s[i].used)
+                o += snprintf(b + o, sizeof b - o, " [script %s pc %d/%d%s]", s_s[i].name, s_s[i].pc, s_s[i].ng, s_s[i].parked ? " parked" : "");
+            fprintf(stderr, "%s%c", b, 10); } }
+    unlock();
+}
diff --git a/libs/audio/ds_player.h b/libs/audio/ds_player.h
new file mode 100644
index 0000000..db037b5
--- /dev/null
+++ b/libs/audio/ds_player.h
@@ -0,0 +1,55 @@
+/*
+ * ds_player -- the DualSense speaker's own sound player (see ds_player.c).
+ *
+ * The game side picks what the controller plays and hands whole sounds over;
+ * cellAudio.c pulls the mixed result once per audio block.
+ */
+#ifndef PS3RECOMP_DS_PLAYER_H
+#define PS3RECOMP_DS_PLAYER_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Sounds are taken only while the player is on (cellAudio: a controller
+ * audio device is open, or RACACIT_DS_RAW captures for a test). */
+void ds_player_enable(int on);
+int  ds_player_enabled(void);
+
+/* A SCREAM (989snd SFX block) bank sound, run from its grain script.
+ * `owner` is the game's sound instance -- ds_player_stop(owner) ends it;
+ * `spk` / `felt`: its level on the speaker / the actuators (0 = not there). */
+void ds_player_scream(uint32_t bank_ea, uint32_t sound, float spk, float felt,
+                      uint32_t owner, const char* name);
+
+/* Mono PS-ADPCM (16-byte frames; copied) at `rate` Hz: a dialogue line or a
+ * streamed sound, starting `delay_ms` from now. */
+void ds_player_adpcm(const uint8_t* data, uint32_t bytes, uint32_t rate, float spk, float felt,
+                     uint32_t owner, uint32_t delay_ms, const char* name);
+
+void ds_player_stop(uint32_t owner);   /* the game stopped that sound: fade it out */
+
+/* A dialogue line the controller plays instead of the TV; returns its token. The game keeps
+ * streaming it (the reads are zeroed), so ds_player_line_read(token, bytes) says how far it
+ * has got, and the copy never runs more than 2 s past that: if the game pauses the line or
+ * drops it by a path no hook sees, the copy holds, and after 30 s it ends. */
+uint32_t ds_player_line(const uint8_t* data, uint32_t bytes, uint32_t rate, float spk, uint32_t delay_ms, const char* name);
+void ds_player_line_read(uint32_t token, uint32_t bytes);
+void ds_player_stop_lines(int all);    /* the game ended speech; all = 0: not Mr. Zurkon's or the Zoni's */
+void ds_player_stream_pause(uint32_t stream, int on);   /* SCREAM's stream pause callback */
+
+/* `owner`'s sound is the game's SCREAM sound `handle` (known once the game's
+ * start returned); `snd_globals`: SCREAM's globals. When that sound is gone
+ * -- stopped by a path no hook sees, or over -- the controller's copy ends. */
+void ds_player_bind(uint32_t owner, uint32_t handle, uint32_t snd_globals);
+void ds_player_stop_all(void);
+
+/* The next `n` samples (48 kHz mono), added into speaker[] and felt[]. */
+void ds_player_render(float* speaker, float* felt, unsigned n);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
