+#else
+extern uint64_t ps3_guest_clock_epoch_ns(void);
+static u64 get_timestamp_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (u64)ts.tv_sec * 1000000000ULL + (u64)ts.tv_nsec - ps3_guest_clock_epoch_ns();
