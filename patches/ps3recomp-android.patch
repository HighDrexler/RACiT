+        for (int j = 0; j < 16; j++)
+            p += snprintf(w + p, sizeof w - p, "%02X%02X%02X%02X ", r->line[j*4], r->line[j*4+1], r->line[j*4+2], r->line[j*4+3]);
+        fprintf(stderr, "[line-ring] %llu %c id=%u pc=0x%05X %08X: %s%c", r->t, r->op, r->id, r->pc, r->ea, w, 10);
