+    if (n && pvkGetQueryPoolResults(s_vk.device, s_gp.qp[c], 0, n * 2u, sizeof(u64) * n * 2u, ts, sizeof(u64),
+                                    VK_QUERY_RESULT_64_BIT) == VK_SUCCESS) {
+        for (u32 i = 0; i < n; i++) {
+            const vk_gp_pass* g = &s_gp.p[c][i];
+            const double ms = (double)(ts[i * 2u + 1u] - ts[i * 2u]) * s_gp.ms_per_tick;
+            if (i) s_gp.between_ms += (double)(ts[i * 2u] - ts[i * 2u - 1u]) * s_gp.ms_per_tick;
+            u32 k = 0;
+            while (k < s_gp.nagg && s_gp.agg[k].fb != g->fb) k++;
+            if (k == s_gp.nagg) {
+                if (k >= 256u) continue;
+                s_gp.nagg++;
+                s_gp.agg[k].fb = g->fb; s_gp.agg[k].w = g->w; s_gp.agg[k].h = g->h;
+                s_gp.agg[k].passes = 0; s_gp.agg[k].draws = 0; s_gp.agg[k].verts = 0; s_gp.agg[k].ms = 0.0;
+                s_gp.agg[k].pipes = 0; s_gp.agg[k].sets = 0; s_gp.agg[k].newsets = 0;
+            }
+            s_gp.agg[k].ms += ms; s_gp.agg[k].passes++; s_gp.agg[k].draws += g->draws; s_gp.agg[k].verts += g->verts;
+            s_gp.agg[k].pipes += g->pipes; s_gp.agg[k].sets += g->sets; s_gp.agg[k].newsets += g->newsets;
+        }
+    }
+    const unsigned long long now = ps3_qpc_us();
+    if (now - s_gp.last_us >= 1000000ull) { if (s_gp.last_us) vk_gp_report(); s_gp.last_us = now; }
