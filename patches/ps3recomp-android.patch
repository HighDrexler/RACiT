+static void vk_gp_open(void)
+{
+    static int checked;
+    if (!checked) {
+        checked = 1;
+        const char* e = getenv("RACACIT_GPU_PROF");
+        if (e && *e == '1') {
+            VkPhysicalDeviceProperties p;
+            pvkGetPhysicalDeviceProperties(s_vk.phys, &p);
+            s_gp.ms_per_tick = (double)p.limits.timestampPeriod / 1000000.0;
+            s_gp.on = 1;
+            for (u32 i = 0; i < VK_BT_SLOTS; i++) {
+                VkQueryPoolCreateInfo q = { .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+                                            .queryType = VK_QUERY_TYPE_TIMESTAMP, .queryCount = VK_GP_MAX * 2u };
+                if (pvkCreateQueryPool(s_vk.device, &q, NULL, &s_gp.qp[i]) != VK_SUCCESS) s_gp.on = 0;
+            }
