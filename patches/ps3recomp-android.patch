+typedef struct { uint64_t v[1]; } uint64x1_t;
+#define L4(expr) do { for (int i = 0; i < 4; i++) { r.v[i] = (expr); } return r; } while (0)
+static uint32_t fbits(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+static float bitsf(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+static uint32x4_t vld1q_u32(const uint32_t* p) { uint32x4_t r; L4(p[i]); }
+static void vst1q_u32(uint32_t* p, uint32x4_t a) { for (int i = 0; i < 4; i++) p[i] = a.v[i]; }
+static uint32x4_t vdupq_n_u32(uint32_t x) { uint32x4_t r; L4(x); }
+static uint32x4_t vandq_u32(uint32x4_t a, uint32x4_t b) { uint32x4_t r; L4(a.v[i] & b.v[i]); }
+static uint32x4_t vorrq_u32(uint32x4_t a, uint32x4_t b) { uint32x4_t r; L4(a.v[i] | b.v[i]); }
+static uint32x4_t veorq_u32(uint32x4_t a, uint32x4_t b) { uint32x4_t r; L4(a.v[i] ^ b.v[i]); }
+static uint32x4_t vaddq_u32(uint32x4_t a, uint32x4_t b) { uint32x4_t r; L4(a.v[i] + b.v[i]); }
+static uint32x4_t vsubq_u32(uint32x4_t a, uint32x4_t b) { uint32x4_t r; L4(a.v[i] - b.v[i]); }
+static uint32x4_t vshrq_n_u32(uint32x4_t a, int n) { uint32x4_t r; L4(a.v[i] >> n); }
+static uint32x4_t vshlq_n_u32(uint32x4_t a, int n) { uint32x4_t r; L4(a.v[i] << n); }
+static uint32x4_t vcgtq_u32(uint32x4_t a, uint32x4_t b) { uint32x4_t r; L4(a.v[i] > b.v[i] ? 0xFFFFFFFFu : 0u); }
+static uint32x4_t vcltq_u32(uint32x4_t a, uint32x4_t b) { uint32x4_t r; L4(a.v[i] < b.v[i] ? 0xFFFFFFFFu : 0u); }
+static uint32x4_t vceqq_u32(uint32x4_t a, uint32x4_t b) { uint32x4_t r; L4(a.v[i] == b.v[i] ? 0xFFFFFFFFu : 0u); }
+static uint32x4_t vceqzq_u32(uint32x4_t a) { uint32x4_t r; L4(a.v[i] == 0u ? 0xFFFFFFFFu : 0u); }
