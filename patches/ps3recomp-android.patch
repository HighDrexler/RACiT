+        if (s_geo_bits[k][wi]) { idx = wi * 64u + (u64)__builtin_ctzll(s_geo_bits[k][wi]); s_geo_hint[k] = (u32)wi; break; }
+    }
+    if (idx == ~0ull) return -1;
+    vk_geo_set(k, idx, 0);
+    while (k > cls) { k--; idx <<= 1; vk_geo_set(k, idx + 1u, 1); }   /* keep the lower half */
