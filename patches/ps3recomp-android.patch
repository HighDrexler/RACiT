-        cr_field = 0
-        # Check if first operand is a CR field
-        if ops and ops[0].startswith("cr"):
-            try:
-                cr_field = int(ops[0][2:])
-            except ValueError:
-                pass
-
-        shift = (7 - cr_field) * 4
-
-        cond_map = {
-            "eq": f"((ctx->cr >> {shift}) & 2)",
-            "ne": f"(!((ctx->cr >> {shift}) & 2))",
-            "lt": f"((ctx->cr >> {shift}) & 8)",
-            "ge": f"(!((ctx->cr >> {shift}) & 8))",
-            "gt": f"((ctx->cr >> {shift}) & 4)",
-            "le": f"(!((ctx->cr >> {shift}) & 4))",
-            "so": f"((ctx->cr >> {shift}) & 1)",
-            "ns": f"(!((ctx->cr >> {shift}) & 1))",
-            "dnz": "((ctx->ctr = (uint32_t)(ctx->ctr - 1)) != 0)",
-            "dz": "((ctx->ctr = (uint32_t)(ctx->ctr - 1)) == 0)",
