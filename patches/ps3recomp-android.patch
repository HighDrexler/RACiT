+            const u32 sx0 = (u32)((((u64)u0 << 8) + (u64)x0 * s_nv3089.ds_dx) >> 20);
+            const u32 sx1 = (u32)((((u64)u0 << 8) + (u64)x1 * s_nv3089.ds_dx) >> 20);
