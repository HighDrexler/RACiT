+    if (k >= VK_GEO_CLASSES) return -1;
+    const u64 words = ((VK_GEO_HEAP >> VK_GEO_SHIFT(k)) + 64u) / 64u;
+    u64 idx = ~0ull;
+    for (u64 w = 0; w < words; w++) {
