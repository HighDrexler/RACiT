-void rsx_dsp_get_vertex_attr(const rsx_dispatch* rsx, u32 index, rsx_dsp_vertex_attr* out)
-{
-    memset(out, 0, sizeof(*out));
-    if (index >= RSX_DSP_NUM_VERTEX_ATTR)
