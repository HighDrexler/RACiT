+static _Thread_local int t_crit_boosted, t_crit_nice0, t_crit_nice0_ok;
+static _Thread_local int t_coll_placed;   /* RACACIT_COLL_LITTLE: on the collision core now */
+static __attribute__((noinline)) int spu_job_crit_begin(const spu_context* ctx)
+{
+    if (__builtin_expect(s_crit_on < 0, 0)) {
+        const char* e = getenv("RACACIT_PINGPONG"); const int on = !(e && *e == '0');
+        e = getenv("RACACIT_PINGPONG_NICE"); s_crit_nice = e ? atoi(e) : -10;
+        s_crit_on = on;
+    }
+    const uint8_t* g = ctx->ls + 0x100;
+    const unsigned guid = (unsigned)g[0] << 24 | (unsigned)g[1] << 16 | (unsigned)g[2] << 8 | g[3];
+    const int crit = s_crit_on && racacit_critical_job(guid);
+    if (t_racacit_lane >= 0) { g_racacit_lanes[t_racacit_lane].guid = guid; g_racacit_lanes[t_racacit_lane].critical = crit; }
+    t_racacit_crit = crit;
+    if (s_crit_nice && crit != t_crit_boosted) {
+        const id_t tid = (id_t)gettid();
+        if (!t_crit_nice0_ok) { errno = 0; const int n = getpriority(PRIO_PROCESS, tid); t_crit_nice0 = errno ? 0 : n; t_crit_nice0_ok = 1; }
+        const int want = crit ? s_crit_nice : t_crit_nice0;
+        const int r = setpriority(PRIO_PROCESS, tid, want);
+        static int logs;
