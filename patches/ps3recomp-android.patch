+ * rsx_ww_guest_written_since (is a GPU target's memory the game's again?)
+ * say no, which is what Android did with no write watch at all: render
+ * targets behave exactly as before.
+ *
+ *   pages  host-sized (4 KB or 16 KB), in the three 256 MB pieces Windows polls (0x2, 0x4, 0xC)
+ *   hot    a page written again within 2 s of being armed, twice running, is left
+ *          writable for 10 s (dynamic vertex data the SPUs rewrite every frame): hashed
+ *          as before, no fault per frame. It was 250 ms: at 60 fps a frame's rewrite is
+ *          inside that, at 2 fps it is not, so a slow level re-armed all of its dynamic
+ *          data every frame, and those faults were what kept it at 2 fps
+ *   groups a fault opens the armed pages of its 64 KB: a buffer being filled faults
+ *          once rather than once a page, and leaves fewer mappings behind
+ *   host writes  file reads into guest memory (a kernel write into a
+ *          read-only page is EFAULT, not a signal) and the runtime's own
+ *          mprotect of guest pages bracket themselves with
+ *          rsx_ww_host_write_begin/end and rsx_ww_prot_begin/end
+ *   mappings  every armed run splits a mapping; past 30,000 mappings arming
+ *          stops for the session (the kernel's limit is 65,530)
+ *
+ * RACACIT_NO_WRITE_WATCH=1 turns it off (hash everything, as before 0.16);
+ * RSX_ENG_STATS=1 adds a "[rsx ww]" line every 5 s.
+ */
+#include <signal.h>
+#include <sched.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <stdatomic.h>
+#include <unistd.h>
+
+/* Initialized once, before installing the signal handler or protecting any
+ * memory, and immutable after s_on publishes success. The three 256 MB guest
+ * pieces and the reservation base must be host-page aligned. Guest page tables
+ * stay 4 KB granular; a write anywhere in one host page invalidates that whole
+ * page, including neighbouring guest pages. */
+static unsigned s_page_shift, s_page_size, s_range_pages, s_npages;
+enum { PG_OPEN = 0, PG_ARMED = 1, PG_BUSY = 2,
+       PG_PROT_OPEN, PG_PROT_ARMED, PG_PROT_UNKNOWN, PG_UNKNOWN };
+static int ww_busy(unsigned char state) { return state >= PG_BUSY && state < PG_UNKNOWN; }
+
+unsigned long long g_rsx_ww_poll_us, g_rsx_ww_polls, g_rsx_ww_pages;   /* RSX_ENG_STATS (pages: faults) */
+unsigned long long g_rsx_ww_heap_us, g_rsx_ww_heap_polls, g_rsx_ww_range_us[3];
+unsigned rsx_ww_heap_span_mb(void) { return 0; }
+
+static _Atomic int s_on = -1;
+static int s_arm_ok = 1;                          /* 0 once the mapping count got too high */
+static _Atomic unsigned s_epoch = 1;
+static _Atomic(unsigned char)*  s_state;          /* PG_* */
+static _Atomic(unsigned short)* s_inflight;       /* host writes in progress (no arming) */
+static _Atomic unsigned*        s_stamp;          /* epoch after the last write seen */
+static unsigned* s_armed_ms;                      /* when armed */
+static _Atomic unsigned* s_open_ms;               /* read by other faulting threads */
+static _Atomic unsigned* s_hot_until;
+static unsigned char* s_strikes;
+static struct sigaction s_prev;
+static _Atomic unsigned long long s_faults, s_arms, s_armed_pages, s_hot_marks;
+
+static unsigned ww_ms(void)
+{
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC_COARSE, &t);
+    return (unsigned)((unsigned long long)t.tv_sec * 1000u + (unsigned long long)t.tv_nsec / 1000000u) | 1u;
+}
+
+/* Page index of guest offset `off`, or -1 outside the three pieces. */
+static int ww_index(uint64_t off)
+{
+    if (off >= 0x100000000ull) return -1;
+    const unsigned piece = (unsigned)(off >> 28);
+    const int k = piece == 0x2 ? 0 : piece == 0x4 ? 1 : piece == 0xC ? 2 : -1;
+    return k < 0 ? -1 : k * (int)s_range_pages + (int)((off & 0x0FFFFFFFu) >> s_page_shift);
+}
+static uint8_t* ww_page_ptr(int i)
+{
+    static const uint32_t base[3] = { 0x20000000u, 0x40000000u, 0xC0000000u };
+    return vm_base + base[i / (int)s_range_pages] + ((uint64_t)(i % (int)s_range_pages) << s_page_shift);
+}
+
+/* Armed -> open (writable), stamped as written now. 1 if it was armed. */
+static int ww_open(int i, int fault)
+{
+    for (;;) {
+        unsigned char st = atomic_load(&s_state[i]);
+        if (ww_busy(st)) { sched_yield(); continue; }
+        if (st != PG_ARMED && st != PG_UNKNOWN) return 0;
+        if (!atomic_compare_exchange_weak(&s_state[i], &st, PG_BUSY)) continue;
+        atomic_store(&s_stamp[i], atomic_load(&s_epoch) + 1u);
+        if (mprotect(ww_page_ptr(i), (size_t)1 << s_page_shift, PROT_READ | PROT_WRITE) != 0) {
+            /* Do not claim a handled fault when the page is still protected.
+             * A real protection/mapping error belongs to the crash handler. */
+            atomic_store(&s_state[i], st);
+            return -1;
+        }
+        const unsigned now = ww_ms();
+        if (fault && st == PG_ARMED) {
+            if (now - s_armed_ms[i] < 2000u) {
+                if (++s_strikes[i] >= 2) { s_hot_until[i] = now + 10000u; s_strikes[i] = 0; atomic_fetch_add(&s_hot_marks, 1); }
+            } else s_strikes[i] = 0;
+        }
+        s_open_ms[i] = now;
+        if (st == PG_ARMED) atomic_fetch_sub(&s_armed_pages, 1);
+        atomic_store(&s_state[i], PG_OPEN);
+        return 1;
+    }
+}
+
+/* After page i faulted open: the other armed pages of its 64 KB, in one mprotect a run. */
+static void ww_open_group(int i)
+{
+    const int n = (int)(65536u >> s_page_shift), g0 = i & ~(n - 1);
+    const unsigned stamp = atomic_load(&s_epoch) + 1u, now = ww_ms(), hot = atomic_load(&s_hot_until[i]);
+    int run = -1;
+    for (int j = g0; j <= g0 + n; j++) {
+        unsigned char st = PG_ARMED;
+        if (j < g0 + n && j != i && atomic_compare_exchange_strong(&s_state[j], &st, PG_BUSY)) {
+            atomic_store(&s_stamp[j], stamp);
+            if (run < 0) run = j;
+            continue;
+        }
+        if (run < 0) continue;
+        const int ok = mprotect(ww_page_ptr(run), (size_t)(j - run) << s_page_shift, PROT_READ | PROT_WRITE) == 0;
+        for (int k = run; k < j; k++) {
+            if (ok) { s_open_ms[k] = now; atomic_fetch_sub(&s_armed_pages, 1); }
+            atomic_store(&s_state[k], ok ? PG_OPEN : PG_ARMED);
+        }
+        run = -1;
+    }
+    if (hot && (int)(hot - now) > 0)
+        for (int j = g0; j < g0 + n; j++) atomic_store(&s_hot_until[j], hot);
+}
+
+static void ww_segv(int sig, siginfo_t* si, void* uc)
+{
+    if (si && si->si_code == SEGV_ACCERR && vm_base && s_on == 1) {
+        const uintptr_t a = (uintptr_t)si->si_addr, b = (uintptr_t)vm_base;
+        const int i = a >= b ? ww_index((uint64_t)(a - b)) : -1;
+        if (i >= 0) {
+            const int opened = ww_open(i, 1);
+            if (opened > 0) { ww_open_group(i); atomic_fetch_add(&s_faults, 1); return; }
+            /* Opened by another thread between the fault and here: just retry. */
+            const unsigned last_open = atomic_load(&s_open_ms[i]);
+            if (!opened && last_open && ww_ms() - last_open < 1000u) return;
+        }
+    }
+    /* Not ours: whoever was installed before (the guest-pointer report, Android's crash handler). */
+    if ((s_prev.sa_flags & SA_SIGINFO) && s_prev.sa_handler != SIG_DFL && s_prev.sa_handler != SIG_IGN) {
+        s_prev.sa_sigaction(sig, si, uc); return;
+    }
+    if (s_prev.sa_handler && s_prev.sa_handler != SIG_DFL && s_prev.sa_handler != SIG_IGN) { s_prev.sa_handler(sig); return; }
+    struct sigaction dfl; memset(&dfl, 0, sizeof dfl); dfl.sa_handler = SIG_DFL; sigemptyset(&dfl.sa_mask);
+    sigaction(sig, &dfl, NULL);
+}
+
+int rsx_ww_on(void)
+{
+    /* -2 owns initialization. Readers must not see half-built metadata or
+     * install competing handlers. Signals do not wait on this state. */
+    for (;;) {
+        int state = atomic_load(&s_on);
+        if (state >= 0) return state;
+        if (state == -2) { sched_yield(); continue; }
+        if (atomic_compare_exchange_weak(&s_on, &state, -2)) break;
+    }
+    const char* e = getenv("RACACIT_NO_WRITE_WATCH");
+    if (e && *e && *e != '0') {
+        fprintf(stderr, "[rsx ww] disabled by RACACIT_NO_WRITE_WATCH: cached data is hashed instead%c", 10);
+        goto disabled;
+    }
+    if (!vm_base) {
+        fprintf(stderr, "[rsx ww] guest reservation is unavailable: cached data is hashed instead%c", 10);
+        goto disabled;
+    }
+    const long host_page = sysconf(_SC_PAGESIZE);
+    if (host_page != 4096 && host_page != 16384) {
+        fprintf(stderr, "[rsx ww] unsupported host page size %ld: cached data is hashed instead%c", host_page, 10);
+        goto disabled;
+    }
+    if ((uintptr_t)vm_base & ((uintptr_t)host_page - 1u)) {
+        fprintf(stderr, "[rsx ww] guest reservation is not %ld-byte aligned: cached data is hashed instead%c", host_page, 10);
+        goto disabled;
+    }
+    s_page_shift = host_page == 16384 ? 14u : 12u;
+    s_page_size = (unsigned)host_page;
+    s_range_pages = 0x10000000u >> s_page_shift;
+    s_npages = 3u * s_range_pages;
+    s_state = calloc(s_npages, sizeof *s_state);
+    s_inflight = calloc(s_npages, sizeof *s_inflight);
+    s_stamp = calloc(s_npages, sizeof *s_stamp);
+    s_armed_ms = calloc(s_npages, sizeof *s_armed_ms);
+    s_open_ms = calloc(s_npages, sizeof *s_open_ms);
+    s_hot_until = calloc(s_npages, sizeof *s_hot_until);
+    s_strikes = calloc(s_npages, sizeof *s_strikes);
+    if (!s_state || !s_inflight || !s_stamp || !s_armed_ms || !s_open_ms || !s_hot_until || !s_strikes) {
+        fprintf(stderr, "[rsx ww] metadata allocation failed: cached data is hashed instead%c", 10);
+        goto disabled;
+    }
+    for (unsigned i = 0; i < s_npages; i++) {
+        atomic_init(&s_state[i], PG_OPEN);
+        atomic_init(&s_inflight[i], 0);
+        atomic_init(&s_stamp[i], 1u); /* Unknown history: written. */
+        atomic_init(&s_open_ms[i], 0);
+        atomic_init(&s_hot_until[i], 0);
+    }
+    /* A signal handler must never enter a library-emulated atomic lock. */
+    if (!atomic_is_lock_free(&s_state[0]) || !atomic_is_lock_free(&s_inflight[0]) ||
+        !atomic_is_lock_free(&s_stamp[0]) || !atomic_is_lock_free(&s_faults)) {
+        fprintf(stderr, "[rsx ww] signal-handler atomics are not lock-free: cached data is hashed instead%c", 10);
+        goto disabled;
+    }
+    struct sigaction sa; memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = ww_segv; sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESTART;
+    sigemptyset(&sa.sa_mask);
+    if (sigaction(SIGSEGV, &sa, &s_prev) != 0) {
+        fprintf(stderr, "[rsx ww] signal-handler installation failed: cached data is hashed instead%c", 10);
+        goto disabled;
+    }
+    atomic_store(&s_on, 1);
+    fprintf(stderr, "[rsx ww] write watch on (%u-byte host pages): cached geometry and textures are rechecked only when written%c", s_page_size, 10);
+    return 1;
+disabled:
+    free(s_state); s_state = NULL;
+    free(s_inflight); s_inflight = NULL;
+    free(s_stamp); s_stamp = NULL;
+    free(s_armed_ms); s_armed_ms = NULL;
+    free(s_open_ms); s_open_ms = NULL;
+    free(s_hot_until); s_hot_until = NULL;
+    free(s_strikes); s_strikes = NULL;
+    atomic_store(&s_on, 0);
+    return 0;
+}
+
+/* Mappings in the process: a runaway count of armed runs would hit the kernel's limit. */
+static unsigned ww_mappings(void)
+{
+    FILE* f = fopen("/proc/self/maps", "r");
+    if (!f) return 0;
+    char buf[65536]; size_t n; unsigned lines = 0;
+    while ((n = fread(buf, 1, sizeof buf, f)) > 0) for (size_t k = 0; k < n; k++) lines += buf[k] == 10;
+    fclose(f);
+    return lines;
+}
+
+/* Runs of pages that may be read-only (armed, or in the middle of a protection
+ * change): each splits its mapping in up to three, so the mappings the write
+ * watch adds are at most twice this. A pass over the page states, no syscall. */
+static unsigned ww_ro_runs(void)
+{
+    unsigned runs = 0;
+    int prev = 0;
+    for (unsigned i = 0; i < s_npages; i++) {
+        if (i % s_range_pages == 0) prev = 0;             /* the three pieces are not neighbours */
+        const unsigned char st = atomic_load_explicit(&s_state[i], memory_order_relaxed);
+        const int ro = st != PG_OPEN && st != PG_PROT_OPEN;
+        runs += ro && !prev;
+        prev = ro;
+    }
+    return runs;
+}
+
+/* The mapping count, every 5 s. It was a read of all of /proc/self/maps each
+ * time, on the render thread (rsx_ww_poll runs in the FIFO walker): thousands
+ * of lines (3,000-5,300 in the .21 diagnostics) made under the kernel's mmap
+ * lock, which every write-watch fault's mprotect on the other game threads
+ * waits for. Now the count is the last real one plus what arming has added
+ * since (ww_ro_runs, an upper bound), and the file is read only when that
+ * estimate passes 20,000 (at most every 10 s), every 5 minutes to follow the
+ * rest of the process, and every time with RSX_ENG_STATS=1. */
+static void ww_tick(void)
+{
+    static unsigned s_next, s_stats = 2;
+    static unsigned s_base, s_have_base, s_real_ms;
+    const unsigned now = ww_ms();
+    if (now < s_next) return;
+    s_next = now + 5000u;
+    if (s_stats == 2) s_stats = getenv("RSX_ENG_STATS") ? 1 : 0;
+    unsigned maps = 0;
+    if (s_arm_ok) {
+        const unsigned runs = ww_ro_runs(), est = s_base + 2u * runs;
+        if (s_stats || !s_have_base || now - s_real_ms >= 300000u || (est > 20000u && now - s_real_ms >= 10000u)) {
+            maps = ww_mappings();
+            s_base = maps > 2u * runs ? maps - 2u * runs : 0u;
+            s_have_base = 1; s_real_ms = now;
+        } else maps = est > 30000u ? 30000u : est;    /* only a real count stops arming */
+    }
+    if (s_arm_ok && maps > 30000u) {
+        s_arm_ok = 0;
+        unsigned opened = 0;
+        for (int i = 0; i < (int)s_npages; i++) opened += ww_open(i, 0) > 0;
+        fprintf(stderr, "[rsx ww] %u mappings: arming stopped for this run (%u pages opened); caches hash again%c", maps, opened, 10);
+    }
+    if (s_stats)
+        fprintf(stderr, "[rsx ww] 5 s: %llu faults, %llu arms, %llu pages armed, %llu hot marks, %u mappings%c",
+                (unsigned long long)atomic_exchange(&s_faults, 0), (unsigned long long)atomic_exchange(&s_arms, 0),
+                (unsigned long long)atomic_load(&s_armed_pages), (unsigned long long)atomic_exchange(&s_hot_marks, 0), maps, 10);
+}
+
+void rsx_ww_poll(void)
+{
+    if (!rsx_ww_on()) return;
+    atomic_fetch_add(&s_epoch, 1);
+    g_rsx_ww_polls++;
+    ww_tick();
+}
+void rsx_ww_poll_heap(void)
+{
+    if (!rsx_ww_on()) return;
+    atomic_fetch_add(&s_epoch, 1);
+    g_rsx_ww_heap_polls++;
+}
+unsigned int rsx_ww_epoch(void) { return atomic_load(&s_epoch); }
+
+/* Arms pages [i0, i1) (all PG_BUSY, taken by the caller) with stamp `st`. */
+static void ww_arm_run(int i0, int i1, unsigned st, unsigned now)
+{
+    if (i0 >= i1) return;
+    const int ok = mprotect(ww_page_ptr(i0), (size_t)(i1 - i0) << s_page_shift, PROT_READ) == 0;
+    for (int i = i0; i < i1; i++) {
+        if (ok) { atomic_store(&s_stamp[i], st); s_armed_ms[i] = now; }
+        atomic_store(&s_state[i], ok ? PG_ARMED : PG_OPEN);
+    }
+    if (ok) { atomic_fetch_add(&s_arms, 1); atomic_fetch_add(&s_armed_pages, (unsigned long long)(i1 - i0)); }
+}
+
+int rsx_ww_written_since(const void* host, unsigned int len, unsigned int epoch)
+{
+    if (s_on != 1 || !host || !len) return 1;
+    const uint64_t off = (uint64_t)((const uint8_t*)host - vm_base);
+    const int first = ww_index(off), last = ww_index(off + len - 1u);
+    if (first < 0 || last < 0 || last - first != (int)(((off + len - 1u) >> s_page_shift) - (off >> s_page_shift)))
+        return 1;   /* outside the watched pieces, or across two */
+    int written = 0, run = -1;
+    unsigned st = 0, now = 0;
+    for (int i = first; i <= last; i++) {
+        unsigned char s = atomic_load(&s_state[i]);
+        if (s == PG_ARMED) {
+            if (atomic_load(&s_stamp[i]) > epoch) written = 1;
+            if (run >= 0) { ww_arm_run(run, i, st, now); run = -1; }
+            continue;
+        }
+        written = 1;
+        /* Not armed: arm it, so the next ask has an answer. The epoch moves
+         * first: a reader that validated while it was open, in this epoch,
+         * then sees it as written, and the caller -- which reads the epoch
+         * after asking -- records one the stamp does not exceed. */
+        /* The clock every 64th ask: this is the usual path on pages the game keeps writing,
+         * a tenth of the render thread's own time with a read each, and the rules it serves
+         * are in seconds. */
+        if (!now) { static unsigned c_ms, c_n; if (!(c_n++ & 63u) || !c_ms) c_ms = ww_ms(); now = c_ms; }
+        const unsigned hot_until = atomic_load(&s_hot_until[i]);
+        if (s == PG_OPEN && s_arm_ok && !atomic_load(&s_inflight[i]) && (!hot_until || (int)(hot_until - now) <= 0) &&
+            atomic_compare_exchange_strong(&s_state[i], &s, PG_BUSY)) {
+            /* A host writer can increment inflight between our first check
+             * and the CAS. Once BUSY is ours, check again before protecting.
+             * A writer starting later waits for BUSY then opens the page. */
+            if (atomic_load(&s_inflight[i])) {
+                atomic_store(&s_state[i], PG_OPEN);
+                if (run >= 0) { ww_arm_run(run, i, st, now); run = -1; }
+                continue;
+            }
+            if (run < 0) {
+                if (!st) st = atomic_fetch_add(&s_epoch, 1) + 1u;
+                run = i;
+            }
+            continue;
+        }
+        if (run >= 0) { ww_arm_run(run, i, st, now); run = -1; }
+    }
+    if (run >= 0) ww_arm_run(run, last + 1, st, now);
+    return written;
+}
+
+/* Render targets: as with no write watch (see above). */
+int rsx_ww_watched(const void* host, unsigned int len) { (void)host; (void)len; return 0; }
+int rsx_ww_guest_written_since(const void* host, unsigned int len, unsigned int epoch)
+{ (void)host; (void)len; (void)epoch; return 0; }
+
+/* A write into guest memory that does not go through user-space stores --
+ * the kernel filling a file read -- or that the engine makes itself: open
+ * the pages first and keep them from being armed until it is done. */
+void rsx_ww_host_write_begin(const void* host, size_t len)
+{
+    if (s_on != 1 || !host || !len) return;
+    const uint64_t off = (uint64_t)((const uint8_t*)host - vm_base);
+    if (off >= 0x100000000ull) return;
+    const uint64_t end = len > 0x100000000ull - off ? 0x100000000ull : off + len;
+    for (uint64_t p = off & ~(uint64_t)(s_page_size - 1u); p < end; p += s_page_size) {
+        const int i = ww_index(p);
+        if (i < 0) continue;
+        atomic_fetch_add(&s_inflight[i], 1);
+        ww_open(i, 0);
+    }
+}
+void rsx_ww_host_write_end(const void* host, size_t len)
+{
+    if (s_on != 1 || !host || !len) return;
+    const uint64_t off = (uint64_t)((const uint8_t*)host - vm_base);
+    if (off >= 0x100000000ull) return;
+    const uint64_t end = len > 0x100000000ull - off ? 0x100000000ull : off + len;
+    const unsigned st = atomic_load(&s_epoch) + 1u;
+    for (uint64_t p = off & ~(uint64_t)(s_page_size - 1u); p < end; p += s_page_size) {
+        const int i = ww_index(p);
+        if (i < 0) continue;
+        atomic_store(&s_stamp[i], st);
+        atomic_fetch_sub(&s_inflight[i], 1);
+    }
+}
+void rsx_ww_self_begin(const void* host, unsigned int len) { rsx_ww_host_write_begin(host, len); }
+void rsx_ww_self_end(const void* host, unsigned int len) { rsx_ww_host_write_end(host, len); }
+
+/* The runtime changing the protection of guest pages (vm.h): hold them
+ * (no arming, faults wait) across its mprotect, then forget they were ours. */
+void rsx_ww_prot_begin(const void* host, size_t len)
+{
+    if (s_on != 1 || !host || !len) return;
+    const uint64_t off = (uint64_t)((const uint8_t*)host - vm_base);
+    if (off >= 0x100000000ull) return;
+    const uint64_t end = len > 0x100000000ull - off ? 0x100000000ull : off + len;
+    for (uint64_t p = off & ~(uint64_t)(s_page_size - 1u); p < end; p += s_page_size) {
+        const int i = ww_index(p);
+        if (i < 0) continue;
+        for (;;) {
+            unsigned char s = atomic_load(&s_state[i]);
+            if (ww_busy(s)) { sched_yield(); continue; }
+            const unsigned char held = s == PG_ARMED ? PG_PROT_ARMED : s == PG_UNKNOWN ? PG_PROT_UNKNOWN : PG_PROT_OPEN;
+            if (atomic_compare_exchange_weak(&s_state[i], &s, held)) {
+                if (s == PG_ARMED) atomic_fetch_sub(&s_armed_pages, 1);
+                break;
+            }
+        }
+    }
+}
+void rsx_ww_prot_end(const void* host, size_t len, int success)
+{
+    if (s_on != 1 || !host || !len) return;
+    const uint64_t off = (uint64_t)((const uint8_t*)host - vm_base);
+    if (off >= 0x100000000ull) return;
+    const uint64_t end = len > 0x100000000ull - off ? 0x100000000ull : off + len;
+    const unsigned st = atomic_load(&s_epoch) + 1u;
+    for (uint64_t p = off & ~(uint64_t)(s_page_size - 1u); p < end; p += s_page_size) {
+        const int i = ww_index(p);
+        if (i < 0) continue;
+        const unsigned char held = atomic_load(&s_state[i]);
+        atomic_store(&s_stamp[i], st);
+        s_open_ms[i] = 0;
+        /* mprotect over multiple VMAs may fail after changing some pages.
+         * Never restore ARMED (which could falsely report writable bytes as
+         * clean). Formerly watched pages become UNKNOWN: always hashed, and
+         * a real protection fault or host-write bracket may reopen them.
+         * Pages that were not ours must retain the runtime's fault semantics. */
+        atomic_store(&s_state[i], success || held == PG_PROT_OPEN ? PG_OPEN : PG_UNKNOWN);
+    }
+}
+
+#else   /* no write watch: every reader hashes */
+void rsx_ww_host_write_begin(const void* host, size_t len) { (void)host; (void)len; }
+void rsx_ww_host_write_end(const void* host, size_t len) { (void)host; (void)len; }
+void rsx_ww_prot_begin(const void* host, size_t len) { (void)host; (void)len; }
+void rsx_ww_prot_end(const void* host, size_t len, int success) { (void)host; (void)len; (void)success; }
+unsigned rsx_ww_heap_span_mb(void) { return 0; }
+unsigned long long g_rsx_ww_poll_us, g_rsx_ww_polls, g_rsx_ww_pages;   /* RSX_ENG_STATS */
+unsigned long long g_rsx_ww_heap_us, g_rsx_ww_heap_polls, g_rsx_ww_range_us[3];
+int          rsx_ww_watched(const void* host, unsigned int len) { (void)host; (void)len; return 0; }
+int          rsx_ww_on(void) { return 0; }
+void         rsx_ww_poll(void) {}
+void         rsx_ww_poll_heap(void) {}
+unsigned int rsx_ww_epoch(void) { return 0; }
+int          rsx_ww_written_since(const void* host, unsigned int len, unsigned int epoch)
+{ (void)host; (void)len; (void)epoch; return 1; }
+int          rsx_ww_guest_written_since(const void* host, unsigned int len, unsigned int epoch)
+{ (void)host; (void)len; (void)epoch; return 1; }
+void         rsx_ww_self_begin(const void* host, unsigned int len) { (void)host; (void)len; }
+void         rsx_ww_self_end(const void* host, unsigned int len) { (void)host; (void)len; }
+#endif
diff --git a/libs/video/rsx_writewatch.h b/libs/video/rsx_writewatch.h
new file mode 100644
index 0000000..12afb7a
--- /dev/null
+++ b/libs/video/rsx_writewatch.h
@@ -0,0 +1,68 @@
+/*
+ * rsx_writewatch -- which pages of guest memory were written, and when.
+ *
+ * The draw engine keeps converted geometry and decoded textures and has to
+ * notice when the guest rewrites them. Hashing every cached byte on every use
+ * was the largest single cost of a draw (Zolar Forest: ~20 MB of textures a
+ * frame plus every draw's vertices). On Windows the guest's address space is
+ * reserved with MEM_WRITE_WATCH, so the OS tracks every write to it -- by the
+ * PPU, SPU DMA, file reads, anything -- and this hands that out as epochs:
+ *
+ *   rsx_ww_poll()   once per FIFO pass, after `put` is read: every page written
+ *                   since the last poll gets the new epoch. The guest writes
+ *                   a draw's data before it moves put, so a draw's data is
+ *                   always stamped before the draw is processed.
+ *   rsx_ww_poll_heap()
+ *                   the same for the title's heap range only (0x20000000), at
+ *                   a FIFO semaphore ACQUIRE: SPU jobs fill vertex data there
+ *                   after the commands are queued and release the label, with
+ *                   no move of put. A third of the cost of a full poll.
+ *   rsx_ww_written_since(p, n, e)
+ *                   was any page of [p, p+n) stamped after epoch e? A reader
+ *                   that validated its copy during epoch e asks this; a write
+ *                   that raced the validation lands in e+1 and is caught.
+ *   rsx_ww_self_begin(p, n) / rsx_ww_self_end(p, n)
+ *                   around the engine's own writes into guest memory (a GPU
+ *                   target read back into it): they are not the guest's, and
+ *                   must not mark the other targets on the same pages as
+ *                   rewritten by the game (rsx_ww_guest_written_since).
+ *
+ * Linux/Android uses page protection for cached guest bytes on 4 KB or 16 KB hosts;
+ * kernel writes and runtime protection changes use the brackets below.
+ * GPU-target overwrite detection remains conservative on that path.
+ * Off (rsx_ww_on() == 0) when the reservation is unsupported, on Linux
+ * hosts with other page sizes or a misaligned reservation, or with
+ * RACACIT_NO_WRITE_WATCH=1: callers hash. Initialize after VM/crash-handler
+ * setup and before guest threads start, so all kernel writes are bracketed.
+ */
+#ifndef PS3RECOMP_RSX_WRITEWATCH_H
+#define PS3RECOMP_RSX_WRITEWATCH_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int          rsx_ww_on(void);
+void         rsx_ww_poll(void);
+void         rsx_ww_poll_heap(void);
+unsigned int rsx_ww_epoch(void);
+int          rsx_ww_written_since(const void* host, unsigned int len, unsigned int epoch);
+int          rsx_ww_guest_written_since(const void* host, unsigned int len, unsigned int epoch);
+int          rsx_ww_watched(const void* host, unsigned int len);
+void         rsx_ww_self_begin(const void* host, unsigned int len);
+void         rsx_ww_self_end(const void* host, unsigned int len);
+/* Android's page-protection watch (rsx_writewatch.c): a write into guest
+ * memory made by the kernel (a file read) brackets itself with
+ * host_write_begin/end; the runtime's own mprotect of guest pages (vm.h)
+ * with prot_begin/end. No-ops on the other hosts. */
+void         rsx_ww_host_write_begin(const void* host, size_t len);
+void         rsx_ww_host_write_end(const void* host, size_t len);
+void         rsx_ww_prot_begin(const void* host, size_t len);
+void         rsx_ww_prot_end(const void* host, size_t len, int success);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
