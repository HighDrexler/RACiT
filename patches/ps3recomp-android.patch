+void racacit_ring_dump(void)
+{
+    if (!ring_on()) return;
+    const long n = s_ring_n;
+    fprintf(stderr, "[line-ring] %ld events on %08X %08X %08X %08X, the last %d:%c", n, s_ring_ea[0], s_ring_ea[1], s_ring_ea[2], s_ring_ea[3],
