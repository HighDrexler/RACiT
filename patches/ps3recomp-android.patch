+__attribute__((used, visibility("hidden"), noreturn)) void racacit_fiber_main(racacit_fiber* f)
+{
+    /* The job may leave through spu_halt or spu_restart_dispatch, whose longjmp targets the
+     * driver frame of the thread that armed it -- not on this stack, and maybe not this thread
+     * (bionic's longjmp then dies: .28, SIGILL on the main thread). Inside a fiber they switch
+     * straight back to the resumer instead (racacit_fiber_nonlocal), dropping this stack, and the
+     * lane repeats the exit on its own stack afterwards. */
+    spu_drain_call_run(f->ctx, f->return_pc);
+    __atomic_store_n(&f->exit_, 1, __ATOMIC_RELEASE);
+    racacit_fswitch(&f->sp, f->back_sp);   /* never resumed again */
+    __builtin_trap();
+}
+
+/* Opt-in (RACACIT_COLL_FIBER=1) since v113-android.36: still open, a 400-800 ms hitch right
+ * after the respawn autosave in every fiber run and in none without (STATUS.txt, .33-.35); light
+ * scenes +15%, combat no gain. The Thor ran .35 with it off for that reason. */
+static int racacit_fiber_on(void)
+{
+    static int on = -1;
+    if (__builtin_expect(on < 0, 0)) { const char* e = getenv("RACACIT_COLL_FIBER"); on = e && *e == '1'; }
+    return on;
+}
+extern int racacit_ctx_wait_ready(const void* ctx);   /* spu_channels.c */
+extern int racacit_ctx_line_changed(const void* ctx);  /* spu_channels.c */
+/* Its event has come -- or it has been parked past the bound: a lock-line wait ends at its bound
+ * without an event too (spu_lr_wait, SPU_LR_WAIT_US), and the guest reads the line again. Some
+ * writes reach a line with no event (the lock-free store path: ~12% of the collision lanes' waits
+ * ended at the bound), so without this a fiber waited for good while the main thread waited for
+ * it (.29: the game stopped in Space Sector 1). 20 us (RACACIT_FIBER_BOUND_US): the main thread
+ * looks every poll of its own wait, so such a write costs at most that, where a lane slept 200. */
+/* v113-android.44: ...or its line holds other bytes than it read, which is what a lane's spin looks
+ * for on every turn (spu_resv_lost_poll): such a write was seen here only when the bound ran out,
+ * up to 20 us of the main thread's wait for each. RACACIT_FIBER_LINE_POLL=0: the bound alone. */
+static unsigned long long s_fib_bound = 0;
+static int s_fib_line_poll = 1;
+static inline int racacit_fiber_ready(racacit_fiber* f)
+{
+    if (__builtin_expect(!s_fib_bound, 0)) {
+        const char* e = getenv("RACACIT_FIBER_BOUND_US"); const long us = e ? atol(e) : 20;
+        const char* lp = getenv("RACACIT_FIBER_LINE_POLL"); s_fib_line_poll = !(lp && *lp == '0');
+        s_fib_bound = (unsigned long long)(us > 0 ? us : 1) * 192ull / 10ull;   /* the 19.2 MHz counter */
+    }
+    return f->poll || racacit_ctx_wait_ready(f->ctx) || (s_fib_line_poll && racacit_ctx_line_changed(f->ctx)) ||
+           racacit_lane_clock() - f->parked_at > s_fib_bound;
+}
+/* The caller set state 2. Runs the fiber until it parks or finishes. */
+extern void racacit_ring_note(char op, uint32_t id, uint32_t pc, uint32_t ea, int only_if_changed);
+static void racacit_fiber_resume(racacit_fiber* f)
+{
+    { spu_context* const c = f->ctx;   /* RACACIT_LINE_RING: who resumes it, at which pc, on which line */
+      if (c) racacit_ring_note('r', (uint32_t)(f - s_fib) | ((uint32_t)c->spu_id << 8), (uint32_t)c->pc & SPU_LS_MASK, c->resv_ea, 1); }   /* only when the line moved: a polling fiber resumes 30k times a second */
+    f->runner = pthread_self();
+    racacit_fswitch(&f->back_sp, f->sp);
+    if (__atomic_load_n(&f->exit_, __ATOMIC_ACQUIRE)) {
+        __atomic_store_n(&f->state, 3, __ATOMIC_RELEASE);
+        __atomic_store_n(&f->done, 1, __ATOMIC_RELEASE);
+        syscall(SYS_futex, &f->done, FUTEX_WAKE_PRIVATE, INT_MAX, NULL, NULL, 0);
+    } else {
+        __atomic_store_n(&f->state, 1, __ATOMIC_RELEASE);
+    }
+}
+/* spu_channels.c: the fiber this context is running in on this thread right now, if any. */
+void* racacit_fiber_of(const spu_context* ctx)
+{
+    for (int i = 0; i < RACACIT_NFIBERS; i++)
+        if (s_fib[i].ctx == ctx && __atomic_load_n(&s_fib[i].state, __ATOMIC_ACQUIRE) == 2 &&
+            pthread_equal(s_fib[i].runner, pthread_self()))
+            return &s_fib[i];
+    return 0;
+}
+/* spu_channels.c spu_halt (1) / spu_restart_dispatch (2): inside a fiber, end it at its pad (does
+ * not return); elsewhere 0. */
+int racacit_fiber_nonlocal(const spu_context* ctx, int kind)
+{
+    racacit_fiber* const f = (racacit_fiber*)racacit_fiber_of(ctx);
+    if (!f) return 0;
+    f->nonlocal = kind;
+    racacit_ring_note('n', (uint32_t)(f - s_fib) | ((uint32_t)ctx->spu_id << 8), (uint32_t)ctx->pc & SPU_LS_MASK, ctx->resv_ea, 0);
+    __atomic_store_n(&f->exit_, 1, __ATOMIC_RELEASE);
+    racacit_fswitch(&f->sp, f->back_sp);   /* never resumed: the stack is set up afresh for the next job */
+    __builtin_trap();
+}
+/* Inside the fiber: park until resumed. poll = not a lock-line wait (resume whenever serviced). */
+void racacit_fiber_park(void* fp, int poll)
+{
+    racacit_fiber* f = (racacit_fiber*)fp;
+    racacit_ring_note(poll ? 'k' : 'K', (uint32_t)(f - s_fib) | ((uint32_t)f->ctx->spu_id << 8), (uint32_t)f->ctx->pc & SPU_LS_MASK, f->ctx->resv_ea, 1);
+    f->poll = poll;
+    f->irq_owner = f->ctx && f->ctx->irq_frame ? pthread_self() : (pthread_t)0;
+    RACACIT_FIBER_K(f, poll ? 4 : 3);
+    if (f->irq_owner) RACACIT_FIBER_K(f, 5);
+    f->parked_at = racacit_lane_clock();
+    racacit_fswitch(&f->sp, f->back_sp);
+}
+/* When the main thread last looked at the fibers (racacit_lane_clock). v113-android.38: a lane whose
+ * fiber is ready takes it back after 30 us when the main thread has not looked for that long -- it is
+ * in a wait outside the two loops that service fibers (the respawn autosave's: the 400-800 ms hitch
+ * of .29-.35, every park costing the 400 us fallback). */
+static volatile unsigned long long s_fib_serviced;
+/* The main thread, in its waits (stubs.cpp): run every published fiber that has its answer. */
+int racacit_fibers_service(void)
+{
+    if (!__atomic_load_n(&g_racacit_fibers_live, __ATOMIC_ACQUIRE)) return 0;
+    __atomic_store_n(&s_fib_serviced, racacit_lane_clock(), __ATOMIC_RELAXED);
+    int ran = 0;
+    for (int pass = 0; pass < 8; pass++) {
+        int any = 0;
+        for (int i = 0; i < RACACIT_NFIBERS; i++) {
+            racacit_fiber* f = &s_fib[i];
+            if (!__atomic_load_n(&f->published, __ATOMIC_ACQUIRE) || __atomic_load_n(&f->state, __ATOMIC_ACQUIRE) != 1) continue;
+            if (!racacit_fiber_ready(f)) continue;
+            if (f->irq_owner && !pthread_equal(f->irq_owner, pthread_self())) continue;
+            int exp = 1;
+            if (!__atomic_compare_exchange_n(&f->state, &exp, 2, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) continue;
+            RACACIT_FIBER_K(f, 1);
+            racacit_fiber_resume(f);
+            any = 1; ran++;
+        }
+        if (!any) break;
+    }
+    if (ran) __atomic_fetch_add(&g_racacit_fiber_n[1], (unsigned long)ran, __ATOMIC_RELAXED);
+    return ran;
+}
+/* main.cpp's stall report: every fiber slot and every lane, to name what a stuck wait waits on. */
+void racacit_fibers_dump(void)
+{
+    const unsigned long long now = racacit_lane_clock();
+    fprintf(stderr, "[fibers] live %d; jobs %lu, main runs %lu, lane runs %lu, no slot %lu%c", g_racacit_fibers_live,
+            g_racacit_fiber_n[0], g_racacit_fiber_n[1], g_racacit_fiber_n[2], g_racacit_fiber_n[3], 10);
+    for (int i = 0; i < RACACIT_NFIBERS; i++) {
+        racacit_fiber* f = &s_fib[i];
+        spu_context* c = f->ctx;
+        if (!c) { fprintf(stderr, "[fibers]  slot %d free%c", i, 10); continue; }
+        const uint8_t* g = c->ls + 0x100;
+        fprintf(stderr, "[fibers]  slot %d ctx %p img %d guid %02X%02X%02X%02X state %d published %d poll %d exit %d nonlocal %d irq %d "
+                        "parked %.0f us ago pc 0x%05X lr 0x%05X evstat 0x%X evmask 0x%X resv %d ea 0x%08X irqframe %p%c",
+                i, (void*)c, c->image_id, g[0], g[1], g[2], g[3], f->state, f->published, f->poll, f->exit_, f->nonlocal,
+                f->irq_owner != 0, (double)(now - f->parked_at) / 19.2, (unsigned)(c->pc & SPU_LS_MASK),
+                c->gpr[0]._u32[0] & SPU_LS_MASK, c->event_status, c->event_mask, c->resv_valid, c->resv_ea, c->irq_frame, 10);
+    }
+    const int n = g_racacit_nlanes < RACACIT_LANES ? g_racacit_nlanes : RACACIT_LANES;
+    for (int i = 0; i < n; i++) {
+        const struct racacit_lane* L = &g_racacit_lanes[i];
+        fprintf(stderr, "[fibers]  lane %d tid %ld asleep %d guid %08X critical %d job %.0f us ago%c", i, L->tid, L->asleep,
+                L->guid, L->critical, L->job ? (double)(now - L->job) / 19.2 : -1.0, 10);
+        /* the context the lane last waited for (spu_lr_wait / the GETLLAR idle backoff set it): which line, and its bytes */
+        spu_context* c = (spu_context*)L->ctx;
+        if (c && c->ls) {
+            extern uint8_t* vm_base;
+            const uint8_t* g = c->ls + 0x100;
+            const uint32_t ea = c->resv_ea & ~127u;
+            const uint8_t* q = vm_base + ea;
+            fprintf(stderr, "[fibers]   lane %d waits: img %d guid %02X%02X%02X%02X pc 0x%05X lr 0x%05X resv %d ea 0x%08X evstat 0x%X evmask 0x%X "
+                            "line %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X%c",
+                    i, c->image_id, g[0], g[1], g[2], g[3], (unsigned)(c->pc & SPU_LS_MASK), c->gpr[0]._u32[0] & SPU_LS_MASK,
+                    c->resv_valid, c->resv_ea, c->event_status, c->event_mask,
+                    q[0],q[1],q[2],q[3], q[4],q[5],q[6],q[7], q[8],q[9],q[10],q[11], q[12],q[13],q[14],q[15],
+                    q[16],q[17],q[18],q[19], q[20],q[21],q[22],q[23], 10);
+        }
+    }
+}
