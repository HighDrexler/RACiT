+            fprintf(stderr, "\n");
+            for (uint32_t a = 0x3FE00; a < 0x40000; a += 0x40) {
+                fprintf(stderr, "[spu-idle]   LS %05X:", a);
+                for (uint32_t j = 0; j < 0x40; j += 4) {
+                    uint32_t t; memcpy(&t, ctx->ls + a + j, 4);
+                    fprintf(stderr, " %08X", __builtin_bswap32(t));
+                }
