+     * from the PPU and six SPU lanes otherwise bounce this cache line between
+     * cores even while its owner is still working. Relaxed loads only wait;
+     * the successful exchange below still acquires every protected write. */
+    while (atomic_exchange_explicit(&g_lockline, 1u, memory_order_acquire)) {
+        while (atomic_load_explicit(&g_lockline, memory_order_relaxed)) {
+#if defined(__aarch64__) || defined(__arm__)
+            __asm__ __volatile__("yield"); /* CPU hint; does not sleep or reschedule */
+#elif defined(__i386__) || defined(__x86_64__)
+            __asm__ __volatile__("pause");
+#endif
+        }
+    }
+}
+void spu_lockline_unlock(void) { atomic_store_explicit(&g_lockline, 0u, memory_order_release); }
+#endif
+
