+/* The acquire fence signal follows its semaphore signal, so a submission
+ * that consumed the semaphore does not formally complete this separate fence.
+ * Normal reuse reaches here after the slot fence; this should already be done.
+ * A failed or timed-out wait retains all objects and ends the game process. */
+static int vk_present_wait_acquire(VkFence fence, int* pending)
+{
+    if (!*pending) return 0;
+    const VkResult r = pvkWaitForFences(s_vk.device, 1, &fence, VK_TRUE, 2000000000ull);
+    if (r != VK_SUCCESS) {
+        vk_device_lost_report(r);
+        VK_LOG("acquisition completion failed (VkResult %d); requesting game process exit\n", (int)r);
+        SDL_AtomicSet(&s_present_fatal, 1);
+        return -1;
+    }
+    *pending = 0;
+    return 0;
+}
