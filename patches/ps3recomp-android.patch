@@ -0,0 +1,686 @@
+#!/usr/bin/env python3
+"""spu_regcache_live.py -- a register cache for lifted SPU functions that knows what is live and what is dirty.
+
+spu_lifter._reg_cache keeps a function's SPU registers in C locals and makes ctx->gpr current around anything
+that can see it. It does that wholesale: before each such call every register the function ever writes is
+stored, after it every register the function ever names is loaded, and on entry all of them are loaded. So it
+refuses a function with a call inside a loop (there it costs more than it saves), and that is where most of the
+hot code is: the collision jobs' loops do DMA through spu_wrch / spu_rdch (22 such functions in job_B9B580,
+54 in job_B8A980), the sound module's likewise.
+
+This pass does the same thing statement by statement, with two data-flow analyses over the function's
+control-flow graph:
+  * may-dirty (forward): the registers whose local may hold a value ctx->gpr does not have yet. Only those are
+    stored, and only where ctx must be current: before a call and before each way out of the function.
+  * live (backward): the registers whose local is read before it is written again. Only those are loaded after
+    a call that may change the register file, and on entry (per entry of a region: its switch).
+A store of a may-dirty register counts as a read of its local, so a local that is stored at a join is valid on
+every path into the join (it was written, or loaded after the last call, or on entry).
+
+Three kinds of statement, by what they may do to the register file:
+  pure   local store access (spu_ls_*), helpers that take no ctx, ctx fields other than gpr: locals only.
+  chan   spu_wrch / spu_rdch / spu_rchcnt. They never write ctx->gpr when they return (audited in
+         runtime/spu, v113-android: the only store reachable from them is spu_dma.h's YDKJ_CRI_CHAIN test
+         switch, another title's), but they can leave by longjmp (spu_halt, spu_restart_dispatch), park a
+         fiber, and the dispatcher then resumes from ctx: ctx->gpr is made current before them, and the
+         locals stay valid after. An SPU interrupt is taken only at a trampoline transfer (spu_drain.c
+         spu_take_interrupt), never inside one.
+  call   everything else that is handed ctx (other lifted functions, spu_drain_call, spu_indirect_branch,
+         spu_stop, spu_halt, spu_img_restore, SPU_RET, a tail call): ctx->gpr current before, the statement
+         runs on ctx->gpr as lifted, the live registers are loaded after.
+
+A function with a construct this file does not model (a hand-written loop, an unknown label, ...) is left
+alone: transform() returns None. check() validates a transformed function on its own, by a forward
+must-analysis over the output: every local read is valid, every load reads a current ctx->gpr, ctx->gpr is
+wholly current at every call and every exit.
+"""
+import re
+
+REF = re.compile(r'ctx->gpr\[(\d+)\]')
+WRITE = re.compile(r'ctx->gpr\[(\d+)\]((?:\._\w+\[[^\]]*\])?)\s*((?:<<|>>|[-+|&^*/%])?)=(?!=)')
+CALL = re.compile(r'\b([A-Za-z_]\w*)\(ctx[,)]')
+PURE_CALL = re.compile(r'^(spu_ls_\w+|__builtin_expect)$')
+CHAN_CALL = ('spu_wrch', 'spu_rdch', 'spu_rchcnt')
+LABEL = re.compile(r'^(loc_[0-9A-F]{8}):$')
+GOTO = re.compile(r'^goto (loc_[0-9A-F]{8})$')
+CASE = re.compile(r'^\s*case (0x[0-9A-Fa-f]+u?): goto (loc_[0-9A-F]{8});$')
+TAIL = re.compile(r'^__attribute__\(\(musttail\)\) return \w+\(ctx\)$')
+BAD_WORD = re.compile(r'^(for|while|do|else|switch|case|default|break|continue|u128)\b')
+
+
+class Unsupported(Exception):
+    pass
+
+
+# ---------------------------------------------------------------------------------------------------------
+# One line of lifted C -> a small tree: ('simple', text) | ('if', cond, tree) | ('block', [tree])
+# ---------------------------------------------------------------------------------------------------------
+def _skip_ws(s, i):
+    while True:
+        while i < len(s) and s[i] in ' \t':
+            i += 1
+        if s.startswith('/*', i):
+            j = s.find('*/', i + 2)
+            if j < 0:
+                raise Unsupported('open comment')
+            i = j + 2
+            continue
+        return i
+
+
+def _skip_quote(s, i):
+    q = s[i]
+    i += 1
+    while i < len(s):
+        if s[i] == '\\':
+            i += 2
+            continue
+        if s[i] == q:
+            return i + 1
+        i += 1
+    raise Unsupported('open literal')
+
+
+def _close_paren(s, i):
+    depth = 0
+    while i < len(s):
+        c = s[i]
+        if c in '"\'':
+            i = _skip_quote(s, i)
+            continue
+        if c == '(':
+            depth += 1
+        elif c == ')':
+            depth -= 1
+            if depth == 0:
+                return i + 1
+        i += 1
+    raise Unsupported('open parenthesis')
+
+
+_IF = re.compile(r'if\s*\(')
+
+
+def _parse_stmt(s, i):
+    i = _skip_ws(s, i)
+    if i >= len(s):
+        raise Unsupported('statement expected')
+    if s[i] == '{':
+        items = []
+        i += 1
+        while True:
+            i = _skip_ws(s, i)
+            if i >= len(s):
+                raise Unsupported('open block')
+            if s[i] == '}':
+                return ('block', items), i + 1
+            t, i = _parse_stmt(s, i)
+            items.append(t)
+    m = _IF.match(s, i)
+    if m:
+        j = _close_paren(s, m.end() - 1)
+        body, k = _parse_stmt(s, j)
+        return ('if', s[m.end():j - 1].strip(), body), k
+    j = i
+    depth = 0
+    while j < len(s):
+        c = s[j]
+        if c in '"\'':
+            j = _skip_quote(s, j)
+            continue
+        if c in '([':
+            depth += 1
+        elif c in ')]':
+            depth -= 1
+        elif c in '{}':
+            raise Unsupported('brace inside a statement')
+        elif c == ';' and depth == 0:
+            # comments inside the statement stay with it; only its ends are trimmed
+            return ('simple', s[i:j].strip()), j + 1
+        j += 1
+    raise Unsupported('statement without an end')
+
+
+def parse_line(line):
+    """The statements of one body line, in order."""
+    out = []
+    i = _skip_ws(line, 0)
+    while i < len(line):
+        t, i = _parse_stmt(line, i)
+        out.append(t)
+        i = _skip_ws(line, i)
+    return out
+
+
+def _mask(regs):
+    m = 0
+    for r in regs:
+        m |= 1 << int(r)
+    return m
+
+
+def _bits(m):
+    out = []
+    n = 0
+    while m:
+        if m & 1:
+            out.append(n)
+        m >>= 1
+        n += 1
+    return out
+
+
+# ---------------------------------------------------------------------------------------------------------
+# The control-flow graph: a node per simple statement and per `if` condition.
+# ---------------------------------------------------------------------------------------------------------
+class Node:
+    __slots__ = ('kind', 'text', 'reads', 'writes', 'kill', 'succ', 'target', 'ends', 'flush', 'reload',
+                 'md_in', 'md_out', 'live_in', 'live_out')
+
+    def __init__(self, kind, text=''):
+        self.kind = kind          # pure | cond | chan | call | exit | goto | nop
+        self.text = text
+        self.reads = self.writes = self.kill = 0
+        self.succ = []
+        self.target = None
+        self.ends = False         # control never passes to the next statement
+        self.flush = self.reload = 0
+        self.md_in = self.md_out = self.live_in = self.live_out = 0
+
+
+def _classify(text):
+    n = Node('pure', text)
+    if not text:
+        n.kind = 'nop'
+        return n
+    if BAD_WORD.match(text):
+        raise Unsupported('statement: ' + text[:40])
+    g = GOTO.match(text)
+    if g:
+        n.kind = 'goto'
+        n.target = g.group(1)
+        n.ends = True
+        return n
+    if 'goto' in text.split('"')[0] and re.search(r'\bgoto\b', text):
+        raise Unsupported('goto: ' + text[:40])
+    if text == 'return':
+        n.kind = 'exit'
+        n.ends = True
+        return n
+    if re.search(r'\breturn\b', text):
+        if not TAIL.match(text):
+            raise Unsupported('return: ' + text[:60])
+        n.kind = 'call'
+        n.ends = True
+        return n
+    if re.match(r'^SPU_RET(_REG)?\(ctx[,)]', text):
+        n.kind = 'call'           # sets ctx->pc from ctx->gpr and returns
+        n.ends = True
+        return n
+    calls = [c for c in CALL.findall(text) if not PURE_CALL.match(c)]
+    if calls:
+        n.kind = 'chan' if all(c in CHAN_CALL for c in calls) else 'call'
+        if n.kind == 'call':
+            return n
+    lead = None
+    for m in WRITE.finditer(text):
+        r = int(m.group(1))
+        n.writes |= 1 << r
+        if m.start() == 0 and not m.group(2) and not m.group(3) and lead is None:
+            lead = (r, m.end())
+        else:
+            n.reads |= 1 << r     # part of a register, or op=: the rest of the old value stays
+    if lead:
+        n.kill = 1 << lead[0]
+        n.reads |= _mask(REF.findall(text[lead[1]:]))
+    else:
+        n.reads |= _mask(REF.findall(text))
+    return n
+
+
+class Graph:
+    def __init__(self):
+        self.nodes = []
+        self.labels = {}          # label -> node index
+        self.lines = []           # per body line: ('label', name, node) | ('code', indent, [tree with node ids]) | ('raw', text)
+
+    def add(self, node):
+        self.nodes.append(node)
+        return len(self.nodes) - 1
+
+
+def _build_tree(g, t):
+    """-> (tree with node ids, entry node id, [node ids that fall through to what follows])"""
+    if t[0] == 'simple':
+        n = g.add(_classify(t[1]))
+        return ('simple', n), n, ([] if g.nodes[n].ends else [n])
+    if t[0] == 'if':
+        c = Node('cond', t[1])
+        if [x for x in CALL.findall(t[1]) if not PURE_CALL.match(x)]:
+            raise Unsupported('call in a condition')
+        if WRITE.search(t[1]):
+            raise Unsupported('assignment in a condition')
+        c.reads = _mask(REF.findall(t[1]))
+        ci = g.add(c)
+        body, be, bout = _build_tree(g, t[2])
+        g.nodes[ci].succ.append(be)
+        return ('if', ci, body), ci, [ci] + bout
+    items = []
+    entry = None
+    outs = []
+    first = True
+    for s in t[1]:
+        tr, e, o = _build_tree(g, s)
+        if first:
+            entry = e
+            first = False
+        else:
+            for p in outs:
+                g.nodes[p].succ.append(e)
+        outs = o
+        items.append(tr)
+    if entry is None:             # {}
+        entry = g.add(Node('nop'))
+        outs = [entry]
+        items.append(('simple', entry))
+    return ('block', items), entry, outs
+
+
+def build(body):
+    """The graph of a function body (the lines after the region's switch). Raises Unsupported."""
+    g = Graph()
+    start = g.add(Node('nop'))
+    outs = [start]
+    for line in body:
+        s = line.strip()
+        if not s:
+            g.lines.append(('raw', line))
+            continue
+        lm = LABEL.match(s)
+        if lm:
+            n = g.add(Node('nop'))
+            if lm.group(1) in g.labels:
+                raise Unsupported('label twice')
+            g.labels[lm.group(1)] = n
+            for p in outs:
+                g.nodes[p].succ.append(n)
+            outs = [n]
+            g.lines.append(('label', line, n))
+            continue
+        if s.endswith(':') and re.match(r'^\w+:$', s):
+            raise Unsupported('label ' + s)
+        indent = line[:len(line) - len(line.lstrip())]
+        trees = []
+        for t in parse_line(line):
+            tr, e, o = _build_tree(g, t)
+            for p in outs:
+                g.nodes[p].succ.append(e)
+            outs = o
+            trees.append(tr)
+        g.lines.append(('code', indent, trees))
+    end = g.add(Node('exit'))     # falling off the end of the function
+    g.nodes[end].ends = True
+    for p in outs:
+        g.nodes[p].succ.append(end)
+    for n in g.nodes:
+        if n.kind == 'goto':
+            if n.target not in g.labels:
+                raise Unsupported('goto out of the function')
+            n.succ.append(g.labels[n.target])
+    g.start = start
+    g.end = end
+    return g
+
+
+def analyse(g, entries):
+    """may-dirty forward, live backward. entries: the node ids control can enter at."""
+    N = g.nodes
+    pred = [[] for _ in N]
+    for i, n in enumerate(N):
+        for s in n.succ:
+            pred[s].append(i)
+    # may-dirty
+    work = list(range(len(N)))
+    inq = [True] * len(N)
+    while work:
+        i = work.pop()
+        inq[i] = False
+        n = N[i]
+        mi = 0
+        for p in pred[i]:
+            mi |= N[p].md_out
+        n.md_in = mi
+        if n.kind == 'call':
+            mo = 0
+        elif n.kind == 'chan':
+            mo = n.writes
+        else:
+            mo = mi | n.writes
+        if mo != n.md_out:
+            n.md_out = mo
+            for s in n.succ:
+                if not inq[s]:
+                    inq[s] = True
+                    work.append(s)
+    for n in N:
+        n.flush = n.md_in if n.kind in ('call', 'chan', 'exit') else 0
+    # live
+    work = list(range(len(N)))
+    inq = [True] * len(N)
+    while work:
+        i = work.pop()
+        inq[i] = False
+        n = N[i]
+        lo = 0
+        for s in n.succ:
+            lo |= N[s].live_in
+        n.live_out = lo
+        if n.kind in ('call', 'exit'):
+            li = n.flush
+        else:
+            li = (lo & ~n.kill) | n.reads | n.flush
+        if li != n.live_in:
+            n.live_in = li
+            for p in pred[i]:
+                if not inq[p]:
+                    inq[p] = True
+                    work.append(p)
+    for n in N:
+        n.reload = n.live_out if (n.kind == 'call' and not n.ends) else 0
+
+
+def _flush_text(m):
+    return '{ ' + ' '.join(f'ctx->gpr[{r}] = _r{r};' for r in _bits(m)) + ' }'
+
+
+def _load_text(m):
+    return '{ ' + ' '.join(f'_r{r} = ctx->gpr[{r}];' for r in _bits(m)) + ' }'
+
+
+def _local(text):
+    return REF.sub(lambda m: f'_r{m.group(1)}', text)
+
+
+def _emit(g, t, used):
+    """-> list of statement strings for one tree"""
+    if t[0] == 'simple':
+        n = g.nodes[t[1]]
+        out = []
+        if n.flush:
+            out.append(_flush_text(n.flush))
+            used[0] |= n.flush
+        if n.kind == 'call':
+            out.append(n.text + ';')
+            if n.reload:
+                out.append(_load_text(n.reload))
+                used[0] |= n.reload
+        elif n.kind == 'nop' and not n.text:
+            if not out:
+                out.append(';')
+        else:
+            out.append(_local(n.text) + ';')
+            used[0] |= n.reads | n.writes
+        return out
+    if t[0] == 'if':
+        c = g.nodes[t[1]]
+        used[0] |= c.reads
+        inner = _emit(g, t[2], used)
+        if len(inner) == 1:
+            return [f'if ({_local(c.text)}) {inner[0]}']
+        return [f'if ({_local(c.text)}) {{ ' + ' '.join(inner) + ' }']
+    parts = []
+    for s in t[1]:
+        parts.extend(_emit(g, s, used))
+    return ['{ ' + ' '.join(parts) + ' }']
+
+
+def transform(head, body):
+    """head: the lines of a region's `switch (entry) { ... }` ([] for a plain function); body: the rest.
+    -> (prologue lines, new head, new body) or None when the function is left alone."""
+    try:
+        g = build(body)
+        cases = []
+        for h in head:
+            c = CASE.match(h)
+            if c:
+                if c.group(2) not in g.labels:
+                    raise Unsupported('case to an unknown label')
+                cases.append((h, c.group(2)))
+            elif h.strip() not in ('switch (entry) {', 'default: break;', '}'):
+                raise Unsupported('switch line: ' + h.strip()[:40])
+        entries = [g.start] + [g.labels[l] for _, l in cases]
+        analyse(g, entries)
+    except Unsupported:
+        return None
+    if not any(n.reads | n.writes | n.flush | n.reload for n in g.nodes):
+        return None
+    used = [0]
+    new = []
+    for ln in g.lines:
+        if ln[0] == 'raw':
+            new.append(ln[1])
+        elif ln[0] == 'label':
+            new.append(ln[1])
+        else:
+            parts = []
+            for t in ln[2]:
+                parts.extend(_emit(g, t, used))
+            new.append(ln[1] + ' '.join(parts))
+    endn = g.nodes[g.end]
+    if endn.flush:
+        new.append('        ' + _flush_text(endn.flush))
+        used[0] |= endn.flush
+    start_in = g.nodes[g.start].live_in
+    used[0] |= start_in
+    new_head = []
+    for h in head:
+        c = CASE.match(h)
+        if c:
+            li = g.nodes[g.labels[c.group(2)]].live_in
+            used[0] |= li
+            ind = h[:len(h) - len(h.lstrip())]
+            new_head.append(f'{ind}case {c.group(1)}: ' + (_load_text(li) + ' ' if li else '') + f'goto {c.group(2)};')
+        else:
+            new_head.append(h)
+    if not used[0]:
+        return None
+    pro = ['    u128 ' + ', '.join(f'_r{r}' for r in _bits(used[0])) + ';']
+    if start_in:
+        # after the switch: the path that starts at the function's first statement
+        new_head = new_head + ['    ' + _load_text(start_in)]
+    return pro, new_head, new
+
+
+# ---------------------------------------------------------------------------------------------------------
+# check(): the output on its own terms. Forward, must: `valid` = the local holds the register's value,
+# `cur` = ctx->gpr holds it. Entry: no local valid, all of ctx current.
+# ---------------------------------------------------------------------------------------------------------
+_C_FLUSH = re.compile(r'^ctx->gpr\[(\d+)\] = _r(\d+)$')
+_C_LOAD = re.compile(r'^_r(\d+) = ctx->gpr\[(\d+)\]$')
+_C_LOCAL = re.compile(r'\b_r(\d+)\b')
+_C_LWRITE = re.compile(r'\b_r(\d+)((?:\._\w+\[[^\]]*\])?)\s*((?:<<|>>|[-+|&^*/%])?)=(?!=)')
+ALL = (1 << 128) - 1
+
+
+class CheckError(Exception):
+    pass
+
+
+def _check_nodes(pro, head, body):
+    """-> (nodes, entry states). A node: dict(kind, need_valid, need_cur_all, set_valid, clr_valid_all,
+    set_cur, clr_cur, succ)."""
+    nodes = []
+    labels = {}
+
+    def add(**k):
+        d = dict(need_valid=0, need_cur=0, need_cur_all=False, set_valid=0, clr_valid_all=False, set_cur=0,
+                 clr_cur=0, succ=[], ends=False, target=None, text='')
+        d.update(k)
+        nodes.append(d)
+        return len(nodes) - 1
+
+    def simple(text):
+        if not text:
+            return add(text=text)
+        f = _C_FLUSH.match(text)
+        if f:
+            if f.group(1) != f.group(2):
+                raise CheckError('store of another register: ' + text)
+            b = 1 << int(f.group(1))
+            return add(need_valid=b, set_cur=b, text=text)
+        l = _C_LOAD.match(text)
+        if l:
+            if l.group(1) != l.group(2):
+                raise CheckError('load of another register: ' + text)
+            b = 1 << int(l.group(1))
+            return add(need_cur=b, set_valid=b, text=text)
+        g_ = GOTO.match(text)
+        if g_:
+            return add(ends=True, target=g_.group(1), text=text)
+        if text == 'return':
+            return add(need_cur_all=True, ends=True, text=text)
+        fullcall = TAIL.match(text) or re.match(r'^SPU_RET(_REG)?\(ctx[,)]', text)
+        calls = [c for c in CALL.findall(text) if not PURE_CALL.match(c)]
+        if fullcall or any(c not in CHAN_CALL for c in calls):
+            if _C_LOCAL.search(text):
+                raise CheckError('a call that names a local: ' + text[:60])
+            return add(need_cur_all=True, clr_valid_all=True, ends=bool(fullcall), text=text)
+        if 'ctx->gpr[' in text:
+            raise CheckError('ctx->gpr outside a call, a store or a load: ' + text[:60])
+        nv = sv = cc = 0
+        lead = None
+        for m in _C_LWRITE.finditer(text):
+            r = 1 << int(m.group(1))
+            cc |= r
+            if m.start() == 0 and not m.group(2) and not m.group(3) and lead is None:
+                lead = (r, m.end())
+            else:
+                nv |= r
+        rest = text[lead[1]:] if lead else text
+        if not lead:
+            rest = text
+        for m in _C_LOCAL.finditer(rest):
+            nv |= 1 << int(m.group(1))
+        if lead:
+            sv = lead[0]
+        return add(need_valid=nv, need_cur_all=bool(calls), set_valid=sv, clr_cur=cc, text=text)
+
+    def tree(t):
+        if t[0] == 'simple':
+            n = simple(t[1])
+            return n, ([] if nodes[n]['ends'] else [n])
+        if t[0] == 'if':
+            if 'ctx->gpr[' in t[1]:
+                raise CheckError('ctx->gpr in a condition')
+            c = add(need_valid=_mask(_C_LOCAL.findall(t[1])), text='if ' + t[1])
+            e, o = tree(t[2])
+            nodes[c]['succ'].append(e)
+            return c, [c] + o
+        entry = None
+        outs = []
+        for s in t[1]:
+            e, o = tree(s)
+            if entry is None:
+                entry = e
+            else:
+                for p in outs:
+                    nodes[p]['succ'].append(e)
+            outs = o
+        if entry is None:
+            entry = add()
+            outs = [entry]
+        return entry, outs
+
+    def seq(lines, outs):
+        for line in lines:
+            s = line.strip()
+            if not s:
+                continue
+            lm = LABEL.match(s)
+            if lm:
+                n = add(text=s)
+                labels[lm.group(1)] = n
+                for p in outs:
+                    nodes[p]['succ'].append(n)
+                outs = [n]
+                continue
+            for t in parse_line(line):
+                e, o = tree(t)
+                for p in outs:
+                    nodes[p]['succ'].append(e)
+                outs = o
+        return outs
+
+    if len(pro) != 1 or not re.match(r'^    u128 _r\d+(, _r\d+)*;$', pro[0]):
+        raise CheckError('prologue: ' + (pro[0][:60] if pro else 'none'))
+    start = add(text='<entry>')
+    case_nodes = []
+    after_switch = []
+    in_switch = False
+    for h in head:
+        s = h.strip()
+        if s == 'switch (entry) {':
+            in_switch = True
+            continue
+        if in_switch and s == '}':
+            in_switch = False
+            continue
+        if in_switch:
+            if s == 'default: break;':
+                continue
+            m = re.match(r'^case 0x[0-9A-Fa-f]+u?: (.*)$', s)
+            if not m:
+                raise CheckError('switch line ' + s[:40])
+            case_nodes.append(m.group(1))
+        else:
+            after_switch.append(h)
+    # entry -> the lines after the switch (the default path), then the body; entry -> each case's statements
+    outs0 = seq(after_switch, [start])
+    outs = seq(body, outs0)
+    end = add(need_cur_all=True, ends=True, text='<end>')
+    for p in outs:
+        nodes[p]['succ'].append(end)
+    for c in case_nodes:
+        if seq(['    ' + c], [start]):
+            raise CheckError('a case that falls through')
+    for n in nodes:
+        if n['target'] is not None:
+            if n['target'] not in labels:
+                raise CheckError('goto to an unknown label ' + n['target'])
+            n['succ'].append(labels[n['target']])
+    return nodes, start
+
+
+def check(pro, head, body):
+    """Raises CheckError if the transformed function can read a stale local, load a stale register, or reach
+    a call or an exit with ctx->gpr not current."""
+    nodes, start = _check_nodes(pro, head, body)
+    valid = [None] * len(nodes)
+    cur = [None] * len(nodes)
+    valid[start] = 0
+    cur[start] = ALL
+    work = [start]
+    while work:
+        i = work.pop()
+        n = nodes[i]
+        v, c = valid[i], cur[i]
+        if n['need_valid'] & ~v:
+            raise CheckError(f"local(s) {_bits(n['need_valid'] & ~v)} read while not valid at: {n['text'][:70]}")
+        if n['need_cur'] & ~c:
+            raise CheckError(f"register(s) {_bits(n['need_cur'] & ~c)} loaded while ctx->gpr is behind at: {n['text'][:70]}")
+        if n['need_cur_all'] and c != ALL:
+            raise CheckError(f"ctx->gpr not current for {_bits(ALL & ~c)[:8]} at: {n['text'][:70]}")
+        if n['clr_valid_all']:
+            v = 0
+        v |= n['set_valid']
+        c = (c | n['set_cur']) & ~n['clr_cur']
+        for s in n['succ']:
+            if valid[s] is None:
+                valid[s], cur[s] = v, c
+                work.append(s)
+            else:
+                nv, nc = valid[s] & v, cur[s] & c
+                if nv != valid[s] or nc != cur[s]:
+                    valid[s], cur[s] = nv, nc
+                    work.append(s)
+    return True
