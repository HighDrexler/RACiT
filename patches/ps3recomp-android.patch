+/*
+ * ps3recomp - PPU thread management syscalls (implementation)
+ */
+
+#include "../platform/ps3_setjmp.h"   /* setjmp/longjmp that never unwind (Windows) */
+
+/* sys_ppu_thread_exit never returns on hardware. Returning CELL_OK to the
+ * guest lets it run on past the call: Twisted Metal has a thread that exits
+ * from inside a loop and so called exit 1,435 times in one run, staying alive
+ * and holding whatever it held. Arm a jump in the thread proc and unwind to it
+ * instead. PS3_NO_THREAD_EXIT_UNWIND=1 restores the old behaviour. */
+#if defined(_MSC_VER)   /* clang/mingw ignores __declspec(thread): it would be ONE global */
+#  define PPU_TLS __declspec(thread)
+#else
+#  define PPU_TLS __thread
+#endif
+static PPU_TLS jmp_buf s_exit_jmp;
+static PPU_TLS int     s_exit_armed = 0;
+
+#include <stddef.h>
+#include "sys_ppu_thread.h"
+#include "../platform/win32_compat.h"   /* GetCurrentThreadId on POSIX */
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>   /* getenv (else return value truncated to int on x64) */
+#ifndef _WIN32
+#include <errno.h>
+#endif
+#if defined(__ANDROID__)
+#include <sys/resource.h>   /* setpriority: the sound feeders' nice level */
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+/* Host stack reserved per guest thread, for pthread_attr_setstacksize. The
+ * same 256 MB the Win32 branch hands _beginthreadex a few hundred lines
+ * down; keep the two in step so a stack-depth bug reproduces on both. */
+#define PPU_HOST_STACK_BYTES  (256u * 1024u * 1024u)
+
+#ifdef _WIN32
+#include <process.h>   /* _beginthreadex: CRT-aware thread creation (raw CreateThread
+                        * leaves per-thread CRT state uninit -> buffered fread() silently
+                        * returns 0 on those threads). */
+#endif
+
+/* ---------------------------------------------------------------------------
+ * Globals
+ * -----------------------------------------------------------------------*/
+ppu_thread_info       g_ppu_threads[PPU_THREAD_MAX];
+vm_stack_alloc        g_vm_stack_alloc;
+ppu_thread_entry_fn   g_ppu_thread_entry_trampoline = NULL;
+
+/* Simple mutex for thread table access */
+#ifdef _WIN32
+static CRITICAL_SECTION s_table_lock;
+static int              s_table_lock_init = 0;
+#else
+static pthread_mutex_t  s_table_lock = PTHREAD_MUTEX_INITIALIZER;
+#endif
+
+static void table_lock(void)
+{
+#ifdef _WIN32
+    if (!s_table_lock_init) {
+        InitializeCriticalSection(&s_table_lock);
+        s_table_lock_init = 1;
+    }
+    EnterCriticalSection(&s_table_lock);
+#else
+    pthread_mutex_lock(&s_table_lock);
+#endif
+}
+
+static void table_unlock(void)
+{
+#ifdef _WIN32
+    LeaveCriticalSection(&s_table_lock);
+#else
+    pthread_mutex_unlock(&s_table_lock);
+#endif
+}
+
+/* Guest stacks of threads whose slots were reclaimed, for the next thread
+ * that fits (the stack region is a bump allocator that never frees). */
+static struct { uint32_t addr, size; } s_free_stacks[PPU_THREAD_MAX * 2];
+static int s_n_free_stacks;
+
+static uint32_t thread_stack_alloc(uint32_t* size)
+{
+    const uint32_t need = VM_ALIGN_UP(*size, vm_host_page_size());
+    int best = -1;
+    for (int i = 0; i < s_n_free_stacks; i++)
+        if (s_free_stacks[i].size >= need && (best < 0 || s_free_stacks[i].size < s_free_stacks[best].size)) best = i;
+    if (best >= 0) {
+        const uint32_t a = s_free_stacks[best].addr;
+        *size = s_free_stacks[best].size;
+        s_free_stacks[best] = s_free_stacks[--s_n_free_stacks];
+        return a;
+    }
+    *size = need;
+    return vm_stack_allocate(&g_vm_stack_alloc, need);
+}
+
+/* Has the host thread behind a slot fully ended (nothing of it still runs
+ * the epilogue that touches the slot)? */
+static int thread_host_done(ppu_thread_info* t)
+{
+#ifdef _WIN32
+    return !t->host_thread || WaitForSingleObject(t->host_thread, 0) == WAIT_OBJECT_0;
+#else
+    return t->finished;
+#endif
+}
+
+/* A finished thread's slot back to FREE: its handles closed, its stack kept
+ * for reuse. Under the table lock. */
+static void thread_slot_reclaim(ppu_thread_info* t)
+{
+#ifdef _WIN32
+    if (t->host_thread) CloseHandle(t->host_thread);
+    if (t->finish_event) CloseHandle(t->finish_event);
+    t->host_thread = NULL; t->finish_event = NULL;
+#else
+    pthread_detach(t->host_thread);
+    pthread_mutex_destroy(&t->finish_mutex);
+    pthread_cond_destroy(&t->finish_cond);
+#endif
+    if (t->stack_addr && t->stack_size && s_n_free_stacks < (int)(sizeof s_free_stacks / sizeof s_free_stacks[0])) {
+        s_free_stacks[s_n_free_stacks].addr = t->stack_addr;
+        s_free_stacks[s_n_free_stacks].size = t->stack_size;
+        s_n_free_stacks++;
+    }
+    t->state = PPU_THREAD_STATE_FREE;
+}
+
+/* Find a free slot. Returns index or -1. Must be called under lock.
+ *
+ * A thread created without SYS_PPU_THREAD_CREATE_JOINABLE is gone once it
+ * exits, on hardware; here its slot is reclaimed when the next thread needs
+ * one (not at exit: the exiting host thread still touches the slot). And when
+ * every slot is taken, a finished thread nobody joined is reclaimed rather
+ * than failing the create: A Crack in Time starts an "Auto Save Thread" and a
+ * "Scaleform Async Load" for every checkpoint and menu, and once the 64 slots
+ * were full of finished ones the next create failed and the game waited for a
+ * thread that never came -- the freeze ten to twenty minutes into play.
+ *
+ * Slots are handed out round-robin, starting after the last one given, so an
+ * id comes back only after the other 63 have been used. The id is the slot,
+ * and lv2 never reissues an id this soon. A Crack in Time polls a finished
+ * save thread's id with sys_ppu_thread_get_priority until ESRCH. Save threads
+ * are never joined, so their slots stay FINISHED and are taken back only when
+ * no slot is free (the second and third loops). After long play the table is
+ * full, and the old lowest-first search then gave the slot of the autosave
+ * that had just ended to the next thread. When that was the session's first
+ * movie, its "Bink Audio Thread" (alive until the game quits) kept the poll
+ * answering OK. The save manager stayed busy, so autosaves stopped and the
+ * Save menu dimmed the screen and waited with the save icon flashing. */
+static int s_next_slot;
+
+static int take_slot(int i)
+{
+    s_next_slot = (i + 1) % PPU_THREAD_MAX;
+    return i;
+}
+
+static int find_free_slot(void)
+{
+    for (int n = 0; n < PPU_THREAD_MAX; n++) {
+        const int i = (s_next_slot + n) % PPU_THREAD_MAX;
+        if (g_ppu_threads[i].state == PPU_THREAD_STATE_FREE)
+            return take_slot(i);
+    }
+    for (int n = 0; n < PPU_THREAD_MAX; n++) {
+        const int i = (s_next_slot + n) % PPU_THREAD_MAX;
+        ppu_thread_info* t = &g_ppu_threads[i];
+        if (t->state == PPU_THREAD_STATE_FINISHED && !t->joinable && thread_host_done(t)) {
+            thread_slot_reclaim(t);
+            return take_slot(i);
+        }
+    }
+    for (int n = 0; n < PPU_THREAD_MAX; n++) {
+        const int i = (s_next_slot + n) % PPU_THREAD_MAX;
+        ppu_thread_info* t = &g_ppu_threads[i];
+        if (t->state == PPU_THREAD_STATE_FINISHED && thread_host_done(t)) {
+            fprintf(stderr, "[SYS] thread table full: reclaiming tid %d \"%s\" (finished, never joined)\n", i + 1, t->name);
+            thread_slot_reclaim(t);
+            return take_slot(i);
+        }
+    }
+    return -1;
+}
+
+/* Find thread by ID. The ID is the index + 1 (0 is invalid). */
+static ppu_thread_info* find_thread(uint64_t thread_id)
+{
+    if (thread_id == 0 || thread_id > PPU_THREAD_MAX) return NULL;
+    ppu_thread_info* t = &g_ppu_threads[thread_id - 1];
+    if (t->state == PPU_THREAD_STATE_FREE) return NULL;
+    return t;
+}
+
+/* ---------------------------------------------------------------------------
+ * Host thread entry point
+ * -----------------------------------------------------------------------*/
+#ifdef _WIN32
+static DWORD WINAPI ppu_host_thread_proc(LPVOID param)
+#else
+static void* ppu_host_thread_proc(void* param)
+#endif
+{
+    ppu_thread_info* info = (ppu_thread_info*)param;
+
+#ifdef _WIN32
+    /* Reserve stack for the STACK_OVERFLOW handler, same as main() does for the
+     * main thread. Deep recompiled call chains DO overflow even a 256 MB stack
+     * (a lifter bug that turns a tail call into recursion is unbounded), and
+     * without the guarantee the handler faults while reporting -- the process
+     * then dies silently with an access violation INSIDE the handler and the
+     * backtrace that would name the recursing function is lost. */
+    { ULONG g = 256 * 1024; SetThreadStackGuarantee(&g); }
+#else
+    /* The same boost as the Win32 branch gives the guest's audio and stream
+     * threads (priority < 512, see sys_ppu_thread_create), as a nice level of
+     * -5. Without CAP_SYS_NICE or an RLIMIT_NICE grant (GameMode, a limits.conf
+     * entry) Linux refuses it and the thread stays at its normal level. */
+    if (info->priority < 512) SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+#if defined(__ANDROID__)
+    /* The game's sound feeders on the Thor's saturated mid cores: the synth clock
+     * (syn_tick_timer_thread, PS3 priority 10), the music and voice streamers
+     * (snd_stream_thread) and Bink's audio. Nice -12, with the sound SPU kernel
+     * (cellAudio.c): at -5 they queued behind the collision lanes (-10) and dialogue
+     * slurred whenever frames dropped (owner, .15). They sleep most of the time.
+     * Not fios (.16 had it): its media threads inflate the game's archives, 67% of
+     * their time in inflate_fast, in bursts that at -12 went ahead of the SPU lanes
+     * and the render threads. RACACIT_SOUND_NICE=0: as before. */
+    { static const char* const k_audio[] = { "syn_tick_timer", "snd_stream", "Bink Audio" };
+      for (unsigned i = 0; i < sizeof k_audio / sizeof k_audio[0]; i++)
+          if (!strncmp(info->name, k_audio[i], strlen(k_audio[i]))) {
+              const char* sn = getenv("RACACIT_SOUND_NICE"); const int n = sn ? atoi(sn) : -12;
+              if (n) setpriority(PRIO_PROCESS, (id_t)syscall(SYS_gettid), n);
+              break;
+          } }
+#endif
+#endif
+
+    /* Register this thread's context for lwarx/stwcx cross-thread reservation
+     * invalidation (ppu_loader.cpp) -- so a concurrent stwcx breaks this thread's
+     * reservation and prevents ABA corruption of the guest's lock-free lists. */
+    { extern void ppu_resv_register(ppu_context*); ppu_resv_register(&info->ctx); }
+
+    { char _hb[160]; snprintf(_hb, sizeof _hb, "[THREAD %llu] host thread started, entry=0x%08llX hosttid=%lu\n",
+            (unsigned long long)info->ctx.thread_id,
+            (unsigned long long)info->entry_addr, (unsigned long)GetCurrentThreadId());
+      fputs(_hb, stderr); }   /* one write: threads start together and interleave */
+
+    /* Invoke the recompiled entry point */
+    if (g_ppu_thread_entry_trampoline) {
+        s_exit_armed = 1;
+        if (setjmp(s_exit_jmp) == 0)
+            g_ppu_thread_entry_trampoline(&info->ctx);
+        else
+            fprintf(stderr, "[THREAD %llu] unwound out of sys_ppu_thread_exit\n",
+                    (unsigned long long)info->ctx.thread_id);
+        s_exit_armed = 0;
+        fprintf(stderr, "[THREAD %llu] entry RETURNED (r3=0x%llX) -- thread finished\n",
+                (unsigned long long)info->ctx.thread_id,
+                (unsigned long long)info->ctx.gpr[3]);
+
+        /* An established interrupt handler does not finish when its body
+         * returns. lv2 re-enters such a thread at its ENTRY on the next
+         * interrupt -- ps1_netemu's two SPU handlers both end in `blr` right
+         * after their `sc 88` (eoi), so a return IS the end of one pass, not
+         * the end of the thread. Wait for the next interrupt and run it again;
+         * without this each handler ran once and the SPUs were never answered,
+         * which is why SPUs 0-3 parked on SPU_RdInMbox and SPU 4 exited. */
+        { extern int ps3_intr_is_handler(unsigned long long);
+          extern int ps3_intr_wait(unsigned long long);
+          if (ps3_intr_is_handler(info->ctx.thread_id)) {
+              fprintf(stderr, "[intr] thread %llu is an interrupt handler -- \n",
+                      (unsigned long long)info->ctx.thread_id);
+              while (ps3_intr_wait(info->ctx.thread_id)) {
+                  s_exit_armed = 1;
+                  if (setjmp(s_exit_jmp) == 0)
+                      g_ppu_thread_entry_trampoline(&info->ctx);
+                  s_exit_armed = 0;
+              }
+          } }
+    } else {
+        fprintf(stderr, "[THREAD %llu] g_ppu_thread_entry_trampoline is NULL — thread is a no-op!\n",
+                (unsigned long long)info->ctx.thread_id);
+    }
+
+    /* Mark as finished */
+    table_lock();
+    info->exit_status = (int64_t)info->ctx.gpr[3];
+
+    if (info->state == PPU_THREAD_STATE_DETACHED) {
+        /* Detached threads self-clean */
+        info->state = PPU_THREAD_STATE_FREE;
+    } else {
+        info->state = PPU_THREAD_STATE_FINISHED;
+    }
+    table_unlock();
+
+    /* Signal anyone waiting for join */
+#ifdef _WIN32
+    SetEvent(info->finish_event);
+    return 0;
+#else
+    pthread_mutex_lock(&info->finish_mutex);
+    info->finished = 1;
+    pthread_cond_signal(&info->finish_cond);
+    pthread_mutex_unlock(&info->finish_mutex);
+    return NULL;
+#endif
+}
