+/* ---- split walker (RSX_WALKER_SPLIT=1, docs/dev/WALKER_SPLIT.md) ----------
+ * One thread was the FIFO walk, the method decode and every draw's sink work
+ * (~1 us a draw on a fast core, the frame limit on i5-class PCs). With the
+ * switch the walker's thread decodes into its own register file (s_dec) and,
+ * at every sink call -- clear, begin, a vertex batch, inline data, end, flip
+ * -- queues what changed since the previous one (registers, constants,
+ * program words, the generation counters) and the call. The sink thread
+ * (rsx_engine_split.c) applies that to g.rsx and runs the ordinary sink: g,
+ * the caches and the backend proxy are still used by one thread at a time.
+ * Every other entry point here first flushes and waits for the sink thread to
+ * finish what is queued (eng_split_sync): then the caller owns g, as before.
+ * Measured before writing it (Axiom, 2026-11-25): the sink is ~58% of the
+ * thread, the walk + decode ~41%. */
+enum { SQ_REGS = 2, SQ_CONSTS, SQ_VP, SQ_SCAL, SQ_CLEAR, SQ_BEGIN, SQ_END, SQ_ARRAYS, SQ_INDEX,
+       SQ_INLINE, SQ_INLINE_HELD, SQ_FLIP };
+#define SQ_HDR(op, n)  ((u32)(op) | ((u32)(n) << 8))
+#define SQ_NSCAL       (RSX_DSP_NUM_TEXTURES + 4u)
+#define SQ_INLINE_BIG  (16u << 10)             /* words: larger streams go through s_sq_inl at a sync */
+/* By writer, on cache lines of their own (see rsx_engine_split.c: shared lines
+ * between the two threads cost the sink ~1.5x): s_split is read by both and
+ * written once; the decoder's state is written by the walker only. */
+static struct { _Alignas(64) int on; } s_split_ro;
+#define s_split s_split_ro.on
+static struct { _Alignas(64) rsx_dispatch dec; u32 scal_sent[SQ_NSCAL]; } s_walk;
+#define s_dec       s_walk.dec               /* walker thread: the decoder's register file */
+#define s_scal_sent s_walk.scal_sent
+static u8* s_sq_inl; static u32 s_sq_inl_cap;  /* sink thread: the current inline stream */
+
+static int sq_inl_room(u32 bytes)
+{
+    if (bytes <= s_sq_inl_cap) return 1;
+    u8* p = (u8*)realloc(s_sq_inl, bytes);
+    if (!p) return 0;
+    s_sq_inl = p; s_sq_inl_cap = bytes;
+    return 1;
+}
+
+static void sq_scal_now(const rsx_dispatch* d, u32* o)
+{
+    o[0] = d->vp_gen; o[1] = d->tex_gen_all; o[2] = d->vtex_gen; o[3] = d->current_primitive;
+    memcpy(o + 4, d->tex_gen, sizeof d->tex_gen);
+}
+
+/* Walker thread: what the decoder changed since the last record. */
+static void sq_flush_state(void)
+{
+    rsx_dispatch* d = &s_dec;
+    if (d->track_n) {
+        const u32 n = d->track_n;
+        u32* o = rsx_sq_reserve(1u + 2u * n);
+        o[0] = SQ_HDR(SQ_REGS, 2u * n);
+        for (u32 i = 0; i < n; i++) {
+            const u32 idx = d->track_list[i];
+            o[1u + 2u * i] = idx; o[2u + 2u * i] = d->regs[idx];
+            d->track_bit[idx] = 0;
+        }
+        rsx_sq_commit(1u + 2u * n);
+        d->track_n = 0;
+    }
+    if (d->const_dirty_hi > d->const_dirty_lo) {
+        /* The slots written, as runs: the lo..hi union of a draw that sets
+         * slots 0-3 and 200-203 is 204 slots. */
+        for (u32 wi = d->const_dirty_lo >> 5; wi <= ((d->const_dirty_hi - 1u) >> 5) && wi < RSX_DSP_NUM_CONSTANTS / 32u; wi++) {
+            while (d->const_bits[wi]) {
+                const u32 lo = wi * 32u + (u32)__builtin_ctz(d->const_bits[wi]);
+                u32 hi = lo + 1u;
+                while (hi < RSX_DSP_NUM_CONSTANTS && (d->const_bits[hi >> 5] >> (hi & 31u) & 1u)) hi++;
+                for (u32 k = lo; k < hi; k++) d->const_bits[k >> 5] &= ~(1u << (k & 31u));
+                const u32 nw = (hi - lo) * 4u;
+                u32* o = rsx_sq_reserve(2u + nw);
+                o[0] = SQ_HDR(SQ_CONSTS, 1u + nw); o[1] = lo;
+                memcpy(o + 2, d->constants[lo], (size_t)nw * 4u);
+                rsx_sq_commit(2u + nw);
+            }
+        }
+        d->const_dirty_lo = d->const_dirty_hi = 0;
+    }
+    if (d->vp_dirty_hi > d->vp_dirty_lo) {
+        const u32 lo = d->vp_dirty_lo, nw = d->vp_dirty_hi - lo;
+        u32* o = rsx_sq_reserve(2u + nw);
+        o[0] = SQ_HDR(SQ_VP, 1u + nw); o[1] = lo;
+        memcpy(o + 2, d->vp + lo, (size_t)nw * 4u);
+        rsx_sq_commit(2u + nw);
+        d->vp_dirty_lo = d->vp_dirty_hi = 0;
+    }
+    u32 sc[SQ_NSCAL]; sq_scal_now(d, sc);
+    if (memcmp(sc, s_scal_sent, sizeof sc)) {
+        u32* o = rsx_sq_reserve(1u + SQ_NSCAL);
+        o[0] = SQ_HDR(SQ_SCAL, SQ_NSCAL); memcpy(o + 1, sc, sizeof sc);
+        rsx_sq_commit(1u + SQ_NSCAL);
+        memcpy(s_scal_sent, sc, sizeof sc);
+    }
+}
+
+static void sq_op(u32 op, u32 nargs, u32 a, u32 b)
+{
+    sq_flush_state();
+    u32* o = rsx_sq_reserve(1u + nargs);
+    o[0] = SQ_HDR(op, nargs);
+    if (nargs > 0) o[1] = a;
+    if (nargs > 1) o[2] = b;
+    rsx_sq_commit(1u + nargs);
+}
+
+/* The decoder's sink: record the call. */
+static void rec_clear(void* u, const rsx_dispatch* r, u32 mask) { (void)u; (void)r; sq_op(SQ_CLEAR, 1, mask, 0); }
+static void rec_begin(void* u, const rsx_dispatch* r, u32 prim) { (void)u; (void)r; sq_op(SQ_BEGIN, 1, prim, 0); }
+/* RSX_SPLIT_SERIAL=1 (diagnostic): wait for the sink after every draw -- the two threads never run at once. */
+static int s_split_serial = -1;
+static void rec_end(void* u, const rsx_dispatch* r)
+{
+    (void)u; (void)r;
+    sq_op(SQ_END, 0, 0, 0);
+    rsx_sq_publish();
+    if (__builtin_expect(s_split_serial < 0, 0)) s_split_serial = getenv("RSX_SPLIT_SERIAL") ? 1 : 0;
+    if (s_split_serial) rsx_sq_sync_at("serial (diagnostic)");
+}
+static void rec_arrays(void* u, const rsx_dispatch* r, u32 first, u32 count) { (void)u; (void)r; sq_op(SQ_ARRAYS, 2, first, count); }
+static void rec_index(void* u, const rsx_dispatch* r, u32 first, u32 count)  { (void)u; (void)r; sq_op(SQ_INDEX, 2, first, count); }
+static void rec_flip(void* u, const rsx_dispatch* r, u32 arg)   { (void)u; (void)r; sq_op(SQ_FLIP, 1, arg, 0); rsx_sq_publish(); }
+static void rec_inline(void* u, const rsx_dispatch* r, const u8* data, u32 bytes)
+{
+    (void)u; (void)r;
+    sq_flush_state();
+    const u32 nw = (bytes + 3u) / 4u;
+    if (nw <= SQ_INLINE_BIG) {
+        u32* o = rsx_sq_reserve(2u + nw);
+        o[0] = SQ_HDR(SQ_INLINE, 1u + nw); o[1] = bytes;
+        memcpy(o + 2, data, bytes);
+        rsx_sq_commit(2u + nw);
+    } else {
+        /* Past a sync the sink thread is not using s_sq_inl: fill it here. */
+        rsx_sq_sync();
+        const u32 ok = sq_inl_room(bytes) ? bytes : 0u;
+        if (ok) memcpy(s_sq_inl, data, bytes);
+        u32* o = rsx_sq_reserve(2u);
+        o[0] = SQ_HDR(SQ_INLINE_HELD, 1u); o[1] = ok;
+        rsx_sq_commit(2u);
+    }
+}
+
+/* Sink thread: one record onto g.rsx, then the ordinary sink. */
+static uint32_t sq_consume(const uint32_t* rec)
+{
+    const u32 op = rec[0] & 0xFFu, n = rec[0] >> 8;
+    const u32* p = rec + 1;
+    rsx_dispatch* r = &g.rsx;
+    switch (op) {
+    case SQ_REGS:
+        for (u32 i = 0; i < n; i += 2) r->regs[p[i]] = p[i + 1];
+        break;
+    case SQ_CONSTS: {
+        const u32 lo = p[0], nw = n - 1u, hi = lo + nw / 4u;
+        memcpy(r->constants[lo], p + 1, (size_t)nw * 4u);
+        if (r->const_dirty_lo == r->const_dirty_hi) { r->const_dirty_lo = lo; r->const_dirty_hi = hi; }
+        else { if (lo < r->const_dirty_lo) r->const_dirty_lo = lo;
+               if (hi > r->const_dirty_hi) r->const_dirty_hi = hi; }
+        break; }
+    case SQ_VP:
+        memcpy(r->vp + p[0], p + 1, (size_t)(n - 1u) * 4u);
+        break;
+    case SQ_SCAL:
+        r->vp_gen = p[0]; r->tex_gen_all = p[1]; r->vtex_gen = p[2]; r->current_primitive = p[3];
+        memcpy(r->tex_gen, p + 4, sizeof r->tex_gen);
+        break;
+    case SQ_CLEAR:  sink_clear(NULL, r, p[0]); break;
+    case SQ_BEGIN:  sink_begin(NULL, r, p[0]); break;
+    case SQ_END:    sink_end(NULL, r); break;
+    case SQ_ARRAYS: sink_draw_arrays(NULL, r, p[0], p[1]); break;
+    case SQ_INDEX:  sink_draw_index(NULL, r, p[0], p[1]); break;
+    case SQ_INLINE:
+        if (sq_inl_room(p[0])) { memcpy(s_sq_inl, p + 1, p[0]); sink_inline_array(NULL, r, s_sq_inl, p[0]); }
+        break;
+    case SQ_INLINE_HELD:
+        if (p[0]) sink_inline_array(NULL, r, s_sq_inl, p[0]);
+        break;
+    case SQ_FLIP:   sink_flip(NULL, r, p[0]); break;
+    default:
+        { static int bad; if (bad++ < 4) fprintf(stderr, "[rsx engine] split walker: unknown record 0x%08X%c", rec[0], 10); }
+        break;
+    }
+    return 1u + n;
+}
+
+/* Every entry point except the method feed: the caller owns g after this. */
+static void eng_split_sync_at(const char* where)
+{
+    if (!s_split || rsx_sq_on_sink_thread()) return;
+    sq_flush_state();
+    rsx_sq_sync_at(where);
+}
+void rsx_draw_engine_split_sync_at(const char* where) { eng_split_sync_at(where); }
+int  rsx_draw_engine_split_on(void) { return s_split; }
+
+static void eng_split_init(void)
+{
+    const char* e = getenv("RSX_WALKER_SPLIT");
+    if (!(e && *e == '1')) return;
+    rsx_dispatch_sink rs;
+    memset(&rs, 0, sizeof rs);
+    rs.clear = rec_clear; rs.begin = rec_begin; rs.end = rec_end; rs.draw_arrays = rec_arrays;
+    rs.draw_index_array = rec_index; rs.inline_array = rec_inline; rs.flip = rec_flip;
+    rsx_dispatch_init(&s_dec, &rs);
+    s_dec.track_bit = (u8*)calloc(RSX_DSP_NUM_REGS, 1);
+    s_dec.track_list = (u32*)malloc(RSX_DSP_NUM_REGS * sizeof(u32));
+    /* Both register files start equal (rsx_dispatch_init), so the deltas are the whole story. */
+    sq_scal_now(&g.rsx, s_scal_sent);
+    if (s_dec.track_bit && s_dec.track_list && rsx_sq_start(sq_consume)) s_split = 1;
+    fprintf(stderr, "[rsx engine] split walker %s: the FIFO walker decodes, a sink thread draws%c",
+            s_split ? "ON" : "FAILED to start (one thread, as before)", 10);
+}
