+static ring_ent s_ring[RING_N]; static volatile long s_ring_n;
+static int ring_on(void)
+{
+    if (s_ring_on < 0) {
+        const char* e = getenv("RACACIT_LINE_RING"); s_ring_on = 0;
+        if (e && *e) {   /* up to four lines, comma-separated */
+            int k = 0; const char* p = e;
+            while (k < 4 && *p) { char* end = 0; const uint32_t v = (uint32_t)strtoul(p, &end, 16) & ~127u;
+                if (end == p) break; s_ring_ea[k++] = v; p = (*end == ',') ? end + 1 : end; }
+            for (int j = k; j < 4; j++) s_ring_ea[j] = k ? s_ring_ea[0] : 0;
+            s_ring_on = k > 0; }
+    }
+    return s_ring_on;
+}
+void racacit_ring_note(char op, uint32_t id, uint32_t pc, uint32_t ea, int only_if_changed)
+{
+    if (!ring_on()) return;
+    const uint32_t l = ea & ~127u;
+    if (l != s_ring_ea[0] && l != s_ring_ea[1] && l != s_ring_ea[2] && l != s_ring_ea[3]) return;
+    extern uint8_t* vm_base;
+    if (only_if_changed) {   /* a polling GETLLAR: only when the line moved since the last entry for it */
+        const long n = s_ring_n;
+        for (long k = n - 1; k >= 0 && k >= n - RING_N; k--) {
+            const ring_ent* r = &s_ring[k & (RING_N - 1)];
+            if (r->ea == l) { if (!memcmp(r->line, vm_base + l, 64)) return; break; }
+        }
+    }
+    extern unsigned long long ps3_qpc_us(void);
+    const long i = InterlockedIncrement(&s_ring_n) - 1;
+    ring_ent* r = &s_ring[i & (RING_N - 1)];
+    r->t = ps3_qpc_us(); r->ea = l; r->id = id; r->pc = pc; r->op = op;
+    memcpy(r->line, vm_base + l, 64);
+}
+void racacit_ring_dump(void)
+{
+    if (!ring_on()) return;
+    const long n = s_ring_n;
+    fprintf(stderr, "[line-ring] %ld events on %08X %08X %08X %08X, the last %d:%c", n, s_ring_ea[0], s_ring_ea[1], s_ring_ea[2], s_ring_ea[3],
+            n < RING_N ? (int)n : RING_N, 10);
+    for (long k = n > RING_N ? n - RING_N : 0; k < n; k++) {
+        const ring_ent* r = &s_ring[k & (RING_N - 1)];
