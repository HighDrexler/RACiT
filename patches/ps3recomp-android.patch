+/* Graphics presets: internal resolution, texture filtering and texture
+ * quality as one choice. "Original" is the PS3's own image: 960x704, plain
+ * filtering, every texture level. */
+static const struct { const char* name; float res; int aniso, tri, texq; } k_presets[] = {
+    { "Low",            0.75f, 0,  0, 2 },
+    { "Medium",         1.0f,  2,  1, 1 },
+    { "High",           1.5f,  4,  1, 0 },
+    { "Ultra",          2.0f, 16,  1, 0 },
+    { "Original (PS3)", 1.0f,  0,  0, 0 },
+};
+static int preset_aniso(int i)   /* the preset's anisotropy, within what the GPU offers */
+{
+    int an = k_presets[i].aniso;
+    while (an > 1 && (float)an > s_max_aniso) an /= 2;
+    return an == 1 ? 0 : an;
+}
+static int preset_of(const rsx_host_options* o)
+{
+    for (int i = 0; i < N_OF(k_presets); i++)
+        if (fabsf(o->res_scale - k_presets[i].res) < 0.01f && o->aniso == preset_aniso(i) &&
+            o->trilinear == k_presets[i].tri && o->tex_quality == k_presets[i].texq) return i;
+    return -1;
+}
+
+static int row_enabled(int i, const rsx_host_options* o)
+{
+    if (k_rows[i].kind == K_HEAD || k_rows[i].kind == K_GAP) return 0;
+    if (k_rows[i].id == R_WINSIZE) return o->display_mode == RSX_UI_DISPLAY_WINDOWED;
+    if (k_rows[i].id == R_SHARP) return o->upscale == RSX_UI_UPSCALE_SHARP;
+    if (k_rows[i].id == R_DSVOL) return o->ds_speaker;
+    if (k_rows[i].id == R_DSHVOL) return o->ds_haptics;
+    if (k_rows[i].id == R_DSTRIGSTR) return o->ds_triggers;
+    if (k_rows[i].id == R_MSENS || k_rows[i].id == R_MINV) return o->kbm;
+    return 1;
+}
