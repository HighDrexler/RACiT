+static spu_fn spu_lookup_ctx_found(const spu_context* ctx, uint32_t addr, int image_id, uint32_t* found)
+{
+    spu_fn fn = spu_lookup_fixed(ctx, addr, image_id, found);
+    if (fn) {
+        if (ctx) ((spu_context*)ctx)->ls_delta = 0;
+        return fn;
+    }
+    if (ctx && s_rl_any && addr + 8 <= SPU_LS_SIZE) {
+        uint32_t delta = 0;
+        fn = spu_lookup_reloc(ctx, addr, &delta, found);
+        if (fn) { ((spu_context*)ctx)->ls_delta = delta; return fn; }
+    }
+    /* (SPU_DUMP_STUBS read once: this is reached on every branch to a PM-generated stub -- the WWS
+     * sound module's interrupt shim at LS 0x3FEC0, ~22,000 times a second at Space Sector 1 -- and
+     * getenv walked the whole environment each time: 0.9% of the sound thread in the .38 profile.) */
+    static int s_dump_stubs = -1;
+    if (__builtin_expect(s_dump_stubs < 0, 0)) s_dump_stubs = getenv("SPU_DUMP_STUBS") ? 1 : 0;
+    if (ctx && ctx->policy_mode && (addr < 0x3F000u || s_dump_stubs))   /* 0x3Fxxx: PM-generated stubs */
+        spu_dump_unknown_job(ctx, addr);
+    return NULL;
+}
