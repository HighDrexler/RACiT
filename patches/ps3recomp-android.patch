diff --git a/libs/video/tests/test_fp_shape.c b/libs/video/tests/test_fp_shape.c
new file mode 100644
index 0000000..f3d4836
--- /dev/null
+++ b/libs/video/tests/test_fp_shape.c
@@ -0,0 +1,164 @@
+/*
+ * rsx_fp_shape_* (v113-android.41) against the three walks it stands in for in the draw engine:
+ * rsx_fp_program_size_mask, rsx_fp_collect_constants and rsx_fp_structural_hash.
+ *
+ * For random programs (the generator of test_fp_size_mask.c, plus pure random bytes):
+ *   - a built shape carries the size, texture units, hash and constant count the walks give;
+ *   - after ANY rewrite of the constant slots only, rsx_fp_shape_same accepts the program, and the
+ *     walks on the rewritten program still give the shape's size, units and hash, and
+ *     rsx_fp_shape_constants gives rsx_fp_collect_constants' block;
+ *   - after a change to any one byte of any instruction slot, rsx_fp_shape_same refuses it.
+ * FP_SHAPE_MUTANT=1/2/3 builds a deliberately wrong copy of the check (a slot skipped, a
+ * half-slot compared, a constant slot off by one) to show the test catches it.
+ *
+ *   zig cc -O2 -std=gnu17 -I include -I libs/video -o test_fp_shape.exe
+ *       libs/video/tests/test_fp_shape.c libs/video/rsx_fp_decompiler.c (+ its dependencies)
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "rsx_fp_decompiler.h"
+
+static unsigned rng = 0x9E3779B9u;
+static unsigned rnd(void) { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+
+static void put_word(unsigned char* p, unsigned w)
+{
+    const unsigned be = (w << 16) | (w >> 16);
+    p[0] = (unsigned char)(be >> 24); p[1] = (unsigned char)(be >> 16); p[2] = (unsigned char)(be >> 8); p[3] = (unsigned char)be;
+}
+
+#ifdef FP_SHAPE_MUTANT
+/* Wrong on purpose: what the test must catch. */
+static int mutant_same(const rsx_fp_shape* shape, const u8* ucode)
+{
+    const u32 n = shape->size >> 4;
+    for (u32 slot = 0; slot < n; slot++) {
+        if (shape->is_const[slot >> 3] & (1u << (slot & 7u))) continue;
+#if FP_SHAPE_MUTANT == 1
+        if (slot == n - 1) continue;                                  /* the last instruction unchecked */
+        if (memcmp(ucode + slot * 16u, shape->code + slot * 16u, 16)) return 0;
+#elif FP_SHAPE_MUTANT == 2
+        if (memcmp(ucode + slot * 16u, shape->code + slot * 16u, 8)) return 0;   /* half a slot */
+#else
+        if (memcmp(ucode + slot * 16u, shape->code + slot * 16u, 16)) return 0;
+#endif
+    }
+    return 1;
+}
+static void mutant_constants(const rsx_fp_shape* shape, const u8* ucode, rsx_fp_constant_block* out)
+{
+#if FP_SHAPE_MUTANT == 3
+    u32 count = 0;
+    const u32 n = shape->size >> 4;
+    for (u32 slot = 0; slot < n && count < shape->n_const; slot++) {
+        if (!(shape->is_const[slot >> 3] & (1u << (slot & 7u)))) continue;
+        for (u32 c = 0; c < 4; ++c)   /* components in the wrong order */
+            out->values[count][c] = rsx_fp_sanitize_constant_word(rsx_fp_read_word(ucode + slot * 16u + (3 - c) * 4));
+        count++;
+    }
+    out->count = count;
+#else
+    rsx_fp_shape_constants(shape, ucode, out);
+#endif
+}
+#define SAME mutant_same
+#define CONSTS mutant_constants
+#else
+#define SAME rsx_fp_shape_same
+#define CONSTS rsx_fp_shape_constants
+#endif
+
+int main(void)
+{
+    enum { MAXB = 4096 };
+    static const unsigned long long SEED = 1469598103934665603ull;
+    static unsigned char prog[MAXB + 64], work[MAXB + 64];
+    static rsx_fp_shape sh;
+    static rsx_fp_constant_block a, b;
+    long cases = 0, built = 0, unbuilt_long = 0, unbuilt_other = 0, fails = 0;
+    long const_rewrites = 0, instr_changes = 0, with_const = 0;
+#define FAIL(...) do { if (fails++ < 8) { printf("  FAIL (case %d): ", it); printf(__VA_ARGS__); printf("\n"); } } while (0)
+    for (int it = 0; it < 120000; it++) {
+        const int pure_random = rnd() % 12 == 0;
+        for (int i = 0; i < MAXB + 64; i++) prog[i] = (unsigned char)rnd();
+        if (!pure_random) {
+            const unsigned n_ins = 1 + rnd() % (rnd() % 6 == 0 ? 200 : 60);
+            const unsigned end_at = rnd() % 10 == 0 ? ~0u : rnd() % n_ins;
+            unsigned off = 0;
+            for (unsigned k = 0; k < n_ins && off + 16 <= MAXB + 48; k++) {
+                unsigned w0 = rnd(), w1 = rnd(), w2 = rnd(), w3 = rnd();
+                w0 &= ~1u;
+                if (k == end_at) w0 |= 1u;
+                if (rnd() % 3 == 0) w0 = (w0 & ~(0x3Fu << 24)) | ((unsigned)(0x17 + rnd() % 3) << 24);
+                if (rnd() % 4) w2 &= 0x7FFFFFFFu;
+                if (rnd() % 3 == 0) { const unsigned which = rnd() % 3; unsigned* s = which == 0 ? &w1 : which == 1 ? &w2 : &w3;
+                                      *s = (*s & ~3u) | 2u; }
+                else { w1 &= ~3u; w2 &= ~3u; w3 &= ~3u; }
+                put_word(prog + off, w0); put_word(prog + off + 4, w1); put_word(prog + off + 8, w2); put_word(prog + off + 12, w3);
+                off += 16;
+                if (k == end_at) break;
+            }
+        }
+        unsigned mask = 0;
+        const unsigned size = rsx_fp_program_size_mask(prog, MAXB, &mask);
+        if (!size) continue;
+        cases++;
+        const int ok = rsx_fp_shape_build(prog, size, SEED, &sh);
+        const int n_old = rsx_fp_collect_constants(prog, size, &a);
+        const unsigned long long h_old = rsx_fp_structural_hash(prog, size, SEED);
+        if (!ok) {
+            if (sh.size) FAIL("no shape, but size left at %u", sh.size);
+            if (size > RSX_FP_SHAPE_MAX_BYTES) unbuilt_long++;
+            else { unbuilt_other++;
+                   /* refusing is only right when a walk refuses too (a constant slot past the end) */
+                   if (n_old >= 0 && h_old) FAIL("shape refused a program the walks accept (size %u)", size); }
+            continue;
+        }
+        built++;
+        if (sh.size != size) FAIL("size %u, walk %u", sh.size, size);
+        if (sh.tex_mask != mask) FAIL("texture units %04X, walk %04X", sh.tex_mask, mask);
+        if (sh.hash != h_old || !h_old) FAIL("hash differs");
+        if ((int)sh.n_const != n_old) FAIL("constants %u, walk %d", sh.n_const, n_old);
+        if (!SAME(&sh, prog)) FAIL("the program it was built from is refused");
+        if (sh.n_const) with_const++;
+
+        /* constants rewritten, in every way: all of them, some of them, single bytes */
+        for (int round = 0; round < 3; round++) {
+            memcpy(work, prog, MAXB + 64);
+            for (unsigned slot = 0; slot < size / 16; slot++) {
+                if (!(sh.is_const[slot >> 3] & (1u << (slot & 7u)))) continue;
+                if (round == 0) for (int i = 0; i < 16; i++) work[slot * 16 + i] = (unsigned char)rnd();
+                else if (round == 1) { if (rnd() & 1) for (int i = 0; i < 16; i++) work[slot * 16 + i] = (unsigned char)rnd(); }
+                else work[slot * 16 + rnd() % 16] ^= (unsigned char)(1u << (rnd() % 8));
+            }
+            const_rewrites++;
+            if (!SAME(&sh, work)) { FAIL("constants rewritten: refused"); continue; }
+            unsigned m2 = 0;
+            const unsigned s2 = rsx_fp_program_size_mask(work, MAXB, &m2);
+            if (s2 != sh.size || m2 != sh.tex_mask) FAIL("constants rewritten: the walk gives size %u units %04X, the shape %u %04X", s2, m2, sh.size, sh.tex_mask);
+            if (rsx_fp_structural_hash(work, s2, SEED) != sh.hash) FAIL("constants rewritten: hash moved");
+            const int n2 = rsx_fp_collect_constants(work, s2, &a);
+            b.count = 12345u;
+            CONSTS(&sh, work, &b);
+            if (n2 != (int)b.count) FAIL("constants rewritten: count %u, walk %d", b.count, n2);
+            else if (n2 > 0 && memcmp(a.values, b.values, (size_t)n2 * sizeof a.values[0])) FAIL("constants rewritten: values differ");
+        }
+        /* one byte of one instruction slot changed: never the same program */
+        for (int round = 0; round < 6; round++) {
+            unsigned slot, tries = 0;
+            do { slot = rnd() % (size / 16); } while ((sh.is_const[slot >> 3] & (1u << (slot & 7u))) && ++tries < 64);
+            if (tries >= 64) break;
+            if (round == 0) slot = size / 16 - 1 - (unsigned)((sh.is_const[(size / 16 - 1) >> 3] >> ((size / 16 - 1) & 7u)) & 1u);   /* the last instruction */
+            if (sh.is_const[slot >> 3] & (1u << (slot & 7u))) continue;
+            memcpy(work, prog, MAXB + 64);
+            work[slot * 16 + (round == 1 ? 15 : rnd() % 16)] ^= (unsigned char)(1u << (rnd() % 8));
+            instr_changes++;
+            if (SAME(&sh, work)) FAIL("an instruction byte changed (slot %u of %u): accepted", slot, size / 16);
+        }
+    }
+    printf("fp shape: %ld programs with an end, %ld shapes built (%ld with constants), %ld too long, %ld malformed; "
+           "%ld constant rewrites, %ld instruction changes; %ld failures\n",
+           cases, built, with_const, unbuilt_long, unbuilt_other, const_rewrites, instr_changes, fails);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_fp_size_mask.c b/libs/video/tests/test_fp_size_mask.c
new file mode 100644
index 0000000..f7a2f73
--- /dev/null
+++ b/libs/video/tests/test_fp_size_mask.c
@@ -0,0 +1,68 @@
+/*
+ * rsx_fp_program_size_mask (v113-android.37) against what it replaces in the draw engine:
+ * rsx_fp_program_size(ucode, max), then rsx_fp_texture_mask(ucode, that size). Random programs
+ * built from instruction words whose END, BRANCH, opcode, texture unit and CONST source bits are
+ * drawn on purpose (a constant slot after an instruction, ends near the bound, no end at all,
+ * bounds not a multiple of 16), plus pure random bytes.
+ *
+ *   zig cc -O2 -std=gnu17 -I include -I libs/video -o test_fp_size_mask.exe
+ *       libs/video/tests/test_fp_size_mask.c libs/video/rsx_fp_decompiler.c (+ its dependencies)
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "rsx_fp_decompiler.h"
+
+static unsigned rng = 0x2545F491u;
+static unsigned rnd(void) { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+
+/* A word as the walk reads it (rsx_fp_read_word: big-endian, halves swapped), stored back. */
+static void put_word(unsigned char* p, unsigned w)
+{
+    const unsigned be = (w << 16) | (w >> 16);
+    p[0] = (unsigned char)(be >> 24); p[1] = (unsigned char)(be >> 16); p[2] = (unsigned char)(be >> 8); p[3] = (unsigned char)be;
+}
+
+int main(void)
+{
+    enum { MAXB = 4096 };
+    static unsigned char prog[MAXB + 64];
+    long cases = 0, fails = 0, ended = 0, noend = 0, with_tex = 0;
+    for (int it = 0; it < 200000; it++) {
+        const int pure_random = rnd() % 10 == 0;
+        for (int i = 0; i < MAXB + 64; i++) prog[i] = (unsigned char)rnd();
+        if (!pure_random) {
+            const unsigned n_ins = 1 + rnd() % 120;
+            const unsigned end_at = rnd() % 8 == 0 ? ~0u : rnd() % n_ins;   /* sometimes no end */
+            unsigned off = 0;
+            for (unsigned k = 0; k < n_ins && off + 16 <= MAXB + 48; k++) {
+                unsigned w0 = rnd(), w1 = rnd(), w2 = rnd(), w3 = rnd();
+                w0 &= ~1u;                                           /* END bit: only where chosen */
+                if (k == end_at) w0 |= 1u;
+                if (rnd() % 3 == 0) w0 = (w0 & ~(0x3Fu << 24)) | ((unsigned)(0x17 + rnd() % 3) << 24);   /* TEX-ish opcodes */
+                if (rnd() % 4) w2 &= 0x7FFFFFFFu;                    /* most not branches */
+                /* CONST source type in one of the three source words, sometimes */
+                if (rnd() % 3 == 0) { const unsigned which = rnd() % 3; unsigned* s = which == 0 ? &w1 : which == 1 ? &w2 : &w3;
+                                      *s = (*s & ~3u) | 2u; }
+                else { w1 &= ~3u; w2 &= ~3u; w3 &= ~3u; }
+                put_word(prog + off, w0); put_word(prog + off + 4, w1); put_word(prog + off + 8, w2); put_word(prog + off + 12, w3);
+                off += 16;
+                if (k == end_at) break;
+            }
+        }
+        const unsigned max = (rnd() % 5 == 0) ? (unsigned)(rnd() % (MAXB + 1)) : (unsigned)MAXB;
+        unsigned mask_new = 0;
+        const unsigned size_old = rsx_fp_program_size(prog, max);
+        const unsigned size_new = rsx_fp_program_size_mask(prog, max, &mask_new);
+        const unsigned mask_old = size_old ? rsx_fp_texture_mask(prog, size_old) : 0xFFFFu;
+        cases++;
+        if (size_old) ended++; else noend++;
+        if (size_old && mask_old && mask_old != 0xFFFFu) with_tex++;
+        if (size_old != size_new || mask_old != mask_new) {
+            if (fails++ < 5) printf("  differs (case %d): size %u/%u mask %04X/%04X max %u\n", it, size_old, size_new, mask_old, mask_new, max);
+        }
+    }
+    printf("fp size+mask: %ld programs (%ld with an end, %ld with texture units, %ld without an end), %ld mismatches\n",
+           cases, ended, with_tex, noend, fails);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_gcm_resync_excursion.c b/libs/video/tests/test_gcm_resync_excursion.c
new file mode 100644
index 0000000..865b1ec
--- /dev/null
+++ b/libs/video/tests/test_gcm_resync_excursion.c
@@ -0,0 +1,191 @@
+/* A resync from outside the ring sweeps the block put is in, not the IO
+ * space between the two (cellGcmSys.c, gcm_fifo_resync_why).
+ *
+ * Ratchet & Clank: A Crack in Time double-buffers its frames in two 5 MB
+ * blocks, A and B. Each starts with a header (semaphore releases and a flip),
+ * the frame follows, and the frame ends in a JUMP to the other block's header;
+ * put stops just past that header. Reading text in the museum or the Battleplex
+ * sometimes left the walker taking a JUMP from the start of B into low IO that
+ * held a data table, not commands. It hit a bad word there and resynced to put
+ * (A + 0x24). The fence sweep then ran from that low address up to put, across
+ * 22 to 27 MB of IO: textures, vertex data and the stale frames in A. It
+ * queued 781 to 5724 old SET_REFERENCE values, more the longer the session.
+ * The label walk stopped on the first bad word, so the releases in A's header
+ * were never replayed. The title spun on that frame's release until its own
+ * "GPU sit and spin" timeout, about 40 seconds with the screen frozen.
+ *
+ * The walker took a JUMP into A's header two frames earlier, so that target
+ * is where put's block starts. The resync now sweeps from there.
+ *
+ * Layout (IO offsets):
+ *   0x3F0000  previous frame's tail: JUMP A
+ *   0x400000  A: header (release 0x400), a method, JUMP B
+ *   0x480000  B: header (release 0x400), then a JUMP into low IO
+ *   0x001000  low IO: one method, then a word that branches to unmapped IO
+ *   0x002000  stale data: 64 old SET_REFERENCE commands
+ *
+ * zig cc -target x86_64-windows-gnu -std=gnu17 -I include -I libs/video
+ *   libs/video/tests/test_gcm_resync_excursion.c -ffunction-sections
+ *   -fdata-sections -Wl,--gc-sections -o test_gcm_resync_excursion.exe
+ */
+#include "../cellGcmSys.c"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+u32 g_rsx_last_reference;
+void (*g_spu_put_hook)(uint32_t ea, uint32_t size);
+void ppu_dump_bctrl_ring(uint32_t n, const char* why) { (void)n; (void)why; }
+void ppu_dump_guest_stack(ppu_context* c, const char* why) { (void)c; (void)why; }
+void rsx_state_init(rsx_state* state) { (void)state; }
+int  rsx_process_method(rsx_state* state, u32 method, u32 data) { (void)state; (void)method; (void)data; return 0; }
+int  rsx_draw_engine_enabled(void) { return 0; }
+int  rsx_process_vp_run(rsx_state* state, u32 method, const u8* src, u32 count)
+{ (void)state; (void)method; (void)src; (void)count; return 0; }
+rsx_backend* rsx_get_backend(void) { return NULL; }
+void rsx_draw_engine_method(u32 method, u32 arg) { (void)method; (void)arg; }
+void rsx_draw_engine_note_flip(u32 buffer_id) { (void)buffer_id; }
+void rsx_draw_engine_set_display_buffer(u32 id, u32 location, u32 offset, u32 pitch, u32 width, u32 height)
+{ (void)id; (void)location; (void)offset; (void)pitch; (void)width; (void)height; }
+void rsx_draw_engine_guest_read(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+void rsx_draw_engine_guest_wrote(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+int  rsx_live_draw_enabled(void) { return 0; }
+void rsx_live_draw_method(u32 method, u32 arg) { (void)method; (void)arg; }
+int  rsx_live_draw_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 w, u32 h)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)w; (void)h; return 0; }
+void rsx_live_draw_note_resolve(u32 a, u32 b, u32 c, u32 d) { (void)a; (void)b; (void)c; (void)d; }
+int  rsx_live_draw_resolve_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 g, u32 h,
+                                u32 i, u32 j, u32 k, u32 l)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i; (void)j; (void)k; (void)l; return 0; }
+void rsx_raise_user_cmd(uint32_t arg) { (void)arg; }
+/* RACiT's runtime hooks the walker also calls. */
+void edgezlib_check_range(u32 ea, u32 len) { (void)ea; (void)len; }
+uint64_t ps3_guest_clock_epoch_qpc(void) { return 0; }
+void ps3_tl(char ev, u32 a, u32 b) { (void)ev; (void)a; (void)b; }
+u32  rsx_draw_engine_park_id(void) { return 0; }
+void rsx_stats_add(u32 a, u32 b, u32 c) { (void)a; (void)b; (void)c; }
+void rsx_ww_poll(void) {}
+void rsx_ww_poll_heap(void) {}
+int  vm_plain_copy(u32 dst, u32 src, u32 n) { memmove(vm_base + dst, vm_base + src, n); return 1; }
+u8*  vm_plain_span(u32 ea, u32 n, int write) { (void)n; (void)write; return vm_base + ea; }
+
+#define IO_ADDR   0x00800000u
+#define IO_SIZE   0x00800000u
+#define CMD_SIZE  0x00010000u
+
+#define BLK_A     0x00400000u
+#define BLK_B     0x00480000u
+#define PREV_TAIL 0x003F0000u
+#define LOW       0x00001000u
+#define STALE     0x00002000u
+#define N_STALE   64u
+
+static uint32_t g_heap = 0x00400000u;
+static u32 host_alloc(u32 size, u32 align)
+{
+    if (!align) align = 4;
+    g_heap = (g_heap + align - 1u) & ~(align - 1u);
+    u32 r = g_heap;
+    g_heap += size;
+    return r;
+}
+static void gw32(uint32_t ea, uint32_t v)
+{
+    uint8_t* p = vm_base + ea;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+static void host_w32(u32 ea, u32 v) { gw32(ea, v); }
+
+static int fails;
+static void check(int ok, const char* what)
+{
+    printf("[%s] %s\n", ok ? "PASS" : "FAIL", what);
+    fails += !ok;
+}
+
+/* One method, count 1, subchannel 0. */
+static u32 put_method(u32 io, u32 method, u32 arg)
+{
+    gw32(IO_ADDR + io, (1u << 18) | method);
+    gw32(IO_ADDR + io + 4, arg);
+    return io + 8;
+}
+static u32 put_jump(u32 io, u32 target)
+{
+    gw32(IO_ADDR + io, 0x20000000u | target);
+    return io + 4;
+}
+/* A block header: NV406E semaphore offset 0x400, release `v`. */
+static u32 put_header(u32 io, u32 v)
+{
+    io = put_method(io, 0x0064u, 0x0400u);
+    return put_method(io, 0x006Cu, v);
+}
+
+static void run(const uint32_t ctrl, u32 put)
+{
+    vm_write32(ctrl + 0, put);
+    cellGcm_rsx_process_fifo();
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    const uint32_t vm_size = ppu_hle_inject_base + 0x10000u;
+    vm_base = (uint8_t*)calloc(1, vm_size);
+    if (!vm_base) { puts("FAIL: guest VM alloc"); return 1; }
+    ppu_vm_size = vm_size;
+
+    u32 ctx_out = host_alloc(4, 4);
+    (void)cellGcmSetupContext(ctx_out, CMD_SIZE, IO_SIZE, IO_ADDR, host_alloc, host_w32);
+    const uint32_t ctrl = (uint32_t)(uintptr_t)cellGcmGetControlRegister();
+
+    /* Stale data well below the ring: old fences a linear sweep would find. */
+    for (u32 i = 0; i < N_STALE; i++)
+        (void)put_method(STALE + i * 16u, 0x0050u, 0xBAD00000u + i);
+
+    /* Frame 1: the previous frame's tail jumps to A; A's frame ends in a
+     * JUMP to B; put stops past B's header. */
+    (void)put_jump(PREV_TAIL, BLK_A);
+    u32 io = put_header(BLK_A, 0x11u);
+    io = put_method(io, 0x1FCCu, 0x6Fu);
+    (void)put_jump(io, BLK_B);
+    const u32 b_put = put_header(BLK_B, 0x22u);
+
+    s_fifo_getoff = PREV_TAIL;
+    vm_write32(ctrl + 4, PREV_TAIL);
+    run(ctrl, b_put);
+    check(s_fifo_getoff == b_put, "frame 1 walks A and stops past B's header");
+    check(vm_read32(GCM_LABEL_GUEST_BASE + 0x400u) == 0x22u, "B's header release reached the label");
+
+    /* Frame 2: B's frame starts with a JUMP into low IO, where a method is
+     * followed by a word that branches to unmapped IO. A gets its next header
+     * and put stops past it. */
+    (void)put_jump(b_put, LOW);
+    io = put_method(LOW, 0x1FCCu, 0x6Fu);
+    gw32(IO_ADDR + io, 0x3F800000u);                    /* float 1.0: JUMP 0x1F800000 */
+    const u32 a_put = put_header(BLK_A, 0x33u);
+
+    const u32 pushed_before = s_ref_qtail;
+    run(ctrl, a_put);
+    check(s_fifo_getoff == a_put, "the bad branch resyncs get to put");
+    check(vm_read32(GCM_LABEL_GUEST_BASE + 0x400u) == 0x33u,
+          "the release in A's header, skipped by the resync, was replayed");
+    check(s_ref_qtail == pushed_before,
+          "no stale SET_REFERENCE from below the ring was queued");
+
+    printf("[gcm_resync_excursion] %s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    free(vm_base);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_rsx_draw_engine.c b/libs/video/tests/test_rsx_draw_engine.c
index 704ccef..7beb023 100644
--- a/libs/video/tests/test_rsx_draw_engine.c
