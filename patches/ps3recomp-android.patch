+/* ---------------------------------------------------------------------------
+ * FPS counter
+ * -------------------------------------------------------------------------*/
+void rsx_host_ui_on_present(void)
+{
+    {   static unsigned long long s_disp_next;   /* the display: at the first present, then every 2 s */
+        const unsigned long long m = now_ms();
+        if (m >= s_disp_next) { s_disp_next = m + 2000; display_check(); } }
+    const unsigned long long t = SDL_GetPerformanceCounter();
+    static double freq;
+    if (!freq) freq = (double)SDL_GetPerformanceFrequency();
+    if (s_last_present) {
+        s_ft[s_ft_n % N_OF(s_ft)] = (double)(t - s_last_present) * 1000.0 / freq;
+        s_ft_n++;
+    }
+    s_last_present = t;
+    const unsigned long long ms = now_ms();
+    if (ms < s_fps_next) return;
+    s_fps_next = ms + 500;
+    /* Over the last second's frames: rate, average and worst frame time. */
+    double sum = 0.0, worst = 0.0; unsigned n = 0;
+    for (unsigned i = 0; i < N_OF(s_ft) && i < s_ft_n && sum < 1000.0; i++) {
+        const double d = s_ft[(s_ft_n - 1 - i) % N_OF(s_ft)];
+        sum += d; n++; if (d > worst) worst = d;
+    }
+    char b[64];
+    if (n && sum > 0.0) snprintf(b, sizeof b, "%.0f FPS   %.1f ms   (worst %.0f ms)", n * 1000.0 / sum, sum / n, worst);
+    else snprintf(b, sizeof b, "-- FPS");
+    LOCK(); memcpy(s_fps_text, b, sizeof b); UNLOCK();
+    /* Uneven (a frame twice the average and past 25 ms) or low (under 45
+     * fps) for about 10 s more than it was even, past the first 90 s of boot
+     * and loading, with pacing off: show the hint, unless another notice or
+     * the menu is up. */
+    if (!s_first_present_ms) s_first_present_ms = ms;
+    if (!s_pace_hinted && !s_open && !s_note.on && g_racacit_present_pace == 0 && n >= 15 && sum > 0.0
+        && ms - s_first_present_ms > 90000) {
+        const double avg = sum / n, fps = n * 1000.0 / sum;
+#if defined(__ANDROID__)
+        /* Android's pacing holds only at the game's own 60 fps cadence (rsx_be_proxy.c): below it
+         * the hint's advice would do nothing, so only uneven frames at ~60 count. */
+        const int bad = fps >= 55.0 && worst > avg * 2.0 && worst > 25.0;
+#else
+        const int bad = (worst > avg * 2.0 && worst > 25.0) || fps < 45.0;
+#endif
+        s_pace_score = bad ? s_pace_score + 1 : (s_pace_score > 0 ? s_pace_score - 1 : 0);
+        if (s_pace_score >= 20) {
+            s_pace_hinted = 1;
+            fprintf(stderr, "[settings] frame rate uneven with pacing off (%.0f fps, worst %.0f ms): showing the frame pacing hint%c", fps, worst, 10);
+            LOCK();
+            snprintf(s_note.head, sizeof s_note.head, "Frame rate uneven?");
+#ifdef __ANDROID__
+            snprintf(s_note.l1, sizeof s_note.l1, "Frame pacing in the RACiT menu (hold Select) can even it out.");
+#else
+            snprintf(s_note.l1, sizeof s_note.l1, "Frame pacing in the RACiT menu (F1, or L3+R3 on a controller) can even it out.");
+#endif
+            snprintf(s_note.l2, sizeof s_note.l2, "It can lower the frame rate when the GPU is busy.");
+            s_note.t0 = 0; s_note.on = 1;
+            UNLOCK();
+        }
+    }
+}
