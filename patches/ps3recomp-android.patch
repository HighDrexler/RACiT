-/* ---------------------------------------------------------------------------
- * sys_fs_close
- *
- * r3 = fd
- * -----------------------------------------------------------------------*/
-int64_t sys_fs_close(ppu_context* ctx)
-{
-    int32_t fd = LV2_ARG_S32(ctx, 0);
-
-    int slot = fd - 3;
-    if (slot < 0 || slot >= SYS_FS_FD_MAX)
-        return (int64_t)(int32_t)CELL_EBADF;
-
-    sys_fs_fd_info* f = &g_sys_fs_fds[slot];
-    if (!f->active)
-        return (int64_t)(int32_t)CELL_EBADF;
-
-    if (f->fp) {
-        fclose(f->fp);
-        f->fp = NULL;
-    }
-    f->active = 0;
-
-    return CELL_OK;
-}
