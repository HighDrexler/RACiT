+/* igpm_rt's call into a job (see spu_job_time_begin) is timed; every other call goes straight on. */
+void spu_drain_call(spu_context* ctx, uint32_t return_pc)
+{
+    if (__builtin_expect(return_pc == 0x3F940u, 0)) {
+        uint32_t guid = 0;
+        const unsigned long long t0 = spu_job_time_begin(ctx, &guid);
+        const int crit = spu_job_crit_begin(ctx);
+#if defined(__ANDROID__) && defined(__aarch64__)
+        if (!(crit && racacit_fiber_job(ctx, return_pc)))
+#endif
+        spu_drain_call_run(ctx, return_pc);
+        if (crit) spu_job_crit_end();
+        spu_job_time_end(t0, guid);
+        return;
+    }
+    spu_drain_call_run(ctx, return_pc);
+}
