+        if (vk_vdesc_build(&d, P->vs, P->fs, rp, &out, 0, s_ap.cache) != VK_SUCCESS) out = VK_NULL_HANDLE;
+        P->build_ms[t] = (u32)((ps3_qpc_us() - t0) / 1000u);
+        P->ready[t] = out;
+        SDL_MemoryBarrierRelease();
+        SDL_AtomicSet(&P->pend[t], 2);
+        SDL_AtomicAdd(&s_ap.active, -1);
+    }
+    return 0;
+}
