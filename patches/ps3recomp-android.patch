-{
-    if (!attr) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
-    static int _n = 0;
-    if (_n++ < 8) printf("[cellSpurs] TasksetAttributeSetTasksetSize(size=%u)\n", size);
-    return CELL_OK;
