-} PathMapping;
-
-static PathMapping s_path_mappings[MAX_PATH_MAPPINGS];
-static char s_root_path[CELL_FS_MAX_FS_PATH_LENGTH] = ".";
-
-static void init_default_mappings(void)
-{
-    static int s_initialized = 0;
-    if (s_initialized)
-        return;
