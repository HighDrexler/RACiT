@@ -0,0 +1,64 @@
+/*
+ * ps3recomp - what the registry walk found for a computed branch, kept per SPU context
+ * (spu_channels.c spu_indirect_branch; test: tests/test_spu_ib_memo.c).
+ *
+ * A word is the key in its bits 63..17 (spu_ib_key: target >> 2, policy mode, image, task or code
+ * owner, resident overlay) and the registry entry's index + 1 in its low 17 bits; 0 is an empty way.
+ *
+ * v113-android.44: 256 sets of 4, the set picked from the whole key. It was one word a target
+ * address (256 of them): two targets that fell on the same word took turns, and so did the same
+ * address under another job -- a lane runs a dozen job modules a frame, each with its own
+ * functions at the addresses the last one used -- so the walk ran again after every change.
+ * [ib2] on the Thor (.22, the sound module alone): 21,000 walks a second ended in a word being
+ * written again; the walk and what it calls were 1.7% of all the game's cycles in the .38
+ * profile (spu_lookup_ctx_found, spu_ib_slow, spu_lifted_lookup), the lanes' part 1.0%.
+ * The way last used is first: a hit there is one compare, as before.
+ */
+#ifndef PS3RECOMP_SPU_IB_MEMO_H
+#define PS3RECOMP_SPU_IB_MEMO_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define SPU_IB_SETS  256u
+#define SPU_IB_WAYS  4u
+#define SPU_IB_WORDS (SPU_IB_SETS * SPU_IB_WAYS)
+
+static inline __attribute__((always_inline)) uint32_t spu_ib_set(uint64_t key)
+{
+    const uint64_t x = key >> 17;   /* overlay (10 bits), task (10), image (10), policy (1), target >> 2 (16) */
+    const uint32_t h = (uint32_t)(x >> 31) ^ (uint32_t)(x >> 39) ^ (uint32_t)x ^ (uint32_t)(x >> 7) ^
+                       (uint32_t)(x >> 14) ^ (uint32_t)(x >> 22);
+    return h & (SPU_IB_SETS - 1u);
+}
+
+/* The word kept for this key, or 0. */
+static inline __attribute__((always_inline)) uint64_t spu_ib_memo_find(uint64_t* memo, uint64_t key)
+{
+    uint64_t* const s = memo + (size_t)spu_ib_set(key) * SPU_IB_WAYS;
+    const uint64_t w0 = s[0];
+    if (__builtin_expect(!((w0 ^ key) >> 17) && (w0 & 0x1FFFFu), 1)) return w0;
+    for (unsigned k = 1; k < SPU_IB_WAYS; k++) {
+        const uint64_t w = s[k];
+        if (!((w ^ key) >> 17) && (w & 0x1FFFFu)) {
+            for (unsigned j = k; j > 0; j--) s[j] = s[j - 1];   /* to the front */
+            s[0] = w;
+            return w;
+        }
+    }
+    return 0;
+}
+
+/* Keep `word` (a key with its entry in the low 17 bits, not 0 there): in place of the key's own
+ * old word if it has one, else of the way used longest ago. */
+static inline void spu_ib_memo_put(uint64_t* memo, uint64_t word)
+{
+    uint64_t* const s = memo + (size_t)spu_ib_set(word) * SPU_IB_WAYS;
+    unsigned at = SPU_IB_WAYS - 1u;
+    for (unsigned k = 0; k < SPU_IB_WAYS; k++)
+        if (!((s[k] ^ word) >> 17)) { at = k; break; }
+    for (unsigned j = at; j > 0; j--) s[j] = s[j - 1];
+    s[0] = word;
+}
+
+#endif
