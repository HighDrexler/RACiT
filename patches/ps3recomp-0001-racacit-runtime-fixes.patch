+static void vk_pool_blk_free(vk_pool_blk* b, u32 unit)
+{
+    u32 k = b->order_at[unit] - 1u;
+    b->order_at[unit] = 0;
+    b->used_units -= 1u << k;
+    u32 s = unit >> k;
+    while (k + 1u < VK_POOL_ORDERS && vk_pool_isfree(b, k, s ^ 1u)) {
+        vk_pool_set(b, k, s ^ 1u, 0); b->nfree[k]--;
+        s >>= 1; k++;
+    }
+    vk_pool_set(b, k, s, 1); b->nfree[k]++;
