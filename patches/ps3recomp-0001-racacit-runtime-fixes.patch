+    case OP_BIND_TARGETS: { const r_targets* a = (const void*)b; u32 s[RSX_BE_MAX_COLOR_TARGETS];
+        for (u32 i = 0; i < a->count && i < RSX_BE_MAX_COLOR_TARGETS; i++) s[i] = tr(a->s[i]);
