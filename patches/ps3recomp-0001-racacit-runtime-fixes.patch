+static void ov_line(float x0, float y0, float x1, float y1, float w, const float c[4])
+{
+    /* Thickness in screen pixels: perpendicular computed in unsquashed space. */
+    float dx = (x1 - x0) / s_ov.ax, dy = y1 - y0, l = sqrtf(dx * dx + dy * dy);
+    if (l <= 0.0f) return;
