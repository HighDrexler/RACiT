diff --git a/runtime/platform/ps3_setjmp.h b/runtime/platform/ps3_setjmp.h
new file mode 100644
index 0000000..7965e71
--- /dev/null
+++ b/runtime/platform/ps3_setjmp.h
@@ -0,0 +1,32 @@
+/* ps3_setjmp.h -- setjmp/longjmp that never unwind.
+ *
+ * The runtime leaves guest code with longjmp (a guest thread's
+ * sys_ppu_thread_exit, an SPU halt, an SPU interrupt return). Those jumps
+ * cross lifted code, trampolines and C++ frames such as ps3_hle_call's TOC
+ * guard, and expect a plain register restore -- which is what glibc/bionic
+ * longjmp is.
+ *
+ * mingw/UCRT longjmp instead UNWINDS (RtlUnwindEx). On real Windows that died
+ * with STATUS_BAD_FUNCTION_TABLE the first time a guest thread exited, and
+ * elsewhere ran a skipped frame's destructor on a dead context; Wine's
+ * lenient unwinder hid both. On mingw x64 these map to ps3_setjmp_win64.c:
+ * save/restore the Win64 callee-saved state, nothing else. MSVC keeps its own
+ * setjmp; POSIX hosts are untouched. */
+#ifndef PS3_SETJMP_H
+#define PS3_SETJMP_H
+#include <setjmp.h>
+#if defined(_WIN32) && !defined(_MSC_VER) && defined(__x86_64__)
+#ifdef __cplusplus
+extern "C" {
+#endif
+int  ps3_setjmp(void* buf) __attribute__((returns_twice));
+void ps3_longjmp(void* buf, int val) __attribute__((noreturn));
+#ifdef __cplusplus
+}
+#endif
+#  undef setjmp
+#  undef longjmp
+#  define setjmp(b)     ps3_setjmp((void*)(b))
+#  define longjmp(b, v) ps3_longjmp((void*)(b), (v))
+#endif
+#endif
diff --git a/runtime/platform/ps3_setjmp_win64.c b/runtime/platform/ps3_setjmp_win64.c
new file mode 100644
index 0000000..d3e4aa2
--- /dev/null
+++ b/runtime/platform/ps3_setjmp_win64.c
@@ -0,0 +1,72 @@
+/* Non-unwinding setjmp/longjmp for mingw x64 -- see ps3_setjmp.h.
+ * Buffer layout (fits mingw's 256-byte jmp_buf):
+ *   0 rbx  8 rbp  16 rdi  24 rsi  32 r12  40 r13  48 r14  56 r15
+ *   64 rsp (as after setjmp returns)  72 return address
+ *   80 MXCSR  84 x87 control word  96..255 xmm6..xmm15 (unaligned stores) */
+#if defined(_WIN32) && !defined(_MSC_VER) && defined(__x86_64__)
+__asm__(
+    ".text\n"
+    ".globl ps3_setjmp\n"
+    ".def ps3_setjmp; .scl 2; .type 32; .endef\n"
+    "ps3_setjmp:\n"
+    "    movq %rbx, 0(%rcx)\n"
+    "    movq %rbp, 8(%rcx)\n"
+    "    movq %rdi, 16(%rcx)\n"
+    "    movq %rsi, 24(%rcx)\n"
+    "    movq %r12, 32(%rcx)\n"
+    "    movq %r13, 40(%rcx)\n"
+    "    movq %r14, 48(%rcx)\n"
+    "    movq %r15, 56(%rcx)\n"
+    "    leaq 8(%rsp), %rdx\n"
+    "    movq %rdx, 64(%rcx)\n"
+    "    movq (%rsp), %rdx\n"
+    "    movq %rdx, 72(%rcx)\n"
+    "    stmxcsr 80(%rcx)\n"
+    "    fnstcw 84(%rcx)\n"
+    "    movdqu %xmm6, 96(%rcx)\n"
+    "    movdqu %xmm7, 112(%rcx)\n"
+    "    movdqu %xmm8, 128(%rcx)\n"
+    "    movdqu %xmm9, 144(%rcx)\n"
+    "    movdqu %xmm10, 160(%rcx)\n"
+    "    movdqu %xmm11, 176(%rcx)\n"
+    "    movdqu %xmm12, 192(%rcx)\n"
+    "    movdqu %xmm13, 208(%rcx)\n"
+    "    movdqu %xmm14, 224(%rcx)\n"
+    "    movdqu %xmm15, 240(%rcx)\n"
+    "    xorl %eax, %eax\n"
+    "    ret\n"
+    "\n"
+    ".globl ps3_longjmp\n"
+    ".def ps3_longjmp; .scl 2; .type 32; .endef\n"
+    "ps3_longjmp:\n"
+    "    movl %edx, %eax\n"
+    "    testl %eax, %eax\n"
+    "    jnz 1f\n"
+    "    movl $1, %eax\n"
+    "1:\n"
+    "    movq 0(%rcx), %rbx\n"
+    "    movq 8(%rcx), %rbp\n"
+    "    movq 16(%rcx), %rdi\n"
+    "    movq 24(%rcx), %rsi\n"
+    "    movq 32(%rcx), %r12\n"
+    "    movq 40(%rcx), %r13\n"
+    "    movq 48(%rcx), %r14\n"
+    "    movq 56(%rcx), %r15\n"
+    "    ldmxcsr 80(%rcx)\n"
+    "    fldcw 84(%rcx)\n"
+    "    movdqu 96(%rcx), %xmm6\n"
+    "    movdqu 112(%rcx), %xmm7\n"
+    "    movdqu 128(%rcx), %xmm8\n"
+    "    movdqu 144(%rcx), %xmm9\n"
+    "    movdqu 160(%rcx), %xmm10\n"
+    "    movdqu 176(%rcx), %xmm11\n"
+    "    movdqu 192(%rcx), %xmm12\n"
+    "    movdqu 208(%rcx), %xmm13\n"
+    "    movdqu 224(%rcx), %xmm14\n"
+    "    movdqu 240(%rcx), %xmm15\n"
+    "    movq 64(%rcx), %rsp\n"
+    "    jmpq *72(%rcx)\n"
+);
+#else
+typedef int ps3_setjmp_win64_unused;
+#endif
