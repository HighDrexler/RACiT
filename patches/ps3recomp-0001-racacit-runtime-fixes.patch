+static void update_cursor(void)
+{
+    rsx_host_options o; rsx_host_ui_options(&o);
+    SDL_ShowCursor((s_open || o.display_mode == RSX_UI_DISPLAY_WINDOWED) ? SDL_ENABLE : SDL_DISABLE);
+}
