+    static volatile int mu = 0;
+    if (!init) { dir = getenv("SPU_DUMP_JOBS"); init = 1; }
+    if (!dir || !*dir) return;
+    const uint8_t* g = ctx->ls + 0x100;
+    while (__sync_lock_test_and_set(&mu, 1)) { }
+    for (int i = 0; i < nseen; i++)
+        if (!memcmp(seen[i], g, 16)) { __sync_lock_release(&mu); return; }
