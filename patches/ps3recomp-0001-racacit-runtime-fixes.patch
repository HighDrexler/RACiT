+static u32 eng_tex_find(const u32 id[8])        /* textures[] + 1, or 0 */
+{
+    for (u32 hi = eng_tex_index_hash(id);; hi = (hi + 1u) & (ENG_TEX_INDEX - 1u)) {
+        const u32 slot = g.tex_index[hi];
+        if (!slot) return 0;
+        if (!memcmp(&g.textures[slot - 1u], id, 8u * sizeof(u32))) return slot;
+    }
