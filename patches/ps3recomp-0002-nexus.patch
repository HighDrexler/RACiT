+
+static void vk_q_report(u32 offset)
+{
+    /* Every report joins the list in stream order, also one that needs no GPU
+     * work (nothing counted: 0; not countable: "visible") -- it waits for the
+     * reports before it like any other. */
+    if (s_q.npend == s_q.cappend) {
+        const u32 n = s_q.cappend ? s_q.cappend * 2u : 256u;
+        vk_qrep* p = (vk_qrep*)realloc(s_q.pend, n * sizeof *p);
+        if (!p) { s_q.n_lost++; rsx_draw_engine_zpass_result(offset, 0xFFFFu); return; }
+        s_q.pend = p; s_q.cappend = n;
+    }
+    vk_qrep r = { offset, 0, 0, 0, NULL, 1, 0, 0 };
+    if (s_q.cur_bad) r.lost = 1;
+    else if (s_q.ncur) {
+        vk_qref* refs = (vk_qref*)malloc(s_q.ncur * sizeof *refs);
+        if (!refs) r.lost = 1;
+        else {
+            memcpy(refs, s_q.cur, s_q.ncur * sizeof *refs);
+            r.left = r.n = s_q.ncur; r.refs = refs; r.done = 0;
+            s_q.rep_epoch = s_bt.epoch; s_q.since_rep = 0;
+        }
+    }
+    s_q.pend[s_q.npend++] = r;
+    vk_q_settle();                     /* segments of finished slots count at once */
