+/* GPU time per frame (on with RACACIT_PACE_STATS=1 or RSX_GPU_TIME=1;
+ * RSX_GPU_TIME=0 off). A timestamp at the start and end of every batch and
+ * around every colour/depth snapshot copy; when a batch's slot is reused its
+ * times go to the frame (present) the batch was recorded in, and every 5 s
+ * one line: the GPU's busy time per frame (the sum of its batches), the worst
+ * frame, frames over 16.7 ms, the snapshot copies' share and the batches a
+ * frame. A frame whose GPU time is near its frame time is GPU-bound -- the
+ * owner's 0.5 fights waited ~20 ms a slow frame on GPU fences with 9-11
+ * snapshots, and nothing measured what the GPU spent its time on. */
+#define VK_TS_PER_SLOT 512u
+static struct {
+    int inited, on;
+    VkQueryPool pool[VK_BT_SLOTS_MAX];
+    u32 used[VK_BT_SLOTS_MAX], frame[VK_BT_SLOTS_MAX], nsnap[VK_BT_SLOTS_MAX];
+    u32 snapq[VK_BT_SLOTS_MAX][VK_TS_PER_SLOT / 2];
+    unsigned long long open_epoch;             /* the batch a snapshot pair was begun in */
+    double ms_per_tick; u64 mask;
+    u32 present;                               /* presents so far: a batch belongs to the next one */
+    u32 acc_id; double acc_busy, acc_snap; u32 acc_b, acc_s;   /* the frame being summed */
+    u32 n, over, nb, ns; double sum, mx, snap;                 /* frames finished in this 5 s window */
+    unsigned long long last_us;
+} s_ts;
+static void vk_ts_init(void)
+{
+    s_ts.inited = 1;
+    const char* a = getenv("RSX_GPU_TIME"); const char* b = getenv("RACACIT_PACE_STATS");
+    if (a ? *a == '0' : !(b && *b == '1')) return;
+    if (!s_ts_valid_bits) { VK_LOG("GPU time: the graphics queue has no timestamps%c", 10); return; }
+    VkPhysicalDeviceProperties p;
