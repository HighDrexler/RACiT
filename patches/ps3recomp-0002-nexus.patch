+      if (s_log < 0) { const char* e = getenv("RSX_ZPASS_LOG"); s_log = e ? atol(e) : 0; }
+      if (s_log > 0 && s_q.inited && ++s_n % 600u == 0)
+          VK_LOG("ZPASS: counted draws %llu, recorded %llu; queries %llu, reports published %llu, lost %llu, waiting %u; "
+                 "GPU conditional draws %llu, report flushes %llu\n",
+                 s_q_seen, s_q_rec, s_q.n_queries, s_q.n_published, s_q.n_lost, s_q.npend,
+                 s_q.n_cond_draws, s_q.n_flushes); }
+    if (!s_q.inited || !s_q.npend) return;
+    for (u32 i = 0; i < VK_BT_SLOTS; i++)
+        if (s_bt.s[i].submitted && s_q.hgen[i] != s_q.gen[i] &&
