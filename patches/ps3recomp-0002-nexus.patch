diff --git a/runtime/spu/tests/test_csflt_rtz.c b/runtime/spu/tests/test_csflt_rtz.c
new file mode 100644
index 0000000..1a9f1b6
--- /dev/null
+++ b/runtime/spu/tests/test_csflt_rtz.c
@@ -0,0 +1,47 @@
+/* Host test (Into the Nexus, 2026-11-16): spu_csflt / spu_cuflt fast paths vs the exact reference,
+ * bit for bit, under the SPU's MXCSR (DAZ | FTZ | round toward zero), every scale; "nearest" as a
+ * second argument runs the other rounding mode. Build: zig cc -O2 -mavx2 -mfma -I.. -I../../../include */
+#include <stdio.h>
+#include <stdint.h>
+#include <xmmintrin.h>
+#include "../spu_helpers.h"
+int g_spu_cvt_rtz = 1;
+static uint64_t s = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { s ^= s << 13; s ^= s >> 7; s ^= s << 17; return (uint32_t)s; }
+static uint32_t pick(void) {
+    switch (rnd() % 8) {
+    case 0: return rnd();                              /* any 32 bits */
+    case 1: return (rnd() & 0xFFFFu) << 16;            /* EDGE Post's 16.16 pattern */
+    case 2: return rnd() >> (rnd() % 32);              /* all magnitudes */
+    case 3: return -(int32_t)(rnd() >> (rnd() % 32));
+    case 4: { static const uint32_t e[] = {0, 1, 0xFFFFFFFFu, 0x7FFFFFFFu, 0x80000000u, 0x80000001u, 1u << 24, (1u << 24) + 1, 0xFFFFFFu, 0x1000001u, 0xFF000000u, 0x00FFFFFFu};
+              return e[rnd() % 12]; }
+    case 5: return (rnd() | 1u) << (rnd() % 8);        /* odd low bits: rounding matters */
+    case 6: return 0x01000000u + (rnd() & 0x7F);
+    default: return rnd() | 0x80000000u;
+    }
+}
+int main(int argc, char** argv) {
+    long iters = argc > 1 ? atol(argv[1]) : 2000000;
+    const unsigned saved = _mm_getcsr();
+    _mm_setcsr(argc > 2 ? ((saved & ~0x6000u) | 0x8040u) : (saved | 0xE040u));   /* SPU_CSR_SPU, or DAZ|FTZ to nearest */
+    long bad = 0, n = 0, fastn = 0;
+    for (int i8 = 0; i8 < 256; i8++)
+        for (long k = 0; k < iters / 256; k++) {
+            u128 a; for (int j = 0; j < 4; j++) a._u32[j] = pick();
+            const u128 f = spu_csflt(a, i8), e = spu_csflt_exact(a, i8);
+            const u128 fu = spu_cuflt(a, i8), eu = spu_cuflt_exact(a, i8);
+            const u128 q = spu_xf_int_scale(_mm_loadu_si128((const __m128i*)a._u32), i8, 0, a);
+            fastn += !(q._u32[0] == 0xFFFFFFFFu && q._u32[1] == 1u);
+            for (int j = 0; j < 4; j++) {
+                n += 2;
+                if (f._u32[j] != e._u32[j] || fu._u32[j] != eu._u32[j]) {
+                    if (bad++ < 10) printf("MISMATCH i8=%d in %08X: csflt %08X exact %08X | cuflt %08X exact %08X\n",
+                                           i8, a._u32[j], f._u32[j], e._u32[j], fu._u32[j], eu._u32[j]);
+                }
+            }
+        }
+    _mm_setcsr(saved);
+    printf("%ld lanes compared, %ld mismatches; signed fast path taken for %.1f%% of vectors\n", n, bad, 100.0 * fastn / (iters / 256 * 256));
+    return bad != 0;
+}
