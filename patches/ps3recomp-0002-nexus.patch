index 0000000..46d417c
--- /dev/null
+++ b/libs/video/tests/test_rsx_texture_decode_fast.c
@@ -0,0 +1,53 @@
+/* rsx_texture_decode_fast must give byte-for-byte what rsx_texture_decode_slow
+ * (the texel-by-texel reference) gives: every uncompressed format byte the
+ * layout code knows, swizzled and linear, square and non-square, both channel
+ * orders. Build: zig cc -O2 -I.. -I../../../include test_rsx_texture_decode_fast.c
+ * ../rsx_texture_layout.c */
+#include "rsx_texture_layout.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static u32 s_rng = 0x12345678u;
+static u32 rnd(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 17; s_rng ^= s_rng << 5; return s_rng; }
+
+int main(void)
+{
+    static const u32 sizes[][2] = { {1,1}, {2,8}, {8,2}, {4,4}, {16,16}, {64,32}, {32,64}, {128,4},
+                                    {4,128}, {256,256}, {1024,512}, {13,7}, {640,360}, {2048,2048} };
+    long checked = 0, failed = 0, skipped = 0;
+    for (u32 fmt = 0x80; fmt <= 0xBF; fmt++) {
+        for (size_t si = 0; si < sizeof sizes / sizeof sizes[0]; si++) {
+            const u32 w = sizes[si][0], h = sizes[si][1];
+            rsx_tex_layout tl;
+            memset(&tl, 0, sizeof tl);
+            rsx_texture_layout_pitched(fmt, w, h, 0, &tl);
+            if (tl.compressed || !tl.bytes_per_texel || !tl.dst_bytes_per_texel || !tl.row_bytes) { skipped++; continue; }
+            /* A swizzled layout needs power-of-two sides (the hardware's rule). */
+            if (tl.swizzled && ((w & (w - 1u)) || (h & (h - 1u)))) { skipped++; continue; }
+            const size_t sbytes = tl.swizzled ? (size_t)(1u << rsx_log2_ceil(w)) * (1u << rsx_log2_ceil(h)) * tl.bytes_per_texel
+                                              : (size_t)tl.row_bytes * h;
+            u8* src = (u8*)malloc(sbytes + 16);
+            for (size_t i = 0; i < sbytes + 16; i++) src[i] = (u8)rnd();
+            const u32 pitch = tl.dst_row_bytes ? tl.dst_row_bytes : w * tl.dst_bytes_per_texel;
+            const size_t dbytes = (size_t)pitch * h;
+            u8* a = (u8*)malloc(dbytes); u8* b = (u8*)malloc(dbytes);
+            for (int order = 0; order < 2; order++) {
+                memset(a, 0xCD, dbytes); memset(b, 0xCD, dbytes);
+                rsx_texture_decode_slow(a, pitch, src, w, h, &tl, order);
+                rsx_texture_decode_fast(b, pitch, src, w, h, &tl, order);
+                checked++;
+                if (memcmp(a, b, dbytes)) {
+                    failed++;
+                    size_t k = 0; while (k < dbytes && a[k] == b[k]) k++;
+                    printf("MISMATCH fmt 0x%02X (base 0x%02X, %s) %ux%u order %d at byte %zu: %02X vs %02X\n",
+                           fmt, tl.base_format, tl.swizzled ? "swizzled" : "linear", w, h, order, k, a[k], b[k]);
+                }
+            }
+            free(a); free(b); free(src);
+        }
+    }
+    printf("decode fast vs slow: %ld cases, %ld mismatches (%ld skipped: compressed/unknown/non-pow2 swizzled)\n",
+           checked, failed, skipped);
+    return failed ? 1 : 0;
+}
