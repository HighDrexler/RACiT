+       * stretch), never from one loading screen to the next. */
+      if (out != last_out || now_us - last_fire > 200000ull) { last_out = out; since = now_us; }
+      last_fire = now_us;
+      if (out > 0 && now_us - since >= 2000000ull) {
+          static int said; if (said < 4) { said++;
+              fprintf(stderr, "[zpass] %ld report(s) never answered by the backend: no longer held%c", out, 10); }
+#ifdef _WIN32
+          InterlockedExchange(&s_zp_out, 0);
+#else
+          atomic_store(&s_zp_out, 0);
+#endif
+          last_out = 0; since = now_us;
