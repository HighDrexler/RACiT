+/* RSX_ZPASS_LOG: counted draws that reached vk_eng_draw, and those recorded. */
+static unsigned long long s_q_seen, s_q_rec;
+/* A counted draw is about to be recorded inside a pass: open a segment. */
+static void vk_q_begin_draw(void)
+{
