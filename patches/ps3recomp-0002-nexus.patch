+/* Reports are handed over in the order the title issued them, never ahead of
+ * an earlier one. Into the Nexus reads a group of counts (func_00611568) by
+ * waiting for ONE report's timer -- the group's last -- and then taking every
+ * count of the group, as the RSX writes reports in order. Handing over a
+ * report with nothing counted at once, or a finished batch's reports in
+ * whatever order they sat in the list, let that timer go before the counts
+ * ahead of it: the title read another object's count from the frame before
+ * and stopped drawing whatever read 0 (0.3 and 0.4, standing in the first
+ * room: Ratchet, the floor hatch, the robots; runs 125-137). */
+static void vk_q_hand_over(vk_qrep* r)
+{
+    if (r->lost) { s_q.n_lost++; rsx_draw_engine_zpass_result(r->offset, 0xFFFFu); }   /* unknown: "visible" */
+    else vk_q_publish(r->offset, r->sum);
+    free(r->refs);
