+    s_ts.ms_per_tick = (p.limits.timestampPeriod > 0.0f ? (double)p.limits.timestampPeriod : 1.0) / 1e6;
+    s_ts.mask = s_ts_valid_bits >= 64u ? ~0ull : ((1ull << s_ts_valid_bits) - 1ull);
+    VkQueryPoolCreateInfo qi = { .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+                                 .queryType = VK_QUERY_TYPE_TIMESTAMP, .queryCount = VK_TS_PER_SLOT };
+    for (u32 i = 0; i < VK_BT_SLOTS; i++)
+        if (pvkCreateQueryPool(s_vk.device, &qi, NULL, &s_ts.pool[i]) != VK_SUCCESS) {
+            for (u32 k = 0; k < i; k++) pvkDestroyQueryPool(s_vk.device, s_ts.pool[k], NULL);
