+/* The slot's fence has signalled (vk_bt_wait_slot): its times to its frame. */
+static void vk_ts_harvest(u32 sl)
+{
+    if (!s_ts.on || s_ts.used[sl] < 2) return;
+    s_ts.used[sl] = 0;
+    u64 t[2];
+    if (pvkGetQueryPoolResults(s_vk.device, s_ts.pool[sl], 0, 2, sizeof t, t, sizeof(u64), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS)
+        return;
