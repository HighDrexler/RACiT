+
+static void vk_q_shutdown(void)
+{
+    if (s_q.inited)
+        for (u32 i = 0; i < VK_BT_SLOTS; i++) pvkDestroyQueryPool(s_vk.device, s_q.pool[i], NULL);
+    if (s_q.gpu) vk_destroy_buffer(&s_q.cbuf);
+    for (u32 i = s_q.phead; i < s_q.npend; i++) free(s_q.pend[i].refs);
+    free(s_q.pend);
+    memset(&s_q, 0, sizeof s_q);
