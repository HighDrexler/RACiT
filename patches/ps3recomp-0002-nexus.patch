+        u64 u[2];
+        if (pvkGetQueryPoolResults(s_vk.device, s_ts.pool[sl], s_ts.snapq[sl][k], 2, sizeof u, u, sizeof(u64),
+                                   VK_QUERY_RESULT_64_BIT) == VK_SUCCESS)
+            snap += (double)((u[1] - u[0]) & s_ts.mask) * s_ts.ms_per_tick;
+    }
+    if (s_ts.frame[sl] + 1u != s_ts.acc_id) { vk_ts_finish_frame(); s_ts.acc_id = s_ts.frame[sl] + 1u; }
+    s_ts.acc_busy += (double)((t[1] - t[0]) & s_ts.mask) * s_ts.ms_per_tick;
+    s_ts.acc_snap += snap; s_ts.acc_b++; s_ts.acc_s += s_ts.nsnap[sl];
+}
+static unsigned long long s_up_n, s_up_inorder;   /* texture uploads ahead of their batch / in order (vk_up_cmd) */
+/* Every present (vk_eng_present): the frame counter, and the line every 5 s. */
+static void vk_ts_present(void)
+{
