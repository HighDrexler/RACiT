+                n++;
+            }
+            pvkCmdCopyQueryPoolResults(s_vk.cmd, s_q.pool[w->slot], w->q, n, s_q.cbuf.buf,
+                                       (VkDeviceSize)w->idx * 4u, 4u, VK_QUERY_RESULT_WAIT_BIT);
+            i += n;
