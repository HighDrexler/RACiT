+/* Samples to guest pixels: the scene is drawn RACACIT_RES_SCALE times the
+ * guest's size each way. Rounded up, so "some passed" stays non-zero. */
+static void vk_q_publish(u32 offset, u64 samples)
+{
+    extern float g_rsx_res_scale;
+    const double sc = g_rsx_res_scale > 0.0f ? (double)g_rsx_res_scale : 1.0;
+    double v = (double)samples / (sc * sc);
+    u64 px = (u64)v; if ((double)px < v) px++;
+    if (px > 0x7FFFFFFEull) px = 0x7FFFFFFEull;
+    rsx_draw_engine_zpass_result(offset, (u32)px);
+    s_q.n_published++;
