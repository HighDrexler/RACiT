+/* Take the results of finished recordings into the waiting reports; a report
+ * whose slot was recorded again unread is lost ("visible"). */
+static void vk_q_settle(void)
+{
+    for (u32 i = s_q.phead; i < s_q.npend; i++) {
+        vk_qrep* r = &s_q.pend[i];
