+{
+    if (!s_ts.on || !s_bt.recording) return 0;
+    const u32 sl = s_bt.cur;
+    if (s_ts.used[sl] < 2 || s_ts.used[sl] + 2u > VK_TS_PER_SLOT) return 0;
+    const u32 q = s_ts.used[sl];
+    s_ts.used[sl] += 2u;
+    s_ts.open_epoch = s_bt.epoch;
+    pvkCmdWriteTimestamp(s_vk.cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, s_ts.pool[sl], q);
+    return q;
+}
+static void vk_ts_mark_end(u32 q)
+{
+    if (!q || !s_ts.on || !s_bt.recording || s_ts.open_epoch != s_bt.epoch) return;   /* the batch went out in between */
+    const u32 sl = s_bt.cur;
+    pvkCmdWriteTimestamp(s_vk.cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s_ts.pool[sl], q + 1u);
