+#define GCM_PG_MAX 4096
+static gcm_pg_hit s_pg_hits[GCM_PG_MAX];
+static LONG CALLBACK gcm_pg_handler(EXCEPTION_POINTERS* ep)
+{
+    if (ep->ExceptionRecord->ExceptionCode != STATUS_GUARD_PAGE_VIOLATION) return EXCEPTION_CONTINUE_SEARCH;
+    const ULONG_PTR a = ep->ExceptionRecord->ExceptionInformation[1];
+    const ULONG_PTR lo = (ULONG_PTR)s_pg_lo & ~(ULONG_PTR)0xFFF;
+    if (!s_pg_lo || a < lo || a >= (ULONG_PTR)s_pg_lo + s_pg_len + 0x1000) return EXCEPTION_CONTINUE_SEARCH;
+    InterlockedExchange(&s_pg_armed, 0);
+    if (a >= (ULONG_PTR)s_pg_lo && a < (ULONG_PTR)s_pg_lo + s_pg_len && ep->ExceptionRecord->ExceptionInformation[0] == 0) {   /* reads only */
+        const LONG n = InterlockedIncrement(&s_pg_n) - 1;
+        if (n < GCM_PG_MAX) {
+            extern unsigned long long ps3_qpc_us(void);
+            s_pg_hits[n].tid = GetCurrentThreadId(); s_pg_hits[n].rw = ep->ExceptionRecord->ExceptionInformation[0];
+            s_pg_hits[n].addr = a; s_pg_hits[n].rip = (void*)ep->ContextRecord->Rip; s_pg_hits[n].us = ps3_qpc_us();
+        }
+    }
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+static DWORD WINAPI gcm_pg_thread(LPVOID p)
+{
+    (void)p;
+    extern uint32_t ppu_prof_resolve_host(void* ra);
+    LONG shown = 0; unsigned printed = 0;
+    for (;;) {
+        Sleep(1);
+        if (!InterlockedCompareExchange(&s_pg_armed, 1, 0)) {
+            DWORD old;
+            VirtualProtect(s_pg_lo, s_pg_len, PAGE_READWRITE | PAGE_GUARD, &old);
+        }
+        const LONG n = s_pg_n < GCM_PG_MAX ? s_pg_n : GCM_PG_MAX;
+        while (shown < n && printed < 4000u) {
+            const gcm_pg_hit* h = &s_pg_hits[shown++];
+            printed++;
+            fprintf(stderr, "[zp-guard] t=%llu tid %lu %s guest 0x%08X host rip %p guest-fn 0x%08X%c",
+                    h->us, (unsigned long)h->tid, h->rw == 0 ? "read " : h->rw == 1 ? "write" : "exec ",
+                    s_pg_ea + (u32)(h->addr - (ULONG_PTR)s_pg_lo), h->rip, ppu_prof_resolve_host(h->rip), 10);
+        }
+    }
+    return 0;
+}
+static void gcm_pg_start(void)
+{
+    static int done; if (done) return; done = 1;
+    const char* e = getenv("RSX_ZPASS_GUARD"); if (!e) return;
+    char* d; const u32 ea = (u32)strtoul(e, &d, 16); const u32 len = *d == ',' ? (u32)strtoul(d + 1, 0, 0) : 0x1000u;
+    extern u8* vm_base;
+    s_pg_ea = ea & ~0xFFFu; s_pg_lo = vm_base + s_pg_ea; s_pg_len = ((ea + len + 0xFFFu) & ~0xFFFu) - s_pg_ea;
+    AddVectoredExceptionHandler(1, gcm_pg_handler);
+    CreateThread(NULL, 0, gcm_pg_thread, NULL, 0, NULL);
+    fprintf(stderr, "[zp-guard] guarding guest 0x%08X..0x%08X%c", s_pg_ea, s_pg_ea + (u32)s_pg_len, 10);
+}
+#else
+static void gcm_pg_start(void) { }
+#endif
