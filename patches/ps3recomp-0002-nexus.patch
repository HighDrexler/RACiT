+        pvkCmdFillBuffer(s_vk.cmd, s_q.cbuf.buf, 0, (VkDeviceSize)VK_Q_CBUF_WORDS * 4u, 1u);   /* never reported: draw */
+        vk_full_barrier();
+        s_q.cbuf_filled = 1;
+    }
+    for (u32 i = 0; i < s_q.npw; ) {
+        const vk_qpw* w = &s_q.pw[i];
+        s_q.pw_at[w->idx] = 0;
+        if (w->kind == 0 && w->gen == s_q.gen[w->slot]) {
+            /* A run of copies whose queries and words both follow on: one call. */
+            u32 n = 1;
+            while (i + n < s_q.npw && s_q.pw[i + n].kind == 0 && s_q.pw[i + n].slot == w->slot &&
+                   s_q.pw[i + n].gen == w->gen && s_q.pw[i + n].q == w->q + n && s_q.pw[i + n].idx == w->idx + n) {
