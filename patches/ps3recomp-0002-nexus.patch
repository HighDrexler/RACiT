+/* The game let go of a sound (Into the Nexus's SCREAM release, func_00A81988): one-shots
+ * are released right after they start and play on to their end, so only what would play
+ * forever stops -- a script with a loop, a voice whose sample repeats. Treating release as
+ * stop cut every gun shot to a 30 ms fade: the "clicks" on the speaker (0.9.6). */
+void ds_player_release(uint32_t owner)
+{
+    if (!owner) return;
+    int loops = 0;
+    lock();
+    for (int i = 0; i < DS_SCRIPTS; i++) {
+        const ds_script* s = &s_s[i];
+        if (!s->used || s->owner != owner || s->stopping) continue;
+        for (int g = 0; g < s->ng; g++) if ((s->g[g][0] >> 24) == 0x15) { loops = 1; break; }   /* LOOP_START */
+    }
+    for (int j = 0; j < DS_VOICES && !loops; j++)
+        if (s_v[j].used && s_v[j].owner == owner && s_v[j].loop_fr >= 0) loops = 1;
+    unlock();
+    if (dbg()) { static int nl; if (nl++ < 300) fprintf(stderr, "[ds-dbg] release %08X: %s%c", owner, loops ? "loops, stopped" : "plays to its end", 10); }
+    if (loops) ds_player_stop(owner);
+}
