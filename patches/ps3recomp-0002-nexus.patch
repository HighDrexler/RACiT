+    s_q.used[sl] = 0;
+    pvkCmdResetQueryPool(s_vk.cmd, s_q.pool[sl], 0, VK_Q_PER_SLOT);
+    s_q.reset_ok[sl] = 1;
+    if (s_q.npend) vk_q_settle();
