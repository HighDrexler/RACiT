+    if (s_q.cur_bad) w.kind = 2;
+    else if (!s_q.ncur) w.kind = 1;
+    else if (s_q.ncur == 1 && s_q.cur[0].gen == s_q.gen[s_q.cur[0].slot]) {
+        w.kind = 0; w.slot = s_q.cur[0].slot; w.q = s_q.cur[0].idx; w.gen = s_q.cur[0].gen;
+    }
+    const u32 at = s_q.pw_at[idx];
+    if (at) { s_q.pw[at - 1u] = w; return; }       /* written again before a flush: the last one counts */
+    if (s_q.npw >= VK_Q_MAX_PW) { vk_bt_end_pass(); vk_q_flush_writes(); }
