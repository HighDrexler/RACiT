+static void vk_ts_open(u32 sl)
+{
+    if (!s_ts.inited) vk_ts_init();
+    if (!s_ts.on) return;
+    pvkCmdResetQueryPool(s_vk.cmd, s_ts.pool[sl], 0, VK_TS_PER_SLOT);
+    pvkCmdWriteTimestamp(s_vk.cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, s_ts.pool[sl], 0);
+    s_ts.used[sl] = 2; s_ts.nsnap[sl] = 0; s_ts.frame[sl] = s_ts.present;
+}
+/* End of a batch (vk_bt_submit, after the last pass). */
+static void vk_ts_close(u32 sl)
+{
+    if (!s_ts.on || s_ts.used[sl] < 2) return;
+    pvkCmdWriteTimestamp(s_vk.cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s_ts.pool[sl], 1);
