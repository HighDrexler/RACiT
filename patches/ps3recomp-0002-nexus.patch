+/* Reports held back for their own count and not answered yet: +1 where the
+ * walker holds one (GET_REPORT, zp_wait), -1 in gcm_zpass_report (the
+ * backend's thread). The hold mark below stays armed while any is out, so a
+ * report carried past a flip still gets the idle hand-over and the watchdog
+ * even when the frame that flipped counted nothing new. */
+#ifdef _WIN32
+static volatile LONG s_zp_out;
+#define GCM_ZP_OUT_INC() InterlockedIncrement(&s_zp_out)
+#define GCM_ZP_OUT_DEC() do { if (InterlockedDecrement(&s_zp_out) < 0) InterlockedExchange(&s_zp_out, 0); } while (0)
+#define GCM_ZP_OUT()     ((long)s_zp_out)
+#else
+static atomic_int s_zp_out;
+#define GCM_ZP_OUT_INC() atomic_fetch_add(&s_zp_out, 1)
+#define GCM_ZP_OUT_DEC() do { if (atomic_fetch_sub(&s_zp_out, 1) <= 0) atomic_store(&s_zp_out, 0); } while (0)
+#define GCM_ZP_OUT()     ((long)atomic_load(&s_zp_out))
+#endif
+static void gcm_zpass_flip(void)
+{
+    /* Since 0.9.6 the backend's flip no longer waits for the GPU (Phase 4y): a
+     * report still with the GPU stays waiting past the flip. The hold mark must
+     * stay armed for it, or nothing hands it over while the title waits for it
+     * with no draws and no flips coming -- vk_q_idle and the 50 ms watchdog
+     * below both key on it. Owner's 0.9.6 session (Kragg, Yerek): main waited
+     * at lr 0x00570B5C for its full 1 s timeout four times. A frame that counted
+     * nothing leaves it clear -- unless reports from before are still out
+     * (s_zp_out): tester log 2026-11-19, three more 1 s stalls at the same lr,
+     * each right after the watchdog line, in frames that counted nothing. */
+    extern unsigned long long ps3_qpc_us(void);
+    const unsigned n = rsx_draw_engine_enabled() ? rsx_draw_engine_zpass_flip() : 0u;
+    s_zp_held_us = (n || GCM_ZP_OUT() > 0) ? (ps3_qpc_us() | 1ull) : 0ull;
