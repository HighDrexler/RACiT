+               s_ts.snap / s_ts.n, (double)s_ts.ns / s_ts.n, (double)s_ts.nb / s_ts.n, s_up_n, s_up_inorder, 10);
+    s_ts.n = s_ts.over = s_ts.nb = s_ts.ns = 0; s_ts.sum = s_ts.mx = s_ts.snap = 0.0;
+    s_up_n = s_up_inorder = 0;
+}
+static void vk_ts_shutdown(void)
+{
+    if (s_ts.on)
+        for (u32 i = 0; i < VK_BT_SLOTS; i++) pvkDestroyQueryPool(s_vk.device, s_ts.pool[i], NULL);
+    memset(&s_ts, 0, sizeof s_ts);
+}
