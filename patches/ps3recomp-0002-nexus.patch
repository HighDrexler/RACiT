+/* A tone's sample: its address field as is when it points into the bank's sample chunk (or
+ * anywhere, with no chunk table to go by), else the field read as an offset into that chunk.
+ * The chunk table is at bank - 0x20: {?, ?, bank's offset 0x20, bank's size, samples'
+ * offset, samples' size}, offsets from the table itself. */
+static uint32_t sample_ea(uint32_t bank, uint32_t field, uint32_t size)
+{
+    const uint32_t ct = bank - 0x20u;
+    if (!ea_ok(ct, 0x18)) return field;
+    const uint32_t bo = g32(ct + 8), bs = g32(ct + 12), so = g32(ct + 16), ss = g32(ct + 20);
+    uint32_t base;
+    if (bo == 0x20u && so >= 0x20u + bs) base = ct + so;           /* offsets from the table, as on disk */
+    else if (bo == bank && so >= bank + bs) base = so;              /* the loader made them addresses */
+    else return field;
+    if (!ss || ss > 0x4000000u || !ea_ok(base, ss)) return field;
+    if (field >= base && field - base < ss) {                             /* an address already */
+        static int said; if (!said) { said = 1;
+            fprintf(stderr, "[ds] tone samples are addresses in the bank's sample chunk (bank %08X: %08X)%c", bank, field, 10); }
+        return field;
+    }
+    if (field < ss && size <= ss - field) {
+        static int said; if (!said) { said = 1;
+            fprintf(stderr, "[ds] tone samples are offsets into the bank's sample chunk (bank %08X: +%X -> %08X)%c",
+                    bank, field, base + field, 10); }
+        return base + field;
+    }
+    return field;
+}
