+static void gcm_zpass_watch(void)
+{
+    extern unsigned long long ps3_qpc_us(void);
+    if (!s_zp_held_us) return;
+    /* Held, and the FIFO is empty (put == get): the title is waiting for the
+     * count and sends nothing more until it has it -- the draw engine sends
+     * the report's batch to the GPU and hands finished counts over now
+     * (rsx_vulkan_backend.c vk_q_idle). At most every 200 us; the walker
+     * comes here every ~1-2 ms while idle. RSX_ZPASS_IDLE=0: off. */
+    { static int on = -1; static unsigned long long last;
+      if (on < 0) { const char* e = getenv("RSX_ZPASS_IDLE"); on = !(e && *e == '0'); }
+      const unsigned long long now = ps3_qpc_us();
+      if (on && now - last >= 200u && rsx_draw_engine_enabled() &&
+          vm_read32(VM_HLE_INJECT_BASE + 0x2000u) == vm_read32(VM_HLE_INJECT_BASE + 0x2004u)) {   /* put == get (GCM_CONTROL_GUEST_ADDR, below) */
+          extern void rsx_draw_engine_zpass_idle(void);
+          last = now; rsx_draw_engine_zpass_idle();
