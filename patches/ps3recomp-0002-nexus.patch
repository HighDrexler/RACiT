+static void vk_q_publish_ready(void)
+{
+    extern void rsx_draw_engine_zpass_stale(u32 offset);
+    while (s_q.phead < s_q.npend) {
+        vk_qrep* r = &s_q.pend[s_q.phead];
+        if (r->done) vk_q_hand_over(r);
+        else if (r->stale_ok) { rsx_draw_engine_zpass_stale(r->offset); free(r->refs); s_q.n_stale++; }
+        else break;
+        s_q.phead++;
+    }
+    if (s_q.phead == s_q.npend) s_q.phead = s_q.npend = 0;
+    else if (s_q.phead >= 256u && s_q.phead * 2u >= s_q.npend) {
+        memmove(s_q.pend, s_q.pend + s_q.phead, (s_q.npend - s_q.phead) * sizeof *s_q.pend);
+        s_q.npend -= s_q.phead; s_q.phead = 0;
+    }
