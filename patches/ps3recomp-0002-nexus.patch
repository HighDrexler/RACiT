diff --git a/tools/test_ppu_cs_addic_spill.py b/tools/test_ppu_cs_addic_spill.py
new file mode 100644
index 0000000..c7521f1
--- /dev/null
+++ b/tools/test_ppu_cs_addic_spill.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Callee-save pairing: a register defined with `addic` and then spilled once.
+
+`addic rN, rA, imm` is lifted as a braced block, so a line-start match for
+"the body redefines rN" never saw it. The single `std rN, off(r1)` that follows
+is then a SPILL of a live value, not the prologue save, and its reload must stay
+a real load. Into the Nexus func_006709D8: `addic r19,r29,-12480` (the handle
+allocator), `std r19,0xD0(r1)`, r19 reused as a temporary, `ld r19,0xD0(r1)`.
+The reload was rewritten to the caller's r19 (0) and the allocator's counters
+were read and written in the null page.
+
+Run: python tools/test_ppu_cs_addic_spill.py
+"""
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import ppu_disasm                       # noqa: E402
+from ppu_lifter import PPULifter        # noqa: E402
+
+BASE = 0x10000
+
+
+def w_stdu(rs, ra, d):  return (62 << 26) | (rs << 21) | (ra << 16) | (d & 0xFFFC) | 1
+def w_std(rs, ra, d):   return (62 << 26) | (rs << 21) | (ra << 16) | (d & 0xFFFC)
+def w_ld(rt, ra, d):    return (58 << 26) | (rt << 21) | (ra << 16) | (d & 0xFFFC)
+def w_lwz(rt, ra, d):   return (32 << 26) | (rt << 21) | (ra << 16) | (d & 0xFFFF)
+def w_addi(rt, ra, s):  return (14 << 26) | (rt << 21) | (ra << 16) | (s & 0xFFFF)
+def w_addic(rt, ra, s): return (12 << 26) | (rt << 21) | (ra << 16) | (s & 0xFFFF)
+def w_addis(rt, ra, s): return (15 << 26) | (rt << 21) | (ra << 16) | (s & 0xFFFF)
+def w_blr():            return (19 << 26) | (20 << 21) | (16 << 1)
+
+
+words = [
+    w_stdu(1, 1, -0x180),
+    w_std(19, 1, 0x108),        # the prologue save
+    w_addis(29, 0, 0xF9),
+    w_addic(19, 29, -12480),    # r19 redefined (braced form)
+    w_std(19, 1, 0xD0),         # spill of the live value
+    w_addic(19, 1, 0x70),       # r19 reused as a temporary
+    w_ld(19, 1, 0xD0),          # reload: must stay a real load
+    w_lwz(5, 19, 0x44),
+    w_ld(19, 1, 0x108),         # the epilogue restore
+    w_addi(1, 1, 0x180),
+    w_blr(),
+]
+insns = [ppu_disasm.decode(w, BASE + 4 * i) for i, w in enumerate(words)]
+func = PPULifter().lift_function(insns, BASE, BASE + 4 * len(words))
+body = "\n".join(func.body_lines)
+
+assert "ctx->gpr[19] = vm_read64(ctx->gpr[1] + 0xD0);" in body, body
+assert body.count("ctx->gpr[19] = _cs_19;") == 1, body
+assert "uint64_t _cs_19 = ctx->gpr[19];" in body, body
+print("PASS: addic-defined spill reload stays a real load; the prologue pair still snapshots")
diff --git a/tools/test_ppu_vmx_exp_log_sat.py b/tools/test_ppu_vmx_exp_log_sat.py
new file mode 100644
index 0000000..6241a54
--- /dev/null
+++ b/tools/test_ppu_vmx_exp_log_sat.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Regression test: vexptefp, vlogefp, vsubuws and vmsumuhm are lowered, lane-correct.
+
+All four had no lowering and lifted to a `/* TODO */` comment, so vD kept a stale
+value (Into the Nexus, 2026-11-17):
+  - vlogefp/vexptefp: func_00619C70 builds the atmosphere tables, x^2.2 per channel
+    of a 512-texel sRGB table (2^(2.2*log2 x)); without them the curve was 2.2x and
+    the packed bytes wrapped -- Thram's haze table was garbage.
+  - vsubuws: the (1 - t) weight of the packed-ARGB colour lerp at 0x005884C0.
+  - vmsumuhm: func_0060613C.
+The register file holds big-endian bytes, so the lanes go through the lifter's own
+ppu_vld*/ppu_vst* helpers. This test lifts each, compiles the emitted C with those
+helpers, runs it and compares vD with a reference model. Needs a host C compiler
+(under CI=1 a missing one fails instead of skipping).
+"""
+from __future__ import annotations
+
+import math
+import os
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import test_ppu_vcmp_record_cr6 as T   # noqa: E402  (its _lift_one / _accessors / _cc)
+
+
+def _lift_one(mnemonic, operands):
+    """As test_ppu_vcmp_record_cr6._lift_one, with the `raw`/`comment` fields the
+    aliasing path (vD also a source: _translate_vmx_aliased) rebuilds from."""
+    from types import SimpleNamespace
+    insns = [SimpleNamespace(addr=0x1000, raw=0, mnemonic=mnemonic, operands=operands, comment=""),
+             SimpleNamespace(addr=0x1004, raw=0x4E800020, mnemonic="blr", operands="", comment="")]
+    func = T.L.PPULifter().lift_function(insns, 0x1000, 0x1008)
+    return "\n".join(ln for ln in func.body_lines if "return" not in ln)
+
+
+def run(cc, mn, ops, regs):
+    body = _lift_one(mn, ops)
+    assert "TODO" not in body, f"{mn}: not lowered\n{body}"
+    init = "\n".join("  { const unsigned char V[16] = {" + ",".join(str(x) for x in data) + "};"
+                     f" memcpy(ctx->vr[{r}], V, 16); }}" for r, data in regs.items())
+    src = "\n".join([
+        "#include <stdint.h>", "#include <string.h>", "#include <stdio.h>", "#include <math.h>",
+        "#include <stdalign.h>",   # the aliasing snapshot's alignas (a keyword in the C++ lift)
+        T._accessors(),
+        "typedef struct { uint8_t vr[32][16]; uint32_t cr; } ctx_t;",
+        "int main(void) { static ctx_t c; ctx_t* ctx = &c;",
+        init, body,
+        "  for (int i = 0; i < 16; i++) printf(\"%02X\", ctx->vr[3][i]); printf(\"\\n\"); return 0; }",
+    ])
+    with tempfile.TemporaryDirectory() as td:
+        cfile = Path(td) / "t.c"
+        exe = Path(td) / ("t.exe" if os.name == "nt" else "t")
+        cfile.write_text(src)
+        r = subprocess.run([cc, "-std=c11", "-O1", "-o", str(exe), str(cfile), "-lm"],
+                           capture_output=True, text=True)
+        assert r.returncode == 0, r.stderr + "\n" + src
+        out = subprocess.run([str(exe)], capture_output=True, text=True)
+        return bytes.fromhex(out.stdout.strip())
+
+
+def f4(v): return struct.pack(">4f", *v)
+def w4(v): return struct.pack(">4I", *v)
+
+
+def test_all():
+    cc = T._cc()
+    if cc is None:
+        if os.environ.get("CI"):
+            raise SystemExit("FAIL: no C compiler found")
+        print("skip test_ppu_vmx_exp_log_sat: no C compiler")
+        return
+    # vexptefp vD, vB (vA unused): 2^x
+    xs = [0.0, 1.0, -1.0, 3.5]
+    got = struct.unpack(">4f", run(cc, "vexptefp", "v3,v0,v2", {2: f4(xs), 3: f4([7, 7, 7, 7])}))
+    for g, x in zip(got, xs):
+        assert math.isclose(g, 2.0 ** x, rel_tol=1e-6), ("vexptefp", got)
+    # vlogefp vD, vB: log2 x (the x^2.2 of func_00619C70: 2.2 * log2(0.5) = -2.2)
+    xs = [1.0, 8.0, 0.5, 2.2]
+    got = struct.unpack(">4f", run(cc, "vlogefp", "v3,v0,v2", {2: f4(xs)}))
+    for g, x in zip(got, xs):
+        assert math.isclose(g, math.log2(x), rel_tol=1e-6, abs_tol=1e-7), ("vlogefp", got)
+    # special values: log2(0) = -inf, log2(-1) = NaN, 2^-inf = 0
+    got = struct.unpack(">4f", run(cc, "vlogefp", "v3,v0,v2", {2: f4([0.0, -1.0, float("inf"), 1.0])}))
+    assert got[0] == float("-inf") and got[1] != got[1] and got[2] == float("inf"), ("vlogefp special", got)
+    got = struct.unpack(">4f", run(cc, "vexptefp", "v3,v0,v2", {2: f4([float("-inf"), 0.0, 0.0, 0.0])}))
+    assert got[0] == 0.0, ("vexptefp -inf", got)
+    # vsubuws vD, vA, vB: unsigned word subtract, saturate at 0
+    a, b = [10, 5, 0xFFFFFFFF, 0x10000], [3, 7, 1, 0x4000]
+    got = struct.unpack(">4I", run(cc, "vsubuws", "v3,v1,v2", {1: w4(a), 2: w4(b)}))
+    assert list(got) == [7, 0, 0xFFFFFFFE, 0xC000], ("vsubuws", [hex(x) for x in got])
+    # vmsumuhm vD, vA, vB, vC: per word, sum of two unsigned halfword products + vC (modulo)
+    a = [0x00010002, 0xFFFF0003, 0x12345678, 0]
+    b = [0x00030004, 0xFFFF0005, 0x00020002, 0]
+    c = [100, 1, 0xFFFFFFFF, 7]
+    want = []
+    for x, y, z in zip(a, b, c):
+        want.append(((x >> 16) * (y >> 16) + (x & 0xFFFF) * (y & 0xFFFF) + z) & 0xFFFFFFFF)
+    got = struct.unpack(">4I", run(cc, "vmsumuhm", "v3,v1,v2,v4", {1: w4(a), 2: w4(b), 4: w4(c)}))
+    assert list(got) == want, ("vmsumuhm", [hex(x) for x in got], [hex(x) for x in want])
+    # vD aliasing an input (func_0060613C: vmsumuhm v3, v31, v4, v3)
+    got = struct.unpack(">4I", run(cc, "vmsumuhm", "v3,v1,v2,v3", {1: w4(a), 2: w4(b), 3: w4(c)}))
+    assert list(got) == want, ("vmsumuhm alias", [hex(x) for x in got])
+    print("  vexptefp, vlogefp, vsubuws, vmsumuhm checked")
+
+
+if __name__ == "__main__":
+    test_all()
+    print("ok test_ppu_vmx_exp_log_sat")
