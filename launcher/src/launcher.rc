// RaCACiT Launcher resources: the icon (made by make_icon.py into build\) and version info.
#include <winver.h>

1 ICON "../build/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,9,0,0
PRODUCTVERSION 0,9,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "RACiT Launcher"
      VALUE "ProductName", "Ratchet & Clank: A Crack in Time (PC recompilation) launcher"
      VALUE "FileVersion", "0.9"
      VALUE "ProductVersion", "0.9"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
